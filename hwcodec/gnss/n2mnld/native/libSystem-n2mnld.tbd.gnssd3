--- !tapi-tbd
tbd-version:      4
targets:          [ arm64-ios ]
install-name:     '/usr/lib/libSystem.B.dylib'
current-version:  1336
compatibility-version: 1
exports:
  - targets:      [ arm64-ios ]
    symbols:
      - ___error
      - ___stack_chk_fail
      - ___stack_chk_guard
      - _abort
      - _accept
      - _access
      - _acos
      - _asin
      - _atan
      - _atan2
      - _atof
      - _atoi
      - _bind
      - _calloc
      - _chdir
      - _chmod
      - _clock_gettime
      - _close
      - _closedir
      - _cos
      - _ctime
      - _exit
      - _exp
      - _exp2
      - _fclose
      - _fcntl
      - _fflush
      - _fgets
      - _fmod
      - _fmodf
      - _fopen
      - _fputc
      - _fputs
      - _fread
      - _free
      - _fseek
      - _ftell
      - _fwrite
      - _gettimeofday
      - _gmtime
      - _inet_ntoa
      - _ioctl
      - _kevent
      - _kqueue
      - _listen
      - _localtime
      - _log
      - _log10
      - _malloc
      - _memcmp
      - _memcpy
      - _memmove
      - _memset
      - _mkdir
      - _mkfifo
      - _mktime
      - _modf
      - _open
      - _opendir
      - _pipe
      - _pow
      - _pthread_attr_destroy
      - _pthread_attr_init
      - _pthread_attr_setdetachstate
      - _pthread_attr_setstacksize
      - _pthread_cond_destroy
      - _pthread_cond_init
      - _pthread_cond_signal
      - _pthread_cond_timedwait
      - _pthread_cond_timedwait_relative_np
      - _pthread_cond_wait
      - _pthread_create
      - _pthread_equal
      - _pthread_exit
      - _pthread_getspecific
      - _pthread_join
      - _pthread_key_create
      - _pthread_mutex_destroy
      - _pthread_mutex_init
      - _pthread_mutex_lock
      - _pthread_mutex_unlock
      - _pthread_mutexattr_init
      - _pthread_mutexattr_settype
      - _pthread_self
      - _pthread_setspecific
      - _puts
      - _qsort
      - _rand
      - _read
      - _readdir
      - _remove
      - _rename
      - _setbuf
      - _setsockopt
      - _sigaction
      - _sigaltstack
      - _signal
      - _sin
      - _sleep
      - _snprintf
      - _socket
      - _srand
      - _stat
      - _strcat
      - _strchr
      - _strcmp
      - _strcpy
      - _strerror
      - _strlen
      - _strncat
      - _strncmp
      - _strncpy
      - _strrchr
      - _strstr
      - _strtok
      - _strtoul
      - _tan
      - _time
      - _usleep
      - _vfscanf
      - _vsnprintf
      - _vsscanf
      - _write
      - dyld_stub_binder
...
