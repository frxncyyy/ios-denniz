--- !tapi-tbd
tbd-version:      4
targets:          [ arm64-ios ]
install-name:     '/usr/lib/libSystem.B.dylib'
current-version:  1336
compatibility-version: 1
exports:
  - targets:      [ arm64-ios ]
    symbols:
      - ___stack_chk_fail
      - ___stack_chk_guard
      - _access
      - _atoi
      - _clock_gettime
      - _close
      - _dlopen
      - _fsync
      - _mkfifo
      - _open
      - _read
      - _snprintf
      - _strcmp
      - _strlen
      - _usleep
      - _write
      - dyld_stub_binder
...
