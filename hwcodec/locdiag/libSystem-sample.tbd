--- !tapi-tbd
tbd-version:      4
targets:          [ arm64-ios ]
install-name:     '/usr/lib/libSystem.B.dylib'
current-version:  1336
compatibility-version: 1
exports:
  - targets:      [ arm64-ios ]
    symbols:
      - ___stack_chk_fail
      - ___stack_chk_guard
      - _access
      - _atoi
      - _close
      - _fsync
      - _mach_port_deallocate
      - _mach_task_self_
      - _mach_vm_read_overwrite
      - _open
      - _proc_listallpids
      - _proc_name
      - _proc_pidinfo
      - _sleep
      - _snprintf
      - _strcmp
      - _strlen
      - _task_for_pid
      - _task_info
      - _task_resume
      - _task_suspend
      - _task_threads
      - _thread_get_state
      - _thread_info
      - _vm_deallocate
      - _write
      - dyld_stub_binder
...
