<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nord2.vcodecd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/vcodecd</string>
		<string>--vendor</string>
		<string>/usr/local/lib/n2vendor</string>
		<string>--gate</string>
		<string>/private/var/db/nord2-vcodec-run</string>
	</array>
	<!-- RunAtLoad is safe because the gate option exits 0 when the transaction has not created the run marker.
	     A guest stop exits 70 and launchd restarts the daemon; a normal exit 0 is not restarted. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/log/nord2-vcodecd.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/nord2-vcodecd.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>N2HW_VENDOR_DIR</key>
		<string>/usr/local/lib/n2vendor</string>
	</dict>
</dict>
</plist>
