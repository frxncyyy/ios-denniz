# Nord2 audio-ID (milestone 1) integration hunks.
# Base: source-snapshot 3d3725a28a238b140d49ce8c42815e5d25ba30a6.
#  - bsd/dev/sweet_touch.c and bsd/conf/files: the post-0082 buildtree files
#    (research/ci-39158169212/buildtree/xnu with 0082 applied).
#  - tools/nord2-mkpatch.sh: the tracked tool.
# Line numbers were computed from the 0082 hunk offsets, not from a live
# file; apply with `patch -p1 --dry-run` first (offsets/fuzz are expected if
# the parent's Wi-Fi/battery work has moved code). Only three call-site
# lines touch sweet_touch.c; no Wi-Fi or battery code is changed.
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -613,2 +613,3 @@
 #include "wifi_wfsys_adapter.h"
 #include "wifi_wfsys_bind.inc"
+#include "audio_id_bind.inc"
@@ -749,3 +750,4 @@
 	/* Called only after all other cores are OFF. Never take a thread lock. */
 	if (!nw_restore()) { return -1; }
+	if (!nab_prepare_return()) { return -1; } /* I2C8 pins/bus unverified */
 	if (!ni_saved) { return 0; }
@@ -810,3 +812,4 @@
 	ni_wifi_snapshot(); /* PMIF cleanup is now armed, before any GPIO change. */
 	ni_wifi_power_probe();
+	nab_audio_id(); /* nord2audioid=1 only; restores its I2C8 pins itself */
 	for (unsigned i = 0; i < sizeof(ni_pins) / sizeof(ni_pins[0]); i++) {
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -120,3 +120,4 @@
 bsd/dev/wifi_wfsys.c			standard
 bsd/dev/wifi_wfsys_adapter.c		standard
+bsd/dev/audio_id.c			standard
 bsd/dev/zoom_reset.c			standard
--- a/tools/nord2-mkpatch.sh
+++ b/tools/nord2-mkpatch.sh
@@ -28,3 +28,4 @@
 NEW_FILES="$NEW_FILES bsd/dev/wifi_wfsys.c bsd/dev/wifi_wfsys.h bsd/dev/wifi_wfsys_adapter.c bsd/dev/wifi_wfsys_adapter.h bsd/dev/wifi_wfsys_bind.inc"
-for name in wifi_firmware wifi_firmware_probe wifi_emi_snapshot wifi_emi_probe ufs_two_lane zoom_reset wifi_common wifi_cold_snapshot wifi_common_scope wifi_adie_id wifi_adie_strap wifi_emi_legacy wifi_persistent wifi_persistent_adapter wifi_wake wifi_wake_adapter wifi_wfsys wifi_wfsys_adapter; do
+NEW_FILES="$NEW_FILES bsd/dev/audio_id.c bsd/dev/audio_id.h bsd/dev/audio_id_bind.inc"
+for name in wifi_firmware wifi_firmware_probe wifi_emi_snapshot wifi_emi_probe ufs_two_lane zoom_reset wifi_common wifi_cold_snapshot wifi_common_scope wifi_adie_id wifi_adie_strap wifi_emi_legacy wifi_persistent wifi_persistent_adapter wifi_wake wifi_wake_adapter wifi_wfsys wifi_wfsys_adapter audio_id; do
     cp "shim/nord2-xnu/$name.h" "$BT/bsd/dev/$name.h"
@@ -44,2 +45,3 @@
 cp shim/nord2-xnu/wifi_wfsys_bind.inc "$BT/bsd/dev/wifi_wfsys_bind.inc"
+cp shim/nord2-xnu/audio_id_bind.inc "$BT/bsd/dev/audio_id_bind.inc"

