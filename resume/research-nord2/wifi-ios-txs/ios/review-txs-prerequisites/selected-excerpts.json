      "lines": [
        "4261: u_int8_t wlanProcessSecurityFrame(IN struct ADAPTER",
        "4262: \t\t\t\t  *prAdapter, IN void *prPacket)",
        "4263: {",
        "4264: \tstruct CMD_INFO *prCmdInfo;",
        "4265: \tstruct STA_RECORD *prStaRec;",
        "4266: \tuint8_t ucBssIndex;",
        "4267: \tuint32_t u4PacketLen;",
        "4268: \tuint8_t aucEthDestAddr[PARAM_MAC_ADDR_LEN];",
        "4269: \tstruct MSDU_INFO *prMsduInfo;",
        "4270: \tuint8_t ucStaRecIndex;",
        "4271: ",
        "4272: \tASSERT(prAdapter);",
        "4273: \tASSERT(prPacket);",
        "4274: ",
        "4275: \tprCmdInfo = cmdBufAllocateCmdInfo(prAdapter, 0);",
        "4276: ",
        "4277: \t/* Get MSDU_INFO for TxDone */",
        "4278: \tprMsduInfo = cnmPktAlloc(prAdapter, 0);",
        "4279: ",
        "4280: \tu4PacketLen = (uint32_t) GLUE_GET_PKT_FRAME_LEN(prPacket);",
        "4281: ",
        "4282: \tif (prCmdInfo && prMsduInfo) {",
        "4283: \t\tucBssIndex = GLUE_GET_PKT_BSS_IDX(prPacket);",
        "4284: ",
        "4285: \t\tkalGetEthDestAddr(prAdapter->prGlueInfo, prPacket,",
        "4286: \t\t\t\t  aucEthDestAddr);",
        "4287: ",
        "4288: \t\tprStaRec = cnmGetStaRecByAddress(prAdapter, ucBssIndex,",
        "4289: \t\t\t\t\t\t aucEthDestAddr);",
        "4290: ",
        "4291: \t\tprCmdInfo->eCmdType = COMMAND_TYPE_SECURITY_FRAME;",
        "4292: \t\tprCmdInfo->u2InfoBufLen = (uint16_t) u4PacketLen;",
        "4293: \t\tprCmdInfo->prPacket = prPacket;",
        "4294: \t\tprCmdInfo->prMsduInfo = prMsduInfo;",
        "4295: \t\tprCmdInfo->pfCmdDoneHandler = wlanSecurityFrameTxDone;",
        "4296: \t\tprCmdInfo->pfCmdTimeoutHandler =",
        "4297: \t\t\t\twlanSecurityAndCmdDataFrameTxTimeout;",
        "4298: \t\tprCmdInfo->fgIsOid = FALSE;",
        "4299: \t\tprCmdInfo->fgSetQuery = TRUE;",
        "4300: \t\tprCmdInfo->fgNeedResp = FALSE;",
        "4301: ",
        "4302: \t\tif (prStaRec)",
        "4303: \t\t\tucStaRecIndex = prStaRec->ucIndex;",
        "4304: \t\telse",
        "4305: \t\t\tucStaRecIndex = STA_REC_INDEX_NOT_FOUND;",
        "4306: ",
        "4307: \t\t/* Fill-up MSDU_INFO */",
        "4308: \t\tnicTxSetDataPacket(prAdapter, prMsduInfo, ucBssIndex,",
        "4309: \t\t\t\t   ucStaRecIndex, 0, u4PacketLen,",
        "4310: \t\t\t\t   nicTxDummyTxDone, MSDU_RATE_MODE_AUTO,",
        "4311: \t\t\t\t   TX_PACKET_OS, 0, FALSE, TRUE);",
        "4312: ",
        "4313: \t\tprMsduInfo->prPacket = prPacket;",
        "4314: \t\t/* No Tx descriptor template for MMPDU */",
        "4315: \t\tprMsduInfo->fgIsTXDTemplateValid = FALSE;",
        "4316: ",
        "4317: \t\tif (GLUE_TEST_PKT_FLAG(prPacket, ENUM_PKT_PROTECTED_1X))",
        "4318: \t\t\tnicTxConfigPktOption(prMsduInfo,",
        "4319: \t\t\t\t\tMSDU_OPT_PROTECTED_FRAME, TRUE);",
        "4320: #if CFG_SUPPORT_MULTITHREAD",
        "4321: \t\tnicTxComposeSecurityFrameDesc(prAdapter, prCmdInfo,",
        "4322: \t\t\t\t\tprMsduInfo->aucTxDescBuffer, NULL);",
        "4323: #endif",
        "4324: ",
        "4325: \t\tkalEnqueueCommand(prAdapter->prGlueInfo,",
        "4326: \t\t\t\t  (struct QUE_ENTRY *) prCmdInfo);",
        "4327: ",
        "4328: \t\tGLUE_SET_EVENT(prAdapter->prGlueInfo);",
        "4329: ",
        "4330: \t\treturn TRUE;",
        "4331: \t}",
        "4332: \tDBGLOG(RSN, INFO,",
        "4333: \t       \"Failed to alloc CMD/MGMT INFO for 1X frame!!\\n\");",
        "4334: \tcmdBufFreeCmdInfo(prAdapter, prCmdInfo);"
      ]
    },
