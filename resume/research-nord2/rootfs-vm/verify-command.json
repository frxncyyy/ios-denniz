[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/usr/lib/modules/7.2.9-arch1-1/vmlinuz",
  "-initrd",
  "$NORD2_REPO/research/nord2/rootfs-vm/verify-initrd.gz",
  "-append",
  "console=ttyS0 rdinit=/init panic=-1 loglevel=4",
  "-drive",
  "file=$NORD2_REPO/research/nord2/rootfs-vm/ios16-root-20H392-nord2-v1.img,format=raw,if=virtio,readonly=on",
  "-virtfs",
  "local,path=$NORD2_REPO/research/nord2/rootfs-vm/archives,mount_tag=inputs,security_model=none,readonly=on"
]
