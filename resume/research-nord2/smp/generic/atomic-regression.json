{
  "implicit_apple": {
    "command": [
      "clang",
      "-target",
      "arm64-apple-macos14.0",
      "-march=armv8.2-a+crypto",
      "-O2",
      "-S",
      "research/nord2/smp/generic/atomic-regression.c",
      "-o",
      "research/nord2/smp/generic/implicit_apple.s"
    ],
    "atomic_instructions": [
      "ldapur\tw0, [x0, #72]",
      "stlur\tw1, [x0, #72]"
    ]
  },
  "explicit_generic": {
    "command": [
      "clang",
      "-target",
      "arm64-apple-macos14.0",
      "-mcpu=generic",
      "-march=armv8.2-a+crypto",
      "-O2",
      "-S",
      "research/nord2/smp/generic/atomic-regression.c",
      "-o",
      "research/nord2/smp/generic/explicit_generic.s"
    ],
    "atomic_instructions": [
      "ldar\tw0, [x8]",
      "stlr\tw1, [x8]"
    ]
  }
}
