+ for(unsigned j=0;j<NRD_QUEUES;j++){
+  const struct ncr_queue*q=&r->queue[queues[j]];r->current=queues[j];r->phase=NCR_DESC_READ;
+  if(!ncr_memory_range(r,q->ring.descriptors+16u*q->next,16,0)){s->error=1;goto out;}
