diff --git a/bsd/dev/rottenapple_wifi_a80211.c b/bsd/dev/rottenapple_wifi_a80211.c
index 848434b..e1ef704 100644
--- a/bsd/dev/rottenapple_wifi_a80211.c
+++ b/bsd/dev/rottenapple_wifi_a80211.c
@@ -126,6 +126,9 @@ _Static_assert(sizeof(struct ra_a80211_req) == 40, "apple80211 request is 40 byt
 #define AUTH_UPPER_WPA2_PSK     0x8
 #define AUTH_LOWER_OPEN         1       /* [I] */
 
+/* CARD_CAPABILITIES bits we set: WEP 0, TKIP 1, AES 2, AES-CCM 3, WPA1 13, WPA2 14 */
+static const uint8_t cap_bits[] = { 0, 1, 2, 3, 13, 14 };
+
 /* [I] values (public-header era enums, not yet confirmed from a binary) */
 #define STATE_INIT              0
 #define STATE_RUN               4
@@ -706,7 +709,17 @@ a80211_get(struct ra_a80211_req *r)
 		r->val = a80211_assoc_result;
 		return 0;
 	case A_CARD_CAPABILITIES:
-		/* capability bit meanings not mapped yet: an empty bitmap (the bind only needs success) */
+		/*
+		 * IO80211 keeps this bitmap from the bind (at its ref + 0x50) and
+		 * _performAssociation checks it before it sends ASSOCIATE: with an
+		 * empty bitmap every WPA2 join failed in userland with -3903. Bits
+		 * it tests: 14 for an RSN network, 13 for a WPA network, 0/1/3 for
+		 * the pairwise/group ciphers (WEP/TKIP/AES-CCM), and 46, 52, 75, 76,
+		 * 96 for optional paths (async join events, PMF, ...) left off.
+		 */
+		for (unsigned i = 0; i < sizeof(cap_bits); i++) {
+			buf[cap_bits[i] / 8] |= (uint8_t)(1u << (cap_bits[i] % 8));
+		}
 		return a80211_reply(r, buf, CAP_BYTES);
 	case A_STATE:
 		r->val = li.associated ? STATE_RUN : STATE_INIT;
