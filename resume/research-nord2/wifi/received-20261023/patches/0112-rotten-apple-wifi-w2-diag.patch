+/* ---- CONNSYS MCU state and firmware logs (diagnostics) ---- */
+
+/*
+ * EMI log rings (common/debug_utility/connsys_debug_utility{.c,_emi.h},
+ * platform/mt6789.c connsys_fw_log_parameter): header 0x40 bytes {MCU base,
+ * size, Wi-Fi base, size, BT base, size, GPS base, size; +0x20 state (1 =
+ * resume); +0x30 IRQ counter; +0x38 "EMIFWLOG"}; each ring: +0 read, +4
+ * write, +0x20 data; rings separated by 0x20 + 0x20 bytes.
+ */
+#define FWLOG_EMI_OFF           0x58000
+#define FWLOG_EMI_SIZE          (192 * 1024)
+#define FWLOG_HDR_SIZE          0x40
+#define FWLOG_RING_RSV          0x20
+#define FWLOG_STATE             0x20
+#define FWLOG_READY             0x38
+#define COREDUMP_EMI_OFF        0x88000
+#define COREDUMP_EMI_SIZE       0xc8000
+#define FWLOG_MAX_LINES         60
+
+static const struct {
+	const char *name;
+	uint32_t size;
+} fwlog_rings[] = {
+	{ "MCU", 16 * 1024 }, { "Wi-Fi", 64 * 1024 }, { "BT", 64 * 1024 }, { "GPS", 32 * 1024 },
+};
+
+static uint32_t
+fwlog_base(unsigned i)
+{
+	uint32_t base = FWLOG_HDR_SIZE;
+	for (unsigned k = 0; k < i; k++) {
+		base += fwlog_rings[k].size + 2 * FWLOG_RING_RSV;
+	}
+	return base;
+}
+
+void
+mtk_connsys_fwlog_init(uintptr_t emi, uint64_t emi_size)
+{
+	if (emi_size < FWLOG_EMI_OFF + FWLOG_EMI_SIZE) {
+		return;
+	}
+	uintptr_t log = emi + FWLOG_EMI_OFF;
+	bzero((void *)log, FWLOG_EMI_SIZE);
+	for (unsigned i = 0; i < ROTTENAPPLE_COUNT(fwlog_rings); i++) {
+		mem_wr32(log + 8 * i, fwlog_base(i));
+		mem_wr32(log + 8 * i + 4, fwlog_rings[i].size);
+	}
+	mem_wr32(log + FWLOG_STATE, 1);
+	memcpy((void *)(log + FWLOG_READY), "EMIFWLOG", 8);
+	__builtin_arm_dsb(0xf);
+}
+
+/* Printable runs of at least 6 characters, one per line, at most *lines lines. */
+static void
+fwlog_strings(const char *tag, uintptr_t p, uint32_t len, unsigned *lines)
+{
+	char line[128];
+	unsigned n = 0;
+
+	for (uint32_t i = 0; i <= len && *lines > 0; i++) {
+		uint8_t ch = i < len ? *(volatile uint8_t *)(p + i) : 0;
+		bool printable = ch >= 0x20 && ch < 0x7f;
+		if (printable) {
+			line[n++] = (char)ch;
+			if (n < sizeof(line) - 1) {
+				continue;
+			}
+		}
+		if (n >= 6) {
+			line[n] = '\0';
+			printf("ROTTEN APPLE: wifi fwlog: %s +0x%05x: %s\n", tag, i + (printable ? 1 : 0) - n, line);
+			(*lines)--;
+		}
+		n = 0;
+	}
+}
+
+void
+mtk_connsys_fwlog_dump(uintptr_t emi, uint64_t emi_size, const char *why, bool text)
+{
+	if (emi_size < COREDUMP_EMI_OFF + COREDUMP_EMI_SIZE) {
+		return;
+	}
+	uintptr_t log = emi + FWLOG_EMI_OFF;
+	char ready[9];
+	memcpy(ready, (const void *)(log + FWLOG_READY), 8);
+	ready[8] = '\0';
+	for (unsigned k = 0; k < 8; k++) {
+		if (ready[k] < 0x20 || ready[k] > 0x7e) {
+			ready[k] = '.';
+		}
+	}
+	printf("ROTTEN APPLE: wifi fwlog (%s): header \"%s\" state %u IRQ counter %u\n", why, ready,
+	    mem_rd32(log + FWLOG_STATE), mem_rd32(log + 0x30));
+	for (unsigned i = 0; i < ROTTENAPPLE_COUNT(fwlog_rings); i++) {
+		uint32_t base = fwlog_base(i), size = fwlog_rings[i].size;
+		uint32_t r = mem_rd32(log + base), w = mem_rd32(log + base + 4);
+		printf("ROTTEN APPLE: wifi fwlog (%s): %s ring at EMI +0x%x: read 0x%x write 0x%x (size 0x%x)\n", why,
+		    fwlog_rings[i].name, FWLOG_EMI_OFF + base, r, w, size);
+		if (text && w != 0) {
+			unsigned lines = FWLOG_MAX_LINES;
+			fwlog_strings(fwlog_rings[i].name, log + base + FWLOG_RING_RSV, size, &lines);
+			const uint8_t *b = (const uint8_t *)(log + base + FWLOG_RING_RSV);
+			printf("ROTTEN APPLE: wifi fwlog: %s first bytes %02x %02x %02x %02x %02x %02x %02x %02x "
+			    "%02x %02x %02x %02x %02x %02x %02x %02x\n", fwlog_rings[i].name, b[0], b[1], b[2], b[3], b[4],
+			    b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+		}
+	}
+	/* The coredump area is zeroed at power-on; anything there was written by the firmware. */
+	uintptr_t cd = emi + COREDUMP_EMI_OFF;
+	uint32_t used = 0;
+	for (uint32_t off = 0; off < COREDUMP_EMI_SIZE; off += 0x1000) {
+		for (uint32_t k = 0; k < 0x1000; k += 64) {
+			if (mem_rd32(cd + off + k) != 0) {
+				used++;
+				break;
+			}
+		}
+	}
+	printf("ROTTEN APPLE: wifi fwlog (%s): coredump area EMI +0x%x: %u of %u 4 KB pages written\n", why,
+	    COREDUMP_EMI_OFF, used, COREDUMP_EMI_SIZE / 0x1000);
+	if (text && used) {
+		unsigned lines = FWLOG_MAX_LINES;
+		fwlog_strings("coredump", cd, 0x20000, &lines);
+	}
+}
+
+/* CONNSYS MCU: program counter samples, its PC log, debug and mailbox registers. */
+static void
+mcu_dump(struct mtk_wfdma *d, const char *why)
+{
+	uint32_t pc[8];
+
+	for (unsigned i = 0; i < ROTTENAPPLE_COUNT(pc); i++) {
+		pc[i] = rd(d, HIF_ON_DBGCR01);
+		delay(500);
+	}
+	DLOG("MCU (%s): PC samples 0x%05x 0x%05x 0x%05x 0x%05x 0x%05x 0x%05x 0x%05x 0x%05x (ROM idle on Android: "
+	    "0x21f66)", why, pc[0], pc[1], pc[2], pc[3], pc[4], pc[5], pc[6], pc[7]);
+	for (uint32_t off = MCU_PC_LOG; off < MCU_PC_LOG_END; off += 0x20) {
+		DLOG("MCU PC log 0x%08x: %08x %08x %08x %08x %08x %08x %08x %08x", 0x18000000u + off, rd(d, off),
+		    rd(d, off + 4), rd(d, off + 8), rd(d, off + 12), rd(d, off + 16), rd(d, off + 20), rd(d, off + 24),
+		    rd(d, off + 28));
+	}
+	uint32_t misc = rd(d, CFG_ON_MISC);
+	DLOG("MCU (%s): COM_REG0 0x%08x SW_DBG 0x%08x FW ver 0x%08x; host mailbox 0x%08x 0x%08x 0x%08x 0x%08x; "
+	    "CONN_CFG_ON IRQ 0x%08x/0x%08x; CONN_ON_MISC 0x%08x (FW_OWN %u, INIT_DONE %u, N9_DONE %u)", why,
+	    rd(d, MCU_COM_REG0), rd(d, MCU_SW_DBG), rd(d, MCU_FW_VER), rd(d, HIF_ON_MAILBOX(0)), rd(d, HIF_ON_MAILBOX(1)),
+	    rd(d, HIF_ON_MAILBOX(2)), rd(d, HIF_ON_MAILBOX(3)), rd(d, CFG_ON_IRQ_STA), rd(d, CFG_ON_IRQ_ENA), misc,
+	    misc & 1, (misc >> 1) & 1, (misc >> 2) & 1);
+}
