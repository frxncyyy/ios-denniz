+/*
+ * After WIFI_START (or the ready bits) failed: MCU state, firmware logs and
+ * coredump strings, then watch the ready bits for another 2 s in case only
+ * the acknowledgement was lost.
+ */
+static void
+start_failed(struct mtk_wfdma *d, const char *what)
+{
+	uint32_t v = 0;
+
+	mcu_dump(d, what);
+	mtk_connsys_fwlog_dump(d->emi, d->emi_size, what, true);
+	uint64_t t0 = now_us();
+	while (!ready(d, &v) && now_us() - t0 < 2000000) {
+		delay(5000);
+	}
+	DLOG("after %s failed: CONN_ON_MISC 0x%08x %s (watched %llu ms more); COM_REG0 0x%08x PC 0x%05x", what, v,
+	    ready(d, &v) ? "READY: the firmware came up anyway" : "still not ready", (now_us() - t0) / 1000,
+	    rd(d, MCU_COM_REG0), rd(d, HIF_ON_DBGCR01));
+}
