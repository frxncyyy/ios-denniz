+
+/* ---- Scan (W4): BSS list from beacons and probe responses ---- */
+
+#define SLOG(fmt, ...)  printf("ROTTEN APPLE: wifi scan: " fmt "\n", ##__VA_ARGS__)
+
+#define WIFI_BSS_MAX            64
+#define WIFI_RESULTS_LINE       176
+
+/* 802.11 */
+#define IEEE80211_HDR_LEN       24
+#define IEEE80211_FIXED_LEN     12      /* timestamp, beacon interval, capability */
+#define FC0_TYPE(fc)            (((fc) >> 2) & 3)
+#define FC0_SUBTYPE(fc)         ((fc) >> 4)
+#define SUBTYPE_PROBE_RESP      5
+#define SUBTYPE_BEACON          8
+#define CAP_PRIVACY             0x0010
+#define IE_SSID                 0
+#define IE_DS_PARAMS            3
+#define IE_RSN                  48
+#define IE_HT_OPERATION         61
+#define IE_VENDOR               221
+
+/* Security summary (sec) */
+#define SEC_PRIVACY             (1u << 0)
+#define SEC_WPA                 (1u << 1)
+#define SEC_RSN                 (1u << 2)
+#define SEC_PMF_CAPABLE         (1u << 3)
+#define SEC_PMF_REQUIRED        (1u << 4)
+#define SEC_BAD_IE              (1u << 5)
+
+/* AKM suites (00-0F-AC-n for RSN, 00-50-F2-n for WPA) */
+#define AKM_EAP                 (1u << 0)
+#define AKM_PSK                 (1u << 1)
+#define AKM_FT_EAP              (1u << 2)
+#define AKM_FT_PSK              (1u << 3)
+#define AKM_EAP_SHA256          (1u << 4)
+#define AKM_PSK_SHA256          (1u << 5)
+#define AKM_SAE                 (1u << 6)
+#define AKM_FT_SAE              (1u << 7)
+#define AKM_SUITE_B             (1u << 8)
+#define AKM_OWE                 (1u << 9)
+#define AKM_SAE_EXT             (1u << 10)
+#define AKM_OTHER               (1u << 15)
+
+/* Pairwise ciphers */
+#define CIPH_WEP                (1u << 0)
+#define CIPH_TKIP               (1u << 1)
+#define CIPH_CCMP               (1u << 2)
+#define CIPH_GCMP               (1u << 3)
+#define CIPH_CCMP256            (1u << 4)
+#define CIPH_GCMP256            (1u << 5)
+#define CIPH_OTHER              (1u << 7)
+
+struct wifi_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32];
+	uint8_t ssid_len;
+	uint8_t channel;                /* DS parameter set / HT operation, else the receive channel */
+	int8_t rssi;                    /* dBm, ROTTENAPPLE_WIFI_RSSI_NONE = unknown */
+	uint8_t sec;                    /* SEC_* */
+	uint16_t akm_rsn, akm_wpa;      /* AKM_* */
+	uint8_t ciph_rsn, ciph_wpa;     /* pairwise CIPH_* */
+	uint16_t capability, beacon_int;
+	uint16_t beacons, presps;       /* frames merged into this entry */
+};
+
+static LCK_MTX_DECLARE(wifi_scan_lock, &rottenapple_wifi_grp);
+static struct {
+	struct wifi_bss bss[WIFI_BSS_MAX];
+	unsigned n;
+	volatile bool collecting;       /* a scan runs: beacons/probe responses go into the list */
+	bool valid;                     /* bss[] holds a finished scan */
+	unsigned number, mode;
+	int result;
+	uint32_t ms;
+	uint32_t frames, beacons, presps, full, malformed, outside;
+	uint32_t presp_to_us, presp_bcast, presp_other;
+	uint8_t presp_other_da[6];
+} wifi_scan;                            /* under wifi_scan_lock */
+
+static const char *const wifi_scan_mode_name[] = { "", "active", "passive", "active, firmware channel list" };
+
+static void
+sec_parse(const uint8_t *p, unsigned l, bool rsn, uint16_t *akm, uint8_t *ciph, uint8_t *sec)
+{
+	static const uint8_t oui_rsn[3] = { 0x00, 0x0f, 0xac }, oui_wpa[3] = { 0x00, 0x50, 0xf2 };
+	const uint8_t *oui = rsn ? oui_rsn : oui_wpa;
+	unsigned o = 2, n;              /* after the version */
+
+	/* IEEE 802.11-2020 9.4.2.24: missing fields take their defaults (CCMP/TKIP, 802.1X) */
+	if (l < o + 4 + 2) {
+		*ciph |= rsn ? CIPH_CCMP : CIPH_TKIP;
+		*akm |= AKM_EAP;
+		return;
+	}
+	o += 4;                         /* group cipher */
+	n = (unsigned)(p[o] | (p[o + 1] << 8));
+	o += 2;
+	for (unsigned i = 0; i < n; i++, o += 4) {
+		if (o + 4 > l) {
+			*sec |= SEC_BAD_IE;
+			return;
+		}
+		uint8_t t = p[o + 3];
+		if (memcmp(p + o, oui, 3) != 0) {
+			*ciph |= CIPH_OTHER;
+		} else if (t == 1 || t == 5) {
+			*ciph |= CIPH_WEP;
+		} else if (t == 2) {
+			*ciph |= CIPH_TKIP;
+		} else if (t == 4) {
+			*ciph |= CIPH_CCMP;
+		} else if (t == 8) {
+			*ciph |= CIPH_GCMP;
+		} else if (t == 9) {
+			*ciph |= CIPH_GCMP256;
+		} else if (t == 10) {
+			*ciph |= CIPH_CCMP256;
+		} else {
+			*ciph |= CIPH_OTHER;
+		}
+	}
+	if (o + 2 > l) {
+		*akm |= AKM_EAP;
+		return;
+	}
+	n = (unsigned)(p[o] | (p[o + 1] << 8));
+	o += 2;
+	for (unsigned i = 0; i < n; i++, o += 4) {
+		if (o + 4 > l) {
+			*sec |= SEC_BAD_IE;
+			return;
+		}
+		uint8_t t = p[o + 3];
+		uint16_t a = AKM_OTHER;
+		if (memcmp(p + o, oui, 3) == 0) {
+			if (!rsn) {
+				a = t == 1 ? AKM_EAP : t == 2 ? AKM_PSK : AKM_OTHER;
+			} else {
+				switch (t) {
+				case 1: a = AKM_EAP; break;
+				case 2: a = AKM_PSK; break;
+				case 3: a = AKM_FT_EAP; break;
+				case 4: a = AKM_FT_PSK; break;
+				case 5: a = AKM_EAP_SHA256; break;
+				case 6: a = AKM_PSK_SHA256; break;
+				case 8: a = AKM_SAE; break;
+				case 9: a = AKM_FT_SAE; break;
+				case 11: case 12: case 13: a = AKM_SUITE_B; break;
+				case 18: a = AKM_OWE; break;
+				case 24: case 25: a = AKM_SAE_EXT; break;
+				default: break;
+				}
+			}
+		}
+		*akm |= a;
+	}
+	if (rsn && o + 2 <= l) {
+		uint16_t caps = (uint16_t)(p[o] | (p[o + 1] << 8));
+		if (caps & (1u << 7)) {
+			*sec |= SEC_PMF_CAPABLE;
+		}
+		if (caps & (1u << 6)) {
+			*sec |= SEC_PMF_REQUIRED;
+		}
+	}
+}
+
+static size_t
+sec_akm_names(char *out, size_t sz, size_t n, uint16_t akm, bool rsn)
+{
+	static const struct {
+		uint16_t mask;
+		const char *rsn, *wpa;
+	} names[] = {
+		{ AKM_PSK | AKM_FT_PSK | AKM_PSK_SHA256, "WPA2-PSK", "WPA-PSK" },
+		{ AKM_SAE | AKM_FT_SAE | AKM_SAE_EXT, "WPA3-SAE", NULL },
+		{ AKM_EAP | AKM_FT_EAP | AKM_EAP_SHA256, "WPA2-EAP", "WPA-EAP" },
+		{ AKM_SUITE_B, "WPA3-EAP-192", NULL },
+		{ AKM_OWE, "OWE", NULL },
+		{ AKM_OTHER, "RSN-other", "WPA-other" },
+	};
+	for (unsigned i = 0; i < ROTTENAPPLE_COUNT(names) && n < sz; i++) {
+		const char *name = rsn ? names[i].rsn : names[i].wpa;
+		if ((akm & names[i].mask) && name) {
+			n += (size_t)snprintf(out + n, sz - n, "%s%s", n ? "/" : "", name);
+		}
+	}
+	return MIN(n, sz - 1);
+}
+
+/* "open", "WEP", "WPA2-PSK CCMP", "WPA2-PSK/WPA3-SAE CCMP, PMF capable", ... */
+static void
+sec_format(const struct wifi_bss *b, char *out, size_t sz)
+{
+	static const struct {
+		uint8_t bit;
+		const char *name;
+	} ciphers[] = {
+		{ CIPH_WEP, "WEP" }, { CIPH_TKIP, "TKIP" }, { CIPH_CCMP, "CCMP" }, { CIPH_GCMP, "GCMP" },
+		{ CIPH_CCMP256, "CCMP-256" }, { CIPH_GCMP256, "GCMP-256" }, { CIPH_OTHER, "other" },
+	};
+	size_t n = 0;
+	bool first = true;
+
+	out[0] = '\0';
+	if (!(b->sec & (SEC_WPA | SEC_RSN))) {
+		snprintf(out, sz, "%s", (b->capability & CAP_PRIVACY) ? "WEP" : "open");
+		return;
+	}
+	if (b->sec & SEC_WPA) {
+		n = sec_akm_names(out, sz, n, b->akm_wpa, false);
+	}
+	if (b->sec & SEC_RSN) {
+		n = sec_akm_names(out, sz, n, b->akm_rsn, true);
+	}
+	uint8_t c = b->ciph_wpa | b->ciph_rsn;
+	for (unsigned i = 0; i < ROTTENAPPLE_COUNT(ciphers) && n < sz - 1; i++) {
+		if (c & ciphers[i].bit) {
+			n += (size_t)snprintf(out + n, sz - n, "%s%s", first ? " " : "+", ciphers[i].name);
+			first = false;
+		}
+	}
+	if (n < sz - 1 && (b->sec & (SEC_PMF_REQUIRED | SEC_PMF_CAPABLE))) {
+		n += (size_t)snprintf(out + n, sz - n, ", PMF %s", (b->sec & SEC_PMF_REQUIRED) ? "required" : "capable");
+	}
+	if (n < sz - 1 && (b->sec & SEC_BAD_IE)) {
+		(void)snprintf(out + n, sz - n, " (truncated IE)");
+	}
+}
+
+/* SSID for logs: quoted, non-printable bytes as \xNN; "<hidden>" when empty or all zero */
+static void
+ssid_format(const struct wifi_bss *b, char *out, size_t sz)
+{
+	size_t n = 0;
+	bool zero = true;
+
+	for (unsigned i = 0; i < b->ssid_len; i++) {
+		zero = zero && b->ssid[i] == 0;
+	}
+	if (b->ssid_len == 0 || zero) {
+		snprintf(out, sz, "<hidden>");
+		return;
+	}
+	out[n++] = '"';
+	for (unsigned i = 0; i < b->ssid_len && n + 6 < sz; i++) {
+		uint8_t ch = b->ssid[i];
+		if (ch >= 0x20 && ch < 0x7f && ch != '"' && ch != '\\') {
+			out[n++] = (char)ch;
+		} else {
+			n += (size_t)snprintf(out + n, sz - n, "\\x%02x", ch);
+		}
+	}
+	out[n++] = '"';
+	out[n] = '\0';
+}
+
+void
+rottenapple_wifi_rx_mgmt(struct rottenapple_wifi *w, const uint8_t *frame, uint32_t len, int rssi, uint8_t rx_channel)
+{
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct wifi_bss b;
+	uint8_t ds = 0, ht = 0;
+	unsigned i;
+
+	if (w == NULL || frame == NULL || len < 2 || FC0_TYPE(frame[0]) != 0 ||
+	    (FC0_SUBTYPE(frame[0]) != SUBTYPE_BEACON && FC0_SUBTYPE(frame[0]) != SUBTYPE_PROBE_RESP)) {
+		return;
+	}
+	bool presp = FC0_SUBTYPE(frame[0]) == SUBTYPE_PROBE_RESP;
+	bool ok = wifi_scan.collecting && len >= IEEE80211_HDR_LEN + IEEE80211_FIXED_LEN;
+	if (!ok) {
+		lck_mtx_lock(&wifi_scan_lock);
+		if (!wifi_scan.collecting) {
+			wifi_scan.outside++;
+		} else {
+			wifi_scan.malformed++;
+		}
+		lck_mtx_unlock(&wifi_scan_lock);
+		return;
+	}
+	bzero(&b, sizeof(b));
+	memcpy(b.bssid, frame + 16, 6);
+	const uint8_t *body = frame + IEEE80211_HDR_LEN;
+	b.beacon_int = (uint16_t)(body[8] | (body[9] << 8));
+	b.capability = (uint16_t)(body[10] | (body[11] << 8));
+	b.rssi = (int8_t)(rssi < -127 ? ROTTENAPPLE_WIFI_RSSI_NONE : rssi > 0 ? 0 : rssi);
+	const uint8_t *ie = body + IEEE80211_FIXED_LEN, *end = frame + len;
+	while (ie + 2 <= end) {
+		uint8_t id = ie[0], l = ie[1];
+		if (ie + 2 + l > end) {
+			b.sec |= SEC_BAD_IE;
+			break;
+		}
+		const uint8_t *p = ie + 2;
+		if (id == IE_SSID && l <= sizeof(b.ssid)) {
+			memcpy(b.ssid, p, l);
+			b.ssid_len = l;
+		} else if (id == IE_DS_PARAMS && l >= 1) {
+			ds = p[0];
+		} else if (id == IE_HT_OPERATION && l >= 1) {
+			ht = p[0];
+		} else if (id == IE_RSN && l >= 2) {
+			b.sec |= SEC_RSN;
+			sec_parse(p, l, true, &b.akm_rsn, &b.ciph_rsn, &b.sec);
+		} else if (id == IE_VENDOR && l >= 6 && p[0] == 0x00 && p[1] == 0x50 && p[2] == 0xf2 && p[3] == 1) {
+			b.sec |= SEC_WPA;
+			sec_parse(p + 4, l - 4u, false, &b.akm_wpa, &b.ciph_wpa, &b.sec);
+		}
+		ie += 2 + l;
+	}
+	if (b.capability & CAP_PRIVACY) {
+		b.sec |= SEC_PRIVACY;
+	}
+	b.channel = ds ? ds : ht ? ht : rx_channel;
+
+	lck_mtx_lock(&wifi_scan_lock);
+	if (!wifi_scan.collecting) {
+		wifi_scan.outside++;
+		lck_mtx_unlock(&wifi_scan_lock);
+		return;
+	}
+	wifi_scan.frames++;
+	if (presp) {
+		/* a probe response goes to the transmitter of the probe request: our own address */
+		wifi_scan.presps++;
+		if (memcmp(frame + 4, w->mac, 6) == 0) {
+			wifi_scan.presp_to_us++;
+		} else if (memcmp(frame + 4, bcast, 6) == 0) {
+			wifi_scan.presp_bcast++;
+		} else if (wifi_scan.presp_other++ == 0) {
+			memcpy(wifi_scan.presp_other_da, frame + 4, 6);
+		}
+	} else {
+		wifi_scan.beacons++;
+	}
+	for (i = 0; i < wifi_scan.n && memcmp(wifi_scan.bss[i].bssid, b.bssid, 6) != 0; i++) {
+	}
+	if (i == wifi_scan.n) {
+		if (wifi_scan.n == WIFI_BSS_MAX) {
+			wifi_scan.full++;
+			lck_mtx_unlock(&wifi_scan_lock);
+			return;
+		}
+		wifi_scan.n++;
+		wifi_scan.bss[i] = b;
+	} else {
+		struct wifi_bss *o = &wifi_scan.bss[i];
+		bool hidden = o->ssid_len == 0 || o->ssid[0] == 0;
+		b.beacons = o->beacons;
+		b.presps = o->presps;
+		if (o->rssi == ROTTENAPPLE_WIFI_RSSI_NONE || (b.rssi != ROTTENAPPLE_WIFI_RSSI_NONE && b.rssi > o->rssi)) {
+			/* stronger: this frame's view replaces the entry (a known SSID wins over a hidden one) */
+			if ((b.ssid_len == 0 || b.ssid[0] == 0) && !hidden) {
+				memcpy(b.ssid, o->ssid, sizeof(b.ssid));
+				b.ssid_len = o->ssid_len;
+			}
+			*o = b;
+		} else if (hidden && b.ssid_len && b.ssid[0]) {
+			/* a probe response names a hidden network */
+			memcpy(o->ssid, b.ssid, sizeof(o->ssid));
+			o->ssid_len = b.ssid_len;
+		}
+	}
+	if (presp) {
+		wifi_scan.bss[i].presps++;
+	} else {
+		wifi_scan.bss[i].beacons++;
+	}
+	lck_mtx_unlock(&wifi_scan_lock);
+}
+
+/* One result line (no newline); in the sysctl form the SSID comes last, so it may contain anything */
+static size_t
+bss_format(const struct wifi_bss *b, char *out, size_t sz, bool for_log)
+{
+	char ssid[32 * 4 + 3], sec[80], rssi[8];
+	int n;
+
+	ssid_format(b, ssid, sizeof(ssid));
+	sec_format(b, sec, sizeof(sec));
+	if (b->rssi == ROTTENAPPLE_WIFI_RSSI_NONE) {
+		snprintf(rssi, sizeof(rssi), "?");
+	} else {
+		snprintf(rssi, sizeof(rssi), "%d", b->rssi);
+	}
+	if (for_log) {
+		n = snprintf(out, sz, "%s  %02x:%02x:%02x:%02x:%02x:%02x  ch %u (%s GHz)  %s dBm  %s  [%u beacon(s), %u probe "
+		    "response(s), interval %u TU]", ssid, b->bssid[0], b->bssid[1], b->bssid[2], b->bssid[3], b->bssid[4],
+		    b->bssid[5], b->channel, b->channel <= 14 ? "2.4" : "5", rssi, sec, b->beacons, b->presps, b->beacon_int);
+	} else {
+		n = snprintf(out, sz, "%02x:%02x:%02x:%02x:%02x:%02x %3u %4s %s | %s", b->bssid[0], b->bssid[1], b->bssid[2],
+		    b->bssid[3], b->bssid[4], b->bssid[5], b->channel, rssi, sec, ssid);
+	}
+	return n < 0 ? 0 : MIN((size_t)n, sz - 1);
+}
+
+/* Indices of the list sorted by RSSI, strongest first (unknown last); caller holds wifi_scan_lock */
+static void
+bss_sorted(uint8_t *idx)
+{
+	for (unsigned i = 0; i < wifi_scan.n; i++) {
+		idx[i] = (uint8_t)i;
+	}
+	for (unsigned i = 1; i < wifi_scan.n; i++) {
+		uint8_t v = idx[i];
+		unsigned j = i;
+		while (j > 0 && wifi_scan.bss[idx[j - 1]].rssi < wifi_scan.bss[v].rssi) {
+			idx[j] = idx[j - 1];
+			j--;
+		}
+		idx[j] = v;
+	}
+}
+
+static void
+wifi_scan_log(struct rottenapple_wifi *w)
+{
+	uint8_t idx[WIFI_BSS_MAX];
+	char line[WIFI_RESULTS_LINE + 64];
+	const uint8_t *m = w->mac;
+
+	lck_mtx_lock(&wifi_scan_lock);
+	SLOG("%u networks (scan %u, %s, %u ms, result %d): %u beacon(s) and %u probe response(s) received%s", wifi_scan.n,
+	    wifi_scan.number, wifi_scan_mode_name[wifi_scan.mode], wifi_scan.ms, wifi_scan.result, wifi_scan.beacons,
+	    wifi_scan.presps, wifi_scan.full ? " (list full: further networks dropped)" : "");
+	bss_sorted(idx);
+	for (unsigned i = 0; i < wifi_scan.n; i++) {
+		bss_format(&wifi_scan.bss[idx[i]], line, sizeof(line), true);
+		SLOG("%2u. %s", i + 1, line);
+	}
+	if (wifi_scan.malformed || wifi_scan.full) {
+		SLOG("%u malformed frame(s), %u frame(s) of networks beyond the first %u", wifi_scan.malformed, wifi_scan.full,
+		    WIFI_BSS_MAX);
+	}
+	/* The MAC proof: a probe response goes to the transmitter address of the probe request */
+	if (wifi_scan.mode == ROTTENAPPLE_WIFI_SCAN_PASSIVE) {
+		SLOG("MAC proof: passive scan, no probe requests sent");
+	} else if (wifi_scan.presp_to_us) {
+		SLOG("MAC proof: PASSED, %u probe response(s) addressed to %02x:%02x:%02x:%02x:%02x:%02x: our probe requests "
+		    "carry the NVRAM MAC address, and the receive filter accepts it", wifi_scan.presp_to_us, m[0], m[1], m[2],
+		    m[3], m[4], m[5]);
+	} else if (wifi_scan.presp_other) {
+		const uint8_t *o = wifi_scan.presp_other_da;
+		SLOG("MAC proof: FAILED, %u probe response(s) addressed to %02x:%02x:%02x:%02x:%02x:%02x, not to our "
+		    "%02x:%02x:%02x:%02x:%02x:%02x", wifi_scan.presp_other, o[0], o[1], o[2], o[3], o[4], o[5], m[0], m[1], m[2],
+		    m[3], m[4], m[5]);
+	} else {
+		SLOG("MAC proof: not possible, no directed probe response received (%u broadcast); association (W5) proves it",
+		    wifi_scan.presp_bcast);
+	}
+	lck_mtx_unlock(&wifi_scan_lock);
+}
+
+int
+rottenapple_wifi_scan(unsigned mode)
+{
+	struct rottenapple_wifi *w = &rottenapple_wifi_dev;
+	int err;
+
+	if (mode == 0 || mode > ROTTENAPPLE_WIFI_SCAN_MODES) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&wifi_state_lock);
+	if (wifi_state != WIFI_RUNNING || wifi_scanning || wifi_stop_pending) {
+		unsigned st = wifi_state;
+		bool busy = wifi_scanning || wifi_stop_pending;
+		lck_mtx_unlock(&wifi_state_lock);
+		SLOG("scan refused: Wi-Fi is %s%s", wifi_state_name[st], busy ? " (a scan or a stop is in progress)" : "");
+		return st == WIFI_OFF ? ENXIO : EBUSY;
+	}
+	wifi_scanning = true;
+	lck_mtx_unlock(&wifi_state_lock);
+
+	if (w->ops->scan == NULL) {
+		SLOG("backend \"%s\" cannot scan", w->ops->compatible);
+		err = ENOTSUP;
+	} else {
+		uint64_t t0, ns;
+		lck_mtx_lock(&wifi_scan_lock);
+		unsigned number = wifi_scan.number + 1;
+		bzero(&wifi_scan, sizeof(wifi_scan));
+		wifi_scan.number = number;
+		wifi_scan.mode = mode;
+		wifi_scan.collecting = true;
+		lck_mtx_unlock(&wifi_scan_lock);
+		SLOG("scan %u: starting (%s)", number, wifi_scan_mode_name[mode]);
+		t0 = mach_absolute_time();
+		err = w->ops->scan(w, mode);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		lck_mtx_lock(&wifi_scan_lock);
+		wifi_scan.collecting = false;
+		wifi_scan.valid = true;
+		wifi_scan.result = err;
+		wifi_scan.ms = (uint32_t)(ns / NSEC_PER_MSEC);
+		lck_mtx_unlock(&wifi_scan_lock);
+		wifi_scan_log(w);
+	}
+
+	lck_mtx_lock(&wifi_state_lock);
+	wifi_scanning = false;
+	thread_wakeup((event_t)&wifi_scanning);
+	lck_mtx_unlock(&wifi_state_lock);
+	return err;
+}
+
+/*
+ * kern.rottenapple_wifi_scan: read = networks in the last list; write 1
+ * (active), 2 (passive) or 3 (active, firmware channel list) = scan now and
+ * return when it is done (a few seconds).
+ */
+static int
+sysctl_rottenapple_wifi_scan SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	int value = (int)wifi_scan.n, changed = 0;
+	int err = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+
+	if (err || !changed) {
+		return err;
+	}
+	if (value <= 0 || value > ROTTENAPPLE_WIFI_SCAN_MODES) {
+		return EINVAL;
+	}
+	return rottenapple_wifi_scan((unsigned)value);
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi_scan, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_rottenapple_wifi_scan, "I", "rotten-apple Wi-Fi scan: networks found; write 1 active, 2 passive, 3 active "
+    "with the firmware channel list");
+
+/* kern.rottenapple_wifi_scan_results: the last list, one network per line: BSSID channel RSSI security | SSID */
+static int
+sysctl_rottenapple_wifi_scan_results SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	size_t size = 160 + WIFI_BSS_MAX * (WIFI_RESULTS_LINE + 1), n;
+	uint8_t idx[WIFI_BSS_MAX];
+	char *buf;
+	int err;
+
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	buf = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&wifi_scan_lock);
+	if (!wifi_scan.valid && !wifi_scan.collecting) {
+		n = (size_t)snprintf(buf, size, "no scan yet (sysctl -w kern.rottenapple_wifi_scan=1)\n");
+	} else {
+		n = (size_t)snprintf(buf, size, "scan %u (%s)%s: %u networks, %u ms, result %d\n", wifi_scan.number,
+		    wifi_scan_mode_name[wifi_scan.mode], wifi_scan.collecting ? " RUNNING" : "", wifi_scan.n, wifi_scan.ms,
+		    wifi_scan.result);
+		bss_sorted(idx);
+		for (unsigned i = 0; i < wifi_scan.n && n + WIFI_RESULTS_LINE + 2 < size; i++) {
+			n += bss_format(&wifi_scan.bss[idx[i]], buf + n, WIFI_RESULTS_LINE, false);
+			buf[n++] = '\n';
+		}
+	}
+	lck_mtx_unlock(&wifi_scan_lock);
+	n = MIN(n, size - 1);
+	buf[n] = '\0';
+	err = SYSCTL_OUT(req, buf, n + 1);
+	kfree_data(buf, size);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi_scan_results, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_rottenapple_wifi_scan_results, "A", "rotten-apple Wi-Fi: the last scan's networks");
