+/* ---- W4: scan ---- */
+
+/* Sleep until *flag is set, the firmware died, the receive thread stopped, or ms passed. */
+static bool
+wl_wait_flag(struct mtk_wlan *l, volatile bool *flag, unsigned ms)
+{
+	uint64_t t0 = now_us();
+
+	while (!*flag && !l->fw_dead && l->running && now_us() - t0 < (uint64_t)ms * 1000) {
+		(void)assert_wait_timeout((event_t)(uintptr_t)flag, THREAD_UNINT, 20, NSEC_PER_MSEC);
+		if (*flag) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+	return *flag;
+}
+
+/* The domain's channels as CHANNEL_INFO {band, channel}; returns the count */
+static unsigned
+scan_channels(uint8_t band[SCAN_CHNL_MAX], uint8_t chan[SCAN_CHNL_MAX])
+{
+	unsigned n = 0;
+
+	for (unsigned s = 0; s < SUBBANDS; s++) {
+		const uint8_t *sb = domain_active[s];
+		unsigned step = sb[2] == CHNL_SPAN_20 ? 4 : 1;
+		for (unsigned i = 0; sb[1] != 0 && i < sb[4] && n < SCAN_CHNL_MAX; i++) {
+			band[n] = sb[1];
+			chan[n] = (uint8_t)(sb[3] + i * step);
+			n++;
+		}
+	}
+	return n;
+}
+
+static void
+scan_done_log(struct mtk_wlan *l)
+{
+	const uint8_t *e = l->scan_evt;
+	uint32_t len = MIN(l->scan_evt_len, (uint32_t)sizeof(l->scan_evt));
+	char line[200];
+	size_t n = 0;
+
+	if (len < 12) {
+		LLOG("SCAN_DONE: %u bytes (short)", l->scan_evt_len);
+		return;
+	}
+	LLOG("SCAN_DONE: seq %u, %u bytes, version %u, state %u%s, %u channels completed, firmware counted %u beacons/probe "
+	    "responses%s", e[SD_SEQ], l->scan_evt_len, e[SD_VERSION], e[SD_STATE],
+	    e[SD_STATE] == FW_SCAN_STATE_SCAN_DONE ? " (done)" : " (NOT done: firmware scan timeout)", e[SD_COMPLETE],
+	    le32(e + SD_BCN_CNT), len >= SD_V4_LEN ? "" : " (no per-channel data in this version)");
+	if (len < SD_V4_LEN) {
+		return;
+	}
+	LLOG("SCAN_DONE: 2.4 GHz %u, 5 GHz %u beacons/probe responses; per channel (channel:frames, non-zero only):",
+	    le32(e + SD_BCN_2G4), le32(e + SD_BCN_5G));
+	line[0] = '\0';
+	unsigned valid = MIN((unsigned)e[SD_VALID_NUM], 64u), shown = 0;
+	for (unsigned i = 0; i < valid; i++) {
+		if (e[SD_BANDP + i] == 0) {
+			continue;
+		}
+		n += (size_t)snprintf(line + n, sizeof(line) - n, " %u:%u", e[SD_CHANNELS + i], e[SD_BANDP + i]);
+		shown++;
+		if (n > sizeof(line) - 16) {
+			LLOG("  %s", line);
+			n = 0;
+			line[0] = '\0';
+		}
+	}
+	if (n || shown == 0) {
+		LLOG("  %s (%u channels reported)", shown ? line : "none", valid);
+	}
+}
+
+int
+mtk_wlan_scan(struct mtk_wlan *l, unsigned mode)
+{
+	uint8_t band[SCAN_CHNL_MAX], chan[SCAN_CHNL_MAX];
+	unsigned nch = 0;
+	bool active = mode != ROTTENAPPLE_WIFI_SCAN_PASSIVE;
+	int err;
+
+	if (!l->started || !l->running || l->fw_dead) {
+		LLOG("scan: Wi-Fi not running (started %d, receive thread %d, firmware dead %d)", l->started, l->running,
+		    l->fw_dead);
+		return ENXIO;
+	}
+	uint8_t *cmd = kalloc_data(SCAN_REQ_LEN, Z_WAITOK | Z_ZERO);
+	if (cmd == NULL) {
+		return ENOMEM;
+	}
+	if (++l->scan_seq_next == 0) {
+		l->scan_seq_next = 1;
+	}
+	uint8_t seq = l->scan_seq_next;
+	cmd[SR_SEQ] = seq;
+	cmd[SR_BSS] = AIS_BSS_INDEX;
+	cmd[SR_SCAN_TYPE] = active ? SCAN_TYPE_ACTIVE : SCAN_TYPE_PASSIVE;
+	cmd[SR_SSID_TYPE] = active ? SCAN_SSID_WILDCARD : 0;    /* aisFsm: wildcard for active, 0 for passive */
+	cmd[SR_FUNC] = SCN_FUNC_DBDC_SCAN_DIS;                  /* no random MAC: the probe requests carry ours */
+	cmd[SR_VERSION] = 1;
+	/* SSID list empty (wildcard), probe delay / dwell / min dwell / timeout 0 = firmware defaults, no IEs */
+	if (mode == ROTTENAPPLE_WIFI_SCAN_ACTIVE_FW) {
+		cmd[SR_CHANNEL_TYPE] = SCAN_CHANNEL_FULL;
+	} else {
+		nch = scan_channels(band, chan);
+		cmd[SR_CHANNEL_TYPE] = SCAN_CHANNEL_SPECIFIED;
+		for (unsigned i = 0; i < nch; i++) {
+			uint8_t *ci = i < SCAN_CMD_CHNL_NUM ? cmd + SR_CHANNELS + 2 * i :
+			    cmd + SR_CHANNELS_EXT + 2 * (i - SCAN_CMD_CHNL_NUM);
+			ci[0] = band[i];
+			ci[1] = chan[i];
+		}
+		cmd[SR_CHANNEL_NUM] = (uint8_t)MIN(nch, (unsigned)SCAN_CMD_CHNL_NUM);
+		cmd[SR_CHANNEL_EXT_NUM] = (uint8_t)(nch > SCAN_CMD_CHNL_NUM ? nch - SCAN_CMD_CHNL_NUM : 0);
+	}
+	LLOG("SCAN_REQ_V2: seq %u, BSS %u, %s scan, SSID type %u (wildcard), function mask 0x%02x (random MAC off), channel "
+	    "type %u (%s), %u + %u channels (%u..%u), firmware dwell times; gen4m scnSendScanReqV2", seq, AIS_BSS_INDEX,
+	    active ? "active" : "passive", cmd[SR_SSID_TYPE], cmd[SR_FUNC], cmd[SR_CHANNEL_TYPE],
+	    nch ? "specified: the default regulatory domain" : "full: the firmware's list from SET_DOMAIN_INFO",
+	    cmd[SR_CHANNEL_NUM], cmd[SR_CHANNEL_EXT_NUM], nch ? chan[0] : 0, nch ? chan[nch - 1] : 0);
+
+	l->scan_done = false;
+	l->scan_evt_len = 0;
+	l->scan_frames = 0;
+	l->scan_frame_logs = 0;
+	uint32_t types_before = l->rx_types[RX_PKT_TYPE_RX_DATA], sleepy_before = l->sleepy;
+	l->scan_seq = seq;
+	/* aisFsmSteps AIS_STATE_SCAN: nicActivateNetwork first (sends the own MAC to the firmware) */
+	err = wl_bss_activate(l, true);
+	if (err == 0) {
+		err = wl_set(l, CMD_ID_SCAN_REQ_V2, cmd, SCAN_REQ_LEN, "SCAN_REQ_V2");
+	}
+	uint64_t t0 = now_us();
+	if (err == 0 && !wl_wait_flag(l, &l->scan_done, SCAN_TIMEOUT_MS)) {
+		if (l->fw_dead || !l->running) {
+			LLOG("scan: firmware died or the receive thread stopped while scanning");
+			err = ENXIO;
+		} else {
+			/* CMD_SCAN_CANCEL {seq, is-ext-channel 0, 2 x 0} (scnFsmMsgAbort) */
+			uint8_t cancel[4] = { seq, 0, 0, 0 };
+			LLOG("scan: no SCAN_DONE within %u ms (%u frames so far): cancelling", SCAN_TIMEOUT_MS, l->scan_frames);
+			(void)wl_set(l, CMD_ID_SCAN_CANCEL, cancel, sizeof(cancel), "SCAN_CANCEL");
+			(void)wl_wait_flag(l, &l->scan_done, SCAN_CANCEL_WAIT_MS);
+			err = ETIMEDOUT;
+		}
+	}
+	uint64_t ms = (now_us() - t0) / 1000;
+	if (l->scan_done) {
+		/* frames the firmware queued before the event may still sit in RX ring 0 */
+		delay(SCAN_TAIL_MS * 1000);
+		scan_done_log(l);
+	}
+	l->scan_seq = 0;
+	if (l->bss_active && !l->fw_dead) {
+		(void)wl_bss_activate(l, false);
+	}
+	LLOG("scan %s after %llu ms: host received %u management frames (RX data packets %u, sleepy notifications %u), "
+	    "frames with FCS error %u, data/control %u; firmware %s", l->scan_done ? "done" : "NOT done", ms, l->scan_frames,
+	    l->rx_types[RX_PKT_TYPE_RX_DATA] - types_before, l->sleepy - sleepy_before, l->rx_fcs, l->rx_ctrl_data,
+	    l->fw_dead ? "DEAD" : "alive");
+	kfree_data(cmd, SCAN_REQ_LEN);
+	if (err == 0 && l->fw_dead) {
+		err = EIO;
+	}
+	return err;
+}
