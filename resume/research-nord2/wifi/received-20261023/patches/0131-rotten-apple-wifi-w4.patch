+/*
+ * What is in the coredump area while the firmware runs normally (W3 saw one
+ * page written right after the firmware start, before any command). The
+ * mt6789 platform header (K common_main/platform/include/mt6789.h) splits
+ * the area: +0x300/+0x310/+0x320/+0x330 BT RAM, Wi-Fi RAM, MCU RAM and MCU
+ * patch build times (Android's WMT writes them, we do not), +0x400 paged
+ * trace, +0x8400 paged dump, +0x10400 full dump. Only the dump parts mean an
+ * assert; page 0 holds the trace.
+ */
+#define COREDUMP_PAGED_TRACE    0x400
+#define COREDUMP_PAGED_DUMP     0x8400
+#define COREDUMP_FULL_DUMP      0x10400
+
+void
+mtk_connsys_coredump_info(uintptr_t emi, uint64_t emi_size)
+{
+	static const char *const bt_names[] = { "BT RAM", "Wi-Fi RAM", "MCU RAM", "MCU patch" };
+	char pages[96], bt[17];
+	size_t n = 0;
+	unsigned used = 0, lines = 12;
+
+	if (emi_size < COREDUMP_EMI_OFF + COREDUMP_EMI_SIZE) {
+		return;
+	}
+	uintptr_t cd = emi + COREDUMP_EMI_OFF;
+	pages[0] = '\0';
+	for (uint32_t off = 0; off < COREDUMP_EMI_SIZE; off += 0x1000) {
+		for (uint32_t k = 0; k < 0x1000; k += 4) {
+			if (mem_rd32(cd + off + k) != 0) {
+				if (n < sizeof(pages) - 8) {
+					n += (size_t)snprintf(pages + n, sizeof(pages) - n, " %u", off / 0x1000);
+				}
+				used++;
+				break;
+			}
+		}
+	}
+	printf("ROTTEN APPLE: wifi fwlog: coredump area: %u page(s) written:%s (paged dump from page %u, full dump from "
+	    "page %u: only those mean an assert)\n", used, used ? pages : " none", COREDUMP_PAGED_DUMP / 0x1000,
+	    COREDUMP_FULL_DUMP / 0x1000);
+	uint32_t first = 0, last = 0;
+	bool any = false;
+	for (uint32_t k = 0; k < 0x1000; k += 4) {
+		if (mem_rd32(cd + k) != 0) {
+			if (!any) {
+				first = k;
+			}
+			last = k;
+			any = true;
+		}
+	}
+	if (!any) {
+		return;
+	}
+	printf("ROTTEN APPLE: wifi fwlog: coredump page 0: non-zero words from +0x%03x to +0x%03x\n", first, last);
+	for (unsigned i = 0; i < ROTTENAPPLE_COUNT(bt_names); i++) {
+		const volatile uint8_t *p = (const volatile uint8_t *)(cd + 0x300 + 0x10 * i);
+		bool set = false;
+		for (unsigned k = 0; k < 16; k++) {
+			bt[k] = (p[k] >= 0x20 && p[k] < 0x7f) ? (char)p[k] : (p[k] ? '.' : ' ');
+			set = set || p[k] != 0;
+		}
+		bt[16] = '\0';
+		if (set) {
+			printf("ROTTEN APPLE: wifi fwlog: coredump +0x%03x %s build time: \"%s\"\n", 0x300 + 0x10 * i, bt_names[i], bt);
+		}
+	}
+	for (uint32_t off = first & ~0x1fu; off <= last && off < first + 0x80; off += 0x20) {
+		printf("ROTTEN APPLE: wifi fwlog: coredump +0x%03x: %08x %08x %08x %08x %08x %08x %08x %08x%s\n", off,
+		    mem_rd32(cd + off), mem_rd32(cd + off + 4), mem_rd32(cd + off + 8), mem_rd32(cd + off + 12),
+		    mem_rd32(cd + off + 16), mem_rd32(cd + off + 20), mem_rd32(cd + off + 24), mem_rd32(cd + off + 28),
+		    off >= COREDUMP_PAGED_TRACE ? " (paged trace)" : "");
+	}
+	fwlog_strings("coredump page 0", cd, 0x1000, &lines);
+}
