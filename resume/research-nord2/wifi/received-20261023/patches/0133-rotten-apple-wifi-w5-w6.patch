+/*
+ * Clean-room from gen4m's AIS/SAA/CNM paths (mgmt/ais_fsm.c, mgmt/saa_fsm.c,
+ * nic/nic.c nicUpdateBss, mgmt/cnm_mem.c cnmStaSendUpdateCmd, mgmt/cnm.c
+ * cnmChMngrRequestPrivilege, common/wlan_oid.c wlanoidSetAddKey) and the GX4
+ * join trace (0x14 REMOVE_STA, 0x09 INFRASTRUCTURE, 0x12 SET_BSS_INFO, 0x13
+ * UPDATE_STA_RECORD, 0x11 BSS_ACTIVATE, 0x1c CH_PRIVILEGE -> EVENT 0x10).
+ * The TXD and the command struct offsets are from docs/WIFI-PLAN.md "W5".
+ *
+ * Only WPA2-PSK CCMP (and open) are handled; the 4-way handshake itself runs
+ * in the core (rottenapple_wifi_sta.c). Management and EAPOL frames go out on
+ * the command ring (MCU port) with a 32-byte HW_MAC_TX_DESC, exactly as
+ * gen4m's COMMAND_TYPE_MANAGEMENT_FRAME / SECURITY_FRAME do.
+ */
+
+/* WTBL assignment: 0-3 reserved for BIP, pairwise STA at 4, group key at 5. */
+#define STA_WLAN_IDX            4
+#define GRP_WLAN_IDX            5
+#define STA_REC_IDX             0
+#define JOIN_CH_INTERVAL_MS     4000
+#define CH_GRANT_WAIT_MS        2000
+#define AUTH_WAIT_MS            1500
+#define ASSOC_WAIT_MS           1500
+#define JOIN_RETRIES            3
+
+/* TXD fields (HW_MAC_TX_DESC, 32-byte long format; docs/WIFI-PLAN.md "W5") */
+#define TXD_PORT_MCU            0x80    /* ucPortIdx_QueueIdx bit7 = MCU port */
+#define TXD_QUEUE_MCU_Q1        (1u << 2)       /* queue index MCU_Q1 in [2:6] */
+#define TXD_LONG_FORMAT         0x80    /* ucHeaderFormat bit7 */
+#define TXD_HF_802_11_NORMAL    (2u << 5)       /* ucHeaderFormat [5:6] = 2 */
+#define TXD_ETHERNET_II         (1u << 4)       /* ucHeaderFormat bit4 (non-802.11) */
+#define TXD_PKT_FORMAT_COMMAND  2       /* ucOwnMAC [0:1] */
+#define TXD_TXS_TO_MCU          0x02    /* ucTxStatus bit1 */
+#define TXD_PROTECTED           0x02    /* u2TxCountLimit bit1 */
+#define TXD_FIXED_RATE_EN       0x80    /* ucPowerOffset bit7 */
+#define NIC_TX_PSE_HDR          4
+
+/* 802.11 */
+#define FC_SUBTYPE_ASSOC_REQ    0
+#define FC_SUBTYPE_ASSOC_RESP   1
+#define FC_SUBTYPE_REASSOC_RESP 3
+#define FC_SUBTYPE_PROBE_RESP   5
+#define FC_SUBTYPE_AUTH         11
+#define FC_SUBTYPE_DEAUTH       12
+#define FC_SUBTYPE_DISASSOC     10
+
+/* Rate codes (wlan_def.h): lowest fixed rate for management frames. */
+static uint16_t
+lowest_rate_code(uint8_t band)
+{
+	return band == 2 ? 0x004b /* OFDM 6M */ : 0x0000 /* CCK 1M long */;
+}
+
+/* Build the 32-byte TXD for a management (is_mgmt) or 802.3 data frame. */
+static void
+build_txd(struct mtk_wlan *l, uint8_t txd[32], bool is_mgmt, uint8_t subtype, uint8_t wlan_idx,
+    uint32_t frame_len, uint8_t mac_hdr_len, bool protected, bool want_txs)
+{
+	bzero(txd, 32);
+	/* DW0 */
+	put16(txd + 0, (uint16_t)(32 + frame_len));             /* u2TxByteCount */
+	if (is_mgmt) {
+		txd[2] = (uint8_t)((NIC_TX_PSE_HDR + mac_hdr_len) >> 1); /* ether offset (words) */
+	} else {
+		txd[2] = (uint8_t)((14 - 2 + NIC_TX_PSE_HDR) >> 1);     /* 802.3: 8 words */
+	}
+	txd[3] = TXD_PORT_MCU | TXD_QUEUE_MCU_Q1;
+	/* DW1 */
+	txd[4] = wlan_idx;
+	if (is_mgmt) {
+		txd[5] = TXD_LONG_FORMAT | TXD_HF_802_11_NORMAL | (uint8_t)((mac_hdr_len >> 1) & 0x1f);
+	} else {
+		txd[5] = TXD_LONG_FORMAT | TXD_ETHERNET_II;             /* non-802.11, Ethernet II */
+	}
+	txd[6] = 0;                                             /* TID 0 */
+	txd[7] = TXD_PKT_FORMAT_COMMAND;                        /* own MAC index 0 */
+	/* DW2: type/subtype for 802.11 */
+	if (is_mgmt) {
+		txd[8] = (uint8_t)(subtype & 0x0f);             /* type 0 (mgmt) in [4:5] = 0 */
+	}
+	/* DW3: protection + remaining tx count (retry) */
+	uint16_t tcl = (uint16_t)(15u << 11);                   /* remaining tx count 15 */
+	if (protected) {
+		tcl |= TXD_PROTECTED;
+	}
+	put16(txd + 12, tcl);
+	/* DW5: PID + TXS to MCU (TX done via EVENT 0x0F) */
+	if (want_txs) {
+		if (++l->tx_pid == 0 || l->tx_pid > 127) {
+			l->tx_pid = 1;
+		}
+		txd[20] = l->tx_pid;
+		txd[21] = TXD_TXS_TO_MCU;
+	}
+	/* DW6: fixed lowest rate for management reliability (data frames auto-rate) */
+	if (is_mgmt) {
+		txd[11] |= TXD_FIXED_RATE_EN;                   /* ucPowerOffset */
+		put16(txd + 24, lowest_rate_code(l->peer_band));
+	}
+}
