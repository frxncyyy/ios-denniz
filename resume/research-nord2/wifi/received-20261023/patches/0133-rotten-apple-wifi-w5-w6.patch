+/*
+ * Rotten Apple: self-contained crypto for WPA2-PSK (milestone W6).
+ * Clean-room: SHA-1 (FIPS 180), HMAC-SHA1 (RFC 2104), PBKDF2 (RFC 2898),
+ * the IEEE 802.11 PRF and AES-128 with RFC 3394 key unwrap. Interface in
+ * rottenapple_wifi_crypto.h. These are the standard public algorithms,
+ * written here so the supplicant does not depend on the kernel's optional
+ * corecrypto build. wpa_supplicant (BSD-licensed) was a behavioural
+ * reference for the PRF labels and key layout only; no code was copied.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <dev/rottenapple_wifi_crypto.h>
+
+/* ---- SHA-1 ---- */
+
+struct ra_sha1 {
+	uint32_t h[5];
+	uint64_t len;           /* message length in bytes */
+	uint8_t buf[64];
+	unsigned n;             /* bytes in buf */
+};
+
+static inline uint32_t
+rol32(uint32_t v, unsigned s)
+{
+	return (v << s) | (v >> (32 - s));
+}
+
+static void
+sha1_block(struct ra_sha1 *c, const uint8_t *p)
+{
+	uint32_t w[80], a, b, d, e, f, k, t;
+	unsigned i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = ((uint32_t)p[4 * i] << 24) | ((uint32_t)p[4 * i + 1] << 16) |
+		    ((uint32_t)p[4 * i + 2] << 8) | (uint32_t)p[4 * i + 3];
+	}
+	for (i = 16; i < 80; i++) {
+		w[i] = rol32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+	}
+	a = c->h[0];
+	b = c->h[1];
+	uint32_t cc = c->h[2];
+	d = c->h[3];
+	e = c->h[4];
+	for (i = 0; i < 80; i++) {
+		if (i < 20) {
+			f = (b & cc) | (~b & d);
+			k = 0x5a827999;
+		} else if (i < 40) {
+			f = b ^ cc ^ d;
+			k = 0x6ed9eba1;
+		} else if (i < 60) {
+			f = (b & cc) | (b & d) | (cc & d);
+			k = 0x8f1bbcdc;
+		} else {
+			f = b ^ cc ^ d;
+			k = 0xca62c1d6;
+		}
+		t = rol32(a, 5) + f + e + k + w[i];
+		e = d;
+		d = cc;
+		cc = rol32(b, 30);
+		b = a;
+		a = t;
+	}
+	c->h[0] += a;
+	c->h[1] += b;
+	c->h[2] += cc;
+	c->h[3] += d;
+	c->h[4] += e;
+}
+
+static void
+sha1_init(struct ra_sha1 *c)
+{
+	c->h[0] = 0x67452301;
+	c->h[1] = 0xefcdab89;
+	c->h[2] = 0x98badcfe;
+	c->h[3] = 0x10325476;
+	c->h[4] = 0xc3d2e1f0;
+	c->len = 0;
+	c->n = 0;
+}
+
+static void
+sha1_update(struct ra_sha1 *c, const uint8_t *p, size_t len)
+{
+	c->len += len;
+	while (len > 0) {
+		unsigned take = MIN((unsigned)len, 64 - c->n);
+		memcpy(c->buf + c->n, p, take);
+		c->n += take;
+		p += take;
+		len -= take;
+		if (c->n == 64) {
+			sha1_block(c, c->buf);
+			c->n = 0;
+		}
+	}
+}
+
+static void
+sha1_final(struct ra_sha1 *c, uint8_t out[RA_SHA1_LEN])
+{
+	uint64_t bits = c->len * 8;
+	uint8_t pad = 0x80;
+	uint8_t lenbe[8];
+	unsigned i;
+
+	sha1_update(c, &pad, 1);
+	pad = 0;
+	while (c->n != 56) {
+		sha1_update(c, &pad, 1);
+	}
+	for (i = 0; i < 8; i++) {
+		lenbe[i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	sha1_update(c, lenbe, 8);
+	for (i = 0; i < 5; i++) {
+		out[4 * i] = (uint8_t)(c->h[i] >> 24);
+		out[4 * i + 1] = (uint8_t)(c->h[i] >> 16);
+		out[4 * i + 2] = (uint8_t)(c->h[i] >> 8);
+		out[4 * i + 3] = (uint8_t)c->h[i];
+	}
+}
+
+/* ---- HMAC-SHA1 ---- */
+
+void
+ra_hmac_sha1(const uint8_t *key, size_t key_len, const uint8_t *msg, size_t msg_len,
+    uint8_t out[RA_SHA1_LEN])
+{
+	struct ra_sha1 c;
+	uint8_t k[64], ipad[64], opad[64], inner[RA_SHA1_LEN];
+	unsigned i;
+
+	bzero(k, sizeof(k));
+	if (key_len > 64) {
+		sha1_init(&c);
+		sha1_update(&c, key, key_len);
+		sha1_final(&c, k);
+	} else {
+		memcpy(k, key, key_len);
+	}
+	for (i = 0; i < 64; i++) {
+		ipad[i] = k[i] ^ 0x36;
+		opad[i] = k[i] ^ 0x5c;
+	}
+	sha1_init(&c);
+	sha1_update(&c, ipad, 64);
+	sha1_update(&c, msg, msg_len);
+	sha1_final(&c, inner);
+	sha1_init(&c);
+	sha1_update(&c, opad, 64);
+	sha1_update(&c, inner, RA_SHA1_LEN);
+	sha1_final(&c, out);
+	bzero(k, sizeof(k));
+	bzero(ipad, sizeof(ipad));
+	bzero(opad, sizeof(opad));
+	bzero(inner, sizeof(inner));
+}
+
+/* ---- PBKDF2-SHA1 ---- */
+
+void
+ra_pbkdf2_sha1(const uint8_t *pass, size_t pass_len, const uint8_t *salt, size_t salt_len,
+    unsigned iterations, uint8_t *dk, size_t dk_len)
+{
+	uint8_t block[64 + 4];          /* salt is the SSID (<= 32) + a 4-byte counter */
+	uint8_t u[RA_SHA1_LEN], t[RA_SHA1_LEN];
+	uint32_t count = 1;
+	size_t done = 0;
+
+	if (salt_len > 64) {
+		salt_len = 64;
+	}
+	while (done < dk_len) {
+		unsigned i, j;
+		memcpy(block, salt, salt_len);
+		block[salt_len] = (uint8_t)(count >> 24);
+		block[salt_len + 1] = (uint8_t)(count >> 16);
+		block[salt_len + 2] = (uint8_t)(count >> 8);
+		block[salt_len + 3] = (uint8_t)count;
+		ra_hmac_sha1(pass, pass_len, block, salt_len + 4, u);
+		memcpy(t, u, RA_SHA1_LEN);
+		for (i = 1; i < iterations; i++) {
+			ra_hmac_sha1(pass, pass_len, u, RA_SHA1_LEN, u);
+			for (j = 0; j < RA_SHA1_LEN; j++) {
+				t[j] ^= u[j];
+			}
+		}
+		size_t take = MIN(dk_len - done, (size_t)RA_SHA1_LEN);
+		memcpy(dk + done, t, take);
+		done += take;
+		count++;
+	}
+	bzero(u, sizeof(u));
+	bzero(t, sizeof(t));
+	bzero(block, sizeof(block));
+}
+
+/* ---- IEEE 802.11 PRF ---- */
+
+void
+ra_prf(const uint8_t *key, size_t key_len, const char *label, const uint8_t *data,
+    size_t data_len, uint8_t *out, size_t out_len)
+{
+	uint8_t buf[128], hash[RA_SHA1_LEN];
+	size_t label_len = strlen(label);
+	size_t done = 0;
+	uint8_t i = 0;
+
+	/* A(i) = HMAC(key, label || 0x00 || data || i), concatenated */
+	while (done < out_len) {
+		size_t n = 0;
+		memcpy(buf + n, label, label_len);
+		n += label_len;
+		buf[n++] = 0;
+		memcpy(buf + n, data, data_len);
+		n += data_len;
+		buf[n++] = i;
+		ra_hmac_sha1(key, key_len, buf, n, hash);
+		size_t take = MIN(out_len - done, (size_t)RA_SHA1_LEN);
+		memcpy(out + done, hash, take);
+		done += take;
+		i++;
+	}
+	bzero(buf, sizeof(buf));
+	bzero(hash, sizeof(hash));
+}
+
+/* ---- AES-128 (encrypt + decrypt), for RFC 3394 key unwrap ---- */
