+/*
+ * Rotten Apple: Wi-Fi station layer (milestones W5 + W6, docs/WIFI-PLAN.md).
+ * Chip-free: association is driven through the backend ops (join, set_key,
+ * set_port, tx_data, disconnect); this file holds the policy, the WPA2-PSK
+ * 4-way-handshake supplicant, the Ethernet ifnet (en1) and the sysctl
+ * interface.
+ *
+ * Flow (sysctl kern.rottenapple_wifi_join = "<ssid>"):
+ *   1. find the strongest BSS of the last scan with that SSID (W4 list);
+ *   2. WPA2-PSK: read the passphrase (/var/root/.wifi-psk, or the write-only
+ *      sysctl kern.rottenapple_wifi_psk), derive PMK = PBKDF2-SHA1(psk, ssid,
+ *      4096, 32), then wipe the passphrase;
+ *   3. ops->join(): the firmware command sequence, open-system auth and the
+ *      association request (the backend builds the IEs and the frames);
+ *   4. WPA2-PSK: the 4-way handshake here, over the data path (EAPOL frames
+ *      the AP sends arrive through rottenapple_wifi_rx_data); install the PTK
+ *      and GTK (ops->set_key) and open the controlled port (ops->set_port);
+ *   5. bring the en interface up with the NVRAM MAC. The user sets the IP
+ *      with ifconfig/route over SSH, or a minimal static IP via
+ *      kern.rottenapple_wifi_ip; DHCP runs from userland (ipconfig) once the
+ *      interface carries traffic.
+ *
+ * The passphrase and every key derived from it are secrets: nothing here
+ * logs or prints them, and every buffer that held one is wiped.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/random.h>
+#include <sys/sockio.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/proc.h>
+#include <sys/kauth.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+#include <netinet/in.h>
+#include <net/if_media.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <dev/rottenapple_wifi.h>
+#include <dev/rottenapple_wifi_crypto.h>
+
+extern int vn_rdwr(enum uio_rw, struct vnode *, caddr_t, int, off_t, enum uio_seg, int, kauth_cred_t,
+    int *, proc_t);
+
+#define TLOG(fmt, ...)  printf("ROTTEN APPLE: wifi sta: " fmt "\n", ##__VA_ARGS__)
+
+/* ---- State ---- */
+
+enum {
+	LINK_IDLE,              /* not associated */
+	LINK_JOINING,          /* auth + assoc in progress */
+	LINK_4WAY,             /* associated, 4-way handshake running */
+	LINK_CONNECTED,        /* data path open */
+};
+static const char *const link_name[] = { "idle", "joining", "4-way handshake", "connected" };
+
+#define PSK_MAX         63      /* WPA passphrase: 8..63 characters */
+#define PMK_LEN         32
+#define KCK_LEN         16
+#define KEK_LEN         16
+#define TK_LEN          16
+#define PTK_LEN         (KCK_LEN + KEK_LEN + TK_LEN)
+#define NONCE_LEN       32
+#define GTK_MAX         32
+
+struct wifi_sta {
+	struct rottenapple_wifi *w;
+	ifnet_t ifp;
+	lck_mtx_t *lock;
+	lck_grp_t *grp;
+
+	volatile unsigned state;
+	struct rottenapple_wifi_join tgt;       /* current/last target */
+	uint8_t own_mac[6];
+
+	/* WPA2-PSK material (secrets; wiped on teardown) */
+	bool have_pmk;
+	uint8_t pmk[PMK_LEN];
+	uint8_t ptk[PTK_LEN];
+	uint8_t snonce[NONCE_LEN];
+	uint8_t anonce[NONCE_LEN];
+	uint64_t replay;                        /* last replay counter seen (big-endian value) */
+	bool replay_valid;
+	uint8_t gtk[GTK_MAX];
+	uint8_t gtk_len, gtk_id;
+	volatile bool hs_done, hs_failed;
+	unsigned hs_m1, hs_m3;                  /* counts, for the log */
+
+	/* reconnect */
+	bool want_reconnect;
+	uint8_t reconnect_ssid[32];
+	uint8_t reconnect_ssid_len;
+
+	/* link info for the log */
+	char ip_text[40];
+	bool ip_set;
+};
+
+static struct wifi_sta sta;
+static bool sta_ready;
+
+/* The fixed WPA2-PSK / CCMP RSN IE (no PMF): the assoc request and EAPOL
+ * message 2 must carry the identical bytes. */
+static const uint8_t rsn_ie_wpa2_psk_ccmp[] = {
+	0x30, 0x14,                             /* RSN IE, length 20 */
+	0x01, 0x00,                             /* version 1 */
+	0x00, 0x0f, 0xac, 0x04,                 /* group cipher CCMP */
+	0x01, 0x00, 0x00, 0x0f, 0xac, 0x04,     /* 1 pairwise cipher CCMP */
+	0x01, 0x00, 0x00, 0x0f, 0xac, 0x02,     /* 1 AKM: PSK */
+	0x00, 0x00,                             /* RSN capabilities (no PMF) */
+};
+
+/* ---- helpers ---- */
+
+static inline uint16_t
+be16(const uint8_t *p)
+{
+	return (uint16_t)((p[0] << 8) | p[1]);
+}
+
+static inline void
+put_be16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+static inline uint64_t
+be64(const uint8_t *p)
+{
+	uint64_t v = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		v = (v << 8) | p[i];
+	}
+	return v;
+}
+
+/* ---- Passphrase ---- */
+
+/*
+ * The passphrase, from /var/root/.wifi-psk (mode 600, root only) or, if that
+ * is absent, the write-only sysctl buffer below. Copied into out (wiped by
+ * the caller); *out_len set. ENOENT if neither is present, EINVAL on a bad
+ * length. Never logged.
+ */
+static uint8_t sysctl_psk[PSK_MAX + 1];
+static uint8_t sysctl_psk_len;
+
+static int
+psk_load(uint8_t *out, size_t *out_len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t fsize = 0;
+	char buf[PSK_MAX + 8];
+	int err, resid = 0;
+
+	/* 1. the root-only file (read quietly: never log its path, size or content) */
+	if (vnode_open("/var/root/.wifi-psk", O_RDONLY, 0, 0, &vp, ctx) == 0) {
+		if (vnode_size(vp, &fsize, ctx) == 0 && fsize > 0 && fsize <= (off_t)sizeof(buf)) {
+			err = vn_rdwr(UIO_READ, vp, buf, (int)fsize, 0, UIO_SYSSPACE, IO_NOAUTH,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			vnode_close(vp, 0, ctx);
+			if (err == 0 && resid == 0) {
+				size_t n = (size_t)fsize;
+				while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r')) {
+					n--;    /* strip the trailing newline the user's editor may add */
+				}
+				if (n < 8 || n > PSK_MAX) {
+					bzero(buf, sizeof(buf));
+					TLOG("passphrase file: length out of range (need 8..63 characters)");
+					return EINVAL;
+				}
+				memcpy(out, buf, n);
+				*out_len = n;
+				bzero(buf, sizeof(buf));
+				return 0;
+			}
+			bzero(buf, sizeof(buf));
+		} else {
+			vnode_close(vp, 0, ctx);
+		}
+	}
+	/* 2. the write-only sysctl */
+	if (sysctl_psk_len >= 8 && sysctl_psk_len <= PSK_MAX) {
+		memcpy(out, sysctl_psk, sysctl_psk_len);
+		*out_len = sysctl_psk_len;
+		return 0;
+	}
+	TLOG("no passphrase: create /var/root/.wifi-psk (mode 600) or write kern.rottenapple_wifi_psk");
+	return ENOENT;
+}
+
+/* ---- The Ethernet interface (en1) ---- */
+
+static errno_t
+sta_if_output(ifnet_t ifp, mbuf_t m)
+{
+	struct wifi_sta *s = &sta;
+	uint8_t frame[ETHERMTU + ETHER_HDR_LEN + 32];
+	size_t len;
+
+	if (s->state != LINK_CONNECTED || s->w->ops->tx_data == NULL) {
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	len = mbuf_pkthdr_len(m);
+	if (len == 0 || len > sizeof(frame)) {
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	if (mbuf_copydata(m, 0, len, frame) != 0) {
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	mbuf_freem(m);
+	int err = s->w->ops->tx_data(s->w, frame, (uint32_t)len, ROTTENAPPLE_WIFI_TX_PROTECTED);
+	if (err) {
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	} else {
+		ifnet_stat_increment_out(ifp, 1, len, 0);
+	}
+	return 0;
+}
+
+static errno_t
+sta_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ? ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		bool up = sta.state == LINK_CONNECTED;
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = up ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+sta_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* Create en1 once (Ethernet family, the NVRAM MAC); later connects reuse it. */
+static int
+sta_if_create(struct wifi_sta *s)
+{
+	struct ifnet_init_eparams init;
+
+	if (s->ifp != NULL) {
+		return 0;
+	}
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "rotten-apple-wifi";
+	init.uniqueid_len = sizeof("rotten-apple-wifi") - 1;
+	init.name = "en";
+	init.unit = 1;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = sta_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = sta_if_ioctl;
+	init.detach = sta_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &s->ifp) != 0) {
+		TLOG("en1: ifnet_allocate failed");
+		s->ifp = NULL;
+		return ENOMEM;
+	}
+	ifnet_set_addrlen(s->ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(s->ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(s->ifp, ETHERMTU);
+	ifnet_set_flags(s->ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(s->ifp, NULL) != 0) {
+		TLOG("en1: ifnet_attach failed");
+		s->ifp = NULL;
+		return ENXIO;
+	}
+	ifnet_set_lladdr(s->ifp, s->own_mac, ETHER_ADDR_LEN);
+	(void)proto_plumb(PF_INET, s->ifp);
+	TLOG("en1 created, MAC from the NVRAM; set an address with ifconfig/ipconfig over SSH, or "
+	    "kern.rottenapple_wifi_ip");
+	return 0;
+}
+
+static void
+sta_if_link(struct wifi_sta *s, bool up)
+{
+	if (s->ifp == NULL) {
+		return;
+	}
+	if (up) {
+		ifnet_set_flags(s->ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	} else {
+		ifnet_set_flags(s->ifp, 0, IFF_RUNNING);
+	}
+	dlil_post_msg(s->ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+}
+
+/* Deliver one received Ethernet frame to en1 (sweet_usb.c pattern). */
+static void
+sta_if_input(struct wifi_sta *s, const uint8_t *eth, uint32_t len)
+{
+	mbuf_t m = NULL;
+
+	if (s->ifp == NULL || len < ETHER_HDR_LEN) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || !(mbuf_flags(m) & MBUF_EXT) ||
+	    mbuf_maxlen(m) < len) {
+		if (m) {
+			mbuf_freem(m);
+		}
+		return;
+	}
+	struct ifnet_stat_increment_param stats = {};
+	memcpy(mbuf_data(m), eth, len);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	void *fh = mbuf_data(m);
+	mbuf_pkthdr_setrcvif(m, s->ifp);
+	mbuf_pkthdr_setheader(m, fh);
+	mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+	(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+	stats.packets_in = 1;
+	stats.bytes_in = len;
+	ifnet_input(s->ifp, m, &stats);
+}
+
+/* ---- 4-way handshake supplicant ---- */
+
+#define EAPOL_TYPE_KEY          3
+#define KEY_DESC_RSN            2
+
+/* key_info bits */
+#define KI_VER_MASK             0x0007
+#define KI_PAIRWISE             0x0008
+#define KI_INSTALL              0x0040
+#define KI_ACK                  0x0080
+#define KI_MIC                  0x0100
+#define KI_SECURE               0x0200
+#define KI_ERROR                0x0400
+#define KI_REQUEST              0x0800
+#define KI_ENCRYPTED            0x1000
+
+/* Offsets inside the EAPOL-Key body (after the 4-byte EAPOL header) */
+#define K_DESC_TYPE             0
+#define K_INFO                  1       /* 2 bytes */
+#define K_LEN                   3       /* 2 bytes */
+#define K_REPLAY                5       /* 8 bytes */
+#define K_NONCE                 13      /* 32 bytes */
+#define K_IV                    45      /* 16 bytes */
+#define K_RSC                   61      /* 8 bytes */
+#define K_RESERVED              69      /* 8 bytes */
+#define K_MIC                   77      /* 16 bytes (SHA1) */
+#define K_DATA_LEN              93      /* 2 bytes */
+#define K_DATA                  95
+#define EAPOL_HDR               4
+#define EAPOL_KEY_FIXED         (EAPOL_HDR + K_DATA)    /* up to key_data */
+
+/* Build the PTK from the PMK and the two nonces/MACs (IEEE 802.11i). */
+static void
+ptk_derive(struct wifi_sta *s)
+{
+	const uint8_t *aa = s->tgt.bssid, *spa = s->own_mac;
+	uint8_t data[2 * 6 + 2 * NONCE_LEN];
+	const uint8_t *n1 = s->anonce, *n2 = s->snonce;
+	size_t o = 0;
+
+	/* min(AA,SPA) || max(AA,SPA) */
+	if (memcmp(aa, spa, 6) < 0) {
+		memcpy(data + o, aa, 6);
+		o += 6;
+		memcpy(data + o, spa, 6);
+		o += 6;
+	} else {
+		memcpy(data + o, spa, 6);
+		o += 6;
+		memcpy(data + o, aa, 6);
+		o += 6;
+	}
+	/* min(ANonce,SNonce) || max(ANonce,SNonce) */
+	if (memcmp(n1, n2, NONCE_LEN) < 0) {
+		memcpy(data + o, n1, NONCE_LEN);
+		o += NONCE_LEN;
+		memcpy(data + o, n2, NONCE_LEN);
+		o += NONCE_LEN;
+	} else {
+		memcpy(data + o, n2, NONCE_LEN);
+		o += NONCE_LEN;
+		memcpy(data + o, n1, NONCE_LEN);
+		o += NONCE_LEN;
+	}
+	ra_prf(s->pmk, PMK_LEN, "Pairwise key expansion", data, o, s->ptk, PTK_LEN);
+	bzero(data, sizeof(data));
+}
+
+/* MIC (key descriptor version 2 = HMAC-SHA1-128) over frame with MIC zeroed. */
+static void
+eapol_mic(struct wifi_sta *s, uint8_t *frame, size_t len)
+{
+	uint8_t full[RA_SHA1_LEN];
+
+	bzero(frame + EAPOL_HDR + K_MIC, 16);
+	ra_hmac_sha1(s->ptk /* KCK */, KCK_LEN, frame, len, full);
+	memcpy(frame + EAPOL_HDR + K_MIC, full, 16);
+	bzero(full, sizeof(full));
+}
+
+static int
+eapol_tx(struct wifi_sta *s, uint8_t *key_body, size_t body_len)
+{
+	uint8_t frame[14 + EAPOL_HDR + K_DATA + 128];
+	size_t total = 14 + EAPOL_HDR + body_len;
+
+	if (s->w->ops->tx_data == NULL || total > sizeof(frame)) {
+		return EINVAL;
+	}
+	/* 802.3 header: dest = BSSID, src = own, ethertype 0x888E (EAPOL) */
+	memcpy(frame, s->tgt.bssid, 6);
+	memcpy(frame + 6, s->own_mac, 6);
+	frame[12] = 0x88;
+	frame[13] = 0x8e;
+	/* EAPOL header: version 2, type Key, length (body) */
+	frame[14] = 2;
+	frame[15] = EAPOL_TYPE_KEY;
+	put_be16(frame + 16, (uint16_t)body_len);
+	memcpy(frame + 18, key_body, body_len);
+	/* EAPOL-Key frames are sent on the unauthorized port: no HW encryption */
+	int err = s->w->ops->tx_data(s->w, frame, (uint32_t)total, 0);
+	bzero(frame, sizeof(frame));
+	return err;
+}
+
+/* Build and send message 2 (SNonce + our RSN IE, MIC under KCK). */
+static int
+eapol_send_m2(struct wifi_sta *s, const uint8_t *m1)
+{
+	uint8_t body[K_DATA + sizeof(rsn_ie_wpa2_psk_ccmp)];
+	uint8_t frame[14 + EAPOL_HDR + sizeof(body)];
+	size_t body_len = K_DATA + sizeof(rsn_ie_wpa2_psk_ccmp);
+	uint16_t ki = (be16(m1 + K_INFO) & KI_VER_MASK) | KI_PAIRWISE | KI_MIC;
+
+	bzero(body, sizeof(body));
+	body[K_DESC_TYPE] = KEY_DESC_RSN;
+	put_be16(body + K_INFO, ki);
+	put_be16(body + K_LEN, 0);
+	memcpy(body + K_REPLAY, m1 + K_REPLAY, 8);
+	memcpy(body + K_NONCE, s->snonce, NONCE_LEN);
+	put_be16(body + K_DATA_LEN, sizeof(rsn_ie_wpa2_psk_ccmp));
+	memcpy(body + K_DATA, rsn_ie_wpa2_psk_ccmp, sizeof(rsn_ie_wpa2_psk_ccmp));
+
+	/* assemble the full frame so the MIC covers the EAPOL header + body */
+	memcpy(frame, s->tgt.bssid, 6);
+	memcpy(frame + 6, s->own_mac, 6);
+	frame[12] = 0x88;
+	frame[13] = 0x8e;
+	frame[14] = 2;
+	frame[15] = EAPOL_TYPE_KEY;
+	put_be16(frame + 16, (uint16_t)body_len);
+	memcpy(frame + 18, body, body_len);
+	eapol_mic(s, frame + 14, EAPOL_HDR + body_len);
+	int err = s->w->ops->tx_data(s->w, frame, (uint32_t)(14 + EAPOL_HDR + body_len), 0);
+	bzero(frame, sizeof(frame));
+	bzero(body, sizeof(body));
+	return err;
+}
+
+/* Build and send message 4 (acknowledge, MIC under KCK, secure bit set). */
+static int
+eapol_send_m4(struct wifi_sta *s, const uint8_t *m3)
+{
+	uint8_t frame[14 + EAPOL_HDR + K_DATA];
+	size_t body_len = K_DATA;       /* no key data */
+	uint16_t ki = (be16(m3 + K_INFO) & KI_VER_MASK) | KI_PAIRWISE | KI_MIC | KI_SECURE;
+
+	memcpy(frame, s->tgt.bssid, 6);
+	memcpy(frame + 6, s->own_mac, 6);
+	frame[12] = 0x88;
+	frame[13] = 0x8e;
+	frame[14] = 2;
+	frame[15] = EAPOL_TYPE_KEY;
+	put_be16(frame + 16, (uint16_t)body_len);
+	uint8_t *body = frame + 18;
+	bzero(body, body_len);
+	body[K_DESC_TYPE] = KEY_DESC_RSN;
+	put_be16(body + K_INFO, ki);
+	memcpy(body + K_REPLAY, m3 + K_REPLAY, 8);
+	put_be16(body + K_DATA_LEN, 0);
+	eapol_mic(s, frame + 14, EAPOL_HDR + body_len);
+	int err = s->w->ops->tx_data(s->w, frame, (uint32_t)(14 + EAPOL_HDR + body_len), 0);
+	bzero(frame, sizeof(frame));
+	return err;
+}
+
+/* Extract the GTK from the (already unwrapped) key-data KDEs of message 3. */
+static bool
+gtk_from_kde(struct wifi_sta *s, const uint8_t *kd, size_t kd_len)
+{
+	size_t o = 0;
+
+	while (o + 2 <= kd_len) {
+		uint8_t id = kd[o], len = kd[o + 1];
+		if (id == 0xdd && len >= 4 && o + 2 + len <= kd_len) {
+			const uint8_t *p = kd + o + 2;
+			if (p[0] == 0x00 && p[1] == 0x0f && p[2] == 0xac && p[3] == 0x01) {
+				/* GTK KDE: OUI 00-0F-AC type 1, then {keyid[0:1], tx}, rsvd, GTK */
+				if (len >= 6) {
+					s->gtk_id = p[4] & 0x03;
+					uint8_t glen = (uint8_t)(len - 6);
+					if (glen > GTK_MAX) {
+						glen = GTK_MAX;
+					}
+					memcpy(s->gtk, p + 6, glen);
+					s->gtk_len = glen;
+					return true;
+				}
+			}
+		} else if (id == 0x00 && len == 0) {
+			break;          /* padding */
+		}
+		if (len == 0) {
+			break;
+		}
+		o += 2 + len;
+	}
+	return false;
+}
+
+/* Install the PTK and GTK, open the port; called with sta.lock held. */
+static int
+install_keys(struct wifi_sta *s)
+{
+	struct rottenapple_wifi_key k;
+	int err;
+
+	/* Pairwise: the TK is the last 16 bytes of the PTK */
+	bzero(&k, sizeof(k));
+	k.type = ROTTENAPPLE_WIFI_KEY_PAIRWISE;
+	k.cipher = ROTTENAPPLE_WIFI_CIPHER_CCMP;
+	k.key_id = 0;
+	k.key_len = TK_LEN;
+	memcpy(k.key, s->ptk + KCK_LEN + KEK_LEN, TK_LEN);
+	memcpy(k.peer, s->tgt.bssid, 6);
+	err = s->w->ops->set_key(s->w, &k);
+	bzero(&k, sizeof(k));
+	if (err) {
+		TLOG("install the pairwise key: FAILED (%d)", err);
+		return err;
+	}
+	/* Group */
+	bzero(&k, sizeof(k));
+	k.type = ROTTENAPPLE_WIFI_KEY_GROUP;
+	k.cipher = ROTTENAPPLE_WIFI_CIPHER_CCMP;
+	k.key_id = s->gtk_id;
+	k.key_len = s->gtk_len == 16 ? 16 : 16;         /* CCMP group key is 16 bytes */
+	memcpy(k.key, s->gtk, MIN(s->gtk_len, (uint8_t)32));
+	err = s->w->ops->set_key(s->w, &k);
+	bzero(&k, sizeof(k));
+	if (err) {
+		TLOG("install the group key: FAILED (%d)", err);
+		return err;
+	}
+	if (s->w->ops->set_port) {
+		err = s->w->ops->set_port(s->w, true);
+		if (err) {
+			TLOG("open the controlled port: FAILED (%d)", err);
+			return err;
+		}
+	}
+	return 0;
+}
+
+/* One EAPOL-Key frame received on the data path (called on the receive thread). */
+static void
+eapol_input(struct wifi_sta *s, const uint8_t *eapol, uint32_t len)
+{
+	const uint8_t *body;
+	uint16_t ki;
+	uint64_t replay;
+
+	if (len < EAPOL_HDR + K_DATA || eapol[15] != EAPOL_TYPE_KEY) {
+		return;
+	}
+	body = eapol + EAPOL_HDR;
+	if (body[K_DESC_TYPE] != KEY_DESC_RSN) {
+		return;
+	}
+	ki = be16(body + K_INFO);
+	if (!(ki & KI_PAIRWISE)) {
+		return;         /* only the pairwise 4-way handshake here (no group rekey yet) */
+	}
+	replay = be64(body + K_REPLAY);
+
+	lck_mtx_lock(s->lock);
+	/* accept EAPOL once we have the PMK: M1 can arrive between the assoc
+	 * response and the join thread setting LINK_4WAY */
+	if ((s->state != LINK_4WAY && s->state != LINK_JOINING) || !s->have_pmk) {
+		lck_mtx_unlock(s->lock);
+		return;
+	}
+	if ((ki & (KI_ACK | KI_MIC)) == KI_ACK) {
+		/* ---- Message 1: ANonce, no MIC ---- */
+		if (s->replay_valid && replay <= s->replay) {
+			lck_mtx_unlock(s->lock);
+			return;         /* replay/old */
+		}
+		s->replay = replay;
+		s->replay_valid = true;
+		memcpy(s->anonce, body + K_NONCE, NONCE_LEN);
+		read_random(s->snonce, NONCE_LEN);
+		ptk_derive(s);
+		s->hs_m1++;
+		int err = eapol_send_m2(s, body);
+		lck_mtx_unlock(s->lock);
+		if (err) {
+			TLOG("4-way: message 2 not sent (%d)", err);
+		}
+		return;
+	}
+	if ((ki & (KI_ACK | KI_MIC | KI_ENCRYPTED)) == (KI_ACK | KI_MIC | KI_ENCRYPTED)) {
+		/* ---- Message 3: MIC + encrypted GTK ---- */
+		uint8_t check[RA_SHA1_LEN], saved[16];
+		uint8_t *frame;
+		uint16_t kd_len = be16(body + K_DATA_LEN);
+		uint32_t need = EAPOL_HDR + K_DATA + kd_len;
+
+		if (replay < s->replay || need > len || kd_len < 24 || (kd_len % 8) != 0) {
+			lck_mtx_unlock(s->lock);
+			TLOG("4-way: message 3 malformed or stale");
+			return;
+		}
+		/* verify the MIC: copy, zero the MIC field, HMAC under KCK */
+		frame = kalloc_data(need, Z_WAITOK);
+		if (frame == NULL) {
+			lck_mtx_unlock(s->lock);
+			return;
+		}
+		memcpy(frame, eapol, need);
+		memcpy(saved, frame + EAPOL_HDR + K_MIC, 16);
+		bzero(frame + EAPOL_HDR + K_MIC, 16);
+		ra_hmac_sha1(s->ptk, KCK_LEN, frame, need, check);
+		if (memcmp(check, saved, 16) != 0) {
+			kfree_data(frame, need);
+			lck_mtx_unlock(s->lock);
+			TLOG("4-way: message 3 MIC mismatch (wrong passphrase?)");
+			s->hs_failed = true;
+			thread_wakeup((event_t)&s->hs_done);
+			return;
+		}
+		if (memcmp(body + K_NONCE, s->anonce, NONCE_LEN) != 0) {
+			kfree_data(frame, need);
+			lck_mtx_unlock(s->lock);
+			TLOG("4-way: message 3 ANonce changed");
+			return;
+		}
+		s->replay = replay;
+		/* decrypt the key data (AES unwrap with the KEK) */
+		uint8_t kd[256];
+		if (kd_len - 8 > sizeof(kd) ||
+		    ra_aes_unwrap(s->ptk + KCK_LEN /* KEK */, eapol + EAPOL_HDR + K_DATA, kd_len, kd) != 0) {
+			kfree_data(frame, need);
+			lck_mtx_unlock(s->lock);
+			TLOG("4-way: message 3 key-data unwrap failed");
+			s->hs_failed = true;
+			thread_wakeup((event_t)&s->hs_done);
+			return;
+		}
+		bool got_gtk = gtk_from_kde(s, kd, kd_len - 8);
+		bzero(kd, sizeof(kd));
+		kfree_data(frame, need);
+		s->hs_m3++;
+		int err = eapol_send_m4(s, body);
+		if (err == 0 && got_gtk) {
+			err = install_keys(s);
+		} else if (!got_gtk) {
+			err = EINVAL;
+			TLOG("4-way: message 3 had no GTK");
+		}
+		s->hs_failed = err != 0;
+		s->hs_done = true;
+		lck_mtx_unlock(s->lock);
+		thread_wakeup((event_t)&s->hs_done);
+		return;
+	}
+	lck_mtx_unlock(s->lock);
+}
+
+/* ---- RX dispatch (backend -> core) ---- */
+
+void
+rottenapple_wifi_rx_data(struct rottenapple_wifi *w, const uint8_t *eth, uint32_t len)
+{
+	struct wifi_sta *s = &sta;
+
+	if (!sta_ready || s->w != w || len < ETHER_HDR_LEN) {
+		return;
+	}
+	if (eth[12] == 0x88 && eth[13] == 0x8e) {
+		eapol_input(s, eth + ETHER_HDR_LEN, len - ETHER_HDR_LEN);
+		return;
+	}
+	if (s->state == LINK_CONNECTED) {
+		sta_if_input(s, eth, len);
+	}
+}
+
+/* ---- Join / disconnect ---- */
+
+static void
+sta_teardown_locked(struct wifi_sta *s, bool tell_firmware)
+{
+	if (tell_firmware && s->w->ops->disconnect && s->state != LINK_IDLE) {
+		s->w->ops->disconnect(s->w);
+	}
+	sta_if_link(s, false);
+	s->state = LINK_IDLE;
+	s->have_pmk = false;
+	s->hs_done = false;
+	s->hs_failed = false;
+	s->replay_valid = false;
+	bzero(s->pmk, sizeof(s->pmk));
+	bzero(s->ptk, sizeof(s->ptk));
+	bzero(s->gtk, sizeof(s->gtk));
+	bzero(s->snonce, sizeof(s->snonce));
+}
+
+#define JOIN_HS_TIMEOUT_MS      5000
+
+static int
+sta_join(struct wifi_sta *s, const uint8_t *ssid, uint8_t ssid_len)
+{
+	struct rottenapple_wifi_join jp;
+	int err;
+
+	if (rottenapple_wifi_running() != s->w) {
+		TLOG("join refused: Wi-Fi is not running (bring it up with rottenapple_wifi=5/6)");
+		return ENXIO;
+	}
+	if (!rottenapple_wifi_scan_lookup(ssid, ssid_len, &jp)) {
+		TLOG("join: \"%.*s\" not in the last scan; scan first (kern.rottenapple_wifi_scan=1)", ssid_len, ssid);
+		return ENOENT;
+	}
+	if (jp.security != ROTTENAPPLE_WIFI_SEC_OPEN && jp.security != ROTTENAPPLE_WIFI_SEC_WPA2_PSK) {
+		TLOG("join: \"%.*s\" uses an unsupported security (only open and WPA2-PSK CCMP are handled)",
+		    ssid_len, ssid);
+		return ENOTSUP;
+	}
+	if (s->w->ops->join == NULL || s->w->ops->tx_data == NULL) {
+		return ENOTSUP;
+	}
+
+	lck_mtx_lock(s->lock);
+	if (s->state != LINK_IDLE) {
+		sta_teardown_locked(s, true);
+	}
+	memcpy(s->own_mac, s->w->mac, 6);
+	s->tgt = jp;
+	s->replay_valid = false;
+	s->hs_done = false;
+	s->hs_failed = false;
+	s->have_pmk = false;
+	if (jp.security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK) {
+		uint8_t psk[PSK_MAX];
+		size_t psk_len = 0;
+		err = psk_load(psk, &psk_len);
+		if (err) {
+			lck_mtx_unlock(s->lock);
+			return err;
+		}
+		/* PMK = PBKDF2-SHA1(passphrase, SSID, 4096, 32) */
+		ra_pbkdf2_sha1(psk, psk_len, ssid, ssid_len, 4096, s->pmk, PMK_LEN);
+		bzero(psk, sizeof(psk));
+		s->have_pmk = true;
+	}
+	s->state = LINK_JOINING;
+	lck_mtx_unlock(s->lock);
+
+	TLOG("join: \"%.*s\" ch %u (%s GHz), %s", ssid_len, ssid, jp.channel, jp.channel <= 14 ? "2.4" : "5",
+	    jp.security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK ? "WPA2-PSK CCMP" : "open");
+
+	err = s->w->ops->join(s->w, &jp);      /* auth + association (blocks) */
+	if (err) {
+		TLOG("join: association FAILED (%d)", err);
+		lck_mtx_lock(s->lock);
+		sta_teardown_locked(s, true);
+		lck_mtx_unlock(s->lock);
+		return err;
+	}
+	s->tgt.aid = jp.aid;
+	TLOG("associated: AID %u; %s", jp.aid, jp.security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK ?
+	    "starting the 4-way handshake" : "open network, no handshake");
+
+	if (jp.security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK) {
+		uint64_t deadline;
+		lck_mtx_lock(s->lock);
+		s->state = LINK_4WAY;
+		clock_interval_to_deadline(JOIN_HS_TIMEOUT_MS, NSEC_PER_MSEC, &deadline);
+		while (!s->hs_done && mach_absolute_time() < deadline) {
+			(void)lck_mtx_sleep_deadline(s->lock, LCK_SLEEP_DEFAULT, (event_t)&s->hs_done,
+			    THREAD_UNINT, deadline);
+		}
+		bool ok = s->hs_done && !s->hs_failed;
+		if (!ok) {
+			sta_teardown_locked(s, true);
+			lck_mtx_unlock(s->lock);
+			TLOG("4-way handshake %s", s->hs_done ? "failed" : "timed out (no EAPOL from the AP)");
+			return s->hs_done ? EACCES : ETIMEDOUT;
+		}
+		lck_mtx_unlock(s->lock);
+		TLOG("4-way handshake done: PTK and GTK (id %u) installed, controlled port open", s->gtk_id);
+	} else if (s->w->ops->set_port) {
+		(void)s->w->ops->set_port(s->w, true);
+	}
+
+	lck_mtx_lock(s->lock);
+	if (sta_if_create(s) == 0) {
+		sta_if_link(s, true);
+		s->state = LINK_CONNECTED;
+	}
+	/* remember for a reconnect */
+	memcpy(s->reconnect_ssid, ssid, ssid_len);
+	s->reconnect_ssid_len = ssid_len;
+	s->want_reconnect = true;
+	lck_mtx_unlock(s->lock);
+	TLOG("connected: en1 up with the NVRAM MAC; configure IP over SSH (ifconfig/ipconfig) or "
+	    "kern.rottenapple_wifi_ip");
+	return 0;
+}
+
+void
+rottenapple_wifi_link_lost(struct rottenapple_wifi *w, const char *reason)
+{
+	struct wifi_sta *s = &sta;
+
+	if (!sta_ready || s->w != w) {
+		return;
+	}
+	lck_mtx_lock(s->lock);
+	if (s->state == LINK_IDLE) {
+		lck_mtx_unlock(s->lock);
+		return;
+	}
+	TLOG("link lost (%s); disconnecting", reason ? reason : "");
+	bool reconnect = s->want_reconnect;
+	uint8_t ssid[32], ssid_len = s->reconnect_ssid_len;
+	memcpy(ssid, s->reconnect_ssid, ssid_len);
+	sta_teardown_locked(s, true);
+	lck_mtx_unlock(s->lock);
+	/* a single best-effort reconnect attempt using the last scan list */
+	if (reconnect && ssid_len) {
+		TLOG("reconnecting to \"%.*s\"", ssid_len, ssid);
+		(void)sta_join(s, ssid, ssid_len);
+	}
+}
+
+void
+rottenapple_wifi_sta_stop(struct rottenapple_wifi *w)
+{
+	struct wifi_sta *s = &sta;
+
+	if (!sta_ready || s->w != w) {
+		return;
+	}
+	lck_mtx_lock(s->lock);
+	s->want_reconnect = false;
+	sta_teardown_locked(s, false);  /* firmware is being torn down anyway */
+	lck_mtx_unlock(s->lock);
+}
+
+/* ---- sysctls ---- */
+
+static int
+sysctl_wifi_join SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	char ssid[33];
+	int err, changed = 0;
+	size_t slen;
+
+	bzero(ssid, sizeof(ssid));
+	if (sta.state >= LINK_JOINING && sta.tgt.ssid_len) {
+		memcpy(ssid, sta.tgt.ssid, sta.tgt.ssid_len);
+	}
+	err = sysctl_io_string(req, ssid, sizeof(ssid), 0, &changed);
+	if (err || !changed) {
+		return err;
+	}
+	slen = strnlen(ssid, 32);
+	if (slen == 0) {
+		/* empty write = disconnect */
+		lck_mtx_lock(sta.lock);
+		sta.want_reconnect = false;
+		sta_teardown_locked(&sta, true);
+		lck_mtx_unlock(sta.lock);
+		TLOG("disconnected (empty join)");
+		return 0;
+	}
+	return sta_join(&sta, (const uint8_t *)ssid, (uint8_t)slen);
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi_join, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_wifi_join, "A", "rotten-apple Wi-Fi: write an SSID to join (empty to disconnect)");
+
+/* write-only passphrase; never readable back, wiped once a PMK is derived */
+static int
+sysctl_wifi_psk SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	char buf[PSK_MAX + 1];
+	int err, changed = 0;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		/* reads give nothing */
+		return SYSCTL_OUT(req, "", 1);
+	}
+	bzero(buf, sizeof(buf));
+	err = sysctl_io_string(req, buf, sizeof(buf), 0, &changed);
+	if (err) {
+		bzero(buf, sizeof(buf));
+		return err;
+	}
+	size_t n = strnlen(buf, PSK_MAX);
+	if (n < 8 || n > PSK_MAX) {
+		bzero(buf, sizeof(buf));
+		return EINVAL;
+	}
+	memcpy(sysctl_psk, buf, n);
+	sysctl_psk_len = (uint8_t)n;
+	bzero(buf, sizeof(buf));
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi_psk, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_wifi_psk, "A", "rotten-apple Wi-Fi: write-only WPA2 passphrase (not readable)");
+
+static int
+sysctl_wifi_link SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	char buf[256];
+	struct wifi_sta *s = &sta;
+	const uint8_t *b = s->tgt.bssid;
+	size_t n;
+
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	if (s->state == LINK_IDLE) {
+		n = (size_t)snprintf(buf, sizeof(buf), "state: idle (not associated)\n");
+	} else {
+		n = (size_t)snprintf(buf, sizeof(buf),
+		    "state: %s\nssid: \"%.*s\"\nbssid: %02x:%02x:%02x:%02x:%02x:%02x\nchannel: %u (%s GHz)\n"
+		    "security: %s\naid: %u\nmessages: M1 %u M3 %u\nip: %s\n",
+		    link_name[s->state], s->tgt.ssid_len, s->tgt.ssid, b[0], b[1], b[2], b[3], b[4], b[5],
+		    s->tgt.channel, s->tgt.channel <= 14 ? "2.4" : "5",
+		    s->tgt.security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK ? "WPA2-PSK CCMP" : "open",
+		    s->tgt.aid, s->hs_m1, s->hs_m3, s->ip_set ? s->ip_text : "(set with ifconfig/ipconfig)");
+	}
+	n = MIN(n, sizeof(buf) - 1);
+	buf[n] = '\0';
+	return SYSCTL_OUT(req, buf, n + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi_link, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_wifi_link, "A", "rotten-apple Wi-Fi: link state, BSSID, channel, security, AID, IP");
+
+/*
+ * Optional static IP: write "A.B.C.D/prefix" (optionally " gw E.F.G.H") to
+ * give en1 an address and, with a gateway, a host route to it over en1
+ * without touching the default route. DHCP from userland is preferred.
+ */
+static int
+sta_set_ipv4(struct wifi_sta *s, uint32_t addr, uint32_t mask, uint32_t gw)
+{
+	socket_t so = NULL;
+	struct ifaliasreq ifra;
+	struct sockaddr_in *a;
+	int err;
+
+	if (s->ifp == NULL) {
+		return ENXIO;
+	}
+	err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (err) {
+		return err;
+	}
+	bzero(&ifra, sizeof(ifra));
+	snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "en1");
+	a = (struct sockaddr_in *)&ifra.ifra_addr;
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(addr);
+	a = (struct sockaddr_in *)&ifra.ifra_mask;
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(mask);
+	a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl((addr & mask) | ~mask);
+	err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+	sock_close(so);
+	if (err == 0) {
+		snprintf(s->ip_text, sizeof(s->ip_text), "%u.%u.%u.%u", (addr >> 24) & 0xff, (addr >> 16) & 0xff,
+		    (addr >> 8) & 0xff, addr & 0xff);
+		s->ip_set = true;
+	}
+	(void)gw;       /* a host route to the gateway can be added with `route` over SSH */
+	return err;
+}
+
+static int
+sysctl_wifi_ip SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	char buf[48];
+	int err, changed = 0;
+	unsigned v[4] = { 0, 0, 0, 0 }, pfx = 24, part = 0, digits = 0;
+	bool in_prefix = false;
+
+	bzero(buf, sizeof(buf));
+	if (sta.ip_set) {
+		strlcpy(buf, sta.ip_text, sizeof(buf));
+	}
+	err = sysctl_io_string(req, buf, sizeof(buf), 0, &changed);
+	if (err || !changed) {
+		return err;
+	}
+	/* parse "A.B.C.D" or "A.B.C.D/prefix" by hand (no sscanf in the kernel) */
+	for (const char *p = buf; *p && *p != ' '; p++) {
+		if (*p >= '0' && *p <= '9') {
+			unsigned *t = in_prefix ? &pfx : &v[part];
+			if (digits == 0 && !in_prefix) {
+				*t = 0;
+			}
+			if (in_prefix && digits == 0) {
+				pfx = 0;
+			}
+			*t = *t * 10 + (unsigned)(*p - '0');
+			digits++;
+		} else if (*p == '.' && !in_prefix) {
+			if (++part > 3) {
+				return EINVAL;
+			}
+			digits = 0;
+		} else if (*p == '/' && !in_prefix) {
+			in_prefix = true;
+			digits = 0;
+		} else {
+			return EINVAL;
+		}
+	}
+	if (part != 3 || v[0] > 255 || v[1] > 255 || v[2] > 255 || v[3] > 255 || pfx > 32) {
+		return EINVAL;
+	}
+	uint32_t addr = (v[0] << 24) | (v[1] << 16) | (v[2] << 8) | v[3];        /* host order */
+	uint32_t mask = pfx == 0 ? 0 : (0xffffffffu << (32 - pfx));
+	return sta_set_ipv4(&sta, addr, mask, 0);
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi_ip, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_wifi_ip, "A", "rotten-apple Wi-Fi: optional static IPv4 for en1 as A.B.C.D/prefix");
+
+/* ---- init ---- */
+
+void
+rottenapple_wifi_sta_init(struct rottenapple_wifi *w)
+{
+	if (sta_ready) {
+		return;
+	}
+	bzero(&sta, sizeof(sta));
+	sta.w = w;
+	sta.state = LINK_IDLE;
+	sta.grp = lck_grp_alloc_init("rottenapple_wifi_sta", LCK_GRP_ATTR_NULL);
+	sta.lock = lck_mtx_alloc_init(sta.grp, LCK_ATTR_NULL);
+	sta_ready = true;
+	TLOG("station layer ready: join with kern.rottenapple_wifi_join, passphrase in /var/root/.wifi-psk");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
