+/*
+ * Rotten Apple: self-contained crypto for the WPA2-PSK 4-way handshake
+ * (milestone W6, docs/WIFI-PLAN.md). Clean-room implementations of the
+ * standard algorithms: SHA-1, HMAC-SHA1, PBKDF2-SHA1, the IEEE 802.11 PRF
+ * and AES-128 (for the RFC 3394 key unwrap of the GTK). No GPL and no
+ * dependency on the kernel's optional corecrypto/ipsec crypto: this file is
+ * always compiled so the supplicant works regardless of the kernel config.
+ *
+ * The passphrase and the keys derived from it are secrets. Nothing here
+ * logs or returns them in cleartext to a reader; callers must wipe their
+ * buffers.
+ */
+#ifndef _BSD_DEV_ROTTENAPPLE_WIFI_CRYPTO_H_
+#define _BSD_DEV_ROTTENAPPLE_WIFI_CRYPTO_H_
+
+#include <sys/types.h>
+
+__BEGIN_DECLS
+
+#define RA_SHA1_LEN     20
+
+/* HMAC-SHA1 of msg under key -> out[RA_SHA1_LEN]. */
+void ra_hmac_sha1(const uint8_t *key, size_t key_len, const uint8_t *msg, size_t msg_len,
+    uint8_t out[RA_SHA1_LEN]);
+
+/*
+ * PBKDF2-SHA1(passphrase, ssid, 4096, dk_len) -> dk. The WPA PMK is
+ * dk_len = 32, iterations 4096 (IEEE 802.11i). passphrase is not NUL
+ * counted; pass its byte length.
+ */
+void ra_pbkdf2_sha1(const uint8_t *pass, size_t pass_len, const uint8_t *salt, size_t salt_len,
+    unsigned iterations, uint8_t *dk, size_t dk_len);
+
+/*
+ * IEEE 802.11 PRF-n (n a multiple of 8 bits): the SHA-1 PRF used to expand
+ * the PMK into the PTK. out_len is the number of bytes wanted (48 for
+ * CCMP: KCK 16 + KEK 16 + TK 16).
+ */
+void ra_prf(const uint8_t *key, size_t key_len, const char *label, const uint8_t *data,
+    size_t data_len, uint8_t *out, size_t out_len);
+
+/*
+ * RFC 3394 AES key unwrap with a 128-bit KEK (the EAPOL-Key KEK). in_len is
+ * the wrapped length (GTK length + 8), a multiple of 8, >= 24. out gets
+ * in_len - 8 bytes. Returns 0 on success (integrity check value matched),
+ * EBADMSG on a mismatch, EINVAL on a bad length.
+ */
+int ra_aes_unwrap(const uint8_t kek[16], const uint8_t *in, size_t in_len, uint8_t *out);
+
+__END_DECLS
+
+#endif /* _BSD_DEV_ROTTENAPPLE_WIFI_CRYPTO_H_ */
