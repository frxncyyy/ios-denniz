+/* ---- Event handlers (receive thread) ---- */
+
+static void
+ev_tx_done(__unused struct rottenapple_wifi *w, const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	if (ev->len >= 2 && ev->body[1] != 0) {
+		l->tx_fails++;          /* EVENT_TX_DONE: ucPacketSeq(PID), ucStatus */
+	}
+}
+
+static void
+ev_ch_privilege(__unused struct rottenapple_wifi *w, const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	/* EVENT_CH_PRIVILEGE: ucBssIndex, ucTokenID, ucStatus (0 = grant) */
+	if (ev->len >= 3 && l->join_active && ev->body[1] == l->ch_token && ev->body[2] == 0) {
+		l->ch_granted = true;
+		thread_wakeup((event_t)(uintptr_t)&l->ch_granted);
+	}
+}
+
+static void
+ev_beacon_timeout(struct rottenapple_wifi *w, __unused const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	if (l->connected) {
+		rottenapple_wifi_link_lost(w, "beacon timeout (EVENT 0x13)");
+	}
+}
+
+static void
+ev_send_deauth(struct rottenapple_wifi *w, __unused const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	if (l->connected) {
+		rottenapple_wifi_link_lost(w, "deauth/disassoc (EVENT 0x1b)");
+	}
+}
