+/* ---- Received auth/assoc/deauth management frames (join + link watch) ---- */
+
+static void
+wl_rx_mgmt_join(struct mtk_wlan *l, const uint8_t *f, uint32_t len)
+{
+	uint8_t subtype;
+
+	if (len < 24) {
+		return;
+	}
+	subtype = f[0] >> 4;
+	/* only frames from our BSSID (addr3) matter */
+	if (memcmp(f + 16, l->peer, 6) != 0 && !l->join_active) {
+		return;
+	}
+	if (subtype == FC_SUBTYPE_AUTH && l->join_active && len >= 30) {
+		/* auth body: algorithm(2), seq(2), status(2) */
+		uint16_t alg = le16(f + 24), seq = le16(f + 26), status = le16(f + 28);
+		if (alg == 0 && seq == 2) {             /* open system, response */
+			l->auth_status = status;
+			l->auth_done = true;
+			thread_wakeup((event_t)(uintptr_t)&l->auth_done);
+		}
+		return;
+	}
+	if ((subtype == FC_SUBTYPE_ASSOC_RESP || subtype == FC_SUBTYPE_REASSOC_RESP) && l->join_active &&
+	    len >= 30) {
+		/* assoc resp body: capability(2), status(2), AID(2) */
+		l->assoc_status = le16(f + 26);
+		l->assoc_aid = (uint16_t)(le16(f + 28) & 0x3fff);
+		l->assoc_done = true;
+		thread_wakeup((event_t)(uintptr_t)&l->assoc_done);
+		return;
+	}
+	if ((subtype == FC_SUBTYPE_DEAUTH || subtype == FC_SUBTYPE_DISASSOC) && l->connected) {
+		rottenapple_wifi_link_lost(l->w, subtype == FC_SUBTYPE_DEAUTH ? "received deauth" :
+		    "received disassoc");
+	}
+}
+
+/* 802.11 data (not header-translated) -> Ethernet, to the core data path. */
+static void
+wl_rx_data_frame(struct mtk_wlan *l, const uint8_t *f, uint32_t len)
+{
+	static const uint8_t snap[6] = { 0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00 };
+	uint8_t eth[1600];
+	uint32_t hdr = 24;
+
+	if (!l->connected || len < 24) {
+		return;
+	}
+	if (f[0] & 0x80) {              /* QoS data: 2-byte QoS control */
+		hdr += 2;
+	}
+	if (len < hdr + 8 + 2 || memcmp(f + hdr, snap, 6) != 0) {
+		l->rx_ctrl_data++;      /* not a SNAP-encapsulated frame we handle */
+		return;
+	}
+	uint32_t payload = len - (hdr + 6);     /* ethertype(2) + data */
+	if (payload + 12 > sizeof(eth)) {
+		return;
+	}
+	/* fromDS: addr1 = DA (f+4), addr2 = BSSID (f+10), addr3 = SA (f+16) */
+	memcpy(eth, f + 4, 6);          /* DA */
+	memcpy(eth + 6, f + 16, 6);     /* SA */
+	memcpy(eth + 12, f + hdr + 6, payload);         /* ethertype + payload */
+	l->rx_data_frames++;
+	rottenapple_wifi_rx_data(l->w, eth, 12 + payload);
+}
+
+/* ---- Commands for the join ---- */
+
+/* CMD_CH_PRIVILEGE (req) + wait for EVENT_CH_PRIVILEGE grant. */
+static int
+wl_ch_privilege(struct mtk_wlan *l, bool req)
+{
+	uint8_t cmd[24] = { 0 };
+
+	cmd[0] = AIS_BSS_INDEX;
+	cmd[1] = ++l->ch_token ? l->ch_token : (l->ch_token = 1);
+	cmd[2] = req ? 0 : 1;                   /* CMD_CH_ACTION_REQ / ABORT */
+	cmd[3] = l->peer_channel;
+	cmd[4] = 0;                             /* RfSco: no secondary */
+	cmd[5] = l->peer_band;                  /* 1 = 2.4, 2 = 5 */
+	cmd[6] = 0;                             /* 20 MHz */
+	cmd[9] = 0;                             /* CH_REQ_TYPE_JOIN */
+	cmd[10] = 4;                            /* ENUM_BAND_AUTO */
+	put32(cmd + 12, req ? JOIN_CH_INTERVAL_MS : 0);
+	l->ch_granted = false;
+	int err = wl_set(l, CMD_ID_CH_PRIVILEGE, cmd, sizeof(cmd), req ? "CH_PRIVILEGE (request)" :
+	    "CH_PRIVILEGE (abort)");
+	if (err || !req) {
+		return err;
+	}
+	uint64_t t0 = now_us();
+	while (!l->ch_granted && l->running && !l->fw_dead && now_us() - t0 < CH_GRANT_WAIT_MS * 1000ull) {
+		(void)assert_wait_timeout((event_t)(uintptr_t)&l->ch_granted, THREAD_UNINT, 20, NSEC_PER_MSEC);
+		if (l->ch_granted) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+	if (!l->ch_granted) {
+		LLOG("join: no channel-privilege grant within %u ms (continuing anyway)", CH_GRANT_WAIT_MS);
+	}
+	return 0;       /* not fatal: the firmware parks on the scan/AIS channel */
+}
+
+/* CMD_REMOVE_STA_RECORD {ucActionType, ucStaIndex, ucBssIndex, rsvd} */
+static int
+wl_remove_sta(struct mtk_wlan *l)
+{
+	uint8_t cmd[4] = { 0 /* STA_REC_CMD_ACTION_STA */, STA_REC_IDX, AIS_BSS_INDEX, 0 };
+	return wl_set(l, CMD_ID_REMOVE_STA_RECORD, cmd, sizeof(cmd), "REMOVE_STA_RECORD");
+}
+
+/* CMD_INFRASTRUCTURE: struct PARAM_OP_MODE {u32 eOpMode = NET_TYPE_INFRA, u8 bss} */
+static int
+wl_infrastructure(struct mtk_wlan *l)
+{
+	uint8_t cmd[8] = { 0 };
+
+	put32(cmd + 0, 1);              /* NET_TYPE_INFRA */
+	cmd[4] = AIS_BSS_INDEX;
+	return wl_set(l, CMD_ID_INFRASTRUCTURE, cmd, sizeof(cmd), "INFRASTRUCTURE (infra)");
+}
+
+/* Rate sets for the band (ENUM_SW_RATE_INDEX bitmaps). */
+static void
+band_rates(uint8_t band, uint16_t *op, uint16_t *basic)
+{
+	if (band == 2) {
+		*op = 0x3fc0;           /* 6..54 Mbps */
+		*basic = 0x0540;        /* 6, 12, 24 basic */
+	} else {
+		*op = 0x3fcf;           /* 1..54 Mbps */
+		*basic = 0x000f;        /* 1, 2, 5.5, 11 basic */
+	}
+}
+
+/*
+ * CMD_UPDATE_STA_RECORD (200 bytes, CFG_SUPPORT_802_11AX build; offsets in
+ * docs/WIFI-PLAN.md "W5"). state 1 creates the WTBL entry, state 3 marks it
+ * associated with the AID.
+ */
+#define USR_LEN         200
+#define USR_STA_INDEX   0
+#define USR_STA_TYPE    1
+#define USR_MAC         2
+#define USR_AID         8
+#define USR_LISTEN      10
+#define USR_BSS         12
+#define USR_PHY         13
+#define USR_NONHT_RATE  14
+#define USR_BASIC_RATE  16
+#define USR_IS_QOS      18
+#define USR_STA_STATE   20
+#define USR_WLAN_IDX    54
+#define USR_BMC_IDX     55
+#define USR_RCPI        50
+#define USR_NEED_RESP   51
+#define USR_HWRATE      74
+#define STA_STATE_1     1
+#define STA_STATE_3     3
+#define STA_TYPE_LEGACY_AP      0x41    /* STA_TYPE_LEGACY_MASK | STA_TYPE_AP_MASK */
+
+static int
+wl_update_sta(struct mtk_wlan *l, uint8_t state)
+{
+	uint8_t *cmd = kalloc_data(USR_LEN, Z_WAITOK | Z_ZERO);
+	uint16_t op, basic;
+	int err;
+
+	if (cmd == NULL) {
+		return ENOMEM;
+	}
+	band_rates(l->peer_band, &op, &basic);
+	cmd[USR_STA_INDEX] = STA_REC_IDX;
+	cmd[USR_STA_TYPE] = STA_TYPE_LEGACY_AP;
+	memcpy(cmd + USR_MAC, l->peer, 6);
+	put16(cmd + USR_AID, state == STA_STATE_3 ? l->assoc_aid : 0);
+	put16(cmd + USR_LISTEN, 1);
+	cmd[USR_BSS] = AIS_BSS_INDEX;
+	cmd[USR_PHY] = l->peer_band == 2 ? 0x08 /* OFDM */ : 0x03 /* HR_DSSS | ERP */;
+	put16(cmd + USR_NONHT_RATE, op);
+	put16(cmd + USR_BASIC_RATE, basic);
+	cmd[USR_IS_QOS] = 0;
+	cmd[USR_STA_STATE] = state;
+	cmd[USR_WLAN_IDX] = l->sta_wlan_idx;
+	cmd[USR_BMC_IDX] = l->grp_wlan_idx;
+	cmd[USR_NEED_RESP] = 0;
+	put16(cmd + USR_HWRATE, lowest_rate_code(l->peer_band));
+	err = wl_set(l, CMD_ID_UPDATE_STA_RECORD, cmd, USR_LEN, state == STA_STATE_1 ?
+	    "UPDATE_STA_RECORD (state 1)" : "UPDATE_STA_RECORD (state 3, associated)");
+	kfree_data(cmd, USR_LEN);
+	return err;
+}
+
+/* CMD_SET_BSS_INFO (116 bytes; offsets in docs/WIFI-PLAN.md "W5"). */
+#define SBI_LEN         116
+#define SBI_BSS         0
+#define SBI_CONN_STATE  1
+#define SBI_OPMODE      2
+#define SBI_SSID_LEN    3
+#define SBI_SSID        4
+#define SBI_BSSID       36
+#define SBI_OP_RATE     44
+#define SBI_BASIC_RATE  46
+#define SBI_STAREC_AP   48
+#define SBI_HWRATE      50
+#define SBI_NONHT_PHY   52
+#define SBI_AUTH        53
+#define SBI_ENC         54
+#define SBI_PHYSET      55
+#define SBI_BMC_IDX     58
+#define SBI_RLM         68      /* CMD_SET_BSS_RLM_PARAM */
+#define SBI_DBDC        90
+#define SBI_WMM         91
+#define SBI_NSS         93
+#define AUTH_MODE_OPEN_FW       0
+#define AUTH_MODE_WPA2_PSK_FW   7
+#define ENC_DISABLED_FW         1       /* ENUM_ENCRYPTION_DISABLED */
+#define ENC_CCMP_FW             6       /* ENUM_ENCRYPTION3_ENABLED */
+
+static int
+wl_set_bss_info(struct mtk_wlan *l, const struct rottenapple_wifi_join *jp, bool connected)
+{
+	uint8_t *cmd = kalloc_data(SBI_LEN, Z_WAITOK | Z_ZERO);
+	uint16_t op, basic;
+	int err;
+
+	if (cmd == NULL) {
+		return ENOMEM;
+	}
+	band_rates(jp->band, &op, &basic);
+	cmd[SBI_BSS] = AIS_BSS_INDEX;
+	cmd[SBI_CONN_STATE] = connected ? 0 /* MEDIA_STATE_CONNECTED */ : 1;
+	cmd[SBI_OPMODE] = 0;            /* OP_MODE_INFRASTRUCTURE */
+	cmd[SBI_SSID_LEN] = jp->ssid_len;
+	memcpy(cmd + SBI_SSID, jp->ssid, jp->ssid_len);
+	memcpy(cmd + SBI_BSSID, jp->bssid, 6);
+	put16(cmd + SBI_OP_RATE, op);
+	put16(cmd + SBI_BASIC_RATE, basic);
+	cmd[SBI_STAREC_AP] = STA_REC_IDX;
+	put16(cmd + SBI_HWRATE, lowest_rate_code(jp->band));
+	cmd[SBI_NONHT_PHY] = jp->band == 2 ? 3 /* OFDM index */ : 1 /* ERP index */;
+	cmd[SBI_AUTH] = jp->security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK ? AUTH_MODE_WPA2_PSK_FW : AUTH_MODE_OPEN_FW;
+	cmd[SBI_ENC] = jp->security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK ? ENC_CCMP_FW : ENC_DISABLED_FW;
+	cmd[SBI_PHYSET] = jp->band == 2 ? 0x08 : 0x03;
+	cmd[SBI_BMC_IDX] = l->grp_wlan_idx;
+	/* RLM: channel + band so the firmware knows the operating channel */
+	cmd[SBI_RLM + 0] = AIS_BSS_INDEX;
+	cmd[SBI_RLM + 1] = jp->band;
+	cmd[SBI_RLM + 2] = jp->channel;
+	cmd[SBI_DBDC] = 4;              /* ENUM_BAND_AUTO */
+	cmd[SBI_NSS] = 1;
+	err = wl_set(l, CMD_ID_SET_BSS_INFO, cmd, SBI_LEN, connected ? "SET_BSS_INFO (connected)" :
+	    "SET_BSS_INFO (connecting)");
+	kfree_data(cmd, SBI_LEN);
+	return err;
+}
+
+/* ---- Auth and association request frames ---- */
+
+static void
+hdr80211(struct mtk_wlan *l, uint8_t *f, uint8_t subtype)
+{
+	f[0] = (uint8_t)(subtype << 4);         /* type 0 (mgmt) */
+	f[1] = 0;
+	put16(f + 2, 0);                        /* duration */
+	memcpy(f + 4, l->peer, 6);              /* addr1 = BSSID (DA) */
+	memcpy(f + 10, l->w->mac, 6);           /* addr2 = own (SA) */
+	memcpy(f + 16, l->peer, 6);             /* addr3 = BSSID */
+	put16(f + 22, (uint16_t)(l->mgmt_seq++ << 4));  /* sequence control */
+}
+
+static int
+wl_send_auth(struct mtk_wlan *l)
+{
+	uint8_t txd[32], frame[30];
+
+	hdr80211(l, frame, FC_SUBTYPE_AUTH);
+	put16(frame + 24, 0);          /* algorithm: open system */
+	put16(frame + 26, 1);          /* transaction sequence 1 */
+	put16(frame + 28, 0);          /* status */
+	build_txd(l, txd, true, FC_SUBTYPE_AUTH, l->sta_wlan_idx, sizeof(frame), 24, false, true);
+	l->tx_frames++;
+	return mtk_wfdma_tx_frame(l->d, txd, 32, frame, sizeof(frame));
+}
+
+static int
+wl_send_assoc(struct mtk_wlan *l, const struct rottenapple_wifi_join *jp)
+{
+	/* fixed WPA2-PSK/CCMP RSN IE; must match EAPOL message 2 in the core */
+	static const uint8_t rsn_ie[] = {
+		0x30, 0x14, 0x01, 0x00, 0x00, 0x0f, 0xac, 0x04, 0x01, 0x00, 0x00, 0x0f, 0xac, 0x04,
+		0x01, 0x00, 0x00, 0x0f, 0xac, 0x02, 0x00, 0x00,
+	};
+	static const uint8_t rates_2g[] = { 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24 };
+	static const uint8_t ext_2g[] = { 0x30, 0x48, 0x60, 0x6c };
+	static const uint8_t rates_5g[] = { 0x8c, 0x12, 0x98, 0x24, 0xb0, 0x48, 0x60, 0x6c };
+	uint8_t txd[32], frame[128];
+	uint8_t *p = frame;
+	uint16_t cap;
+
+	hdr80211(l, frame, FC_SUBTYPE_ASSOC_REQ);
+	p = frame + 24;
+	cap = 0x0021;                  /* ESS | short preamble | short slot */
+	if (jp->security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK) {
+		cap |= 0x0010;         /* privacy */
+	}
+	put16(p, cap);
+	p += 2;
+	put16(p, 1);                   /* listen interval */
+	p += 2;
+	/* SSID */
+	*p++ = 0;
+	*p++ = jp->ssid_len;
+	memcpy(p, jp->ssid, jp->ssid_len);
+	p += jp->ssid_len;
+	/* supported rates */
+	*p++ = 1;
+	if (jp->band == 2) {
+		*p++ = sizeof(rates_5g);
+		memcpy(p, rates_5g, sizeof(rates_5g));
+		p += sizeof(rates_5g);
+	} else {
+		*p++ = sizeof(rates_2g);
+		memcpy(p, rates_2g, sizeof(rates_2g));
+		p += sizeof(rates_2g);
+		/* extended rates (2.4 GHz) */
+		*p++ = 50;
+		*p++ = sizeof(ext_2g);
+		memcpy(p, ext_2g, sizeof(ext_2g));
+		p += sizeof(ext_2g);
+	}
+	/* RSN IE for WPA2-PSK */
+	if (jp->security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK) {
+		memcpy(p, rsn_ie, sizeof(rsn_ie));
+		p += sizeof(rsn_ie);
+	}
+	uint32_t flen = (uint32_t)(p - frame);
+	build_txd(l, txd, true, FC_SUBTYPE_ASSOC_REQ, l->sta_wlan_idx, flen, 24, false, true);
+	l->tx_frames++;
+	return mtk_wfdma_tx_frame(l->d, txd, 32, frame, flen);
+}
+
+/* ---- The join ---- */
+
+static bool
+wl_wait_join(struct mtk_wlan *l, volatile bool *flag, unsigned ms)
+{
+	uint64_t t0 = now_us();
+
+	while (!*flag && l->running && !l->fw_dead && now_us() - t0 < (uint64_t)ms * 1000) {
+		(void)assert_wait_timeout((event_t)(uintptr_t)flag, THREAD_UNINT, 20, NSEC_PER_MSEC);
+		if (*flag) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+	return *flag;
+}
+
+int
+mtk_wlan_join(struct mtk_wlan *l, struct rottenapple_wifi_join *jp)
+{
+	int err;
+	unsigned attempt;
+
+	if (!l->started || !l->running || l->fw_dead) {
+		return ENXIO;
+	}
+	l->sta_wlan_idx = STA_WLAN_IDX;
+	l->grp_wlan_idx = GRP_WLAN_IDX;
+	l->sta_rec_idx = STA_REC_IDX;
+	memcpy(l->peer, jp->bssid, 6);
+	l->peer_channel = jp->channel;
+	l->peer_band = jp->band;
+	l->connected = false;
+
+	/* AIS network on with the own MAC (as the scan path does) */
+	if (!l->bss_active && (err = wl_bss_activate(l, true)) != 0) {
+		return err;
+	}
+	if ((err = wl_infrastructure(l)) != 0) {
+		return err;
+	}
+	(void)wl_ch_privilege(l, true);         /* park on the channel (grant not fatal) */
+	(void)wl_remove_sta(l);                 /* clean any stale STA record */
+	if ((err = wl_set_bss_info(l, jp, false)) != 0) {
+		return err;
+	}
+	if ((err = wl_update_sta(l, STA_STATE_1)) != 0) {       /* create the WTBL entry */
+		return err;
+	}
+
+	l->join_active = true;
+	for (attempt = 1; attempt <= JOIN_RETRIES; attempt++) {
+		l->auth_done = false;
+		l->auth_status = 0xffff;
+		if ((err = wl_send_auth(l)) != 0) {
+			LLOG("join: auth frame not sent (%d)", err);
+			continue;
+		}
+		if (!wl_wait_join(l, &l->auth_done, AUTH_WAIT_MS)) {
+			LLOG("join: no auth response (attempt %u/%u)", attempt, JOIN_RETRIES);
+			continue;
+		}
+		if (l->auth_status != 0) {
+			LLOG("join: auth rejected, status %u", l->auth_status);
+			l->join_active = false;
+			return ECONNREFUSED;
+		}
+		LLOG("join: open-system authentication succeeded");
+		break;
+	}
+	if (!l->auth_done || l->auth_status != 0) {
+		l->join_active = false;
+		return l->auth_done ? ECONNREFUSED : ETIMEDOUT;
+	}
+	for (attempt = 1; attempt <= JOIN_RETRIES; attempt++) {
+		l->assoc_done = false;
+		l->assoc_status = 0xffff;
+		if ((err = wl_send_assoc(l, jp)) != 0) {
+			LLOG("join: assoc frame not sent (%d)", err);
+			continue;
+		}
+		if (!wl_wait_join(l, &l->assoc_done, ASSOC_WAIT_MS)) {
+			LLOG("join: no assoc response (attempt %u/%u)", attempt, JOIN_RETRIES);
+			continue;
+		}
+		break;
+	}
+	l->join_active = false;
+	if (!l->assoc_done) {
+		return ETIMEDOUT;
+	}
+	if (l->assoc_status != 0) {
+		LLOG("join: association rejected, status %u", l->assoc_status);
+		return ECONNREFUSED;
+	}
+	jp->aid = l->assoc_aid;
+	LLOG("join: associated, AID %u", l->assoc_aid);
+
+	/* connected context: STA state 3, SET_BSS_INFO connected, PM notify */
+	if ((err = wl_update_sta(l, STA_STATE_3)) != 0 || (err = wl_set_bss_info(l, jp, true)) != 0) {
+		return err;
+	}
+	l->connected = true;
+	return 0;
+}
+
+void
+mtk_wlan_disconnect(struct mtk_wlan *l)
+{
+	uint8_t cmd[4] = { 0 };
+
+	if (!l->started) {
+		return;
+	}
+	l->connected = false;
+	l->join_active = false;
+	/* INDICATE_PM_BSS_ABORT {ucBssIndex, rsvd[3]} */
+	cmd[0] = AIS_BSS_INDEX;
+	(void)wl_set(l, CMD_ID_INDICATE_PM_BSS_ABORT, cmd, sizeof(cmd), "INDICATE_PM_BSS_ABORT");
+	(void)wl_remove_sta(l);
+	(void)wl_ch_privilege(l, false);
+	LLOG("disconnected: STA record removed, channel released");
+}
+
+/* ---- Keys (CMD_ADD_REMOVE_KEY) and the controlled port ---- */
+
+/* CMD_802_11_KEY (64 bytes; offsets from docs/WIFI-PLAN.md "W6"). */
+#define KEY_ADDREMOVE   0
+#define KEY_TXKEY       1
+#define KEY_TYPE        2
+#define KEY_AUTHENT     3
+#define KEY_PEER        4
+#define KEY_BSSIDX      10
+#define KEY_ALG         11
+#define KEY_ID          12
+#define KEY_LEN         13
+#define KEY_WLANIDX     14
+#define KEY_MGMTPROT    15
+#define KEY_MATERIAL    16
+#define KEY_RSC         48
+#define CIPHER_CCMP_FW  4
+
+int
+mtk_wlan_set_key(struct mtk_wlan *l, const struct rottenapple_wifi_key *k)
+{
+	uint8_t cmd[64] = { 0 };
+	bool pairwise = k->type == ROTTENAPPLE_WIFI_KEY_PAIRWISE;
+
+	cmd[KEY_ADDREMOVE] = 1;                         /* add */
+	cmd[KEY_TXKEY] = pairwise ? 1 : 0;
+	cmd[KEY_TYPE] = pairwise ? 1 : 0;              /* 1 = pairwise, 0 = group */
+	cmd[KEY_AUTHENT] = 0;                           /* supplicant, not authenticator */
+	if (pairwise) {
+		memcpy(cmd + KEY_PEER, k->peer, 6);
+	}
+	cmd[KEY_BSSIDX] = AIS_BSS_INDEX;
+	cmd[KEY_ALG] = CIPHER_CCMP_FW;
+	cmd[KEY_ID] = k->key_id;
+	cmd[KEY_LEN] = k->key_len;
+	cmd[KEY_WLANIDX] = pairwise ? l->sta_wlan_idx : l->grp_wlan_idx;
+	cmd[KEY_MGMTPROT] = 0;
+	memcpy(cmd + KEY_MATERIAL, k->key, MIN(k->key_len, (uint8_t)32));
+	/* key material is a secret: log the type and index only, never the bytes */
+	int err = wl_set(l, CMD_ID_ADD_REMOVE_KEY, cmd, sizeof(cmd), pairwise ?
+	    "ADD_KEY (pairwise CCMP)" : "ADD_KEY (group CCMP)");
+	bzero(cmd, sizeof(cmd));
+	return err;
+}
+
+int
+mtk_wlan_set_port(struct mtk_wlan *l, bool authorized)
+{
+	/*
+	 * The firmware opens the controlled port once the pairwise key is
