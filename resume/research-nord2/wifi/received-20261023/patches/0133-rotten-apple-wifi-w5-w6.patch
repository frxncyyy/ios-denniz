+
+static uint8_t aes_inv_sbox[256];
+static bool aes_inv_ready;
+
+static uint8_t
+xtime(uint8_t x)
+{
+	return (uint8_t)((x << 1) ^ ((x >> 7) * 0x1b));
+}
+
+static uint8_t
+gmul(uint8_t a, uint8_t b)
+{
+	uint8_t p = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		if (b & 1) {
+			p ^= a;
+		}
+		uint8_t hi = a & 0x80;
+		a <<= 1;
+		if (hi) {
+			a ^= 0x1b;
+		}
+		b >>= 1;
+	}
+	return p;
+}
+
+struct aes128 {
+	uint8_t rk[11][16];     /* round keys */
+};
+
+static void
+aes128_key(struct aes128 *a, const uint8_t key[16])
+{
+	static const uint8_t rcon[10] = { 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36 };
+	uint8_t t[4];
+	unsigned r, i;
+
+	if (!aes_inv_ready) {
+		for (i = 0; i < 256; i++) {
+			aes_inv_sbox[aes_sbox[i]] = (uint8_t)i;
+		}
+		aes_inv_ready = true;
+	}
+	memcpy(a->rk[0], key, 16);
+	for (r = 1; r <= 10; r++) {
+		memcpy(t, &a->rk[r - 1][12], 4);
+		uint8_t tmp = t[0];
+		t[0] = aes_sbox[t[1]] ^ rcon[r - 1];
+		t[1] = aes_sbox[t[2]];
+		t[2] = aes_sbox[t[3]];
+		t[3] = aes_sbox[tmp];
+		for (i = 0; i < 4; i++) {
+			a->rk[r][i] = a->rk[r - 1][i] ^ t[i];
+		}
+		for (i = 4; i < 16; i++) {
+			a->rk[r][i] = a->rk[r][i - 4] ^ a->rk[r - 1][i];
+		}
+	}
+}
+
+static void
+aes128_encrypt(const struct aes128 *a, const uint8_t in[16], uint8_t out[16])
+{
+	uint8_t s[16];
+	unsigned r, i;
+
+	for (i = 0; i < 16; i++) {
+		s[i] = in[i] ^ a->rk[0][i];
+	}
+	for (r = 1; r <= 10; r++) {
+		uint8_t t[16];
+		for (i = 0; i < 16; i++) {
+			t[i] = aes_sbox[s[i]];
+		}
+		/* ShiftRows (column-major state: byte c*4+row) */
+		uint8_t sr[16];
+		for (unsigned col = 0; col < 4; col++) {
+			for (unsigned row = 0; row < 4; row++) {
+				sr[col * 4 + row] = t[((col + row) % 4) * 4 + row];
+			}
+		}
+		if (r < 10) {
+			for (unsigned col = 0; col < 4; col++) {
+				uint8_t *c = sr + col * 4;
+				uint8_t a0 = c[0], a1 = c[1], a2 = c[2], a3 = c[3];
+				s[col * 4 + 0] = (uint8_t)(xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3);
+				s[col * 4 + 1] = (uint8_t)(a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3);
+				s[col * 4 + 2] = (uint8_t)(a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3));
+				s[col * 4 + 3] = (uint8_t)((xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3));
+			}
+		} else {
+			memcpy(s, sr, 16);
+		}
+		for (i = 0; i < 16; i++) {
+			s[i] ^= a->rk[r][i];
+		}
+	}
+	memcpy(out, s, 16);
+}
+
+static void
+aes128_decrypt(const struct aes128 *a, const uint8_t in[16], uint8_t out[16])
+{
+	uint8_t s[16];
+	unsigned r, i;
+
+	for (i = 0; i < 16; i++) {
+		s[i] = in[i] ^ a->rk[10][i];
+	}
+	for (r = 10; r >= 1; r--) {
+		/* InvShiftRows */
+		uint8_t sr[16];
+		for (unsigned col = 0; col < 4; col++) {
+			for (unsigned row = 0; row < 4; row++) {
+				sr[col * 4 + row] = s[((col + 4 - row) % 4) * 4 + row];
+			}
+		}
+		uint8_t t[16];
+		for (i = 0; i < 16; i++) {
+			t[i] = aes_inv_sbox[sr[i]];
+		}
+		for (i = 0; i < 16; i++) {
+			t[i] ^= a->rk[r - 1][i];
+		}
+		if (r > 1) {
+			for (unsigned col = 0; col < 4; col++) {
+				uint8_t *c = t + col * 4;
+				uint8_t a0 = c[0], a1 = c[1], a2 = c[2], a3 = c[3];
+				s[col * 4 + 0] = (uint8_t)(gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13) ^ gmul(a3, 9));
+				s[col * 4 + 1] = (uint8_t)(gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11) ^ gmul(a3, 13));
+				s[col * 4 + 2] = (uint8_t)(gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14) ^ gmul(a3, 11));
+				s[col * 4 + 3] = (uint8_t)(gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9) ^ gmul(a3, 14));
+			}
+		} else {
+			memcpy(s, t, 16);
+		}
+	}
+	memcpy(out, s, 16);
+}
+
+int
+ra_aes_unwrap(const uint8_t kek[16], const uint8_t *in, size_t in_len, uint8_t *out)
+{
+	static const uint8_t iv[8] = { 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6 };
+	struct aes128 a;
+	uint8_t ablk[8], blk[16];
+	size_t n, i;
+	int j, err = 0;
+
+	if (in_len < 24 || (in_len % 8) != 0) {
+		return EINVAL;
+	}
+	n = in_len / 8 - 1;             /* number of 64-bit data blocks */
+	aes128_key(&a, kek);
+	memcpy(ablk, in, 8);            /* A = C[0] */
+	memcpy(out, in + 8, n * 8);     /* R = C[1..n] */
+	for (j = 5; j >= 0; j--) {
+		for (i = n; i >= 1; i--) {
+			uint64_t t = (uint64_t)(n * (unsigned)j + i);
+			memcpy(blk, ablk, 8);
+			for (unsigned b = 0; b < 8; b++) {
+				blk[b] ^= (uint8_t)(t >> (56 - 8 * b));
+			}
+			memcpy(blk + 8, out + (i - 1) * 8, 8);
+			aes128_decrypt(&a, blk, blk);
+			memcpy(ablk, blk, 8);
+			memcpy(out + (i - 1) * 8, blk + 8, 8);
+		}
+	}
+	for (i = 0; i < 8; i++) {
+		if (ablk[i] != iv[i]) {
+			err = EBADMSG;
+			break;
+		}
+	}
+	bzero(&a, sizeof(a));
+	bzero(blk, sizeof(blk));
+	bzero(ablk, sizeof(ablk));
+	return err;
+}
