+/*
+ * Snapshot of two CONNSYS blocks the ROM's BTIF receive path goes through:
+ * its MCU DMA (the BTIF RX channel's pointers should move when our bytes
+ * arrive and when the ROM consumes them) and its interrupt controller
+ * (pending vs masked). The first snapshot logs the non-zero words, later
+ * ones the words that changed. Only taken after a stall (a command with
+ * nothing back for 300 ms) and at a failure, never on the normal path.
+ */
+static void
+snap_window(struct mtk_wmt *m, const char *name, uint32_t base, uint32_t *prev, unsigned words, const char *why)
+{
+	char line[8 * 24 + 1];
+	size_t k = 0;
+	unsigned hits = 0, shown = 0;
+
+	for (unsigned i = 0; i < words; i++) {
+		uint32_t v = c_rd(m, base + 4 * i);
+		bool hit = m->snap_valid ? v != prev[i] : v != 0;
+		if (hit) {
+			hits++;
+			if (shown < SNAP_MAX_SHOWN) {
+				if (m->snap_valid) {
+					k += (size_t)snprintf(line + k, sizeof(line) - k, " +%03x %x>%x", 4 * i, prev[i], v);
+				} else {
+					k += (size_t)snprintf(line + k, sizeof(line) - k, " +%03x %x", 4 * i, v);
+				}
+				shown++;
+				if (shown % 6 == 0 || k > sizeof(line) - 30) {
+					MLOG("  %s:%s", name, line);
+					k = 0;
+				}
+			}
+		}
+		prev[i] = v;
+	}
+	if (k) {
+		MLOG("  %s:%s", name, line);
+	}
+	MLOG("%s (%s): %u word(s) %s%s", name, why, hits, m->snap_valid ? "changed since the last snapshot" : "non-zero",
+	    hits > shown ? " (first ones shown)" : "");
+}
+
+static void
+conn_snap(struct mtk_wmt *m, const char *why)
+{
+	snap_window(m, "CONNSYS MCU DMA 0x180a1000", CONN_MCU_DMA, m->snap_dma, CONN_MCU_DMA_SIZE / 4, why);
+	snap_window(m, "CONNSYS MCU CIRQ 0x180a5000", CONN_MCU_CIRQ, m->snap_cirq, CONN_MCU_CIRQ_SIZE / 4, why);
+	m->snap_valid = true;
+	m->snaps++;
+	MLOG("CONNSYS (%s): PC 0x%05x 0x%05x COM_REG0 0x%08x", why, c_rd(m, CONN_HIF_ON_PC), c_rd(m, CONN_HIF_ON_PC),
+	    c_rd(m, CONN_MCU_COM_REG0));
 }
 
