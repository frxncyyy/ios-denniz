+	d_wr(m, ch, DMA_VFF_ADDR, (uint32_t)pa);
+	d_wr(m, ch, DMA_VFF_ADDR_H, (uint32_t)(pa >> 32));
+	d_wr(m, ch, DMA_VFF_LEN, VFF_SIZE);
+	d_wr(m, ch, DMA_VFF_WPT, 0);
+	d_wr(m, ch, DMA_VFF_RPT, 0);
