+bool
+rottenapple_wifi_scan_bss(const uint8_t *bssid, struct rottenapple_wifi_bss_info *bi)
+{
+	bool found = false;
+
+	lck_mtx_lock(&wifi_scan_lock);
+	for (unsigned i = 0; i < wifi_scan.n; i++) {
+		const struct wifi_bss *b = &wifi_scan.bss[i];
+		if (memcmp(b->bssid, bssid, 6) == 0) {
+			bi->channel = b->channel;
+			bi->rssi = b->rssi;
+			bi->capability = b->capability;
+			bi->beacon_int = b->beacon_int;
+			found = true;
+			break;
+		}
+	}
+	lck_mtx_unlock(&wifi_scan_lock);
+	return found;
+}
