+		}
 		user_addr_t list = (cmd == SIOCGIFMEDIA64) ? ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
 		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
 		bool up = sta.state == LINK_CONNECTED;
@@ -299,8 +311,8 @@ sta_if_create(struct wifi_sta *s)
 	init.flags = IFNET_INIT_LEGACY;
 	init.uniqueid = "rotten-apple-wifi";
 	init.uniqueid_len = sizeof("rotten-apple-wifi") - 1;
-	init.name = "en";
-	init.unit = 1;
+	init.name = STA_IF_PREFIX;
+	init.unit = STA_IF_UNIT;
 	init.family = IFNET_FAMILY_ETHERNET;
 	init.type = IFT_ETHER;
 	init.output = sta_if_output;
@@ -329,6 +341,15 @@ sta_if_create(struct wifi_sta *s)
 	}
 	ifnet_set_lladdr(s->ifp, s->own_mac, ETHER_ADDR_LEN);
 	(void)proto_plumb(PF_INET, s->ifp);
+	if (s->netif == NULL) {
+		/* configd/InterfaceNamer only see interfaces that exist in IOKit (stage I1) */
+		struct rottenapple_netif_desc d = {
+			.kind = ROTTENAPPLE_NETIF_WIFI, .prefix = STA_IF_PREFIX, .unit = STA_IF_UNIT,
+			.mtu = ETHERMTU, .builtin = true, .primary = true, .model = "Wi-Fi",
+		};
+		memcpy(d.mac, s->own_mac, ETHER_ADDR_LEN);
+		s->netif = rottenapple_netif_publish(&d);
+	}
 	TLOG("en1 created, MAC from the NVRAM; set an address with ifconfig/ipconfig over SSH, or "
 	    "kern.rottenapple_wifi_ip");
 	return 0;
@@ -345,6 +366,7 @@ sta_if_link(struct wifi_sta *s, bool up)
 	} else {
 		ifnet_set_flags(s->ifp, 0, IFF_RUNNING);
 	}
+	rottenapple_netif_link(s->netif, up, up ? STA_LINK_BPS : 0);
 	dlil_post_msg(s->ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
 }
 
@@ -955,6 +977,34 @@ rottenapple_wifi_sta_stop(struct rottenapple_wifi *w)
 	lck_mtx_unlock(s->lock);
 }
 
+/*
+ * Create en1 (and its IOKit stand-in) as soon as Wi-Fi runs and the MAC is
+ * known, not at the first join: configd builds its network configuration
+ * from the interfaces present when IOKit goes quiet after boot, and wifid
+ * expects the interface while not associated. The link stays down until a
+ * join completes.
+ */
+void
+rottenapple_wifi_sta_attach(struct rottenapple_wifi *w)
+{
+	struct wifi_sta *s = &sta;
+	static const uint8_t zero[6];
+
+	if (!sta_ready || s->w != w) {
+		return;
+	}
+	if (memcmp(w->mac, zero, sizeof(zero)) == 0) {
+		TLOG("en1 not created at bring-up: no MAC address from the firmware configuration");
+		return;
+	}
+	lck_mtx_lock(s->lock);
+	if (s->ifp == NULL) {
+		memcpy(s->own_mac, w->mac, 6);
+		(void)sta_if_create(s);
+	}
+	lck_mtx_unlock(s->lock);
+}
