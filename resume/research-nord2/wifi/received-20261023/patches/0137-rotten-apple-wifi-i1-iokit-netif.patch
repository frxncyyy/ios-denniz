diff --git a/bsd/dev/rottenapple_netif.h b/bsd/dev/rottenapple_netif.h
new file mode 100644
index 0000000..eaf2fb4
--- /dev/null
+++ b/bsd/dev/rottenapple_netif.h
@@ -0,0 +1,59 @@
+/*
+ * Rotten Apple: IOKit stand-ins for BSD network interfaces (not an exported
+ * header; shared by bsd/dev and iokit/Kernel/arm/RottenAppleNetwork.cpp).
+ *
+ * iOS userland finds network hardware through IOKit, not through the
+ * ifnet list: configd's InterfaceNamer and SCNetworkInterface enumerate
+ * IOServiceMatching("IONetworkInterface"), read the interface's
+ * IOInterfaceType / BSD Name / IOInterfaceNamePrefix / IOInterfaceUnit /
+ * IOBuiltin, then walk to the parent (the controller: IOMACAddress,
+ * IOFeatures, IOSelfNamed) and its parent (the "bus"). A controller that
+ * conforms to IO80211Controller makes the interface "IEEE80211" (Wi-Fi);
+ * any other Ethernet-type controller makes it "Ethernet". InterfaceNamer
+ * also needs an IONetworkStack service it can open, or it never declares
+ * the registry quiet and PreferencesMonitor never builds the network
+ * configuration.
+ *
+ * A BSD driver that owns an ifnet publishes the matching IOKit objects with
+ * rottenapple_netif_publish() once the ifnet is attached, and reports its
+ * link with rottenapple_netif_link(). The objects carry the ifnet's existing
+ * name and unit, so InterfaceNamer never has to name anything.
+ *
+ * Boot-arg rottenapple_netif=0 turns publication (and IONetworkStack) off.
+ */
+#ifndef _BSD_DEV_ROTTENAPPLE_NETIF_H_
+#define _BSD_DEV_ROTTENAPPLE_NETIF_H_
+
+#include <sys/types.h>
+#include <stdbool.h>
+
+__BEGIN_DECLS
+
+#define ROTTENAPPLE_NETIF_ETHERNET      1       /* IOEthernetController / IOEthernetInterface */
+#define ROTTENAPPLE_NETIF_WIFI          2       /* IO80211Controller / IO80211Interface (infrastructure STA) */
+
+struct rottenapple_netif_desc {
+	unsigned kind;                  /* ROTTENAPPLE_NETIF_* */
+	const char *prefix;             /* BSD name prefix, e.g. "en" */
+	uint32_t unit;                  /* BSD unit: the attached ifnet's */
+	uint8_t mac[6];                 /* link-layer address */
+	uint32_t mtu;
+	bool builtin;                   /* IOBuiltin */
+	bool primary;                   /* IOPrimaryInterface */
+	const char *model;              /* IOModel of the controller */
+};
+
+/*
+ * Publish controller + interface for an attached ifnet. Thread context, may
+ * sleep. Returns an opaque handle (never freed: the objects live as long as
+ * the ifnet, which our drivers never detach), NULL when disabled or on
+ * failure (logged).
+ */
+void *rottenapple_netif_publish(const struct rottenapple_netif_desc *d);
+
+/* Link state on the controller (IOLinkStatus, IOLinkSpeed in bit/s). */
+void rottenapple_netif_link(void *handle, bool active, uint64_t speed_bps);
+
+__END_DECLS
+
+#endif
