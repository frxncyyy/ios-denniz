diff --git a/iokit/Kernel/arm/RottenAppleNetwork.cpp b/iokit/Kernel/arm/RottenAppleNetwork.cpp
new file mode 100644
index 0000000..cf361f5
--- /dev/null
+++ b/iokit/Kernel/arm/RottenAppleNetwork.cpp
@@ -0,0 +1,340 @@
+/*
+ * Rotten Apple: IOKit stand-ins for BSD network interfaces
+ * (docs/WIFI-PLAN.md, stage I1; API in bsd/dev/rottenapple_netif.h).
+ *
+ * IONetworkingFamily and IO80211Family are not part of our kernel, so
+ * configd sees no network hardware: its InterfaceNamer plugin times out
+ * waiting for IONetworkStack and SCNetworkInterfaceCopyAll() is empty. This
+ * file provides the minimum IOKit surface userland actually tests:
+ *
+ *   - class names. configd uses IOServiceMatching("IONetworkInterface")
+ *     and IOObjectConformsTo(controller, "IO80211Controller"); wifid looks
+ *     for IO80211 interfaces. The abstract classes below exist only so
+ *     those names resolve along our objects' class chains; they implement
+ *     nothing of Apple's family ABI.
+ *   - IONetworkStack (matched on IOResources, KernelConfigTables.cpp) with
+ *     a user client InterfaceNamer can open (type 0) and send naming
+ *     requests to (IOConnectSetCFProperties). Our interfaces are published
+ *     already named (BSD Name + IOInterfaceUnit), so a request for one of
+ *     them succeeds as a no-op and any other is refused and logged.
+ *   - per interface a controller (IOMACAddress, IOLinkStatus, ...) attached
+ *     to IOResources, and under it the interface (IOInterfaceType 6,
+ *     BSD Name, IOInterfaceNamePrefix, IOInterfaceUnit, IOBuiltin, ...):
+ *     configd's createInterface() reads exactly interface -> parent ->
+ *     grandparent.
+ *
+ * Boot-arg rottenapple_netif=0: nothing is published.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOBSD.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMessage.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <pexpert/pexpert.h>
+
+extern "C" {
+#include "../../../bsd/dev/rottenapple_netif.h"     /* not an exported header */
+}
+
+#define NLOG(fmt, ...)  IOLog("ROTTEN APPLE: netif: " fmt "\n", ##__VA_ARGS__)
+
+/* Property keys (the strings userland reads; Apple's IONetworkingFamily names). */
+#define kRANetInterfaceType             "IOInterfaceType"
+#define kRANetInterfaceNamePrefix       "IOInterfaceNamePrefix"
+#define kRANetInterfaceUnit             "IOInterfaceUnit"
+#define kRANetInterfaceName             "IOInterfaceName"
+#define kRANetBuiltin                   "IOBuiltin"
+#define kRANetPrimaryInterface          "IOPrimaryInterface"
+#define kRANetLocation                  "IOLocation"
+#define kRANetMaxTransferUnit           "IOMaxTransferUnit"
+#define kRANetMediaAddressLength        "IOMediaAddressLength"
+#define kRANetMediaHeaderLength         "IOMediaHeaderLength"
+#define kRANetInterfaceFlags            "IOInterfaceFlags"
+#define kRANetInterfaceState            "IOInterfaceState"
+#define kRANetMACAddress                "IOMACAddress"
+#define kRANetFeatures                  "IOFeatures"
+#define kRANetLinkStatus                "IOLinkStatus"
+#define kRANetLinkSpeed                 "IOLinkSpeed"
+#define kRANetVendor                    "IOVendor"
+#define kRANetModel                     "IOModel"
+#define kRANet80211Role                 "IO80211InterfaceRole"
+#define kRANetStackCommand              "IONetworkStackUserCommand"
+#define kRANetRegistryEntryID           "IORegistryEntryID"
+#define kRANetSelfNamed                 "IOSelfNamed"
+
+#define RA_IFT_ETHER            6               /* IFT_ETHER */
+#define RA_LINK_VALID           0x1             /* kIONetworkLinkValid */
+#define RA_LINK_ACTIVE          0x2             /* kIONetworkLinkActive */
+#define RA_IF_FLAGS             0x8863          /* UP|BROADCAST|SIMPLEX|MULTICAST|RUNNING|NOTRAILERS */
+#define RA_IF_STATE_REGISTERED  0x1             /* attached to BSD (kIONetworkInterfaceRegisteredState) */
+
+static bool
+netif_enabled(void)
+{
+	uint32_t v = 1;
+	(void)PE_parse_boot_argn("rottenapple_netif", &v, sizeof(v));
+	return v != 0;
+}
+
+/* ---- Class names userland conforms against (no behaviour of their own) ---- */
+
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController {
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IO80211Controller : public IOEthernetController {
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+OSDefineMetaClassAndStructors(IO80211Controller, IOEthernetController);
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class IO80211Interface : public IOEthernetInterface {
+	OSDeclareDefaultStructors(IO80211Interface);
+};
+OSDefineMetaClassAndStructors(IO80211Interface, IOEthernetInterface);
+
+/* ---- Our concrete objects ---- */
+
+class RottenAppleEthernetController : public IOEthernetController {
+	OSDeclareDefaultStructors(RottenAppleEthernetController);
+};
+OSDefineMetaClassAndStructors(RottenAppleEthernetController, IOEthernetController);
+
+class RottenAppleWiFiController : public IO80211Controller {
+	OSDeclareDefaultStructors(RottenAppleWiFiController);
+};
+OSDefineMetaClassAndStructors(RottenAppleWiFiController, IO80211Controller);
+
+class RottenAppleEthernetInterface : public IOEthernetInterface {
+	OSDeclareDefaultStructors(RottenAppleEthernetInterface);
+};
+OSDefineMetaClassAndStructors(RottenAppleEthernetInterface, IOEthernetInterface);
+
+class RottenAppleWiFiInterface : public IO80211Interface {
+	OSDeclareDefaultStructors(RottenAppleWiFiInterface);
+};
+OSDefineMetaClassAndStructors(RottenAppleWiFiInterface, IO80211Interface);
+
+/* ---- IONetworkStack ---- */
+
+class IONetworkStack : public IOService {
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+IOService *
+IONetworkStack::probe(IOService *provider, SInt32 *score)
+{
+	if (!netif_enabled()) {
+		return NULL;
+	}
+	return IOService::probe(provider, score);
+}
+
+bool
+IONetworkStack::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	registerService();
+	NLOG("IONetworkStack registered (interfaces arrive pre-named)");
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/*
+ * A naming request: {IONetworkStackUserCommand, IORegistryEntryID (8-byte
+ * data), IOInterfaceUnit}. Commands 0 (with unit) and 1 (lowest unit). Ours
+ * are already named: accept a request for one of them, refuse the rest.
+ */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *cmd = OSDynamicCast(OSNumber, dict->getObject(kRANetStackCommand));
+	OSData *idd = OSDynamicCast(OSData, dict->getObject(kRANetRegistryEntryID));
+	uint64_t id = 0;
+	if (idd != NULL && idd->getLength() == sizeof(id)) {
+		memcpy(&id, idd->getBytesNoCopy(), sizeof(id));
+	}
+	IOReturn ret = kIOReturnUnsupported;
+	if (id != 0) {
+		OSDictionary *match = IOService::registryEntryIDMatching(id);
+		IOService *svc = match ? IOService::copyMatchingService(match) : NULL;
+		OSSafeReleaseNULL(match);
+		if (svc != NULL && svc->getProperty(kIOBSDNameKey) != NULL &&
+		    OSDynamicCast(IONetworkInterface, svc) != NULL) {
+			ret = kIOReturnSuccess;         /* already named */
+		}
+		OSSafeReleaseNULL(svc);
+	}
+	NLOG("IONetworkStack: naming request command %d for entry 0x%llx: %s",
+	    cmd ? (int)cmd->unsigned32BitValue() : -1, id,
+	    ret == kIOReturnSuccess ? "already named, ok" : "refused (only pre-named interfaces exist)");
+	return ret;
+}
+
+/* ---- Publication ---- */
+
+struct rottenapple_netif {
+	IOService *controller;
+	IOService *interface;
+	char name[16];
+};
+
+static OSNumber *
+num32(uint32_t v)
+{
+	return OSNumber::withNumber((unsigned long long)v, 32);
+}
+
+static void
+set_num(IOService *s, const char *key, uint32_t v)
+{
+	OSNumber *n = num32(v);
+	if (n != NULL) {
+		s->setProperty(key, n);
+		n->release();
+	}
+}
+
+extern "C" void *
+rottenapple_netif_publish(const struct rottenapple_netif_desc *d)
+{
+	if (d == NULL || d->prefix == NULL || !netif_enabled()) {
+		return NULL;
+	}
+	IOService *bus = IOService::getResourceService();
+	bool wifi = d->kind == ROTTENAPPLE_NETIF_WIFI;
+	IOService *ctl = wifi ? (IOService *)OSTypeAlloc(RottenAppleWiFiController) :
+	    (IOService *)OSTypeAlloc(RottenAppleEthernetController);
+	IOService *ifc = wifi ? (IOService *)OSTypeAlloc(RottenAppleWiFiInterface) :
+	    (IOService *)OSTypeAlloc(RottenAppleEthernetInterface);
+	struct rottenapple_netif *h = IOMallocType(struct rottenapple_netif);
+	char name[16];
+
+	snprintf(name, sizeof(name), "%s%u", d->prefix, d->unit);
+	if (bus == NULL || ctl == NULL || ifc == NULL || h == NULL || !ctl->init() || !ifc->init()) {
+		NLOG("%s: publish failed (allocation)", name);
+		goto fail;
+	}
+
+	/* the controller: what configd reads from the interface's parent */
+	{
+		OSData *mac = OSData::withBytes(d->mac, 6);
+		if (mac != NULL) {
+			ctl->setProperty(kRANetMACAddress, mac);
+			mac->release();
+		}
+	}
+	set_num(ctl, kRANetFeatures, 0);
+	set_num(ctl, kRANetLinkStatus, RA_LINK_VALID);
+	ctl->setProperty(kRANetLinkSpeed, 0ULL, 64);
+	ctl->setProperty(kRANetVendor, "Rotten Apple");
+	ctl->setProperty(kRANetModel, d->model ? d->model : (wifi ? "Wi-Fi" : "Ethernet"));
+	ctl->setProperty(kRANetSelfNamed, kOSBooleanFalse);
+
+	/* the interface */
+	set_num(ifc, kRANetInterfaceType, RA_IFT_ETHER);
+	ifc->setProperty(kRANetInterfaceNamePrefix, d->prefix);
+	set_num(ifc, kRANetInterfaceUnit, d->unit);
+	ifc->setProperty(kIOBSDNameKey, name);
+	ifc->setProperty(kRANetInterfaceName, name);
+	ifc->setProperty(kRANetBuiltin, d->builtin ? kOSBooleanTrue : kOSBooleanFalse);
+	ifc->setProperty(kRANetPrimaryInterface, d->primary ? kOSBooleanTrue : kOSBooleanFalse);
+	ifc->setProperty(kRANetLocation, "");
+	set_num(ifc, kRANetMaxTransferUnit, d->mtu ? d->mtu : 1500);
+	set_num(ifc, kRANetMediaAddressLength, 6);
+	set_num(ifc, kRANetMediaHeaderLength, 14);
+	set_num(ifc, kRANetInterfaceFlags, RA_IF_FLAGS);
+	set_num(ifc, kRANetInterfaceState, RA_IF_STATE_REGISTERED);
+	if (wifi) {
+		ifc->setProperty(kRANet80211Role, "Infrastructure");
+	}
+
+	if (!ctl->attach(bus)) {
+		NLOG("%s: publish failed (controller attach)", name);
+		goto fail;
+	}
+	if (!ifc->attach(ctl)) {
+		NLOG("%s: publish failed (interface attach)", name);
+		ctl->detach(bus);
+		goto fail;
+	}
+	ctl->registerService();
+	ifc->registerService();
+
+	h->controller = ctl;
+	h->interface = ifc;
+	strlcpy(h->name, name, sizeof(h->name));
+	NLOG("%s published to IOKit as %s (%s controller)", name, ifc->getMetaClass()->getClassName(),
+	    wifi ? "IO80211" : "Ethernet");
+	return h;
+
+fail:
+	OSSafeReleaseNULL(ctl);
+	OSSafeReleaseNULL(ifc);
+	if (h != NULL) {
+		IOFreeType(h, struct rottenapple_netif);
+	}
+	return NULL;
+}
+
+extern "C" void
+rottenapple_netif_link(void *handle, bool active, uint64_t speed_bps)
+{
+	struct rottenapple_netif *h = (struct rottenapple_netif *)handle;
+	if (h == NULL) {
+		return;
+	}
+	set_num(h->controller, kRANetLinkStatus, RA_LINK_VALID | (active ? RA_LINK_ACTIVE : 0));
+	h->controller->setProperty(kRANetLinkSpeed, active ? speed_bps : 0ULL, 64);
+	h->controller->messageClients(kIOMessageServicePropertyChange);
+}
