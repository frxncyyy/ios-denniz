+		akms[na++] = 2;
+	}
+	if (rsn && (akm & ROTTENAPPLE_WIFI_AKM_FT_PSK)) {
+		akms[na++] = 4;
+	}
+	if (rsn && (akm & ROTTENAPPLE_WIFI_AKM_PSK_SHA256)) {
+		akms[na++] = 6;
+	}
+	if (rsn && (akm & ROTTENAPPLE_WIFI_AKM_SAE)) {
+		akms[na++] = 8;
+	}
+	if (rsn && (akm & ROTTENAPPLE_WIFI_AKM_OWE)) {
+		akms[na++] = 18;
+	}
+	if (na == 0) {
+		akms[na++] = 2;
+	}
+	if (ciph & ROTTENAPPLE_WIFI_CIPH_CCMP) {
+		ciphs[nc++] = 4;
+	}
+	if (ciph & ROTTENAPPLE_WIFI_CIPH_TKIP) {
+		ciphs[nc++] = 2;
+	}
+	if (rsn && (ciph & ROTTENAPPLE_WIFI_CIPH_GCMP256)) {
+		ciphs[nc++] = 9;
