+/* The current BSS as a scan-list entry (scan list values where known). */
+static void
+a80211_current_entry(const struct rottenapple_wifi_link_info *li, struct rottenapple_wifi_bss_entry *e)
+{
+	struct rottenapple_wifi_bss_info bi = { .channel = li->channel, .rssi = li->rssi };
+
+	(void)rottenapple_wifi_scan_bss(li->bssid, &bi);
+	bzero(e, sizeof(*e));
+	memcpy(e->bssid, li->bssid, 6);
+	memcpy(e->ssid, li->ssid, li->ssid_len);
+	e->ssid_len = li->ssid_len;
+	e->channel = li->channel;
+	e->rssi = bi.rssi;
+	e->capability = bi.capability;
+	e->beacon_int = bi.beacon_int;
+	if (li->security == ROTTENAPPLE_WIFI_SEC_WPA2_PSK) {
+		e->sec = ROTTENAPPLE_WIFI_BSS_RSN | ROTTENAPPLE_WIFI_BSS_PRIVACY;
+		e->akm_rsn = ROTTENAPPLE_WIFI_AKM_PSK;
+		e->ciph_rsn = ROTTENAPPLE_WIFI_CIPH_CCMP;
+	}
+}
+
+static uint64_t
+ms_since(uint64_t t)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static void
+a80211_scan_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int err = rottenapple_wifi_scan(ROTTENAPPLE_WIFI_SCAN_ACTIVE);
+	if (err == EBUSY || err == ENXIO || err == ENOTSUP || err == EINVAL) {
+		rottenapple_wifi_a80211_scan_done();    /* no scan ran: end the caller's wait anyway */
+	}
+	ALOG("userland scan finished (%d), %u networks", err, rottenapple_wifi_scan_count());
+	a80211_scanning = false;
+}
+
+static int
+a80211_scan_req(void)
+{
+	struct rottenapple_wifi_link_info li;
+	thread_t th;
+
+	rottenapple_wifi_sta_link_info(&li);
+	lck_mtx_lock(&a80211_lock);
+	if (a80211_scanning) {
+		lck_mtx_unlock(&a80211_lock);
+		return 0;                       /* the running scan posts SCAN_DONE */
+	}
+	if ((li.associated || a80211_assoc_running) && a80211_scan_done_at != 0 &&
+	    ms_since(a80211_scan_done_at) < SCAN_REUSE_MS && rottenapple_wifi_scan_count() > 0) {
+		lck_mtx_unlock(&a80211_lock);
+		rottenapple_wifi_a80211_scan_done();    /* fresh enough: no off-channel scan while associated */
+		return 0;
+	}
+	a80211_scanning = true;
+	lck_mtx_unlock(&a80211_lock);
+	if (kernel_thread_start(a80211_scan_thread, NULL, &th) != KERN_SUCCESS) {
+		a80211_scanning = false;
+		return ENOMEM;
+	}
+	thread_deallocate(th);
+	return 0;
+}
+
+static int
+a80211_scan_result_get(struct ra_a80211_req *r)
+{
+	struct rottenapple_wifi_bss_entry e;
+
+	lck_mtx_lock(&a80211_lock);
+	unsigned i = a80211_scan_cursor;
+	bool ok = !a80211_scanning && rottenapple_wifi_scan_entry(i, &e);
+	a80211_scan_cursor = ok ? i + 1 : 0;   /* EIO ends the list (IO80211 _Apple80211Scan) and rewinds */
+	lck_mtx_unlock(&a80211_lock);
+	if (!ok) {
+		return EIO;
+	}
+	uint8_t *sr = kalloc_data(SR_LEN, Z_WAITOK | Z_ZERO);
+	if (sr == NULL) {
+		return ENOMEM;
+	}
+	uint32_t len = a80211_scan_result(sr, &e);
+	int err = a80211_reply(r, sr, MAX(len, MIN(r->len, (uint32_t)SR_LEN)));
+	kfree_data(sr, SR_LEN);
+	return err;
+}
+
+static void
+a80211_assoc_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	struct rottenapple_wifi_join jp;
+	struct rottenapple_wifi_link_info before;
+	int err;
+
+	rottenapple_wifi_sta_link_info(&before);
+	if (!rottenapple_wifi_scan_lookup(a80211_assoc.ssid, a80211_assoc.ssid_len, &jp)) {
+		(void)rottenapple_wifi_scan(ROTTENAPPLE_WIFI_SCAN_ACTIVE);
+	}
+	err = rottenapple_wifi_sta_join(a80211_assoc.ssid, a80211_assoc.ssid_len,
+	    a80211_assoc.have_pmk ? a80211_assoc.pmk : NULL);
+	bzero(&a80211_assoc, sizeof(a80211_assoc));
+	ALOG("userland join: %s (%d)", err ? "FAILED" : "connected", err);
+	if (err) {
+		a80211_assoc_result = ASSOC_RESULT_FAILED;
+		a80211_post(M_ASSOC_DONE, NULL, 0);
+	}
+	a80211_assoc_running = false;
+	if (err && before.associated) {
+		/* a failed switch must not leave the phone offline: back to the previous network */
+		int e2 = rottenapple_wifi_sta_rejoin_last();
+		ALOG("previous network %s (%d)", e2 ? "NOT restored" : "restored", e2);
+	}
+}
+
+static int
+a80211_associate(struct ra_a80211_req *r)
+{
+	struct rottenapple_wifi_link_info li;
+	uint8_t *as;
+	thread_t th;
+	int err = 0;
+
+	if (r->data == 0 || r->len < AS_PMK + 32) {
+		return EINVAL;
+	}
+	if (a80211_assoc_running) {
+		return EBUSY;
+	}
+	as = kalloc_data(ASSOC_LEN, Z_WAITOK | Z_ZERO);
+	if (as == NULL) {
+		return ENOMEM;
+	}
+	err = copyin((user_addr_t)r->data, as, MIN(r->len, (uint32_t)ASSOC_LEN));
+	if (err) {
+		goto out;
+	}
+	uint32_t ssid_len, key_len, key_type, pmk_len;
+	uint16_t upper;
+	memcpy(&ssid_len, as + AS_SSID_LEN, 4);
+	memcpy(&key_len, as + AS_KEY_LEN, 4);
+	memcpy(&key_type, as + AS_KEY_TYPE, 4);
+	memcpy(&pmk_len, as + AS_PMK_LEN, 4);
+	memcpy(&upper, as + AS_AUTH_UPPER, 2);
+	if (ssid_len == 0 || ssid_len > 32) {
+		err = EINVAL;
+		goto out;
+	}
+	if (upper != AUTH_UPPER_NONE && upper != AUTH_UPPER_WPA2_PSK) {
+		ALOG("associate: auth type 0x%x not supported (open and WPA2-PSK only)", upper);
+		err = EOPNOTSUPP;
+		goto out;
+	}
+	rottenapple_wifi_sta_link_info(&li);
+	if (li.associated && li.ssid_len == ssid_len && memcmp(li.ssid, as + AS_SSID, ssid_len) == 0) {
+		/* already on this network (joined at boot or before): keep the link */
+		ALOG("associate: already associated to the requested network, keeping the link");
+		a80211_assoc_result = ASSOC_RESULT_OK;
+		a80211_post(M_ASSOC_DONE, NULL, 0);
+		goto out;
+	}
+	bzero(&a80211_assoc, sizeof(a80211_assoc));
+	memcpy(a80211_assoc.ssid, as + AS_SSID, ssid_len);
+	a80211_assoc.ssid_len = (uint8_t)ssid_len;
+	if (upper == AUTH_UPPER_WPA2_PSK) {
+		if (pmk_len == 32) {
+			memcpy(a80211_assoc.pmk, as + AS_PMK, 32);
+			a80211_assoc.have_pmk = true;
+		} else if (key_len == 32 && key_type == AS_KEY_TYPE_PMK) {
+			memcpy(a80211_assoc.pmk, as + AS_KEY, 32);
+			a80211_assoc.have_pmk = true;
+		}
+		/* no PMK: the station layer falls back to the passphrase file */
+	}
+	ALOG("associate: WPA2-PSK %s, PMK %s", upper == AUTH_UPPER_WPA2_PSK ? "yes" : "no (open)",
+	    a80211_assoc.have_pmk ? "from userland" : "not given (passphrase file fallback)");
+	a80211_assoc_result = 0;
+	a80211_assoc_running = true;
+	if (kernel_thread_start(a80211_assoc_thread, NULL, &th) != KERN_SUCCESS) {
+		bzero(&a80211_assoc, sizeof(a80211_assoc));
+		a80211_assoc_running = false;
+		err = ENOMEM;
+		goto out;
+	}
+	thread_deallocate(th);
+out:
+	bzero(as, ASSOC_LEN);                   /* holds the key material */
+	kfree_data(as, ASSOC_LEN);
+	return err;
+}
