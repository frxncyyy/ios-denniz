-		n += sizeof(rsn_ie_psk_ccmp);
+	ie[n++] = e->channel;
+	if (e->sec & ROTTENAPPLE_WIFI_BSS_RSN) {
+		n += put_sec_ie(ie + n, true, e->akm_rsn, e->ciph_rsn, (e->sec & ROTTENAPPLE_WIFI_BSS_PMF_CAP) != 0,
+		    (e->sec & ROTTENAPPLE_WIFI_BSS_PMF_REQ) != 0);
+	}
+	if (e->sec & ROTTENAPPLE_WIFI_BSS_WPA) {
+		n += put_sec_ie(ie + n, false, e->akm_wpa, e->ciph_wpa, false, false);
 	}
 	put16(sr + 0x8a, (uint16_t)n);
 	return SR_HDR + n;
