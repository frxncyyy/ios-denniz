 	}
-	return EOPNOTSUPP;              /* read-only for now (no disassociate/associate/scan from userland) */
+	if (a80211_on < 2) {
+		return EOPNOTSUPP;      /* rottenapple_a80211=1: read-only */
+	}
+	switch (r->type) {
+	case A_SCAN_REQ:
+		return a80211_scan_req();
+	case A_ASSOCIATE:
+		return a80211_associate(r);
+	case A_DISASSOCIATE: {
+		struct rottenapple_wifi_link_info li;
+		rottenapple_wifi_sta_link_info(&li);
+		ALOG("disassociate requested by userland (%s)", li.associated ? "associated" : "not associated");
+		if (li.associated && !a80211_assoc_running) {
+			rottenapple_wifi_sta_disconnect();
+		}
+		return 0;
+	}
+	default:
+		return EOPNOTSUPP;
+	}
 }
 
