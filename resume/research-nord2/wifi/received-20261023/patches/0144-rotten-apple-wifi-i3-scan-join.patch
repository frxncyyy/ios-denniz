+int
+rottenapple_wifi_sta_join(const uint8_t *ssid, uint8_t ssid_len, const uint8_t *pmk)
+{
+	if (!sta_ready || ssid_len == 0 || ssid_len > 32) {
+		return EINVAL;
+	}
+	return sta_join_ex(&sta, ssid, ssid_len, pmk);
+}
+
+int
+rottenapple_wifi_sta_rejoin_last(void)
+{
+	uint8_t ssid[32], ssid_len, pmk[PMK_LEN];
+	bool have_pmk;
+	int err;
+
+	if (!sta_ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(sta.lock);
+	ssid_len = sta.reconnect_ssid_len;
+	memcpy(ssid, sta.reconnect_ssid, sizeof(ssid));
+	memcpy(pmk, sta.reconnect_pmk, PMK_LEN);
+	have_pmk = sta.reconnect_have_pmk;
+	lck_mtx_unlock(sta.lock);
+	if (ssid_len == 0) {
+		return ENOENT;
+	}
+	TLOG("rejoining the last network");
+	err = sta_join_ex(&sta, ssid, ssid_len, have_pmk ? pmk : NULL);
+	bzero(pmk, sizeof(pmk));
+	return err;
+}
+
+void
+rottenapple_wifi_sta_disconnect(void)
+{
+	if (!sta_ready) {
+		return;
+	}
+	lck_mtx_lock(sta.lock);
+	sta.want_reconnect = false;
+	bzero(sta.reconnect_pmk, PMK_LEN);
+	sta.reconnect_have_pmk = false;
+	sta_teardown_locked(&sta, true);
+	lck_mtx_unlock(sta.lock);
+}
