+static uint32_t
+put_sec_ie(uint8_t *ie, bool rsn, uint16_t akm, uint8_t ciph, bool pmf_cap, bool pmf_req)
+{
+	static const uint8_t oui_rsn[3] = { 0x00, 0x0f, 0xac }, oui_wpa[3] = { 0x00, 0x50, 0xf2 };
+	const uint8_t *oui = rsn ? oui_rsn : oui_wpa;
+	uint8_t akms[8], ciphs[4];
+	unsigned na = 0, nc = 0, n = 2;
