@@ -32,6 +32,7 @@ ROTTENAPPLE_BACKEND_SET(wifi, struct rottenapple_wifi_ops);
 #define WIFI_FW_DIR             "/usr/share/firmware/rottenapple/wifi"
 #define WIFI_FW_MAX             (4u << 20)
 #define WIFI_W1_CYCLES          2
+#define WIFI_MAX_LEVEL          3
 #define WIFI_PAGE               0x4000ull
 
 #define WLOG(fmt, ...)  printf("ROTTEN APPLE: wifi: " fmt "\n", ##__VA_ARGS__)
@@ -215,17 +216,64 @@ wifi_w1(struct rottenapple_wifi *w)
 	    passed, WIFI_W1_CYCLES);
