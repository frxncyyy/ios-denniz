+/*
+ * Rotten Apple: MediaTek CONNAC1 Wi-Fi host interface (WFDMA rings, init
+ * commands, RAM-code download, firmware start) for the CONNSYS backend
+ * (rottenapple_mtk_connsys.c). Milestone W2, docs/WIFI-PLAN.md "W2".
+ */
+#ifndef _BSD_DEV_ROTTENAPPLE_MTK_WFDMA_H_
+#define _BSD_DEV_ROTTENAPPLE_MTK_WFDMA_H_
+
+#include <dev/rottenapple_wifi.h>
+
+__BEGIN_DECLS
+
+struct mtk_wfdma_ring {
+	const char *name;
+	uint32_t hw;                    /* hardware ring number (register block) */
+	uint32_t ext;                   /* base-extension register index */
+	uint32_t count;                 /* descriptors */
+	uint32_t idx;                   /* TX: next CPU index; RX: last index handed back (CIDX) */
+	uintptr_t desc;                 /* 16-byte descriptors, write-combined */
+	uint64_t desc_pa;
+	uintptr_t buf;                  /* nbuf buffers of buf_size bytes */
+	uint64_t buf_pa;
+	uint32_t nbuf, buf_size;
+};
+
+struct mtk_wfdma {
+	/* filled by the caller before mtk_wfdma_wifi_on */
+	struct rottenapple_wifi *w;
+	uintptr_t conn;                 /* CONNSYS window (bus 0x18000000), mapped uncached */
+	uintptr_t emi;                  /* CONNSYS EMI carve-out (firmware view 0xF0000000) */
+	uint64_t emi_size;
+	uintptr_t pool;                 /* Wi-Fi DMA pool, write-combined */
+	uint64_t pool_pa, pool_size;
+	const char *ram_code;           /* WIFI_RAM_CODE file name in the firmware directory */
+
+	/* state */
+	uint8_t *fw;
+	size_t fw_size;
+	struct mtk_wfdma_ring tx_data0, tx_data1, tx_cmd, tx_fwdl, rx_data, rx_evt;
+	uint8_t seq;
+	uint32_t state;
+	volatile uint32_t irq_count, irq_sta;
+};
+
+/*
+ * W2 on a CONNSYS whose CPU sits in its ROM idle loop (W1 power_on done):
+ * driver ownership, WFDMA rings in the DMA pool, chip ID over ACCESS_REG,
+ * RAM-code download (WFDMA and EMI regions), WIFI_START, ready bits.
+ * level >= 3 also queries NIC_CAPABILITY_V2 (firmware version, MAC address).
+ * Every wait has a timeout; nothing panics. mtk_wfdma_wifi_off undoes it and
+ * is always called afterwards, also on failure.
+ */
+int mtk_wfdma_wifi_on(struct mtk_wfdma *d, unsigned level);
+void mtk_wfdma_wifi_off(struct mtk_wfdma *d);
+
+__END_DECLS
+
