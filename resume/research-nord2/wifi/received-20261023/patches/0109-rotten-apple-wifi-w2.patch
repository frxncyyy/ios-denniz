+/* ---- W2: Wi-Fi firmware over WFDMA (rottenapple_mtk_wfdma.c) ---- */
+
+static int
+connsys_wifi_on(struct rottenapple_wifi *w, unsigned level)
+{
+	struct connsys *c = w->priv;
+	struct mtk_wfdma *d = &c->wlan;
+	int err;
+
+	if (c->ram_code == NULL) {
+		CLOG("no mediatek,wifi-ram-code: W2 not possible");
+		return EINVAL;
+	}
+	if (!(c->state & ST_CPU)) {
+		CLOG("W2 needs the CONNSYS CPU at ROM idle");
+		return ENXIO;
+	}
+	if (c->pool == 0 &&
+	    (err = rottenapple_wifi_carveout(w, "mediatek,dma-pool", &c->pool_pa, &c->pool_size, &c->pool)) != 0) {
+		return err;
+	}
+	bzero(d, sizeof(*d));
+	d->w = w;
+	d->conn = c->conn;
+	d->emi = c->emi;
+	d->emi_size = c->emi_size;
+	d->pool = c->pool;
+	d->pool_pa = c->pool_pa;
+	d->pool_size = c->pool_size;
+	d->ram_code = c->ram_code;
+	return mtk_wfdma_wifi_on(d, level);
+}
+
+static void
+connsys_wifi_off(struct rottenapple_wifi *w)
+{
+	struct connsys *c = w->priv;
+
+	mtk_wfdma_wifi_off(&c->wlan);
+}
