+/*
+ * W2 (level 2) / W2 + first query (level 3): W1's power-up, then the Wi-Fi
+ * firmware up to "ready", then stop it and power down; WIFI_W1_CYCLES times.
+ */
+static void
+wifi_w2(struct rottenapple_wifi *w, unsigned level)
+{
+	unsigned passed = 0;
+
+	if (w->ops->power_on == NULL || w->ops->power_off == NULL || w->ops->wifi_on == NULL ||
+	    w->ops->wifi_off == NULL) {
+		WLOG("W2: backend has no power or Wi-Fi hooks");
+		return;
+	}
+	if (w->ops->report) {
+		w->ops->report(w);
+	}
+	for (unsigned cycle = 1; cycle <= WIFI_W1_CYCLES; cycle++) {
+		WLOG("W2 cycle %u/%u: powering up", cycle, WIFI_W1_CYCLES);
+		int err = w->ops->power_on(w);
+		if (err) {
+			WLOG("W2 cycle %u/%u: power-up FAILED (%d); powering down", cycle, WIFI_W1_CYCLES, err);
+		} else {
+			WLOG("W2 cycle %u/%u: chip CPU at its idle loop; starting the Wi-Fi firmware", cycle,
+			    WIFI_W1_CYCLES);
+			err = w->ops->wifi_on(w, level);
