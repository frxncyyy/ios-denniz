+++ b/bsd/dev/rottenapple_wifi.c
@@ -0,0 +1,248 @@
+/*
+ * Rotten Apple: Wi-Fi core (binding and milestones: rottenapple_wifi.h).
+ * Vendor-free: the chip glue is a ROTTENAPPLE_BACKEND(wifi, ...) backend.
+ *
+ * Firmware comes from the mounted root (rootfiles, patch 0103, installs it
+ * there from the ADT), so the milestones run on a kernel thread started
+ * right after the root fix-ups in bsd_init.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/proc.h>
+#include <sys/kauth.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <dev/rottenapple_wifi.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+extern boolean_t pmap_valid_address(uint64_t addr);     /* osfmk/arm/pmap/pmap.h */
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+
+ROTTENAPPLE_BACKEND_SET(wifi, struct rottenapple_wifi_ops);
+
+#define WIFI_NODE               "rotten-apple-wifi"
+#define WIFI_FW_DIR             "/usr/share/firmware/rottenapple/wifi"
+#define WIFI_FW_MAX             (4u << 20)
+#define WIFI_W1_CYCLES          2
+#define WIFI_PAGE               0x4000ull
+
+#define WLOG(fmt, ...)  printf("ROTTEN APPLE: wifi: " fmt "\n", ##__VA_ARGS__)
+
+static struct rottenapple_wifi rottenapple_wifi_dev;
+
+int
+rottenapple_wifi_reg_index(struct rottenapple_wifi *w, const char *name)
+{
+	int i = rottenapple_prop_string_index(w->node, "reg-names", name);
+	return i >= 0 && (unsigned)i < w->nregs && w->regs[i] != 0 ? i : -1;
+}
+
+/* ---- Firmware from the root file system ---- */
+
+int
+rottenapple_wifi_firmware_load(struct rottenapple_wifi *w, const char *name, uint8_t **data,
+    size_t *size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	const char *dir = rottenapple_prop_string(w->node, "firmware-dir", 0);
+	char path[MAXPATHLEN];
+	vnode_t vp = NULLVP;
+	off_t fsize = 0;
+	uint8_t *buf;
+	int err, resid = 0;
+
+	*data = NULL;
+	*size = 0;
+	if (name == NULL || name[0] == '\0' || strchr(name, '/') != NULL) {
+		return EINVAL;
+	}
+	if (snprintf(path, sizeof(path), "%s/%s", dir ? dir : WIFI_FW_DIR, name) >= (int)sizeof(path)) {
+		return ENAMETOOLONG;
+	}
+	if ((err = vnode_open(path, O_RDONLY, 0, 0, &vp, ctx)) != 0) {
+		WLOG("firmware %s: cannot open (%d)", path, err);
+		return err;
+	}
+	if ((err = vnode_size(vp, &fsize, ctx)) != 0 || fsize <= 0 || (uint64_t)fsize > WIFI_FW_MAX) {
+		WLOG("firmware %s: bad size %lld (%d)", path, (long long)fsize, err);
+		vnode_close(vp, 0, ctx);
+		return err ? err : EFBIG;
+	}
+	buf = (uint8_t *)kalloc_data((vm_size_t)fsize, Z_WAITOK);
+	if (buf == NULL) {
+		vnode_close(vp, 0, ctx);
+		return ENOMEM;
+	}
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)fsize, 0, UIO_SYSSPACE, IO_NOAUTH,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_close(vp, 0, ctx);
+	if (err == 0 && resid != 0) {
+		err = EIO;
+	}
+	if (err) {
+		WLOG("firmware %s: read failed (%d)", path, err);
+		kfree_data(buf, (vm_size_t)fsize);
+		return err;
+	}
+	*data = buf;
+	*size = (size_t)fsize;
+	WLOG("firmware %s: %lld bytes", path, (long long)fsize);
+	return 0;
+}
+
+void
+rottenapple_wifi_firmware_free(uint8_t *data, size_t size)
+{
+	if (data != NULL) {
+		kfree_data(data, (vm_size_t)size);
+	}
+}
+
+/* ---- Carve-outs ---- */
+
+int
+rottenapple_wifi_carveout(struct rottenapple_wifi *w, const char *prop, uint64_t *pa,
+    uint64_t *size, uintptr_t *va)
+{
+	uint64_t const *c;
+	unsigned int len;
+
+	if (SecureDTGetProperty(w->node, prop, (void const **)&c, &len) != kSuccess || len < 16 ||
+	    c[1] == 0 || (c[0] & (WIFI_PAGE - 1)) || (c[1] & (WIFI_PAGE - 1))) {
+		WLOG("%s: missing or not 16 KB aligned", prop);
+		return EINVAL;
+	}
+	*pa = c[0];
+	*size = c[1];
+	/* Firmware memory must never be RAM the kernel hands out. */
+	for (uint64_t p = c[0]; p < c[0] + c[1]; p += WIFI_PAGE) {
+		if (pmap_valid_address(p)) {
+			WLOG("%s: 0x%llx+0x%llx overlaps kernel-managed RAM at 0x%llx; refused",
+			    prop, c[0], c[1], p);
+			return EBUSY;
+		}
+	}
+	if (va != NULL) {
+		*va = ml_io_map_wcomb((vm_offset_t)c[0], (vm_size_t)c[1]);
+		if (*va == 0) {
+			WLOG("%s: cannot map 0x%llx+0x%llx", prop, c[0], c[1]);
+			return ENOMEM;
+		}
+	}
+	WLOG("%s: 0x%llx+0x%llx outside kernel RAM%s", prop, c[0], c[1], va ? ", mapped write-combined" : "");
+	return 0;
+}
+
+/* ---- Bring-up ---- */
+
+static int
+wifi_attach(struct rottenapple_wifi *w, const char *node_name)
+{
+	uint64_t const *reg = NULL;
+	unsigned int size = 0;
+	const char *compat;
+
+	bzero(w, sizeof(*w));
+	strlcpy(w->name, node_name, sizeof(w->name));
+	if (!rottenapple_node(node_name, &w->node)) {
+		WLOG("no ADT node %s; nothing to do", node_name);
+		return ENOENT;
+	}
+	w->ops = rottenapple_backend_find(w->node, ROTTENAPPLE_BACKEND_BEGIN(wifi),
+	    ROTTENAPPLE_BACKEND_END(wifi));
+	if (w->ops == NULL) {
+		compat = rottenapple_prop_string(w->node, "compatible", 0);
+		WLOG("no backend for \"%s\"", compat ? compat : "");
+		return ENXIO;
+	}
+	if (SecureDTGetProperty(w->node, "reg", (void const **)&reg, &size) == kSuccess) {
+		w->nregs = MIN(size / 16, ROTTENAPPLE_MAX_REGS);
+	}
+	for (unsigned i = 0; i < w->nregs; i++) {
+		w->reg_pa[i] = reg[2 * i];
+		w->reg_size[i] = reg[2 * i + 1];
+		w->regs[i] = ml_io_map((vm_offset_t)reg[2 * i], (vm_size_t)reg[2 * i + 1]);
+		if (w->regs[i] == 0) {
+			WLOG("cannot map reg %u (0x%llx+0x%llx)", i, w->reg_pa[i], w->reg_size[i]);
+			return ENOMEM;
+		}
+	}
+	WLOG("%s: backend \"%s\", %u reg ranges, %u power domains, %u clocks", node_name,
+	    w->ops->compatible, w->nregs, rottenapple_pd_count(node_name), rottenapple_clk_count(node_name));
+	int err = w->ops->probe ? w->ops->probe(w) : 0;
+	if (err) {
+		WLOG("backend probe failed (%d); hardware not touched", err);
+	}
+	return err;
+}
+
+/* W1: power-up, identify, firmware, CPU to idle, power-down; WIFI_W1_CYCLES times. */
+static void
+wifi_w1(struct rottenapple_wifi *w)
+{
+	unsigned passed = 0;
+
+	if (w->ops->power_on == NULL || w->ops->power_off == NULL) {
+		WLOG("W1: backend has no power hooks");
+		return;
+	}
+	if (w->ops->report) {
+		w->ops->report(w);
+	}
+	for (unsigned cycle = 1; cycle <= WIFI_W1_CYCLES; cycle++) {
+		WLOG("W1 cycle %u/%u: powering up", cycle, WIFI_W1_CYCLES);
+		int err = w->ops->power_on(w);
+		WLOG("W1 cycle %u/%u: %s (%d); powering down", cycle, WIFI_W1_CYCLES,
+		    err ? "power-up FAILED" : "chip CPU reached its idle loop", err);
+		w->ops->power_off(w);
+		if (w->ops->report) {
+			w->ops->report(w);
+		}
+		if (err) {
+			break;          /* a failed cycle is not repeated */
+		}
+		passed++;
+	}
+	WLOG("W1 result: %s (%u/%u cycles)", passed == WIFI_W1_CYCLES ? "PASSED" : "FAILED",
+	    passed, WIFI_W1_CYCLES);
+}
+
+static void
+rottenapple_wifi_thread(void *arg, __unused wait_result_t wr)
+{
+	unsigned level = (unsigned)(uintptr_t)arg;
+	struct rottenapple_wifi *w = &rottenapple_wifi_dev;
+
+	WLOG("milestone W%u (rottenapple_wifi=%u)", level, level);
+	if (wifi_attach(w, WIFI_NODE) != 0) {
+		return;
+	}
+	wifi_w1(w);
+}
+
+void
+rottenapple_wifi_start(void)
+{
+	uint32_t level = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("rottenapple_wifi", &level, sizeof(level)) || level == 0) {
+		return;                 /* default: Wi-Fi hardware is not touched */
+	}
+	if (level != 1) {
+		WLOG("rottenapple_wifi=%u unknown (1 = W1); hardware not touched", level);
+		return;
+	}
+	if (kernel_thread_start(rottenapple_wifi_thread, (void *)(uintptr_t)level, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/rottenapple_wifi.h
@@ -0,0 +1,90 @@
+/*
+ * Rotten Apple: Wi-Fi core. The core knows no chip: it finds the Wi-Fi
+ * node, maps its registers, hands out firmware files and carve-outs, and
+ * runs the bring-up milestones. Everything chip- or SoC-specific (power
+ * sequence, identity, firmware placement, CPU start) is a backend chosen by
+ * the node's compatible list and registered with
+ * ROTTENAPPLE_BACKEND(wifi, ops):
+ *
+ *   rotten-apple-wifi {
+ *       compatible = "<soc>-<block>", ...;
+ *       reg = <...>;  reg-names = "...", ...;      (mapped uncached by the core)
+ *       rotten-apple-interrupts = <...>;  interrupt-names = "...", ...;
+ *       power-domains, clocks, <supply>-supply, pinctrl-<state>   (used by the backend)
+ *       firmware-dir = "/usr/share/firmware/rottenapple/wifi";   (optional, the default)
+ *       <backend properties>
+ *   }
+ *
+ * The node is a consumer, not a provider: nothing powers it on first use.
+ *
+ * Milestones (boot-arg rottenapple_wifi; 0 or absent: nothing is touched):
+ *   1  W1: power up, identify, place the firmware, start the chip's CPU and
+ *      see it reach its idle loop, power down; twice. Runs on a kernel
+ *      thread after the root file system is mounted (firmware comes from
+ *      the root), never panics: any failure is logged and powers down.
+ */
+#ifndef _BSD_DEV_ROTTENAPPLE_WIFI_H_
+#define _BSD_DEV_ROTTENAPPLE_WIFI_H_
+
+#include <dev/rottenapple_provider.h>
+
+__BEGIN_DECLS
+
+struct rottenapple_wifi_ops;
+
+/* One Wi-Fi node. */
+struct rottenapple_wifi {
+	char name[32];                  /* ADT node name */
+	DTEntry node;
+	const struct rottenapple_wifi_ops *ops;
+	uintptr_t regs[ROTTENAPPLE_MAX_REGS];   /* "reg" ranges, mapped uncached (device) */
+	uint64_t reg_pa[ROTTENAPPLE_MAX_REGS];
+	uint64_t reg_size[ROTTENAPPLE_MAX_REGS];
+	unsigned nregs;
+	void *priv;                     /* backend state */
+};
+
+/*
+ * A Wi-Fi backend. All hooks run in thread context, unlocked, and may sleep.
+ * power_off is always called after power_on, also when power_on failed
+ * part way: the backend undoes exactly what it did, in reverse.
+ */
+struct rottenapple_wifi_ops {
+	const char *compatible;
+	/* Resolve the backend's own properties and providers; no hardware writes. */
+	int (*probe)(struct rottenapple_wifi *w);
+	/* Log state that is readable while the block is unpowered (reads only). */
+	void (*report)(struct rottenapple_wifi *w);
+	/* W1: power, identify, firmware into place, CPU to its idle loop. */
+	int (*power_on)(struct rottenapple_wifi *w);
+	void (*power_off)(struct rottenapple_wifi *w);
+};
+
+/* Index of the "reg-names" entry name, -1 if absent or unmapped. */
+int rottenapple_wifi_reg_index(struct rottenapple_wifi *w, const char *name);
+
+/*
+ * Read firmware file name (no '/') from the node's "firmware-dir" (default
+ * /usr/share/firmware/rottenapple/wifi) on the mounted root. *data is a
+ * kalloc_data buffer of *size bytes; free it with rottenapple_wifi_firmware_free.
+ * ENOENT, EFBIG (> 4 MB or empty), ENOMEM or a VFS error.
+ */
+int rottenapple_wifi_firmware_load(struct rottenapple_wifi *w, const char *name,
+    uint8_t **data, size_t *size);
+void rottenapple_wifi_firmware_free(uint8_t *data, size_t size);
+
+/*
+ * A firmware carve-out named by the u64 <pa size> property prop. Refused
+ * (EBUSY) when any page of it is kernel-managed RAM; mapped write-combined
+ * (normal non-cacheable: unaligned copies are fine, nothing to clean) when
+ * va is non-NULL. Mappings live for the kernel's lifetime.
+ */
+int rottenapple_wifi_carveout(struct rottenapple_wifi *w, const char *prop, uint64_t *pa,
+    uint64_t *size, uintptr_t *va);
+
+/* Start the milestone selected by boot-arg rottenapple_wifi (after the root is mounted). */
+void rottenapple_wifi_start(void);
+
+__END_DECLS
+
+#endif
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -954,7 +954,9 @@ bsd_init(void)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	{
 		extern void rottenapple_root_fixups(void);      /* bsd/dev/rottenapple_rootfix.c */
+		extern void rottenapple_wifi_start(void);       /* bsd/dev/rottenapple_wifi.c */
 		rottenapple_root_fixups();
+		rottenapple_wifi_start();                       /* boot-arg rottenapple_wifi=1 only */
 	}
 #endif
 
