+void
+rottenapple_wifi_sta_link_info(struct rottenapple_wifi_link_info *li)
+{
+	struct wifi_sta *s = &sta;
+
+	bzero(li, sizeof(*li));
+	li->rssi = ROTTENAPPLE_WIFI_RSSI_NONE;
+	if (!sta_ready) {
+		return;
