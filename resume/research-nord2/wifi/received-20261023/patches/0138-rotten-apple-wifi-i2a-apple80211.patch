 		ifnet_set_flags(s->ifp, 0, IFF_RUNNING);
 	}
 	rottenapple_netif_link(s->netif, up, up ? STA_LINK_BPS : 0);
+	rottenapple_wifi_a80211_link(up);
 	dlil_post_msg(s->ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
