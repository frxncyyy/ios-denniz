+sysctl_rottenapple_wifi SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	int value = wifi_state == WIFI_RUNNING ? WIFI_LEVEL_RUN : 0, changed = 0;
+	int err = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+
+	if (err || !changed) {
+		return err;
+	}
+	if (value == 0) {
+		err = rottenapple_wifi_stop();
+		return err == EALREADY ? 0 : err;
+	}
+	if (value == WIFI_LEVEL_RUN) {
+		return wifi_launch(WIFI_LEVEL_RUN);
+	}
+	return EINVAL;
+}
+SYSCTL_PROC(_kern, OID_AUTO, rottenapple_wifi, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_rottenapple_wifi, "I", "rotten-apple Wi-Fi: 5 = running; write 0 to stop, 5 to start");
