+int
+rottenapple_wifi_stop(void)
+{
+	struct rottenapple_wifi *w = &rottenapple_wifi_dev;
+
+	lck_mtx_lock(&wifi_state_lock);
+	if (wifi_state != WIFI_RUNNING) {
+		unsigned st = wifi_state;
+		lck_mtx_unlock(&wifi_state_lock);
+		WLOG("stop: nothing to stop (Wi-Fi is %s)", wifi_state_name[st]);
+		return st == WIFI_OFF ? EALREADY : EBUSY;
+	}
+	wifi_state = WIFI_STOPPING;
+	lck_mtx_unlock(&wifi_state_lock);
+
+	WLOG("stop: stopping Wi-Fi, powering down");
+	w->ops->wifi_off(w);
+	w->ops->power_off(w);
+	if (w->ops->report) {
+		w->ops->report(w);
+	}
+	wifi_set_state(WIFI_OFF);
+	WLOG("stop: Wi-Fi stopped and powered down");
+	return 0;
+}
