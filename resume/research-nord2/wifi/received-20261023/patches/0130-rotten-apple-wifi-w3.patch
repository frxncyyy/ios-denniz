+	lck_mtx_lock(&wifi_state_lock);
+	if (wifi_state != WIFI_OFF) {
+		unsigned st = wifi_state;
+		lck_mtx_unlock(&wifi_state_lock);
+		WLOG("start (level %u) refused: Wi-Fi is %s", level, wifi_state_name[st]);
+		return EBUSY;
+	}
+	wifi_state = WIFI_STARTING;
+	lck_mtx_unlock(&wifi_state_lock);
+	if (kernel_thread_start(rottenapple_wifi_thread, (void *)(uintptr_t)level, &thread) != KERN_SUCCESS) {
+		wifi_set_state(WIFI_OFF);
+		return ENOMEM;
+	}
+	thread_deallocate(thread);
+	return 0;
