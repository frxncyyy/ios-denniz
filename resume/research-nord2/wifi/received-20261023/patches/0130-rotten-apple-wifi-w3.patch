+/* ---- Unsolicited firmware events ---- */
+
+static void
+ev_debug_msg(__unused struct rottenapple_wifi *w, const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+	char text[129];
+
+	/* EVENT_DEBUG_MSG {u16 id, u8 type, u8 flags, u32 value, u16 size, 2 x 0, text} */
+	l->debug_msgs++;
+	if (ev->len < 12) {
+		return;
+	}
+	uint32_t n = MIN((uint32_t)le16(ev->body + 8), ev->len - 12);
+	printable(text, sizeof(text), ev->body + 12, n);
+	if (l->debug_msgs <= 64) {
+		LLOG("firmware debug message id 0x%04x type %u value 0x%08x: \"%s\"", le16(ev->body), ev->body[2],
+		    le32(ev->body + 4), text);
+	}
+}
+
+static void
+ev_assert(__unused struct rottenapple_wifi *w, const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+	char text[129];
+
+	l->asserts++;
+	printable(text, sizeof(text), ev->body, ev->len);
+	LLOG("FIRMWARE ASSERT DUMP event (%u bytes): \"%s\"", ev->len, text);
+}
+
+/* INIT_EVENT_CMD_RESULT {u8 status, u8 CID, 2 x 0}: gen4m "FW not support cmd" */
+static void
+ev_cmd_result(__unused struct rottenapple_wifi *w, const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	l->rejected++;
+	LLOG("firmware did not handle command 0x%02x (seq %u): status %u", ev->len >= 2 ? ev->body[1] : 0, ev->seq,
+	    ev->len >= 1 ? ev->body[0] : 0);
+}
