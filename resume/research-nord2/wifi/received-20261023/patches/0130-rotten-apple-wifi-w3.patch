+/* ---- Helpers ---- */
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static inline uint64_t
+le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | ((uint64_t)le32(p + 4) << 32);
+}
+
+static inline void
+put16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+}
+
+static inline void
+put32(uint8_t *p, uint32_t v)
+{
+	put16(p, (uint16_t)v);
+	put16(p + 2, (uint16_t)(v >> 16));
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static bool
+mac_valid(const uint8_t *m)
+{
+	static const uint8_t zero[6];
+	return memcmp(m, zero, 6) != 0 && !(m[0] & 1) && !(m[0] == 0xff && m[1] == 0xff);
+}
+
+static void
+printable(char *out, size_t outsz, const uint8_t *p, size_t len)
+{
+	size_t n = MIN(len, outsz - 1);
+	for (size_t i = 0; i < n; i++) {
+		out[i] = (p[i] >= 0x20 && p[i] < 0x7f) ? (char)p[i] : (p[i] == 0 ? ' ' : '.');
+	}
+	out[n] = '\0';
+}
+
+/* ---- Files: NVRAM, WIFI_CUSTOM, wifi.cfg ---- */
+
+static int
+load_path(const char *path, uint8_t **data, size_t *size)
+{
+	char dir[MAXPATHLEN];
+	const char *slash = path ? strrchr(path, '/') : NULL;
+
+	if (slash == NULL || slash == path || slash[1] == '\0' || (size_t)(slash - path) >= sizeof(dir)) {
+		return EINVAL;
+	}
+	memcpy(dir, path, (size_t)(slash - path));
+	dir[slash - path] = '\0';
+	return rottenapple_firmware_load(dir, slash + 1, 64 * 1024, data, size);
+}
+
+/*
+ * The tag area after offset 256. The device's file (NVRAM version 0x0102,
+ * peer 0x0003) holds tags {id, length, data} with a one-byte length here:
+ * ids 0..0xc follow each other at 0x100, 0x105, 0x139, 0x181, 0x236, ...
+ * (gen4m's own WIFI_NVRAM_TAG_FORMAT has a 16-bit length; it only walks
+ * the tags on chips with is_support_nvram_fragment, not soc2_1x1, which
+ * gets the 2048 bytes as they are). Logged for information only [I].
+ */
+static void
+nvram_tags_log(const uint8_t *nv)
+{
+	char line[160];
+	size_t n = 0;
+	uint32_t off = NV_TAGS;
+	unsigned count = 0;
+
+	line[0] = '\0';
+	while (off + 2 <= MTK_WLAN_NVRAM_SIZE && count < 32) {
+		uint8_t id = nv[off], len = nv[off + 1];
+		if (id == 0 && len == 0 && count > 0) {
+			break;
+		}
+		if (off + 2 + len > MTK_WLAN_NVRAM_SIZE) {
+			break;
+		}
+		n += (size_t)snprintf(line + n, sizeof(line) - n, "%s%u@0x%x+%u", count ? " " : "", id, off, len);
+		if (n >= sizeof(line) - 16) {
+			LLOG("NVRAM tags (id@offset+length): %s", line);
+			n = 0;
+			line[0] = '\0';
+		}
+		off += 2 + len;
+		count++;
+	}
+	if (n) {
+		LLOG("NVRAM tags (id@offset+length): %s", line);
+	}
+	LLOG("NVRAM tag area: %u tags, ends at 0x%x", count, off);
+}
+
+static void
+cfg_parse(struct mtk_wlan *l, const uint8_t *buf, size_t size)
+{
+	size_t i = 0;
+
+	while (i < size && l->ncfg < MTK_WLAN_CFG_MAX) {
+		size_t end = i;
+		while (end < size && buf[end] != '\n' && buf[end] != '\r') {
+			end++;
+		}
+		/* "key value" / "key=value", '#' comments, surrounding blanks ignored */
+		size_t k = i;
+		while (k < end && (buf[k] == ' ' || buf[k] == '\t')) {
+			k++;
+		}
+		size_t ke = k;
+		while (ke < end && buf[ke] != ' ' && buf[ke] != '\t' && buf[ke] != '=' && buf[ke] != '#') {
+			ke++;
+		}
+		size_t v = ke;
+		while (v < end && (buf[v] == ' ' || buf[v] == '\t' || buf[v] == '=')) {
+			v++;
+		}
+		size_t ve = v;
+		while (ve < end && buf[ve] != '#') {
+			ve++;
+		}
+		while (ve > v && (buf[ve - 1] == ' ' || buf[ve - 1] == '\t')) {
+			ve--;
+		}
+		if (ke > k && buf[k] != '#') {
+			if (ke - k > MTK_WLAN_CFG_STR || ve - v > MTK_WLAN_CFG_STR) {
+				LLOG("wifi.cfg: entry at +%zu longer than %u characters: skipped (gen4m skips it too)", i,
+				    MTK_WLAN_CFG_STR);
+			} else {
+				memcpy(l->cfg_key[l->ncfg], buf + k, ke - k);
+				l->cfg_key[l->ncfg][ke - k] = '\0';
+				memcpy(l->cfg_val[l->ncfg], buf + v, ve - v);
+				l->cfg_val[l->ncfg][ve - v] = '\0';
+				l->ncfg++;
+			}
+		}
+		i = end + 1;
+	}
+}
+
+int
+mtk_wlan_prepare(struct mtk_wlan *l)
+{
+	uint8_t *data = NULL;
+	size_t size = 0;
+	int err;
+
+	l->prepared = false;
+	l->ncfg = 0;
+	if (l->nvram_path == NULL) {
+		LLOG("no mediatek,nvram in the ADT: W3 needs the NVRAM (MAC address, TX power)");
+		return EINVAL;
+	}
+	if ((err = load_path(l->nvram_path, &data, &size)) != 0) {
+		LLOG("NVRAM %s: not loaded (%d); rootfiles installs it from research/wifi/nvram", l->nvram_path, err);
+		return err;
+	}
+	if (size < MTK_WLAN_NVRAM_SIZE) {
+		LLOG("NVRAM: %zu bytes, need %u (WIFI_CFG_PARAM_STRUCT)", size, MTK_WLAN_NVRAM_SIZE);
+		rottenapple_firmware_free(data, size);
+		return EINVAL;
+	}
+	memcpy(l->nvram, data, MTK_WLAN_NVRAM_SIZE);
+	const uint8_t *nv = l->nvram;
+	/* gen4m glLoadNvram: version, MAC, country code (as two characters), 5 GHz */
+	LLOG("NVRAM: %zu bytes (%u sent to the firmware%s), version own 0x%04x peer 0x%04x (gen4m log \"NVRAM Version = "
+	    "[00000102,00000003]\")", size, MTK_WLAN_NVRAM_SIZE, size > MTK_WLAN_NVRAM_SIZE ? ", the rest is the nvdata trailer" : "",
+	    le16(nv + NV_OWN_VER), le16(nv + NV_PEER_VER));
+	LLOG("NVRAM: MAC %02x:%02x:%02x:%02x:%02x:%02x (%s), country code 0x%02x%02x%s, 5 GHz support %u enable %u, "
+	    "channel list map %u index %u", nv[NV_MAC], nv[NV_MAC + 1], nv[NV_MAC + 2], nv[NV_MAC + 3], nv[NV_MAC + 4],
+	    nv[NV_MAC + 5], mac_valid(nv + NV_MAC) ? "valid" : "NOT valid", nv[NV_COUNTRY], nv[NV_COUNTRY + 1],
+	    (nv[NV_COUNTRY] | nv[NV_COUNTRY + 1]) ? "" : " (none: default regulatory domain)", nv[NV_SUPPORT_5G],
+	    nv[NV_ENABLE_5G], nv[NV_REG_MAP], nv[NV_REG_INDEX]);
+	if (size >= MTK_WLAN_NVRAM_SIZE + 2) {
+		LLOG("NVRAM: trailer after byte 2048: %02x %02x (nvdata checksum; not sent)", data[MTK_WLAN_NVRAM_SIZE],
+		    data[MTK_WLAN_NVRAM_SIZE + 1]);
+	}
+	if (le16(nv + NV_OWN_VER) != 0x0102) {
+		LLOG("NVRAM: own version 0x%04x, expected 0x0102 (layout read from the device file); sent anyway, as gen4m does",
+		    le16(nv + NV_OWN_VER));
+	}
+	nvram_tags_log(nv);
+	/* wlanLoadManufactureData: u2CountryCode = cc[0] << 8 | cc[1] */
+	l->country = (uint16_t)((nv[NV_COUNTRY] << 8) | nv[NV_COUNTRY + 1]);
+	rottenapple_firmware_free(data, size);
+
+	/* WIFI_CUSTOM: gen4m only names it (platform.c WIFI_NVRAM_CUSTOM_NAME); logged */
+	if (l->custom_path && load_path(l->custom_path, &data, &size) == 0) {
+		LLOG("WIFI_CUSTOM: %zu bytes: %02x %02x %02x %02x %02x %02x%s (not used by gen4m)", size, size > 0 ? data[0] : 0,
+		    size > 1 ? data[1] : 0, size > 2 ? data[2] : 0, size > 3 ? data[3] : 0, size > 4 ? data[4] : 0,
+		    size > 5 ? data[5] : 0, size > 6 ? " ..." : "");
+		rottenapple_firmware_free(data, size);
+	}
+
+	/* wifi.cfg: built-in default "AdapScan 0x0" first (wlanLoadDefaultCustomerSetting), then the file */
+	strlcpy(l->cfg_key[0], "AdapScan", sizeof(l->cfg_key[0]));
+	strlcpy(l->cfg_val[0], "0x0", sizeof(l->cfg_val[0]));
+	l->ncfg = 1;
+	if (l->cfg_name && rottenapple_wifi_firmware_load(l->w, l->cfg_name, &data, &size) == 0) {
+		cfg_parse(l, data, size);
+		rottenapple_firmware_free(data, size);
+		for (unsigned i = 1; i < l->ncfg; i++) {
+			LLOG("wifi.cfg: %s = %s", l->cfg_key[i], l->cfg_val[i]);
+		}
+	} else if (l->cfg_name) {
+		LLOG("wifi.cfg not loaded: only the built-in default goes to the firmware");
+	}
+	l->prepared = true;
+	return 0;
+}
+
+/* ---- Commands through the generic API ---- */
+
+static int
+wl_set(struct mtk_wlan *l, uint8_t id, const void *payload, uint32_t len, const char *what)
+{
+	int err = rottenapple_wifi_cmd(l->w, id, true, payload, len, ROTTENAPPLE_WIFI_NO_EVENT, NULL, 0, NULL, 0);
+	LLOG("cmd 0x%02x %s: %u bytes%s", id, what, len, err ? " NOT SENT" : " sent");
+	return err;
+}
+
+static int
+wl_query(struct mtk_wlan *l, uint8_t id, const void *payload, uint32_t len, uint8_t eid, void *resp, uint32_t size,
+    uint32_t *rlen)
+{
+	return rottenapple_wifi_cmd(l->w, id, false, payload, len, eid, resp, size, rlen, QUERY_TIMEOUT_MS);
+}
+
+/* CMD_ACCESS_REG {u32 address, u32 data} query -> EVENT_ACCESS_REG {address, data} (wlanoidQueryMcrRead) */
+static int
+wl_reg_read(struct mtk_wlan *l, uint32_t addr, uint32_t *val)
+{
+	uint8_t cmd[8] = { 0 }, ev[8];
+	uint32_t rlen = 0;
+	int err;
+
+	put32(cmd, addr);
+	if ((err = wl_query(l, CMD_ID_ACCESS_REG, cmd, sizeof(cmd), EVENT_ID_ACCESS_REG, ev, sizeof(ev), &rlen)) != 0) {
+		return err;
+	}
+	if (rlen < 8 || le32(ev) != addr) {
+		LLOG("ACCESS_REG 0x%08x: answer for 0x%08x (%u bytes)", addr, rlen >= 4 ? le32(ev) : 0, rlen);
+		return EIO;
+	}
+	*val = le32(ev + 4);
+	return 0;
+}
+
+/*
+ * CMD_ID_GET_SET_CUSTOMER_CFG with CMD_HEADER {u32 version CMD_VER_1, u32
+ * type SET, u8 item count, pad, u16 buffer length, 4 x CMD_FORMAT_V1}, the
+ * format of connsysFwLogControl and wlanFeatureToFw.
+ */
+static int
+wl_customer_cfg(struct mtk_wlan *l, const char *const *keys, const char *const *vals, unsigned n, const char *what)
+{
+	uint8_t cmd[CUSTOMER_CFG_LEN];
+	int err = 0;
+
+	for (unsigned base = 0; base < n && err == 0; base += CUSTOMER_CFG_ITEMS) {
+		unsigned items = MIN(n - base, CUSTOMER_CFG_ITEMS);
+		bzero(cmd, sizeof(cmd));
+		put32(cmd + 0, CMD_VER_1);
+		put32(cmd + 4, CMD_TYPE_SET);
+		cmd[8] = (uint8_t)items;
+		put16(cmd + 10, (uint16_t)(items * CUSTOMER_CFG_ITEM_LEN));
+		for (unsigned i = 0; i < items; i++) {
+			uint8_t *it = cmd + 12 + i * CUSTOMER_CFG_ITEM_LEN;
+			size_t kl = strnlen(keys[base + i], MTK_WLAN_CFG_STR), vl = strnlen(vals[base + i], MTK_WLAN_CFG_STR);
+			it[0] = ITEM_TYPE_STR;
+			it[1] = (uint8_t)kl;
+			it[2] = (uint8_t)vl;
+			memcpy(it + 4, keys[base + i], kl);
+			memcpy(it + 4 + MTK_WLAN_CFG_STR, vals[base + i], vl);
+			LLOG("  %s item %u: \"%s\" = \"%s\"", what, base + i, keys[base + i], vals[base + i]);
+		}
+		err = wl_set(l, CMD_ID_GET_SET_CUSTOMER_CFG, cmd, sizeof(cmd), what);
+	}
+	return err;
+}
+
+/* CMD_BASIC_CONFIG {native 802.11, assert path, debug level, 0, u16 RX csum, u16 TX csum, segment, 3 x 0} */
+static int
+wl_basic_config(struct mtk_wlan *l)
+{
+	uint8_t cmd[BASIC_CONFIG_LEN] = { 0 };
+
+	/*
+	 * gen4m: native 802.11 0, assert path DBG_ASSERT_PATH_WIFI (0), level
+	 * DBG_ASSERT_CTRL_LEVEL_ERROR (0); checksum offload bits only with
+	 * CFG_TCP_IP_CHKSUM_OFFLOAD and fgIsSupportCsumOffload. Off here: the
+	 * W5 data path computes checksums in software until it handles the
+	 * RX descriptor checksum status.
+	 */
+	LLOG("BASIC_CONFIG: native 802.11 0, assert path Wi-Fi, assert level error, checksum offload off "
+	    "(firmware %s it)", l->d->csum_offload ? "supports" : "does not report");
+	return wl_set(l, CMD_ID_BASIC_CONFIG, cmd, sizeof(cmd), "BASIC_CONFIG");
+}
+
+/*
+ * CMD_SET_DOMAIN_INFO {u16 country, u16 is-passive, 6 x CMD_SUBBAND_INFO
+ * {reg class, band, channel span, first channel, channel count, 3 x 0},
+ * u8 2.4 GHz bandwidth, u8 5 GHz bandwidth, 2 x 0}. rlmDomainSendCmd with
+ * no country (the NVRAM has none): rlmDomainSendPassiveScanInfoCmd with
+ * arSupportedRegDomains_Passive[1] (the default: passive on 52-64 and
+ * 100-144), then rlmDomainSendDomainInfoCmd with the last entry of
+ * arSupportedRegDomains (the default group). Bandwidth modes
+ * CONFIG_BW_20_40M for both bands (aisFsmInit with Sta2gBw = 40 MHz).
+ */
+static void
+domain_fill(uint8_t *cmd, uint16_t country, bool passive, const uint8_t sub[SUBBANDS][5])
+{
+	bzero(cmd, DOMAIN_INFO_LEN);
+	put16(cmd + 0, country);
+	put16(cmd + 2, passive ? 1 : 0);
+	for (unsigned i = 0; i < SUBBANDS; i++) {
+		uint8_t *s = cmd + 4 + 8 * i;
+		s[0] = sub[i][0];
+		s[1] = sub[i][1];
+		if (sub[i][1] != 0) {           /* BAND_NULL: only class and band are copied */
+			s[2] = sub[i][2];
+			s[3] = sub[i][3];
+			s[4] = sub[i][4];
+		}
+	}
+	cmd[4 + 8 * SUBBANDS] = CONFIG_BW_20_40M;
+	cmd[5 + 8 * SUBBANDS] = CONFIG_BW_20_40M;
+}
+
+static int
+wl_domain(struct mtk_wlan *l)
+{
+	static const uint8_t passive[SUBBANDS][5] = {
+		{ 81, BAND_2G4, CHNL_SPAN_5, 1, 0 }, { 82, BAND_2G4, CHNL_SPAN_5, 14, 0 },
+		{ 115, BAND_5G, CHNL_SPAN_20, 36, 0 }, { 118, BAND_5G, CHNL_SPAN_20, 52, 4 },
+		{ 121, BAND_5G, CHNL_SPAN_20, 100, 12 }, { 125, BAND_5G, CHNL_SPAN_20, 149, 0 },
+	};
+	static const uint8_t active[SUBBANDS][5] = {
+		{ 81, BAND_2G4, CHNL_SPAN_5, 1, 13 }, { 115, BAND_5G, CHNL_SPAN_20, 36, 4 },
+		{ 118, BAND_5G, CHNL_SPAN_20, 52, 4 }, { 121, BAND_5G, CHNL_SPAN_20, 100, 12 },
+		{ 125, BAND_5G, CHNL_SPAN_20, 149, 5 }, { 0, 0, 0, 0, 0 },
+	};
+	uint8_t cmd[DOMAIN_INFO_LEN];
+	int err;
+
+	if (l->country != 0) {
+		/* gen4m would look the country up in its tables; we only carry the default group */
+		LLOG("NVRAM country code 0x%04x: not in our tables, the default regulatory domain is used", l->country);
+	}
+	LLOG("regulatory domain: default group (gen4m: \"No matched country code, use the default regulatory "
+	    "domain\"): 2.4 GHz 1-13, 5 GHz 36-48, 52-64 (DFS), 100-144 (DFS), 149-165; passive scan on 52-64, 100-144");
+	domain_fill(cmd, l->country, true, passive);
+	if ((err = wl_set(l, CMD_ID_SET_DOMAIN_INFO, cmd, sizeof(cmd), "SET_DOMAIN_INFO (passive channels)")) != 0) {
+		return err;
+	}
+	domain_fill(cmd, l->country, false, active);
+	return wl_set(l, CMD_ID_SET_DOMAIN_INFO, cmd, sizeof(cmd), "SET_DOMAIN_INFO (channels)");
+}
+
+/*
+ * CMD_SET_COUNTRY_CHANNEL_POWER_LIMIT {u16 country, u8 flag, u8 count, u8
+ * keep table, u8 band index, u8 limit type, u8 version 1, entries}, 1472
+ * bytes. Without a country, rlmDomainPwrLimitDefaultTableDecision picks
+ * the {0, 0} entry of g_rRlmPowerLimitDefault: 63 for every sub-band, unit
+ * dBm, so rlmDomainBuildCmdByDefaultTable writes 63 (MAX_TX_POWER, no
+ * limit) into all 9 values of each of the 61 channels (1-14, 36-50, 52-64,
+ * 100-144, 149-165, the even ones in 5 GHz); the configuration table has no
+ * {0, 0} rows. The second command (PWR_LIMIT_TYPE_COMP_ANT_V2, keep table)
+ * carries no entries: txpowerctrl.cfg is absent and no SAR scenario is on.
+ */
+static int
+wl_power_limits(struct mtk_wlan *l, const char *when)
+{
+	static const struct {
+		uint8_t first, last, step;
+	} sub[] = { { 1, 14, 1 }, { 36, 50, 2 }, { 52, 64, 2 }, { 100, 144, 2 }, { 149, 165, 2 } };
+	uint8_t *cmd = kalloc_data(PWR_LIMIT_LEN, Z_WAITOK | Z_ZERO);
+	char what[64];
+	unsigned n = 0;
+	int err;
+
+	if (cmd == NULL) {
+		return ENOMEM;
+	}
+	put16(cmd + 0, 0);                      /* country of the default table entry */
+	cmd[6] = PWR_LIMIT_TYPE_11AC;
+	cmd[7] = 1;
+	for (unsigned s = 0; s < ROTTENAPPLE_COUNT(sub); s++) {
+		for (unsigned ch = sub[s].first; ch <= sub[s].last && n < PWR_LIMIT_CHANNELS; ch += sub[s].step, n++) {
+			uint8_t *e = cmd + PWR_LIMIT_HDR + n * PWR_LIMIT_ENTRY;
+			e[0] = (uint8_t)ch;
+			memset(e + 1, MAX_TX_POWER, PWR_LIMIT_VALUES);
+		}
+	}
+	cmd[3] = (uint8_t)n;
+	snprintf(what, sizeof(what), "SET_COUNTRY_POWER_LIMIT (%s, %u channels at %u)", when, n, MAX_TX_POWER);
+	err = wl_set(l, CMD_ID_SET_COUNTRY_POWER_LIMIT, cmd, PWR_LIMIT_LEN, what);
+	if (err == 0) {
+		bzero(cmd, PWR_LIMIT_LEN);
+		cmd[4] = 1;                     /* fgPwrTblKeep */
+		cmd[6] = PWR_LIMIT_TYPE_ANT_V2;
+		cmd[7] = 1;
+		snprintf(what, sizeof(what), "SET_COUNTRY_POWER_LIMIT (%s, antenna, no entries)", when);
+		err = wl_set(l, CMD_ID_SET_COUNTRY_POWER_LIMIT, cmd, PWR_LIMIT_LEN, what);
+	}
+	kfree_data(cmd, PWR_LIMIT_LEN);
+	return err;
+}
+
+/* CMD_BSS_ACTIVATE_CTRL {BSS index, active, network type, own MAC index, MAC[6], BMC WLAN index, 0} */
+static int
+wl_bss_activate(struct mtk_wlan *l, bool on)
+{
+	uint8_t cmd[12] = { 0 };
+
+	cmd[0] = AIS_BSS_INDEX;
+	cmd[1] = on ? 1 : 0;
+	cmd[2] = NETWORK_TYPE_AIS;
+	cmd[3] = AIS_OWN_MAC_INDEX;
+	if (on) {
+		memcpy(cmd + 4, l->mac, 6);     /* nicDeactivateNetwork leaves the address 0 */
+	}
+	cmd[10] = l->bmc_idx;
+	int err = wl_set(l, CMD_ID_BSS_ACTIVATE_CTRL, cmd, sizeof(cmd), on ? "BSS_ACTIVATE_CTRL (AIS on)" :
+	    "BSS_ACTIVATE_CTRL (AIS off)");
+	if (err == 0) {
+		l->bss_active = on;
+	}
+	return err;
+}
+
+/* Read the RMAC words; false when a read fails (stops early). */
+static bool
+rmac_read(struct mtk_wlan *l, uint32_t *w)
+{
+	for (unsigned i = 0; i < RMAC_WORDS; i++) {
+		int err = wl_reg_read(l, RMAC_BASE + 4 * i, &w[i]);
+		if (err) {
+			LLOG("RMAC 0x%08x: read failed (%d)", RMAC_BASE + 4 * i, err);
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * Words of the RMAC block that hold the MAC: MAC[0..3] little-endian with
+ * MAC[4..5] in the low half of the next word (the CONNAC own-MAC register
+ * pair layout [I]), or any word equal to four consecutive MAC bytes.
+ */
+static unsigned
+rmac_find(struct mtk_wlan *l, const uint32_t *w, char *out, size_t outsz)
+{
+	const uint8_t *m = l->mac;
+	uint32_t lo = le32(m), hi = le16(m + 4), mid = le32(m + 2);
+	unsigned found = 0;
+	size_t n = 0;
+
+	out[0] = '\0';
+	for (unsigned i = 0; i < RMAC_WORDS && n < outsz - 48; i++) {
+		if (w[i] == lo && i + 1 < RMAC_WORDS && (w[i + 1] & 0xffff) == hi) {
+			n += (size_t)snprintf(out + n, outsz - n, " 0x%08x/0x%08x = %08x %08x (address pair)",
+			    RMAC_BASE + 4 * i, RMAC_BASE + 4 * i + 4, w[i], w[i + 1]);
+			found++;
+		} else if (w[i] == mid || w[i] == __builtin_bswap32(lo) || w[i] == __builtin_bswap32(mid)) {
+			n += (size_t)snprintf(out + n, outsz - n, " 0x%08x = %08x (4 address bytes)", RMAC_BASE + 4 * i, w[i]);
+			found++;
+		}
+	}
+	return found;
+}
+
+/*
+ * The MAC address. gen4m (wlanUpdateNetworkAddress): the host-supplied
+ * address (the NVRAM's) when it is valid, else the efuse one, else a
+ * generated 00:08:22:xx:xx:xx; nicApplyNetworkAddress keeps it host side.
+ * It reaches the firmware with the AIS network activation (CMD 0x11). The
+ * readback: the RMAC block before and after the activation, through the
+ * firmware's own register access (CMD 0xC0).
+ */
+static int
+wl_mac(struct mtk_wlan *l)
+{
+	uint32_t before[RMAC_WORDS], after[RMAC_WORDS];
+	char found[256];
+	int err;
+
+	if (mac_valid(l->nvram + NV_MAC)) {
+		memcpy(l->mac, l->nvram + NV_MAC, 6);
+		l->mac_source = "NVRAM";
+	} else if (mac_valid(l->d->efuse_mac)) {
+		memcpy(l->mac, l->d->efuse_mac, 6);
+		l->mac_source = "efuse";
+	} else {
+		uint32_t t = (uint32_t)now_us();
+		l->mac[0] = 0x00;
+		l->mac[1] = 0x08;
+		l->mac[2] = 0x22;
+		l->mac[3] = (uint8_t)t;
+		l->mac[4] = (uint8_t)(t >> 8);
+		l->mac[5] = (uint8_t)(t >> 16);
+		l->mac_source = "generated (no valid NVRAM or efuse address)";
+	}
+	LLOG("MAC address %02x:%02x:%02x:%02x:%02x:%02x from the %s (efuse %02x:%02x:%02x:%02x:%02x:%02x); gen4m: \"Using "
+	    "host-supplied MAC address\"", l->mac[0], l->mac[1], l->mac[2], l->mac[3], l->mac[4], l->mac[5], l->mac_source,
+	    l->d->efuse_mac[0], l->d->efuse_mac[1], l->d->efuse_mac[2], l->d->efuse_mac[3], l->d->efuse_mac[4],
+	    l->d->efuse_mac[5]);
+
+	l->bmc_idx = BMC_WLAN_INDEX_FIRST;
+	if (l->d->wtbl_entries && l->bmc_idx >= l->d->wtbl_entries) {
+		LLOG("only %u WTBL entries: no broadcast entry for the AIS network", l->d->wtbl_entries);
+		return EINVAL;
+	}
+	bool have_before = rmac_read(l, before);
+	if (have_before && rmac_find(l, before, found, sizeof(found))) {
+		LLOG("MAC already in RMAC before the activation:%s", found);
+	}
+	LLOG("AIS network on: BSS %u, own MAC index %u, broadcast WLAN index %u (gen4m nicActivateNetwork)", AIS_BSS_INDEX,
+	    AIS_OWN_MAC_INDEX, l->bmc_idx);
+	if ((err = wl_bss_activate(l, true)) != 0) {
+		return err;
+	}
+	if (!rmac_read(l, after)) {
+		LLOG("MAC readback: RMAC not readable; the address is set (activation sent) but not proven");
+	} else if (rmac_find(l, after, found, sizeof(found))) {
+		LLOG("MAC readback: PASSED, %02x:%02x:%02x:%02x:%02x:%02x is in the RMAC own-address registers:%s", l->mac[0],
+		    l->mac[1], l->mac[2], l->mac[3], l->mac[4], l->mac[5], found);
+	} else {
+		LLOG("MAC readback: address NOT found in RMAC 0x%08x-0x%08x (the own-MAC register offset is our guess [I]); "
+		    "words changed by the activation:", RMAC_BASE, RMAC_BASE + 4 * RMAC_WORDS - 4);
+	}
+	if (have_before) {
+		unsigned changed = 0;
+		for (unsigned i = 0; i < RMAC_WORDS && changed < 8; i++) {
+			if (before[i] != after[i]) {
+				LLOG("  RMAC 0x%08x: 0x%08x -> 0x%08x", RMAC_BASE + 4 * i, before[i], after[i]);
+				changed++;
+			}
+		}
+		if (changed == 0) {
+			LLOG("  RMAC: no word changed with the activation");
+		}
+	}
+	/* back to gen4m's idle state (AIS deactivated); W4 activates it around each scan */
+	return wl_bss_activate(l, false);
+}
+
+/* EVENT_STATISTICS: 14 x u64 counters, then u32 HW MAC awake duration (wsys_cmd_handler_fw.h) */
+static int
+wl_statistics(struct mtk_wlan *l)
+{
+	uint8_t q[STATISTICS_QUERY_LEN] = { 0 }, *ev;
+	uint32_t rlen = 0;
+	int err;
+
+	ev = kalloc_data(MTK_WFDMA_EVT_BUF, Z_WAITOK | Z_ZERO);
+	if (ev == NULL) {
+		return ENOMEM;
+	}
+	err = wl_query(l, CMD_ID_GET_STATISTICS, q, sizeof(q), EVENT_ID_STATISTICS, ev, MTK_WFDMA_EVT_BUF, &rlen);
+	if (err == 0 && rlen >= 116) {
+		LLOG("statistics (%u bytes): TX fragments %llu, multicast TX %llu, failed %llu, retries %llu, multiple "
+		    "retries %llu, RTS ok %llu / failed %llu, ACK failures %llu, duplicates %llu", rlen, le64(ev),
+		    le64(ev + 8), le64(ev + 16), le64(ev + 24), le64(ev + 32), le64(ev + 40), le64(ev + 48), le64(ev + 56),
+		    le64(ev + 64));
+		LLOG("statistics: RX fragments %llu, multicast RX %llu, FCS errors %llu, MDRDY %llu, channel idle %llu, HW "
+		    "MAC awake %u", le64(ev + 72), le64(ev + 80), le64(ev + 88), le64(ev + 96), le64(ev + 104), le32(ev + 112));
+	} else if (err == 0) {
+		LLOG("statistics: short event (%u bytes)", rlen);
+		err = EIO;
+	}
+	kfree_data(ev, MTK_WFDMA_EVT_BUF);
+	return err;
+}
