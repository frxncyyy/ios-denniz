+	bzero(h, sizeof(*h));
+	h->ready = ready(d, &h->misc);
+	h->pc = rd(d, HIF_ON_DBGCR01);
+	h->com_reg0 = rd(d, MCU_COM_REG0);
+	h->mcu2host = rd(d, PDMA_MCU2HOST_SW_STA);
+	h->int_sta = rd(d, PDMA_INT_STA);
+	if (d->emi_size >= COREDUMP_EMI_OFF + COREDUMP_EMI_SIZE) {
+		uintptr_t log = d->emi + FWLOG_EMI_OFF, cd = d->emi + COREDUMP_EMI_OFF;
+		for (unsigned i = 0; i < ROTTENAPPLE_COUNT(fwlog_rings); i++) {
