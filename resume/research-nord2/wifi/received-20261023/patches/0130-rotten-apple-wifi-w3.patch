+
+static int
+rx_next(struct mtk_wfdma *d, struct mtk_wfdma_ring *r, uint8_t *out, uint32_t size, uint32_t *len)
+{
+	if (!(d->state & ST_DMA)) {
+		return ENXIO;
+	}
+	int err = rx_poll(d, r, out, size, len, 0);
+	return err == ETIMEDOUT ? EAGAIN : err;
+}
+
+int
+mtk_wfdma_rx_event(struct mtk_wfdma *d, uint8_t *out, uint32_t size, uint32_t *len)
+{
+	return rx_next(d, &d->rx_evt, out, size, len);
+}
+
+int
+mtk_wfdma_rx_data(struct mtk_wfdma *d, uint8_t *out, uint32_t size, uint32_t *len)
+{
+	return rx_next(d, &d->rx_data, out, size, len);
+}
+
+#define INT_W3_MASK     (INT_RX_DONE(0) | INT_RX_DONE(1) | INT_MCU2HOST_SW)
+
+void
+mtk_wfdma_irq_attach(struct mtk_wfdma *d, void (*wake)(void *), void *arg)
+{
+	wr(d, PDMA_INT_MSK, 0);
+	d->irq_wake_arg = arg;
+	d->irq_wake = wake;
+	wr(d, HIF_ON_IRQ_ENA, 1);
+	wr(d, PDMA_INT_STA, rd(d, PDMA_INT_STA));       /* write 1 to clear (kalDevReadIntStatus) */
+	wr(d, PDMA_INT_MSK, INT_W3_MASK);
+	DLOG("SPI 409 drives the event path: INT_MSK 0x%08x (RX done 0/1, MCU software interrupt), %s", rd(d, PDMA_INT_MSK),
+	    (d->state & ST_IRQ) ? "handler installed" : "NO handler (polling only)");
+}
+
+void
+mtk_wfdma_irq_detach(struct mtk_wfdma *d)
+{
+	if (d->state & ST_DMA) {
+		wr(d, PDMA_INT_MSK, 0);
+	}
+	d->irq_wake = NULL;
+	d->irq_wake_arg = NULL;
+}
+
+uint32_t
+mtk_wfdma_irq_ack(struct mtk_wfdma *d, uint32_t *mcu_sw)
+{
+	uint32_t sta = rd(d, PDMA_INT_STA);
+
+	*mcu_sw = 0;
+	if (sta) {
+		wr(d, PDMA_INT_STA, sta);
+	}
+	if (sta & INT_MCU2HOST_SW) {
+		*mcu_sw = rd(d, PDMA_MCU2HOST_SW_STA);
+		if (*mcu_sw) {
+			wr(d, PDMA_MCU2HOST_SW_STA, *mcu_sw);
+		}
+	}
+	return sta;
+}
+
+void
+mtk_wfdma_irq_unmask(struct mtk_wfdma *d)
+{
+	if ((d->state & ST_DMA) && d->irq_wake) {
+		wr(d, PDMA_INT_MSK, INT_W3_MASK);
+	}
+}
