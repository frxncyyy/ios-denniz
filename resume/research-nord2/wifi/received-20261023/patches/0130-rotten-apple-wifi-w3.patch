+/* ---- Command/event API ---- */
+
+int
+rottenapple_wifi_cmd(struct rottenapple_wifi *w, uint8_t id, bool set, const void *payload, uint32_t len,
+    int resp_event, void *resp, uint32_t resp_size, uint32_t *resp_len, unsigned timeout_ms)
+{
+	uint8_t seq = 0;
+	uint64_t deadline;
+	int err;
+
+	if (w == NULL || w->ops == NULL || w->ops->cmd_send == NULL || resp_event > 0xff ||
+	    (resp != NULL && resp_size == 0)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&wifi_cmd_lock);
+	lck_mtx_lock(&wifi_ev_lock);
+	if (resp_event >= 0) {
+		wifi_waiter.active = true;
+		wifi_waiter.done = false;
+		wifi_waiter.id = (uint8_t)resp_event;
+		wifi_waiter.seq = 0;            /* matches nothing until the sequence number is known */
+		wifi_waiter.buf = resp;
+		wifi_waiter.size = resp ? resp_size : 0;
+		wifi_waiter.len = 0;
+	}
+	/* ev_lock held: the receive thread cannot deliver the answer before seq is set */
+	err = w->ops->cmd_send(w, id, set, payload, len, &seq);
+	wifi_waiter.seq = seq;
+	if (err || resp_event < 0) {
+		wifi_waiter.active = false;
+		lck_mtx_unlock(&wifi_ev_lock);
+		lck_mtx_unlock(&wifi_cmd_lock);
+		if (err) {
+			WLOG("command 0x%02x (%s, %u bytes): not sent (%d)", id, set ? "set" : "query", len, err);
+		}
+		return err;
+	}
+	clock_interval_to_deadline(timeout_ms, NSEC_PER_MSEC, &deadline);
+	while (!wifi_waiter.done && mach_absolute_time() < deadline) {
+		/* drops ev_lock while asleep; rottenapple_wifi_event_input wakes &wifi_waiter */
+		(void)lck_mtx_sleep_deadline(&wifi_ev_lock, LCK_SLEEP_DEFAULT, (event_t)&wifi_waiter, THREAD_UNINT,
+		    deadline);
+	}
+	err = !wifi_waiter.done ? ETIMEDOUT : wifi_waiter.got_id != (uint8_t)resp_event ? EBADMSG : 0;
+	uint8_t got = wifi_waiter.got_id;
+	if (resp_len) {
+		*resp_len = wifi_waiter.len;
+	}
+	wifi_waiter.active = false;
+	lck_mtx_unlock(&wifi_ev_lock);
+	lck_mtx_unlock(&wifi_cmd_lock);
+	if (err == ETIMEDOUT) {
+		WLOG("command 0x%02x (%s, seq %u): no event 0x%02x within %u ms", id, set ? "set" : "query", seq,
+		    resp_event, timeout_ms);
+	} else if (err) {
+		/* MediaTek: 0xFD = INIT_EVENT_CMD_RESULT, the firmware does not handle the command */
+		WLOG("command 0x%02x (%s, seq %u): answered by event 0x%02x, expected 0x%02x", id, set ? "set" : "query",
+		    seq, got, resp_event);
+	}
+	return err;
+}
+
+int
+rottenapple_wifi_event_register(struct rottenapple_wifi *w, uint8_t id, rottenapple_wifi_event_fn fn, void *arg)
+{
+	int err = ENOSPC;
+
+	if (w == NULL || fn == NULL) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&wifi_ev_lock);
+	for (unsigned i = 0; i < WIFI_MAX_HANDLERS; i++) {
+		if (wifi_handlers[i].fn == fn && wifi_handlers[i].id == id && wifi_handlers[i].arg == arg) {
+			err = EEXIST;
+			break;
+		}
+	}
+	for (unsigned i = 0; err == ENOSPC && i < WIFI_MAX_HANDLERS; i++) {
+		if (wifi_handlers[i].fn == NULL) {
+			wifi_handlers[i].id = id;
+			wifi_handlers[i].arg = arg;
+			wifi_handlers[i].fn = fn;
+			err = 0;
+		}
+	}
+	lck_mtx_unlock(&wifi_ev_lock);
+	return err;
+}
+
+void
+rottenapple_wifi_event_unregister(struct rottenapple_wifi *w, uint8_t id, rottenapple_wifi_event_fn fn, void *arg)
+{
+	if (w == NULL) {
+		return;
+	}
+	lck_mtx_lock(&wifi_ev_lock);
+	for (unsigned i = 0; i < WIFI_MAX_HANDLERS; i++) {
+		if (wifi_handlers[i].fn == fn && wifi_handlers[i].id == id && wifi_handlers[i].arg == arg) {
+			wifi_handlers[i].fn = NULL;
+		}
+	}
+	lck_mtx_unlock(&wifi_ev_lock);
+}
+
+void
+rottenapple_wifi_event_input(struct rottenapple_wifi *w, uint8_t id, uint8_t seq, const uint8_t *body,
+    uint32_t len)
+{
+	struct rottenapple_wifi_event ev = { .id = id, .seq = seq, .len = len, .body = body };
+	struct {
+		rottenapple_wifi_event_fn fn;
+		void *arg;
+	} call[WIFI_MAX_HANDLERS];
+	unsigned n = 0;
+	bool answered = false;
+
+	lck_mtx_lock(&wifi_ev_lock);
+	/* matched by sequence number alone, as gen4m's nicGetPendingCmdInfo; the caller checks the id */
+	if (wifi_waiter.active && !wifi_waiter.done && wifi_waiter.seq != 0 && wifi_waiter.seq == seq) {
+		if (wifi_waiter.buf) {
+			memcpy(wifi_waiter.buf, body, MIN(len, wifi_waiter.size));
+		}
+		wifi_waiter.got_id = id;
+		wifi_waiter.len = len;
+		wifi_waiter.done = true;
+		answered = true;
+		thread_wakeup((event_t)&wifi_waiter);
+	}
+	for (unsigned i = 0; i < WIFI_MAX_HANDLERS; i++) {
+		if (wifi_handlers[i].fn != NULL && wifi_handlers[i].id == id) {
+			call[n].fn = wifi_handlers[i].fn;
+			call[n].arg = wifi_handlers[i].arg;
+			n++;
+		}
+	}
+	lck_mtx_unlock(&wifi_ev_lock);
+	for (unsigned i = 0; i < n; i++) {
+		call[i].fn(w, &ev, call[i].arg);
+	}
+	if (!answered && n == 0) {
+		wifi_unhandled++;
+		if (wifi_unhandled <= 32) {
+			WLOG("event 0x%02x seq %u (%u bytes): no waiter, no handler%s", id, seq, len,
+			    wifi_unhandled == 32 ? " (further unhandled events are not logged)" : "");
+		}
 	}
 }
