+
+static void
+wl_rx_events(struct mtk_wlan *l)
+{
+	for (unsigned k = 0; k < RX_BURST; k++) {
+		uint32_t len = 0;
+		int err = mtk_wfdma_rx_event(l->d, l->rxbuf, MTK_WFDMA_EVT_BUF, &len);
+		if (err) {
+			if (err != EAGAIN) {
+				LLOG("RX ring 1: error %d", err);
+			}
+			return;
+		}
+		uint16_t type = (uint16_t)(le32(l->rxbuf) >> 16);
+		if (len < MTK_WFDMA_EVT_BODY || (type & RX_PKT_TYPE_SW_MASK) != RX_PKT_TYPE_SW_EVENT) {
+			if (l->rx_other++ < 16) {
+				LLOG("RX ring 1: %u-byte packet of type 0x%04x (not an event): %08x %08x %08x %08x", len, type,
+				    le32(l->rxbuf), le32(l->rxbuf + 4), le32(l->rxbuf + 8), le32(l->rxbuf + 12));
+			}
+			continue;
+		}
+		l->events++;
+		rottenapple_wifi_event_input(l->w, l->rxbuf[MTK_WFDMA_EVT_EID], l->rxbuf[MTK_WFDMA_EVT_SEQ],
+		    l->rxbuf + MTK_WFDMA_EVT_BODY, len - MTK_WFDMA_EVT_BODY);
+	}
+}
+
+static void
+wl_rx_data(struct mtk_wlan *l)
+{
+	for (unsigned k = 0; k < RX_BURST; k++) {
+		uint32_t len = 0;
+		int err = mtk_wfdma_rx_data(l->d, l->databuf, MTK_WFDMA_EVT_BUF, &len);
+		if (err) {
+			if (err != EAGAIN) {
+				LLOG("RX ring 0: error %d", err);
+			}
+			return;
+		}
+		/* nothing consumes data frames before W4/W5: count them, show the first descriptors */
+		if (l->data_pkts++ < 8) {
+			LLOG("RX ring 0: %u-byte packet, RXD %08x %08x %08x %08x (dropped: no data path yet)", len,
+			    le32(l->databuf), le32(l->databuf + 4), le32(l->databuf + 8), le32(l->databuf + 12));
+		}
+	}
+}
+
+static void
+wl_health_log(struct mtk_wlan *l, const char *why, const struct mtk_wfdma_health *h)
+{
+	LLOG("%s: CONN_ON_MISC 0x%08x (%s), PC 0x%08x, COM_REG0 0x%08x, MCU2HOST 0x%08x, INT_STA 0x%08x; log rings "
+	    "0x%x/0x%x/0x%x/0x%x; coredump %u pages; IRQs %u, events %u, data packets %u, debug messages %u, asserts %u",
+	    why, h->misc, h->ready ? "ready" : "NOT READY", h->pc, h->com_reg0, h->mcu2host, h->int_sta, h->log_w[0],
+	    h->log_w[1], h->log_w[2], h->log_w[3], h->coredump_pages, l->irqs, l->events, l->data_pkts, l->debug_msgs,
+	    l->asserts);
+}
+
+/*
+ * Is the firmware alive: ready bits, MCU error interrupt, coredump area,
+ * log rings (new text is printed). Returns false once it is gone.
+ */
+static bool
+wl_health(struct mtk_wlan *l, const char *why)
+{
+	struct mtk_wfdma_health h;
+
+	mtk_wfdma_health(l->d, &h);
+	if (memcmp(h.log_w, l->h_last.log_w, sizeof(h.log_w)) != 0) {
+		mtk_wfdma_fwlog_new(l->d, l->h_last.log_w, h.log_w, 20);
+	}
+	if (h.coredump_pages != l->h_last.coredump_pages && !l->coredump_logged) {
+		LLOG("coredump area: %u -> %u pages written: the firmware dumped state (assert?)", l->h_last.coredump_pages,
+		    h.coredump_pages);
+		mtk_connsys_fwlog_dump(l->d->emi, l->d->emi_size, "coredump", true);
+		l->coredump_logged = true;
+	}
+	if (!h.ready && !l->fw_dead) {
+		l->fw_dead = true;
+		wl_health_log(l, "FIRMWARE NO LONGER READY", &h);
+		mtk_connsys_fwlog_dump(l->d->emi, l->d->emi_size, "firmware down", true);
+	} else if (why) {
+		wl_health_log(l, why, &h);
+	}
+	l->h_last = h;
+	return !l->fw_dead;
+}
+
+static void
+wl_thread(void *arg, __unused wait_result_t wr)
+{
+	struct mtk_wlan *l = arg;
+
+	l->running = true;
+	LLOG("receive thread running (SPI 409 + %u ms backup poll)", POLL_MS);
+	while (!l->stop) {
+		uint32_t mcu_sw = 0;
+		(void)assert_wait_timeout((event_t)(uintptr_t)&l->wake_pending, THREAD_UNINT, POLL_MS, NSEC_PER_MSEC);
+		if (l->wake_pending || l->stop) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		}
+		if (l->wake_pending) {
+			l->irqs++;
+		} else {
+			l->polls++;
+		}
+		l->wake_pending = 0;
+		if (l->stop) {
+			break;
+		}
+		uint32_t sta = mtk_wfdma_irq_ack(l->d, &mcu_sw);
+		if (mcu_sw) {
+			l->mcu_sw++;
+			LLOG("MCU software interrupt: MCU2HOST_SW_STA 0x%08x (INT_STA 0x%08x)%s", mcu_sw, sta,
+			    (mcu_sw & 0x3c) ? ": error/recovery bits (SER)" : "");
+		}
+		wl_rx_events(l);
+		wl_rx_data(l);
+		mtk_wfdma_irq_unmask(l->d);
+		if (l->wmt) {
+			mtk_wmt_poll(l->wmt);
+		}
+		uint64_t t = now_us();
+		if (t >= l->next_health) {
+			const char *beat = NULL;
+			if (t >= l->next_beat) {
+				/* 10 s, then every minute for 10 minutes, then every 30 minutes */
+				beat = "alive";
+				l->beats++;
+				l->next_beat = t + (l->beats < 11 ? 60 : 1800) * 1000000ull;
+			}
+			(void)wl_health(l, beat);
+			l->next_health = t + HEALTH_US;
+		}
+	}
+	LLOG("receive thread stopped (IRQs %u, polls %u, events %u, data packets %u)", l->irqs, l->polls, l->events,
+	    l->data_pkts);
+	l->running = false;
+	l->exited = true;
+	thread_wakeup((event_t)(uintptr_t)&l->exited);
+}
+
+static int
+wl_thread_start(struct mtk_wlan *l)
+{
+	thread_t thread;
+
+	l->stop = false;
+	l->exited = false;
+	l->wake_pending = 0;
+	l->t_start = now_us();
+	l->next_health = l->t_start + HEALTH_US;
+	l->next_beat = l->t_start + 10 * 1000000ull;
+	if (kernel_thread_start(wl_thread, l, &thread) != KERN_SUCCESS) {
+		LLOG("receive thread: cannot start");
+		return ENOMEM;
+	}
+	thread_deallocate(thread);
+	l->thread_started = true;
+	for (uint64_t t0 = now_us(); !l->running && now_us() - t0 < THREAD_EXIT_TIMEOUT_US;) {
+		delay(1000);
+	}
+	return 0;
+}
+
+static void
+wl_thread_stop(struct mtk_wlan *l)
+{
+	if (!l->thread_started || l->exited) {
+		return;
+	}
+	l->stop = true;
+	thread_wakeup((event_t)(uintptr_t)&l->wake_pending);
+	uint64_t t0 = now_us();
+	while (!l->exited && now_us() - t0 < THREAD_EXIT_TIMEOUT_US) {
+		delay(2000);
+	}
+	if (!l->exited) {
+		LLOG("receive thread did not stop within %llu ms", THREAD_EXIT_TIMEOUT_US / 1000);
+	}
+}
+
+/* ---- W3 ---- */
+
+int
+mtk_wlan_start(struct mtk_wlan *l)
+{
+	static const char *const dbglog_key[] = { "EnableDbgLog" };
+	const char *dbglog_val[1];
+	const char *keys[MTK_WLAN_CFG_MAX], *vals[MTK_WLAN_CFG_MAX];
+	uint32_t fwlog = 0, hw = 0, fw = 0;
+	int err;
+
+	if (!l->prepared) {
+		return EINVAL;
+	}
+	l->started = true;
+	l->rxbuf = kalloc_data(MTK_WFDMA_EVT_BUF, Z_WAITOK | Z_ZERO);
+	l->databuf = kalloc_data(MTK_WFDMA_EVT_BUF, Z_WAITOK | Z_ZERO);
+	if (l->rxbuf == NULL || l->databuf == NULL) {
+		return ENOMEM;
+	}
+	mtk_wfdma_health(l->d, &l->h_last);
+	wl_health_log(l, "W3 start", &l->h_last);
+	(void)rottenapple_wifi_event_register(l->w, EVENT_ID_DEBUG_MSG, ev_debug_msg, l);
+	(void)rottenapple_wifi_event_register(l->w, EVENT_ID_ASSERT_DUMP, ev_assert, l);
+	(void)rottenapple_wifi_event_register(l->w, EVENT_ID_CMD_RESULT, ev_cmd_result, l);
+
+	/* Event path: the receive thread on SPI 409 (polling backs it up) */
+	if ((err = wl_thread_start(l)) != 0) {
+		return err;
+	}
+	mtk_wfdma_irq_attach(l->d, wl_wake, l);
+
+	/* connsysFwLogControl: "EnableDbgLog" 0 on Android unless a log reader runs; boot-arg rottenapple_wifi_fwlog=1 */
+	(void)PE_parse_boot_argn("rottenapple_wifi_fwlog", &fwlog, sizeof(fwlog));
+	dbglog_val[0] = fwlog ? "1" : "0";
+	if ((err = wl_customer_cfg(l, dbglog_key, dbglog_val, 1, "firmware log switch")) != 0) {
+		return err;
+	}
+	if ((err = wl_basic_config(l)) != 0) {
+		return err;
+	}
+	/* wlanLoadManufactureData + txPwrCtrlLoadConfig, in gen4m's order */
+	if ((err = wl_domain(l)) != 0 || (err = wl_power_limits(l, "regulatory")) != 0) {
+		return err;
+	}
+	LLOG("NVRAM to the firmware: %u bytes (SET_NVRAM_SETTINGS, whole WIFI_CFG_PARAM_STRUCT: soc2_1x1 has no NVRAM "
+	    "fragments)", MTK_WLAN_NVRAM_SIZE);
+	if ((err = wl_set(l, CMD_ID_SET_NVRAM_SETTINGS, l->nvram, MTK_WLAN_NVRAM_SIZE, "SET_NVRAM_SETTINGS")) != 0) {
+		return err;
+	}
+	if ((err = wl_power_limits(l, "after NVRAM, txPwrCtrlLoadConfig")) != 0) {
+		return err;
+	}
+	/* wlanFeatureToFw(WLAN_CFG_DEFAULT): the built-in default and the wifi.cfg entries, 4 per command */
+	for (unsigned i = 0; i < l->ncfg; i++) {
+		keys[i] = l->cfg_key[i];
+		vals[i] = l->cfg_val[i];
+	}
+	if ((err = wl_customer_cfg(l, keys, vals, l->ncfg, "wifi.cfg")) != 0) {
+		return err;
+	}
+
+	/* Sync point and chip info: the firmware answers register queries after all the sets above */
+	if ((err = wl_reg_read(l, CHIP_TOP_HVR, &hw)) != 0 || (err = wl_reg_read(l, CHIP_TOP_FVR, &fw)) != 0) {
+		LLOG("ACCESS_REG query failed (%d): the firmware does not answer normal commands", err);
+		(void)wl_health(l, "after the configuration");
+		return err;
+	}
+	LLOG("configuration accepted (the register query after it was answered); chip: TOP_HVR 0x%08x TOP_FVR 0x%08x "
+	    "(expect 0x8a00/0x8a00), firmware %u.%u build %u branch \"%s\" date \"%s\", efuse %u bytes", hw, fw,
+	    l->d->fw_ver >> 8, l->d->fw_ver & 0xff, l->d->fw_build, l->d->fw_branch, l->d->fw_date, l->d->efuse_size);
+
+	if ((err = wl_mac(l)) != 0) {
+		return err;
+	}
+	if ((err = wl_statistics(l)) != 0) {
+		LLOG("statistics query failed (%d); not fatal", err);
+	}
+	/* settle, then the verdict: still ready, no assert, nothing new in the coredump area */
+	delay(500000);
+	if (!wl_health(l, "W3 done")) {
+		return EIO;
+	}
+	if (l->asserts) {
+		LLOG("the firmware sent %u assert dump event(s)", l->asserts);
+		return EIO;
+	}
+	LLOG("W3: Wi-Fi configured and running: MAC from the %s, events by interrupt (%u IRQs so far, %u polls), %u "
+	    "command(s) not handled by the firmware", l->mac_source, l->irqs, l->polls, l->rejected);
+	return 0;
+}
+
+void
+mtk_wlan_stop(struct mtk_wlan *l)
+{
+	struct mtk_wfdma_health h;
+
+	if (!l->started) {
+		return;
+	}
+	LLOG("stopping Wi-Fi (gen4m halHifPowerOffWifi order)");
+	if (l->running && !l->fw_dead) {
+		if (l->bss_active) {
+			(void)wl_bss_activate(l, false);
+		}
+		/* CMD_NIC_POWER_CTRL {power mode 1 = off, 3 x 0} (wlanSendNicPowerCtrlCmd(TRUE)) */
+		uint8_t cmd[4] = { 1, 0, 0, 0 };
+		if (wl_set(l, CMD_ID_NIC_POWER_CTRL, cmd, sizeof(cmd), "NIC_POWER_CTRL (Wi-Fi off)") == 0) {
+			uint64_t t0 = now_us();
+			do {
+				delay(5000);
+				mtk_wfdma_health(l->d, &h);
+			} while (h.ready && now_us() - t0 < OFF_TIMEOUT_US);
+			LLOG("Wi-Fi power off %s: CONN_ON_MISC 0x%08x after %llu ms (gen4m wlanCheckWifiFunc(FALSE))",
+			    h.ready ? "NOT acknowledged" : "done", h.misc, (now_us() - t0) / 1000);
+		}
+	}
+	mtk_wfdma_irq_detach(l->d);
+	wl_thread_stop(l);
+	rottenapple_wifi_event_unregister(l->w, EVENT_ID_DEBUG_MSG, ev_debug_msg, l);
+	rottenapple_wifi_event_unregister(l->w, EVENT_ID_ASSERT_DUMP, ev_assert, l);
+	rottenapple_wifi_event_unregister(l->w, EVENT_ID_CMD_RESULT, ev_cmd_result, l);
+	mtk_wfdma_health(l->d, &h);
+	wl_health_log(l, "stopped", &h);
+	l->started = false;
+	l->bss_active = false;
+}
+
+void
+mtk_wlan_release(struct mtk_wlan *l)
+{
+	if (l->rxbuf) {
+		kfree_data(l->rxbuf, MTK_WFDMA_EVT_BUF);
+		l->rxbuf = NULL;
+	}
+	if (l->databuf) {
+		kfree_data(l->databuf, MTK_WFDMA_EVT_BUF);
+		l->databuf = NULL;
+	}
+}
