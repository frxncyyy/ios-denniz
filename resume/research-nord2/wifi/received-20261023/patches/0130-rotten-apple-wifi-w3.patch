+/* ---- Receive thread ---- */
+
+static void
+wl_wake(void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	l->wake_pending = 1;
+	thread_wakeup((event_t)(uintptr_t)&l->wake_pending);
