--- /dev/null
+++ b/bsd/dev/rottenapple_mtk_wmt.h
@@ -0,0 +1,84 @@
+/*
+ * Rotten Apple: MediaTek CONNSYS "WMT" software init over BTIF/STP for the
+ * CONNSYS backend (rottenapple_mtk_connsys.c). Milestone W2b,
+ * docs/WIFI-PLAN.md "W2b".
+ *
+ * The AP talks to the CONNSYS CPU's ROM over BTIF, an on-chip UART-like
+ * link (AP side at 0x1100c000, CONNSYS side at 0x180a2000), in MediaTek's
+ * STP framing. The ROM's WMT task takes commands {0x01, opcode, u16
+ * length, body} and answers with events {0x02, opcode, u16 length, body}.
+ * Android's WMT stack runs a fixed script there between ROM idle and the
+ * Wi-Fi driver; the important part is the RF calibration.
+ */
+#ifndef _BSD_DEV_ROTTENAPPLE_MTK_WMT_H_
+#define _BSD_DEV_ROTTENAPPLE_MTK_WMT_H_
+
+#include <dev/rottenapple_wifi.h>
+
+__BEGIN_DECLS
+
+#define MTK_WMT_RX_MAX          2048    /* largest STP payload (Linux: 2048 in full mode) */
+#define MTK_WMT_TRACE           64      /* last bytes kept per direction for the failure dump */
+#define MTK_WMT_CMD_MAX         256     /* largest WMT command we send */
+
+struct mtk_wmt {
+	/* filled by the caller before mtk_wmt_on */
+	uintptr_t conn;                 /* CONNSYS window (bus 0x18000000), mapped uncached */
+	uintptr_t btif;                 /* AP-side BTIF (0x1100c000) */
+	uintptr_t conn_btif;            /* CONNSYS-side BTIF (0x180a2000) */
+	struct rottenapple_clk *clk;    /* BTIF clock gate ("btifc") */
+	uint32_t chip_id;               /* SoC id for SET_CHIP_ID (0x6789) */
+	uint32_t adie;                  /* expected RF chip (0x6631) */
+	uintptr_t emi;                  /* CONNSYS EMI (for the calibration backup check) */
+	uint64_t emi_size;
+
+	/* state */
+	uint32_t state;
+	unsigned mode;                  /* STP: 0 off, 1 mandatory, 2 full */
+	uint8_t txseq, txack, rxack, rxseq;     /* full mode sequence numbers */
+	/* receive parser */
+	unsigned pstate;
+	uint8_t hdr[4];
+	uint8_t ptype, pseq, pack;
+	uint16_t plen, pcount;
+	uint16_t pcrc;
+	uint8_t rx[MTK_WMT_RX_MAX + 4];
+	/* the event being waited for */
+	uint8_t want_op;
+	bool got;
+	uint8_t evt[MTK_WMT_RX_MAX];
+	uint16_t evt_len;
+	/* the last frame sent (full mode: kept for a retransmission until acked) */
+	uint8_t out[MTK_WMT_CMD_MAX];
+	uint16_t out_len;
+	uint8_t out_type, out_seq;
+	bool out_pending;               /* sent in full mode, no ACK yet */
+	bool in_tx, ack_due;            /* an ACK to send once the current frame is out */
+	bool wak_held;                  /* BTIF WAK held low (ap_wakeup_consys asserted) */
+	bool wak_end_high;              /* level WAK is left at after a pulse (default low) */
+	uint32_t wak_pulses;
+	uint32_t rto_resets, double_sends;      /* CONNSYS RX-timeout re-arms, frames sent twice */
+	/* statistics and trace for the dumps */
+	uint32_t rx_bytes, tx_bytes, rx_frames, tx_frames, acks_rx, acks_tx;
+	uint32_t hdr_errs, crc_errs, seq_errs, junk, overruns, fw_msgs;
+	uint8_t rx_trace[MTK_WMT_TRACE], tx_trace[MTK_WMT_TRACE];
+	uint32_t rx_trace_n, tx_trace_n;
+	uint64_t cal_us;                /* RF calibration time, 0 if not done */
+};
+
+/*
+ * With the CONNSYS CPU at ROM idle (W1 power_on done): BTIF on (clock,
+ * FIFOs, PIO), STP in mandatory mode, chip ID reads, the switch to STP full
+ * mode, then the WMT init script of Android's mtk_wcn_soc_sw_init for
+ * MT6789 + MT6631 (chip ID, a-die, coexistence and antenna settings, RF
+ * calibration, ...). Every command and event is logged as hex. Every wait
+ * has a timeout; a failure dumps the BTIF and STP state and returns an
+ * errno. mtk_wmt_off is always called afterwards (also on failure), before
+ * the CONNSYS power-off.
+ */
+int mtk_wmt_on(struct mtk_wmt *m);
+void mtk_wmt_off(struct mtk_wmt *m);
+
+__END_DECLS
+
+#endif
