diff --git a/bsd/dev/rottenapple_wifi_sta.c b/bsd/dev/rottenapple_wifi_sta.c
index d098038..351aee3 100644
--- a/bsd/dev/rottenapple_wifi_sta.c
+++ b/bsd/dev/rottenapple_wifi_sta.c
@@ -1012,10 +1012,35 @@ rottenapple_wifi_sta_stop(struct rottenapple_wifi *w)
 int
 rottenapple_wifi_sta_join(const uint8_t *ssid, uint8_t ssid_len, const uint8_t *pmk)
 {
+	bool differs = false;
+	int err;
+
 	if (!sta_ready || ssid_len == 0 || ssid_len > 32) {
 		return EINVAL;
 	}
-	return sta_join_ex(&sta, ssid, ssid_len, pmk);
+	if (pmk != NULL) {
+		/*
+		 * Diagnostic and fallback: compare the PMK userland derived (from
+		 * the password typed in Settings or its keychain) with the one from
+		 * the passphrase file. Only "matches"/"differs" is ever logged.
+		 */
+		uint8_t psk[PSK_MAX], fpmk[PMK_LEN];
+		size_t psk_len = 0;
+		if (psk_load(psk, &psk_len) == 0) {
+			ra_pbkdf2_sha1(psk, psk_len, ssid, ssid_len, 4096, fpmk, PMK_LEN);
+			differs = memcmp(fpmk, pmk, PMK_LEN) != 0;
+			TLOG("join: the userland PMK %s the passphrase file's", differs ? "DIFFERS from" : "matches");
+		}
+		bzero(psk, sizeof(psk));
+		bzero(fpmk, sizeof(fpmk));
+	}
+	err = sta_join_ex(&sta, ssid, ssid_len, pmk);
+	if (err != 0 && differs) {
+		/* a wrong password typed in Settings must not keep the phone offline */
+		TLOG("join with the userland PMK failed (%d); retrying with the passphrase file", err);
+		err = sta_join_ex(&sta, ssid, ssid_len, NULL);
+	}
+	return err;
 }
 
