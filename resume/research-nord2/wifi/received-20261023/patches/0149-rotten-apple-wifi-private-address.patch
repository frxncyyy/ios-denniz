index 37d74b9..ed22529 100644
--- a/bsd/dev/rottenapple_mtk_wlan.c
+++ b/bsd/dev/rottenapple_mtk_wlan.c
@@ -2510,6 +2510,37 @@ mtk_wlan_scan(struct mtk_wlan *l, unsigned mode)
 	return err;
 }
 
+/*
+ * Own address for the next association (private Wi-Fi addresses). The
+ * firmware takes the own address from BSS_ACTIVATE_CTRL (gen4m
+ * nicActivateNetwork: aucOwnMacAddr into the RMAC own-address slot), host
+ * frames take it from w->mac; re-activate the AIS network so the new
+ * address is in the firmware before the join. The address is never logged.
+ */
+int
+mtk_wlan_set_mac(struct mtk_wlan *l, const uint8_t *mac)
+{
+	if (!l->started || !l->running || l->fw_dead) {
+		return ENXIO;
+	}
+	if (l->connected || l->join_active) {
+		return EBUSY;
+	}
+	if (memcmp(l->mac, mac, 6) == 0) {
+		return 0;
+	}
+	memcpy(l->mac, mac, 6);
+	memcpy(l->w->mac, mac, 6);
+	int err = 0;
+	if (l->bss_active) {
+		(void)wl_bss_activate(l, false);
+		err = wl_bss_activate(l, true);
+	}
+	LLOG("own address changed for the next association (%s address)%s", (mac[0] & 0x02) ? "private" : "hardware",
+	    err ? ", BSS re-activation FAILED" : "");
+	return err;
+}
+
 void
 mtk_wlan_release(struct mtk_wlan *l)
 {
