diff --git a/bsd/dev/rottenapple_wifi_a80211.c b/bsd/dev/rottenapple_wifi_a80211.c
index 1926787..3a9c08a 100644
--- a/bsd/dev/rottenapple_wifi_a80211.c
+++ b/bsd/dev/rottenapple_wifi_a80211.c
@@ -644,6 +644,99 @@ out:
 	return err;
 }
 
+/*
+ * Wi-Fi power from Settings / Control Center (POWER set, radio 0 state):
+ * off = disconnect and the full stop (firmware off, chip powered down);
+ * on = the level-5 bring-up again (about 3 s on the device), then the last
+ * network is rejoined unless userland joined one meanwhile. en1 and its
+ * IOKit objects stay. A worker thread applies the latest request, so
+ * rapid toggles collapse; POWER_CHANGED is posted after every change.
+ * (wifid also turns power off until the first unlock after boot and on again
+ * afterwards.)
+ */
+static volatile bool a80211_power_want = true;
+static volatile bool a80211_power_busy;
+
+static void
+a80211_power_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		bool want = a80211_power_want;
+		bool running = rottenapple_wifi_running() != NULL;
+		if (want == running) {
+			lck_mtx_lock(&a80211_lock);
+			if (a80211_power_want == want) {
+				a80211_power_busy = false;
+				lck_mtx_unlock(&a80211_lock);
+				return;
+			}
+			lck_mtx_unlock(&a80211_lock);
+			continue;
+		}
+		if (!want) {
+			int err = rottenapple_wifi_stop();
+			ALOG("power off from userland: %s (%d)", err == 0 ? "radio off" : "stop failed", err);
+			a80211_post(M_POWER_CHANGED, NULL, 0);
+			if (err && err != EALREADY) {
+				delay(500 * 1000);      /* EBUSY while starting/stopping: try again shortly */
+			}
+			continue;
+		}
+		int err = rottenapple_wifi_power_on();
+		ALOG("power on from userland: %s (%d)", err == 0 ? "radio on" : "start failed", err);
+		a80211_post(M_POWER_CHANGED, NULL, 0);
+		if (err) {
+			delay(1000 * 1000);
+			if (rottenapple_wifi_running() == NULL && a80211_power_want) {
+				ALOG("power on failed; leaving the radio off (toggle again to retry)");
+				lck_mtx_lock(&a80211_lock);
+				a80211_power_want = false;
+				lck_mtx_unlock(&a80211_lock);
+			}
+			continue;
+		}
+		/* give userland's auto-join a moment, then rejoin the last network ourselves */
+		delay(3000 * 1000);
+		struct rottenapple_wifi_link_info li;
+		rottenapple_wifi_sta_link_info(&li);
+		if (a80211_power_want && !li.associated && !a80211_assoc_running) {
+			(void)rottenapple_wifi_scan(ROTTENAPPLE_WIFI_SCAN_ACTIVE);
+			rottenapple_wifi_sta_link_info(&li);
+			if (a80211_power_want && !li.associated && !a80211_assoc_running) {
+				int e2 = rottenapple_wifi_sta_rejoin_last();
+				ALOG("power on: last network %s (%d)", e2 == 0 ? "rejoined" : "not rejoined", e2);
+			}
+		}
+	}
+}
+
+static int
+a80211_power(bool on)
+{
+	thread_t th;
+
+	lck_mtx_lock(&a80211_lock);
+	bool changed = a80211_power_want != on;
+	a80211_power_want = on;
+	if (a80211_power_busy) {
+		lck_mtx_unlock(&a80211_lock);
+		return 0;                       /* the worker picks the new state up */
+	}
+	if ((rottenapple_wifi_running() != NULL) == on) {
+		lck_mtx_unlock(&a80211_lock);
+		return 0;
+	}
+	a80211_power_busy = true;
+	lck_mtx_unlock(&a80211_lock);
+	ALOG("power %s requested by userland%s", on ? "on" : "off", changed ? "" : " (again)");
+	if (kernel_thread_start(a80211_power_thread, NULL, &th) != KERN_SUCCESS) {
+		a80211_power_busy = false;
+		return ENOMEM;
+	}
+	thread_deallocate(th);
+	return 0;
+}
