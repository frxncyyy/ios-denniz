+/*
+ * Radio on for userland (stage I3 power): start the level-5 bring-up again
+ * and wait until it runs. 0 when running (also if it already was), EBUSY /
+ * ETIMEDOUT / EIO otherwise.
+ */
+int
+rottenapple_wifi_power_on(void)
+{
+	uint64_t deadline;
+	int err = wifi_launch(WIFI_LEVEL_RUN);
+
+	if (err == EBUSY && wifi_state == WIFI_RUNNING) {
+		return 0;
+	}
+	if (err && err != EBUSY) {
+		return err;
+	}
+	clock_interval_to_deadline(30000, NSEC_PER_MSEC, &deadline);
+	while (wifi_state == WIFI_STARTING && mach_absolute_time() < deadline) {
+		delay(50 * 1000);
+	}
+	return wifi_state == WIFI_RUNNING ? 0 : (wifi_state == WIFI_STARTING ? ETIMEDOUT : EIO);
+}
