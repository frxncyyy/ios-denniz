+/*
+ * EVENT_TX_DONE ucStatus (gen4m ENUM_TX_RESULT_CODE). The firmware maps its
+ * internal TX results onto these in txmFreePkt's event builder; a frame it
+ * drops in txmSendHifPackets (inactive BSS, bad packet type, invalid STA
+ * record) is reported as 33.
+ */
+static const char *
+tx_status_name(uint8_t st)
+{
+	switch (st) {
+	case 0: return "acked";
+	case 1: return "lifetime timeout";
+	case 2: return "RTS error";
+	case 3: return "no ACK (MPDU error)";
+	case 4: return "aging timeout";
+	case 5: return "flushed";
+	case 6: return "BIP error";
+	case 7: return "unspecified error";
+	case 33: return "dropped in firmware";
+	case 34: return "queue clearance";
+	case 35: return "inactive BSS";
+	default: return "failed";
+	}
+}
