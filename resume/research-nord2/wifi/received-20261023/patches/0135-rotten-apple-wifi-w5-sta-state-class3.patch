+/*
+ * ACTIVATE_STA_REC (EVENT 0x0C): the firmware's answer to an
+ * UPDATE_STA_RECORD with ucNeedResp set, sent only after it accepted the
+ * update (sta_rec.c: the WLAN index, type and BSS matched the record).
+ * Body {MAC[6], STA index, BSS index}; the MAC is not printed.
+ */
+static void
+ev_sta_rec(__unused struct rottenapple_wifi *w, const struct rottenapple_wifi_event *ev, void *arg)
+{
+	struct mtk_wlan *l = arg;
+
+	if (ev->len < 8) {
+		LLOG("ACTIVATE_STA_REC event: %u bytes (short)", ev->len);
+		return;
+	}
+	if (ev->body[6] == l->sta_rec_idx) {
+		l->sta_rec_ack = true;
+	}
+	LLOG("firmware accepted the STA record update: STA %u, BSS %u (EVENT 0x0C ACTIVATE_STA_REC, seq %u)",
+	    ev->body[6], ev->body[7], ev->seq);
+}
+
+/*
+ * Called from the receive thread: an EAPOL frame that got no EVENT_TX_DONE
+ * within a second was taken by the firmware (the DMA consumed it, nothing
+ * reported a drop: drops in txmSendHifPackets come back as status 33) but
+ * never left its queue.
+ */
+static void
+wl_eapol_watch(struct mtk_wlan *l)
+{
+	if (!l->eapol_pending || l->eapol_stall_logged) {
+		return;
+	}
+	uint64_t age = now_us() - l->eapol_tx_us;
+	if (age < 1000000ull) {
+		return;
+	}
+	l->eapol_stall_logged = true;
+	LLOG("EAPOL TX PID %u: no EVENT_TX_DONE after %llu ms (%u TX done events since the join, STA record state-3 %s): "
+	    "the firmware queued it but did not transmit it. Boot with rottenapple_wifi_fwlog=1 to see its TXM warnings",
+	    l->eapol_pid, age / 1000, l->txdone_events, l->sta_rec_ack ? "acknowledged" : "NOT acknowledged");
+	(void)wl_health(l, "EAPOL TX stalled");
+}
