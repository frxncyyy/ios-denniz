+/*
+ * Fixed rate in the TXD. DW6 is {u16 u2AntID (bandwidth [2:0], dynamic BW
+ * bit 3, antenna index [15:4]), u16 u2FixedRate (rate code [11:0], bit 15 =
+ * take the rate from a CR instead of the TXD)}: the rate code goes in the
+ * upper half (byte 26), FIXED_RATE_MODE (bit 15) stays 0 = "use this TXD
+ * rate", and ucPowerOffset bit 7 enables it (gen4m nic_tx.h DW6 fields,
+ * HAL_MAC_TX_DESC_SET_FR_RATE / _FIXED_RATE_MODE_TO_DESC). Patches up to
+ * 0134 wrote the rate into u2AntID (byte 24): harmless for CCK 1M (code 0,
+ * every 2.4 GHz frame so far) but the OFDM 6M code 0x4b would have asked for
+ * a 160 MHz dynamic-bandwidth transmission on antenna 4 on 5 GHz.
+ */
+static void
+txd_fixed_rate(uint8_t txd[32], uint16_t rate_code)
+{
+	txd[11] |= TXD_FIXED_RATE_EN;                           /* ucPowerOffset */
+	put16(txd + 24, 0);                                     /* u2AntID: BW 20, antenna 0 */
+	put16(txd + 26, (uint16_t)(rate_code & 0x0fff));        /* u2FixedRate, mode = TXD */
+}
