<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.nord2.videoprobe: the probe's launchd job.  The installer merges this dictionary into
  /System/Library/xpc/launchd.plist (job label com.nord2.videoprobe) and keeps receipt.json's installed_launchd_sha256
  consistent.  The program itself exits at once unless /private/var/db/nord2-video-probe exists, waits 45 s and writes
  /private/var/db/nord2-video/probe-(n).jsonl.  There is no KeepAlive.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nord2.videoprobe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/n2vt_probe</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardErrorPath</key>
	<string>/private/var/db/nord2-video/probe.stderr</string>
</dict>
</plist>
