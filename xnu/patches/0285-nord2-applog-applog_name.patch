 /*
+ * NORD2 applog (port of ios-topaz 0920 + 0921, themselves after the HakiOS/darwin-redwood applog).
+ *
+ * applog_name=NAME[,NAME...]: programs whose file names begin with one of the NAMEs get
+ * OS_ACTIVITY_DT_MODE=YES appended to their environment at exec, which makes os_log mirror its
+ * messages on standard error. It works on its own (0921): what such a program writes to /dev/null
+ * (where launchd points the standard output and error of its jobs and of applications) is copied
+ * to the kernel log by the SWEET /dev/null tee in bsd/dev/mem.c as "|name| text", which asks
+ * exec_applog_name_match() below (the names in boot-arg sweetnull are tee'd as before).
+ *
+ * applog=1: in posix_spawn file actions, standard output and error opened on /dev/null are
+ * opened on /dev/console instead, for every program (0920; not needed for applog_name).
+ * applog=2: also OS_ACTIVITY_DT_MODE for every program (slow).
+ *
+ * NORD2_APPLOG_NAME_DEFAULT is the value of applog_name when the boot-arg is absent: the Nord 2
+ * command line (BOOT_LINE_LENGTH 608) is full, so a diagnostic build sets it with -D. A boot-arg
+ * applog_name=... replaces it (applog_name=- matches nothing in practice).
+ */
+#ifndef NORD2_APPLOG_NAME_DEFAULT
+#define NORD2_APPLOG_NAME_DEFAULT ""
+#endif
+static TUNABLE(uint32_t, exec_applog, "applog", 0);
+static TUNABLE_STR(exec_applog_name, 128, "applog_name", NORD2_APPLOG_NAME_DEFAULT);
+
+bool exec_applog_name_match(const char *name, size_t namelen);
+
+/* does name (namelen bytes, need not be terminated) begin with one of the applog_name words? */
+bool
+exec_applog_name_match(const char *name, size_t namelen)
+{
+	const char *p = exec_applog_name;
+
+	if (name == NULL) {
+		return false;
+	}
+	while (*p != 0) {
+		const char *word = p;
+
+		while (*p != 0 && *p != ',') {
+			p++;
+		}
+		if (p != word && (size_t)(p - word) <= namelen &&
+		    strncmp(word, name, (size_t)(p - word)) == 0) {
+			return true;
+		}
+		if (*p == ',') {
+			p++;
+		}
+	}
+	return false;
+}
+
+static bool
+exec_applog_oslog(struct image_params *imgp)
+{
+	if (exec_applog >= 2) {
+		return true;
+	}
+	if (exec_applog_name[0] == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	return exec_applog_name_match(imgp->ip_ndp->ni_cnd.cn_nameptr, imgp->ip_ndp->ni_cnd.cn_namelen);
+}
+
+static const char *
+exec_applog_path(int fd, const char *path)
+{
+	if (exec_applog && (fd == 1 || fd == 2) && strcmp(path, "/dev/null") == 0) {
+		return "/dev/console";
+	}
+	return path;
+}
