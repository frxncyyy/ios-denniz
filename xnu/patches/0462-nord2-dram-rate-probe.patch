+{
+	static volatile uint32_t *dv, *spm;
+	struct n2dr r;
+	if (n2dr_map[0] == NULL) {
+		n2dr_map[0] = (volatile uint32_t *)ml_io_map(N2DR_NAO_PA, 0x1000);
+		n2dr_map[1] = (volatile uint32_t *)ml_io_map(N2DR_AO_PA, 0x2000);
+		dv = (volatile uint32_t *)ml_io_map(0x10012000, 0x1000);
+		spm = (volatile uint32_t *)ml_io_map(0x10006000, 0x1000);
+	}
+	if (n2dr_map[0] == NULL || n2dr_map[1] == NULL || dv == NULL || spm == NULL) {
