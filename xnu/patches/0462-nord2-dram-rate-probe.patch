+	printf("NORD2 DRAM RATE: next is the DDRPHY of channel A (NAO %#x + 0x50c, AO %#x + 0x704..0x8b4 of the active shuffle level), read-only\n", N2DR_NAO_PA, N2DR_AO_PA);
+	n2cf_sleep_ms(NULL, 400);
+	n2dr_read(n2dr_rd, NULL, &r);
+	printf("NORD2 DRAM RATE: shu_lv=%u pll=%u sdmpcw=%#x prediv=%u posdiv=%u ckdiv4=%u pll_md=%u cldiv2=%u fbksel=%u dqopen=%u -> %u = %u Mbps (steps 4266 3733 3200 2400 1866 1600 1200 800; 4 channels x 16 bit: %u MB/s peak)\n",
+	    r.shu_lv, r.pll_id, r.sdmpcw, r.prediv, r.posdiv, r.ckdiv4, r.pll_md, r.cldiv2, r.fbksel, r.dqopen, r.raw, r.mbps, r.mbps * 8u);
+}
