+	n2cf_sleep_ms(NULL, 400);
+	printf("NORD2 DRAM RATE: DVFSRC basic_control=%08x (en %u, out_en %u) sw_req1/2/3=%08x/%08x/%08x current_level=%08x target_level=%08x | SPM dvfs_level=%08x dvs_dfs_level=%08x dvfs_sta=%08x sw_flag_0=%08x\n",
