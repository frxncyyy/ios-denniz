+#define N2IO_GICD               0x0c000000UL
+#define N2IO_GICD_ISEN_M4U0     (0x100u + 4u * (332u / 32u))    /* SPI 300 = INTID 332 */
+#define N2IO_GICD_BIT_M4U0      (1u << (332u % 32u))
