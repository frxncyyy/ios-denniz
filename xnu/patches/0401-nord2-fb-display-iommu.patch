+#define N2IO_M4U0               0x1411a000UL
+#define N2IO_LARB0              0x14118000UL
+#define N2IO_LARB1              0x14119000UL
+#define N2IO_MMSYS_CG1          0x14116110UL    /* +8 = clear (ungate) */
