+#ifndef SWEET_FB_IOMMU_HW_H
+#define SWEET_FB_IOMMU_HW_H
+#include "sweet_fb_iommu.h"
+
+extern "C" {
+extern unsigned long gPhysBase, gPhysSize;
+vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+}
