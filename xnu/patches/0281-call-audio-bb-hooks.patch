+// 0281: call audio (bsd/dev/audio_call.c, patch 0280; the hook is NULL without it): speech on while a call is dialing,
+// alerting, active or held, off otherwise (an incoming call rings through iOS until it is answered).
+extern "C" void (*nord2_call_state_hook)(unsigned want, unsigned mode);
+static void bb_call_audio_update(void)
+{
+  unsigned want = 0;
+  for (uint32_t id = 1; id < 8; id++) {
+    const bb_call &c = bb_calls[id];
+    if (c.used && (c.state == NBM_CALL_ORIGINATION || c.state == NBM_CALL_CONVERSATION || c.state == NBM_CALL_ALERTING ||
+                   c.state == NBM_CALL_HOLD)) want = 1;
+  }
+  if (bb_speech_on) want = 1;                            // 0277ba: the modem's speech path is up (+ESPEECH: 1, early media too)
+  if (nord2_call_state_hook) nord2_call_state_hook(want, (unsigned)bb_call_mode());
+}
