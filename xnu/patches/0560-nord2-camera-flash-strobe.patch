+static inline uint32_t
+n2t_strobe_to_sel(uint32_t ms)
+{
+	uint32_t want = ms + N2T_STRB_TO_MARGIN_MS;
+	if (want <= 64u) { return 0; }
+	uint32_t n = (want - 64u + 31u) / 32u;
+	return n > 74u ? 74u : n;
+}
