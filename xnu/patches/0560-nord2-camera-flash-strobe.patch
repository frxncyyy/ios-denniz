+	if (!n2t_pmu_read(N2T_REG_FLED1_STRB2, &s1) || !n2t_pmu_read(N2T_REG_FLED2_STRB2, &s2) || !n2t_pmu_read(N2T_REG_FLED_STRB_CTRL, &to) ||
