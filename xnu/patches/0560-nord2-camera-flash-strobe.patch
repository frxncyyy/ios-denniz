+	if ((en & (N2T_EN_STROBE | N2T_EN_TORCH)) && !n2t_pmu_write(N2T_REG_FLED_EN, (uint8_t)(en & ~(N2T_EN_STROBE | N2T_EN_TORCH)))) { return false; }
