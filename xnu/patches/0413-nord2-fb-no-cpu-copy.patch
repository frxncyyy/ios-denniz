+/* 0413: no CPU copy composition.  May this frame go through the CPU copy path?  Only in the debug modes 0/1 chosen by hand, or as the
+ * emergency path when the overlay is unusable for the whole boot (kern.n2fbcpuemerg, default 1: a frozen screen hides even a panic).
+ * During a fault backoff (mode 0 set by the driver, back on later) frames are held, never copied. */
+static inline bool
+sweet_fb_hw_cpu_allowed(uint32_t mode, bool backoff_pending, bool overlay_dead, bool emergency_ok)
+{
+	if (overlay_dead) { return emergency_ok; }
+	if (backoff_pending) { return false; }
+	return mode < SWEET_FB_HW_SINGLE;
+}
+/* 0413: panel blank on display off (DCS 0x28 display off / 0x29 on, no CPU fade) when the overlay is the frame source. */
+enum { SWEET_FB_BLANK_NONE = 0, SWEET_FB_BLANK_OFF, SWEET_FB_BLANK_ON, SWEET_FB_BLANK_CPU_FADE };
+static inline int
+sweet_fb_blank_action(bool power_off, bool blanked, bool overlay_source, unsigned off_failures)
+{
+	if (power_off) {
+		if (!overlay_source || off_failures >= 30) { return blanked ? SWEET_FB_BLANK_NONE : SWEET_FB_BLANK_CPU_FADE; }
+		return blanked ? SWEET_FB_BLANK_NONE : SWEET_FB_BLANK_OFF;
+	}
+	return blanked ? SWEET_FB_BLANK_ON : SWEET_FB_BLANK_NONE;
+}
