+                const struct n2c_job *j = &c->jobs[k];
+                if (j->ctx != idx || j->state == N2C_JOB_FREE)
+                        continue;
+                if (!terminal(j->state))
+                        r->ctx_jobs++;
+                if ((j->state == N2C_JOB_RUNNING || j->state == N2C_JOB_STOPPING) && !r->kind) {
+                        r->kind = j->kind;
+                        r->phase = j->phase;
+                        r->slot = (uint8_t)j->slot;
+                        r->head = j->heads[j->phase & 1u];
