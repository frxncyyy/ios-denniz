+                        if (!x->revive_held) {
+                                x->revive_held = true;
+                                c->as_stats.revive_refused++;
+                                note(c, "Nord2 GPU core: faulted context not revived (budget of the 30 s window spent; waits for the window)");
+                        }
+                        continue;
+                }
+                as_unbind(c, x);
+                x->state = N2C_CTX_OPEN;
+                x->revives++;
+                c->as_stats.revives++;
