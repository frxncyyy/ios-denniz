+sweet_fb_hw_h6c(uint32_t layers, const uint64_t snap[], uint64_t lowwater, uint64_t age_us, uint64_t limit_us)
+{
+	for (unsigned l = 0; l < 32u && (layers >> l) != 0; l++) {
+		if (((layers >> l) & 1u) && snap[l] > lowwater) { return age_us < limit_us ? 1 : 2; }
+	}
+	return 0;
