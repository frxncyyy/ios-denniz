+/*
+ * nord2_haptic_ram.h -- 0611 (haptic2-20261114): crisp RAM clicks for the AW8697 (included at the end of nord2_haptic.h; pure C,
+ * host-tested by test/haptic_test.c against the simulated chip).
+ *
+ * Why [V phone logs autocycle/runs/f3, vc9p, gr1 with q10jcz]: 0610 turned every iOS haptic into CONT drive: "on (iOS)" ...
+ * "stop (iOS silent) after 41..53 ms", then the chip's brake ran 13..31 ms more ("standby N ms after the stop").  CONT mode is
+ * a closed loop that ramps the LRA up over several periods and keeps it at resonance: ~8 cycles of 170 Hz = the "mosquito" buzz
+ * the user reported.  Android (the same kernel tree, aw8697.c "vibration run in ram mode") plays every effect from the chip's
+ * SRAM: short waveforms with the drive and an antiphase brake baked in.  The Android file aw8697_haptic_170.bin is not on the
+ * phone nor in the vendor dump, so this file SYNTHESISES the waveforms at boot, at the f0 the chip tracked during the boot pulse
+ * (170 Hz on this motor; 1700 dHz when the reading is missing or outside 160..180 Hz) and uploads them over I2C9.
+ *
+ * RAM format [V aw8697.c aw8697_container_update / aw8697_ram_loaded, haptic_hv.c get_ram_num]: the image is written from
+ * BASE_ADDR through the RAMDATA port (RAMINIT on, RAMADDR auto-increments, bursts); byte 0 at the base is a version byte, then
+ * one 4-byte entry per waveform {start H, start L, end H, end L} (absolute SRAM addresses; ram_num = (first start - base - 1) / 4),
+ * then the waveforms: signed 8-bit samples at 24 kHz with PWMDBG = 24K [V aw8697.c osc calibration: fre_val 2 -> len / 24000].
+ * FIFO_AE/AF = base/2 and base - base/4 (aw8697_container_update).  Playback [V aw8697_haptic_play_wav_seq / play_mode RAM]:
+ * WAVSEQ1 = waveform, WAVSEQ2 = 0, loops 0, SYSCTRL play mode RAM with the boost BYPASSED (as Android's RAM mode), active, GO;
+ * gain = DATDBG (0x80 = unity, Android's AW8697_HAPTIC_RAM_VBAT_COMP_GAIN, scaled by 4400 / VBAT, ceiling 128 x 4400 / 3000).
+ * In bypass the bridge output cannot exceed VBAT whatever the gain: the strongest click equals Android's.
+ *
+ * Waveforms (full scale = VBAT across the 8.3 ohm LRA, as Android): N drive half-cycles of a soft-clipped sine at f0, then M
+ * antiphase half-cycles (the brake: at resonance the LRA's velocity is in phase with the drive, so an antiphase drive takes out
+ * about the energy the same number of half-cycles put in; the last brake half-cycle is weaker so the motor is not driven back).
+ *   tick  (selection, keyboard, soft taps)  1 cycle drive + 0.7 cycle brake  ~11.8 ms
+ *   click (most UIKit impacts)              2 cycles      + 1.7               ~23.5 ms
+ *   heavy (very loud iOS transients)        3 cycles      + 2.7               ~35 ms
+ * Profiles (compile time, N2H_RAM_PROFILE): 0 default; 1 strong (squarer drive, one more drive half-cycle); 2 soft (pure sine,
+ * gain 3/4).
+ * Vendor waveforms (compile time, N2H_VENDOR_RAM): nord2_haptic_vendor.h, generated by haptic2-20261114/make_vendor_header.py from
+ * Android's own aw8697_haptic_170.bin (odm partition), replaces the synthesis: the file's image is uploaded as Android does
+ * (its base address, its table) and tick / click / heavy play the vendor waveform indices chosen by the script.
+ */
+#ifndef NORD2_HAPTIC_RAM_H
+#define NORD2_HAPTIC_RAM_H
+
+#ifndef N2H_RAM_PROFILE
+#define N2H_RAM_PROFILE         0
+#endif
+
+#ifdef N2H_VENDOR_RAM
+#include "nord2_haptic_vendor.h"          /* n2h_vendor_img[], N2H_VENDOR_BASE / _LEN / _NWAVES, n2h_vendor_idx[] */
+#define N2H_RAM_BASE            N2H_VENDOR_BASE
+#else
+#define N2H_RAM_BASE            0x0800u   /* waveform area 0x0800..0x1fff (the RTP FIFO below it is unused) */
+#endif
+#define N2H_RAM_END             0x2000u   /* 8 KiB SRAM */
+#define N2H_RAM_RATE            24000u
+#define N2H_RAM_VERSION         0x01u
+#if defined(N2H_VENDOR_RAM) && N2H_VENDOR_LEN > 3072u
+#define N2H_RAM_IMG_MAX         N2H_VENDOR_LEN
+#else
+#define N2H_RAM_IMG_MAX         3072u     /* our image (header + 3 waveforms, any profile, f0 >= 160 Hz) stays below this */
+#endif
+#define N2H_RAM_CHUNK           128u      /* bytes uploaded / verified per owner tick (~13 ms of bus time) */
+#define N2H_F0_MIN_OK           1600u
+#define N2H_F0_MAX_OK           1800u
+#define N2H_GAIN_UNITY          0x80u
+#define N2H_VBAT_REFER          4400u     /* Android AW8697_VBAT_REFER / MIN / MAX */
+#define N2H_VBAT_MIN            3000u
+#define N2H_VBAT_MAX            4500u
+#define N2H_CLICK_STALE_US      40000ull  /* an onset not played within 40 ms (motor busy) is dropped */
+#define N2H_RAM_OVERRUN_MS      30u       /* RAM play still busy this long past the waveform: GO 0 */
+#define N2H_TICK_BELOW          350u      /* level (0..1000 of N2H_PEAK_FULL) below this: tick */
+#define N2H_HEAVY_PEAK          16384u    /* |sample| from half full scale: heavy */
+
+enum { N2H_W_TICK = 1, N2H_W_CLICK = 2, N2H_W_HEAVY = 3 };
+static const char *const n2h_wave_name[N2H_W_COUNT + 1] = { "none", "tick", "click", "heavy" };
+
+#define N2H_BRK_MAX 10
+struct n2h_wdef { uint8_t drive_halves, nbrk; uint8_t brk_pct[N2H_BRK_MAX]; };
+struct n2h_profile {
+	const char *name;
+	uint16_t clip_q8;             /* sine x clip_q8 / 256, clipped at full scale (256 = pure sine, 512 = nearly square) */
+	uint8_t gain_max;             /* DATDBG at level 1000 before the VBAT compensation */
+	struct n2h_wdef w[N2H_W_COUNT + 1];
+};
+static const struct n2h_profile n2h_profiles[3] = {
+	{ "default", 358, N2H_GAIN_UNITY, { { 0, 0, { 0 } },
+		{ 2, 2, { 100, 40 } },
+		{ 4, 4, { 100, 100, 100, 40 } },
+		{ 6, 6, { 100, 100, 100, 100, 100, 40 } } } },
+	{ "strong", 512, N2H_GAIN_UNITY, { { 0, 0, { 0 } },
+		{ 3, 3, { 100, 100, 30 } },
+		{ 5, 5, { 100, 100, 100, 100, 40 } },
+		{ 7, 7, { 100, 100, 100, 100, 100, 100, 40 } } } },
+	{ "soft", 256, 0x60, { { 0, 0, { 0 } },
+		{ 2, 2, { 100, 40 } },
+		{ 4, 4, { 100, 100, 100, 40 } },
+		{ 6, 6, { 100, 100, 100, 100, 100, 40 } } } },
+};
+#if N2H_RAM_PROFILE < 0 || N2H_RAM_PROFILE > 2
+#error "N2H_RAM_PROFILE must be 0 (default), 1 (strong) or 2 (soft)"
+#endif
+#define N2H_PROFILE (&n2h_profiles[N2H_RAM_PROFILE])
+
+/* sin(i x 90 deg / 64), Q15 */
+static const uint16_t n2h_qsin[65] = {
+	0, 804, 1608, 2410, 3212, 4011, 4808, 5602, 6393, 7179, 7962, 8739, 9512, 10278, 11039, 11793, 12539, 13279, 14010, 14732,
+	15446, 16151, 16846, 17530, 18204, 18868, 19519, 20159, 20787, 21403, 22005, 22594, 23170, 23731, 24279, 24811, 25329, 25832,
+	26319, 26790, 27245, 27683, 28105, 28510, 28898, 29268, 29621, 29956, 30273, 30571, 30852, 31113, 31356, 31580, 31785, 31971,
+	32137, 32285, 32412, 32521, 32609, 32678, 32728, 32757, 32767 };
+
+struct n2h_ram_layout {
+	uint32_t f0_dhz, len;                     /* image bytes (from the base) */
+	uint16_t start[N2H_W_COUNT + 1], end[N2H_W_COUNT + 1];   /* absolute SRAM addresses, end inclusive */
+	uint32_t ms_x10[N2H_W_COUNT + 1];         /* waveform length, 0.1 ms */
+	uint8_t idx[N2H_W_COUNT + 1];             /* WAVSEQ1 value for tick / click / heavy */
+	bool vendor;
+};
+
+static inline uint32_t
+n2h_f0_for_ram(uint32_t tracked_dhz)
+{
+	return tracked_dhz >= N2H_F0_MIN_OK && tracked_dhz <= N2H_F0_MAX_OK ? tracked_dhz : N2H_F0_PRE;
+}
+
+/* one waveform at f0 into out (cap bytes); returns its length or 0 when it does not fit */
+static inline unsigned
+n2h_wave_synth(uint8_t *out, unsigned cap, uint32_t f0_dhz, const struct n2h_wdef *w, uint16_t clip_q8)
+{
+	unsigned halves = (unsigned)w->drive_halves + w->nbrk, n = 0;
+	/* phase in units of one half-cycle = 2^32; advance per 24 kHz sample = f0 x 2 / 24000 half-cycles */
+	uint64_t inc = ((uint64_t)f0_dhz << 32) / (5u * N2H_RAM_RATE), ph = 0;
+	for (;;) {
+		unsigned h = (unsigned)(ph >> 32);
+		if (h >= halves) { break; }
+		if (n >= cap) { return 0; }
+		unsigned idx = (unsigned)((ph >> 25) & 127u);           /* 0..127 across the half-cycle */
+		uint32_t s = n2h_qsin[idx <= 64 ? idx : 128 - idx];      /* |sin|, Q15 */
+		uint32_t v = s * clip_q8 / 256u;
+		if (v > 32767u) { v = 32767u; }
+		unsigned pct = h < w->drive_halves ? 100u : w->brk_pct[h - w->drive_halves];
+		int32_t mag = (int32_t)((v * 127u * pct + 50u * 32767u) / (100u * 32767u));
+		bool neg = (h & 1u) != 0;                                /* the sine's own sign in this half-cycle */
+		if (h >= w->drive_halves) { neg = !neg; }               /* brake: antiphase */
+		out[n++] = (uint8_t)(int8_t)(neg ? -mag : mag);
+		ph += inc;
+	}
+	for (unsigned z = 0; z < 2; z++) {                           /* end at rest */
+		if (n >= cap) { return 0; }
+		out[n++] = 0;
+	}
+	return n;
+}
+
+/* the whole image (version, table, waveforms); returns its length (0 = failure) */
+static inline unsigned
+n2h_ram_build(uint8_t *img, unsigned cap, uint32_t f0_dhz, const struct n2h_profile *p, struct n2h_ram_layout *lay)
+{
+	unsigned hdr = 1u + 4u * N2H_W_COUNT, pos = hdr;
+	if (cap < hdr || f0_dhz < N2H_F0_MIN_OK || f0_dhz > N2H_F0_MAX_OK) { return 0; }
+	*lay = (struct n2h_ram_layout){ 0 };
+	lay->f0_dhz = f0_dhz;
+#ifdef N2H_VENDOR_RAM
+	(void)p; (void)pos;
+	if (cap < N2H_VENDOR_LEN || N2H_VENDOR_BASE + N2H_VENDOR_LEN > N2H_RAM_END) { return 0; }
+	for (unsigned i = 0; i < N2H_VENDOR_LEN; i++) { img[i] = n2h_vendor_img[i]; }
+	lay->vendor = true;
+	for (unsigned k = 1; k <= N2H_W_COUNT; k++) {
+		unsigned v = n2h_vendor_idx[k];
+		if (v < 1 || v > N2H_VENDOR_NWAVES) { return 0; }
+		const uint8_t *e = img + 1 + 4 * (v - 1);
+		unsigned st = (unsigned)e[0] << 8 | e[1], en = (unsigned)e[2] << 8 | e[3];
+		if (st <= N2H_VENDOR_BASE || en < st || en >= N2H_VENDOR_BASE + N2H_VENDOR_LEN) { return 0; }
+		lay->start[k] = (uint16_t)st; lay->end[k] = (uint16_t)en; lay->idx[k] = (uint8_t)v;
+		lay->ms_x10[k] = (en - st + 1u) * 10000u / N2H_RAM_RATE;
+	}
+	lay->len = N2H_VENDOR_LEN;
+	return N2H_VENDOR_LEN;
+#else
+	img[0] = N2H_RAM_VERSION;
+	for (unsigned k = 1; k <= N2H_W_COUNT; k++) {
+		unsigned n = n2h_wave_synth(img + pos, cap - pos, f0_dhz, &p->w[k], p->clip_q8);
+		if (n == 0 || N2H_RAM_BASE + pos + n > N2H_RAM_END) { return 0; }
+		lay->start[k] = (uint16_t)(N2H_RAM_BASE + pos);
+		lay->end[k] = (uint16_t)(N2H_RAM_BASE + pos + n - 1);
+		lay->ms_x10[k] = n * 10000u / N2H_RAM_RATE;
+		lay->idx[k] = (uint8_t)k;
+		uint8_t *e = img + 1 + 4 * (k - 1);
+		e[0] = (uint8_t)(lay->start[k] >> 8); e[1] = (uint8_t)lay->start[k];
+		e[2] = (uint8_t)(lay->end[k] >> 8);   e[3] = (uint8_t)lay->end[k];
+		pos += n;
+	}
+	lay->len = pos;
+	return pos;
+#endif
+}
+
+/* RAM layout registers + RAMINIT on (aw8697_container_update order); the data follows with n2h_ram_write */
+static const struct n2h_op n2h_seq_ram_open[] = {
+	{ N2H_OP_RMW, N2H_REG_SYSCTRL, N2H_SYSCTRL_RAMINIT | N2H_SYSCTRL_BOOST, N2H_SYSCTRL_RAMINIT },
+	{ N2H_OP_W, N2H_REG_BASE_ADDRH, 0xFF, (uint8_t)(N2H_RAM_BASE >> 8) },
+	{ N2H_OP_W, N2H_REG_BASE_ADDRL, 0xFF, (uint8_t)N2H_RAM_BASE },
+	{ N2H_OP_W, N2H_REG_FIFO_AEH, 0xFF, (uint8_t)((N2H_RAM_BASE >> 1) >> 8) },
+	{ N2H_OP_W, N2H_REG_FIFO_AEL, 0xFF, (uint8_t)(N2H_RAM_BASE >> 1) },
+	{ N2H_OP_W, N2H_REG_FIFO_AFH, 0xFF, (uint8_t)((N2H_RAM_BASE - (N2H_RAM_BASE >> 2)) >> 8) },
+	{ N2H_OP_W, N2H_REG_FIFO_AFL, 0xFF, (uint8_t)(N2H_RAM_BASE - (N2H_RAM_BASE >> 2)) },
+};
+static const struct n2h_op n2h_seq_ram_close[] = {
+	{ N2H_OP_RMW, N2H_REG_SYSCTRL, N2H_SYSCTRL_RAMINIT | N2H_SYSCTRL_BOOST, 0 },
+};
+
+/* RAMADDR = addr then bursts of the RAMDATA port (RAMINIT must be on: the caller opened it) */
+static inline bool
+n2h_ram_addr(const struct n2h_bus *b, uint16_t addr)
+{
+	return addr < N2H_RAM_END && n2h_write(b, N2H_REG_RAMADDRH, (uint8_t)(addr >> 8)) && n2h_write(b, N2H_REG_RAMADDRL, (uint8_t)addr);
+}
+
+static inline bool
+n2h_ram_write(const struct n2h_bus *b, uint16_t addr, const uint8_t *v, unsigned n)
+{
+	if (b->wrn == NULL || addr < N2H_RAM_BASE || (uint32_t)addr + n > N2H_RAM_END || !n2h_ram_addr(b, addr)) { return false; }
+	for (unsigned i = 0; i < n; i += N2H_BURST_MAX) {
+		unsigned k = n - i < N2H_BURST_MAX ? n - i : N2H_BURST_MAX;
+		if (!b->wrn(b->ctx, N2H_REG_RAMDATA, v + i, k)) { return false; }
+	}
+	return true;
+}
+
+/* reads back and compares; *bad = first mismatching offset (n = none). false on a bus error. */
+static inline bool
+n2h_ram_verify(const struct n2h_bus *b, uint16_t addr, const uint8_t *v, unsigned n, unsigned *bad, uint8_t *got)
+{
+	uint8_t buf[N2H_BURST_MAX];
+	*bad = n;
+	if (b->rdn == NULL || !n2h_ram_addr(b, addr)) { return false; }
+	for (unsigned i = 0; i < n; i += N2H_BURST_MAX) {
+		unsigned k = n - i < N2H_BURST_MAX ? n - i : N2H_BURST_MAX;
+		if (!b->rdn(b->ctx, N2H_REG_RAMDATA, buf, k)) { return false; }
+		for (unsigned j = 0; j < k && *bad == n; j++) {
+			if (buf[j] != v[i + j]) { *bad = i + j; *got = buf[j]; }
+		}
+	}
+	return true;
+}
+
+/* play one RAM waveform: n2h_run(b, seq, gain, wave) (aw8697_haptic_set_wav_seq + play_wav_seq; boost bypassed) */
+static const struct n2h_op n2h_seq_ram_play[] = {
+	{ N2H_OP_GAIN, N2H_REG_DATDBG, 0xFF, 0 },
+	{ N2H_OP_WAVE, N2H_REG_WAVSEQ1, 0xFF, 0 },
+	{ N2H_OP_W, N2H_REG_WAVSEQ2, 0xFF, 0 },
+	{ N2H_OP_W, N2H_REG_WAVLOOP1, 0xFF, 0 },
+	{ N2H_OP_W, N2H_REG_MAIN_LOOP, 0xFF, 0 },
+	{ N2H_OP_RMW, N2H_REG_SYSCTRL, N2H_SYSCTRL_PLAY_MASK | N2H_SYSCTRL_BOOST | N2H_SYSCTRL_STANDBY | N2H_SYSCTRL_RAMINIT,
+	  N2H_SYSCTRL_PLAY_RAM },
+	{ N2H_OP_RMW, N2H_REG_SYSINTM, N2H_SYSINTM_UVLO, 0 },
+	{ N2H_OP_RMW, N2H_REG_GO, N2H_GO, N2H_GO },
+};
+
+/* DATDBG for a level (0..1000), with Android's RAM VBAT compensation and the thermal halving */
+static inline uint8_t
+n2h_gain_for(uint32_t level, uint32_t vbat_mv, uint32_t therm, const struct n2h_profile *p)
+{
+	if (level > 1000) { level = 1000; }
+	if (vbat_mv < N2H_VBAT_MIN) { vbat_mv = N2H_VBAT_MIN; }
+	if (vbat_mv > N2H_VBAT_MAX) { vbat_mv = N2H_VBAT_MAX; }
+	uint32_t g = (uint32_t)p->gain_max * (550u + 450u * level / 1000u) / 1000u;
+	g = g * N2H_VBAT_REFER / vbat_mv;
+	if (therm == 1) { g /= 2u; }
+	if (g > N2H_GAIN_HW_MAX) { g = N2H_GAIN_HW_MAX; }
+	if (g < 8u) { g = 8u; }
+	return (uint8_t)g;
+}
+
+/* the waveform for an iOS onset's peak */
+static inline uint8_t
+n2h_wave_for(uint32_t peak, uint32_t *level)
+{
+	uint32_t l = peak >= N2H_PEAK_FULL ? 1000u : peak * 1000u / N2H_PEAK_FULL;
+	*level = l;
+	if (peak >= N2H_HEAVY_PEAK) { return N2H_W_HEAVY; }
+	return l < N2H_TICK_BELOW ? N2H_W_TICK : N2H_W_CLICK;
+}
+
+/*
+ * A new iOS onset -> one RAM click (call only when the motor is idle).  true = play *wave at *gain.  An onset older than
+ * N2H_CLICK_STALE_US (the motor was busy) is dropped; the same limits as the CONT path apply (switch, latch, thermal, budget).
+ */
+static inline bool
+n2h_click_take(struct n2h_state *s, struct n2h_stream *t, const struct n2h_env *e, const struct n2h_cfg *c, uint64_t now,
+    uint32_t vbat_mv, const struct n2h_profile *p, uint8_t *wave, uint8_t *gain, uint32_t *peak_out)
+{
+	uint64_t onset = e->onset_us, heard = e->heard_us;
+	if (!t->ram_ok || s->nseg) { return false; }
+	if (onset == 0 || onset == t->click_onset || heard < onset) { return false; }
+	t->click_onset = onset;
+	if (!c->mode || s->latched || s->therm >= 2) { return false; }
+	if (now < onset || now - onset > N2H_CLICK_STALE_US) { t->stale++; return false; }
+	if (s->budget_us <= 0) { s->throttled++; return false; }
+	uint32_t peak = (uint32_t)e->peak, level = 0;
+	if (peak <= N2H_SILENT_BELOW) { peak = N2H_SILENT_BELOW + 1; }
+	*wave = n2h_wave_for(peak, &level);
+	*gain = n2h_gain_for(level, vbat_mv, s->therm, p);
+	*peak_out = peak;
+	t->clicks++;
+	t->wave_n[*wave]++;
+	return true;
+}
+
+/* zero crossings of a write's samples with a +-N2H_SILENT_BELOW hysteresis (the iOS waveform's frequency, for the log) */
+static inline unsigned
+n2h_zc_count(const int16_t *s, unsigned n, volatile int64_t *last_sign)
+{
+	unsigned zc = 0;
+	int64_t ls = *last_sign;
+	for (unsigned i = 0; i < n; i++) {
+		int64_t sg = s[i] > (int32_t)N2H_SILENT_BELOW ? 1 : s[i] < -(int32_t)N2H_SILENT_BELOW ? -1 : 0;
+		if (sg != 0) {
+			if (ls != 0 && sg != ls) { zc++; }
+			ls = sg;
+		}
+	}
+	*last_sign = ls;
+	return zc;
+}
