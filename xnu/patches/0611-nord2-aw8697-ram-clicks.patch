+/* 0611: RAM waveform playing: wait for GLB_STATE idle after its length, then standby; still busy N2H_RAM_OVERRUN_MS later: GO 0 */
+static void
+n2h_ram_playing(uint64_t now)
+{
+	if (now < n2h_ram.play_end_us) { return; }
