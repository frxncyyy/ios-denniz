--- a/bsd/dev/nord2_gpu_core.c
+++ b/bsd/dev/nord2_gpu_core.c
@@ -1883,6 +1883,11 @@
                                         continue;
                                 if ((b->flags & N2C_BO_IMPORTED) || b->clean_seq > c->l2_done_seq)
                                         need_inv = true;
+                                /* 0667: a CPU write-combined / uncached buffer the CPU can reach is written past every CPU cache, so no clean ever
+                                 * marks it (clean_seq stays put), yet the GPU L2 may still hold lines of an earlier content (recycled descriptor
+                                 * pools: JS status 0x58 DATA_INVALID_FAULT in Maps, q10jperf4).  Such buffers always need the start invalidate. */
+                                if ((b->flags & N2C_BO_CPU_UNCACHED) && (b->cpu_visible || b->cpu_dirty))
+                                        need_inv = true;
                                 if ((b->flags & N2C_BO_IMPORTED) || b->cpu_visible)
                                         keep_end = false;
                         }
