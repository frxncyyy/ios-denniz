--- a/bsd/dev/nord2_gpu_core.h
+++ b/bsd/dev/nord2_gpu_core.h
@@ -40,7 +40,7 @@
 /* Handles per context.  A handle is (serial << N2C_SLOT_BITS) | slot, 32 bits in the ABI (u32 handles[]), so the slot field takes
  * N2C_SLOT_BITS of the serial: 0105 raised the context limit from 256 to 1024 slots (backboardd held all 256 and dropped commands) and
  * the core-wide serial, which never repeats so a stale handle cannot alias, shrank from 24 to 22 bits (4194303 buffers per boot). */
-#define N2C_SLOT_BITS 10u
+#define N2C_SLOT_BITS 12u   /* 0186: 4096 slots (was 1024: backboardd/SpringBoard grew to 1024 LIVE buffers in ~3 minutes, ALLOC then failed with N2C_E_NO_HANDLE = EIO = the 10 s freeze); serial 20 bits = 1048575 buffers per boot */
 #define N2C_MAX_BOS (1u << N2C_SLOT_BITS)
 #define N2C_SLOT_MASK (N2C_MAX_BOS - 1u)
 #define N2C_HANDLE_SERIAL_MAX (0xffffffffu >> N2C_SLOT_BITS)
--- a/bsd/dev/nord2_gpu_va.h
+++ b/bsd/dev/nord2_gpu_va.h
@@ -20,7 +20,7 @@
 /* Free extents.  Every live buffer can leave one free gap behind it (small buffers are 64 KiB aligned and the gap is not reusable for
  * another 64 KiB-aligned buffer), so the list must hold more extents than a context has handles: 256 extents made the 257th small
  * buffer fail with N2C_E_VA long before any other limit (0105; nord2_gpu_core.c asserts N2VA_MAX_EXTENTS > N2C_MAX_BOS). */
-#define N2VA_MAX_EXTENTS 1032u
+#define N2VA_MAX_EXTENTS 4104u   /* 0186: must stay above N2C_MAX_BOS (4096) */
 #define N2VA_GRANULE 0x1000ull
 
 struct n2va_extent {
