+	n2gl_o.emictl = n2gl_rd(N2G_CFG_EMI_CTL); done[25] = true;
+	if (!n2gl_field(N2G_CFG_EMI_CTL, 1u, 1u)) { return N2G_E_ARG; }   /* (b) EMI_REQ_GPS = 1 */
