+	n2gl_show("USRT A2DF", N2G_USRT_A2DF(0)); n2gl_show("USRT D2AF", N2G_USRT_D2AF(0));
+	n2gl_show("USRT D2A0", N2G_USRT_D2A0(0)); n2gl_show("USRT D2A1", N2G_USRT_D2A1(0));
+	n2gl_lines = 0;
