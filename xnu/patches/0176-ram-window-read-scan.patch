+extern "C" void nord2_bc(unsigned tag, unsigned a, unsigned bval);
+static uint64_t now_ms_abs() { uint64_t ns = 0; absolutetime_to_nanoseconds(mach_absolute_time(), &ns); return ns / 1000000ull; }
+/* 0176: read test of the whole RAM window.  The crashes (p69-p76) are hard resets with no panic text, always after minutes of heavy use when the allocator has reached most of the window;
+ * if a physical range inside the window is not readable (memory protection, wrong size), the first touch kills the SoC.  45 s after boot one 8-byte read per 16 KiB page of
+ * [gPhysBase, gPhysBase + gPhysSize) through the physmap, progress in the breadcrumbs (tag 0x30: pa low, pa high) and in the log every 256 MiB.  Boot-arg n2memscan=0 disables it. */
+extern "C" vm_offset_t phystokv(uint64_t pa);
+static void n2_memscan(void *, wait_result_t) {
+        IOSleep(45000);
+        uint64_t base = gPhysBase, size = gPhysSize, step = 16384, nextlog = base + (256ull << 20), t0 = now_ms_abs();
+        IOLog("NORD2 MEMSCAN: start pa %#llx + %llu MiB\n", base, size >> 20);
+        for (uint64_t pa = base; pa + step <= base + size; pa += step) {
+                if (!(pa & ((64ull << 20) - 1)) || pa == base) nord2_bc(0x30, (unsigned)pa, (unsigned)(pa >> 32));
+                volatile uint64_t *v = (volatile uint64_t *)phystokv(pa);
+                (void)*v;
+                if (pa >= nextlog) { IOLog("NORD2 MEMSCAN: read ok up to %#llx\n", pa); nextlog += 256ull << 20; IOSleep(1); }
+        }
+        IOLog("NORD2 MEMSCAN: whole window read ok in %llu ms\n", now_ms_abs() - t0);
+        nord2_bc(0x31, 0, 0);
+        thread_terminate(current_thread());
+}
