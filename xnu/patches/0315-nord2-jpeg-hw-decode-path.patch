+/* the one-job lock (callers sleep interruptibly); n2jd_job_end books the result and arms the idle power-off */
+static int
+n2jd_job_begin(void)
+{
+	lck_mtx_lock(&n2jd_lock);
+	while (n2jd.busy) {
+		int err = msleep(&n2jd.busy, &n2jd_lock, PZERO | PCATCH, "redwood-jpeg", NULL);
+		if (err) {
+			lck_mtx_unlock(&n2jd_lock);
+			return err == EWOULDBLOCK ? EAGAIN : err;
+		}
+	}
+	n2jd.busy = true;
+	lck_mtx_unlock(&n2jd_lock);
+	return 0;
+}
+
+static void
+n2jd_job_end(uint32_t hw_us, uint32_t status, int err)
+{
+	lck_mtx_lock(&n2jd_lock);
+	n2jd.busy = false;
+	if (hw_us) { n2jd.last_hw_us = hw_us; }
+	if (status == 0 && err == 0) { n2jd.jobs_done++; }
+	else { n2jd.jobs_failed++; }                    /* hardware failure, or a source/copyout fault */
+	if (__atomic_load_n(&n2jd.powered, __ATOMIC_ACQUIRE)) {
+		n2jd.last_job_ns = n2jd_now_ns();
+		n2jd_schedule_off();
+	}
+	wakeup(&n2jd.busy);
+	lck_mtx_unlock(&n2jd_lock);
+}
+
+/*
+ * 0315: the hardware decoder experiment path (include/redwood_jpegdec.h).  User space supplies the register words (J04),
+ * the kernel owns the addresses: an address register must be 0 or a 16-aligned address below RWJD_LEGAL_END inside the
+ * decoder claim, an [I] scalar slot must be < 2^24 (so a misread "stride" can never be a DRAM address), every other
+ * offset outside the allow-list is refused.  VEN + JPGENC come up exactly as for an encode (n2jd_power_on); the decoder
+ * adds vencsys bit 12 (jpgdec core 0) and larb7 ports 11/12 (OSTDL 1/4, smi_conf.h larb7; NON_SEC_CON bypass), and gates
+ * bit 12 again after every job.
+ */
+#define N2JD_DEC_W(o)   (1ull << ((o) >> 2 & 63u))
+/* offsets 0x000..0x37c as two 64-bit maps per 0x100: allowed, address class, scalar [I] */
+static const uint64_t n2jd_dec_ok[4] = {
+	N2JD_DEC_W(0x090) | N2JD_DEC_W(0x0f8) | N2JD_DEC_W(0x0fc),
+	0xffull << 16 | 3ull << 24 | 3ull << 27 | 1ull << 31,                  /* 0x140-0x164, 0x16c, 0x170, 0x17c (not 0x168/0x174/0x178) */
+	N2JD_DEC_W(0x200) | N2JD_DEC_W(0x20c) | N2JD_DEC_W(0x210) | N2JD_DEC_W(0x224) | N2JD_DEC_W(0x23c) |
+	    N2JD_DEC_W(0x240) | N2JD_DEC_W(0x248) | N2JD_DEC_W(0x24c) | N2JD_DEC_W(0x270) | N2JD_DEC_W(0x274),
+	N2JD_DEC_W(0x31c) | N2JD_DEC_W(0x320) | N2JD_DEC_W(0x330) | N2JD_DEC_W(0x334) | N2JD_DEC_W(0x338) |
+	    N2JD_DEC_W(0x33c) | N2JD_DEC_W(0x344) | N2JD_DEC_W(0x36c) | N2JD_DEC_W(0x370) | N2JD_DEC_W(0x374),
+};
+static const uint64_t n2jd_dec_addr[4] = {
+	0, 0x3full << 16,                                                                            /* DEST banks 0x140-0x154 */
+	N2JD_DEC_W(0x200) | N2JD_DEC_W(0x248),
+	N2JD_DEC_W(0x31c) | N2JD_DEC_W(0x338) | N2JD_DEC_W(0x36c) | N2JD_DEC_W(0x370) | N2JD_DEC_W(0x374),
+};
+static const uint64_t n2jd_dec_scalar[4] = {
+	0, 1ull << 31, 0, N2JD_DEC_W(0x330) | N2JD_DEC_W(0x334) | N2JD_DEC_W(0x33c) | N2JD_DEC_W(0x344),
+};
+_Static_assert(N2JD_DEC_W(0x17c) == 1ull << 31 && N2JD_DEC_W(0x140) == 1ull << 16, "allow-list bit layout");
+_Static_assert(RWJD_PA >= RW_CLAIM_JPEG_PA + RW_CLAIM_JPEG_BYTES && RWJD_PA + RWJD_BYTES <= 0xdfe70000u &&
+    (RW_CLAIM_VCODEC_PA + RW_CLAIM_VCODEC_BYTES <= RWJD_PA || RW_CLAIM_VCODEC_PA >= RWJD_PA + RWJD_BYTES),
+    "the decoder claim must sit between the JPEG claim and DPM and clear of the vcodec pool");
+
+/* 0 or the errno for one register of a write list */
+static int
+n2jd_dec_check(const struct rwjd_reg *r)
+{
+	uint32_t o = r->off;
+	if ((o & 3u) || o >= 0x380u) { return EINVAL; }
+	uint64_t b = N2JD_DEC_W(o);
+	unsigned i = o >> 8;
+	if (!(n2jd_dec_ok[i] & b)) { return EPERM; }
+	if ((n2jd_dec_addr[i] & b) && r->value != 0 &&
+	    (r->value < RWJD_PA || r->value >= RWJD_LEGAL_END || (r->value & 15u))) { return EFAULT; }
+	if ((n2jd_dec_scalar[i] & b) && r->value >= 0x01000000u) { return EFAULT; }
+	return 0;
+}
+
+static void
+n2jd_dec_clock(bool on)
+{
+	ni_wr(n2j.cg, on ? 0x4 : 0x8, 1u << 12);                     /* vencsys SET/CLR: jpgdec core 0 */
+}
+
+static int
+n2jd_dec_run(struct rwjd_job *d, struct rwjd_reg *r)
+{
+	bool probe = (d->flags & RWJD_PROBE) != 0;
+	if (!n2jd_maps()) { d->out_status = RWJ_E_BUS; return EIO; }
+	if (!n2jd.dec) { n2jd.dec = n2j_map(RWJD_DEC_PA, 0x1000, 1); }
+	if (!n2jd.dbuf) { n2jd.dbuf = n2j_map(RWJD_PA, RWJD_BYTES, 0); }
+	if (!n2jd.dec || !n2jd.dbuf) { d->out_status = RWJ_E_BUS; return EIO; }
+	uint8_t *b = (uint8_t *)n2jd.dbuf;
+	if (!probe) {
+		int e = copyin((user_addr_t)d->src, b, d->src_bytes);
+		if (e) { return e; }
+		uint32_t pad = ((d->src_bytes + 127u) & ~127u) - d->src_bytes + 128u;
+		memset(b + d->src_bytes, 0, pad);
+		n2j_cache(n2jd.dbuf, d->src_bytes + pad);
+		memset(b + (RWJD_IDX_PA - RWJD_PA), 0, 0x10000u);
+		n2j_cache(n2jd.dbuf + (RWJD_IDX_PA - RWJD_PA), 0x10000u);
+		n2j_cache(n2jd.dbuf + (RWJD_OUT_PA - RWJD_PA), d->dst_bytes);     /* no dirty line may land on the output later */
+	}
+	uint32_t pr = n2jd_power_on();
+	if (pr) { d->out_status = pr; return EIO; }
+	n2jd_dec_clock(true);
+	vm_offset_t v = n2jd.dec;
+	int err = 0;
+	if (probe) {
+		for (uint32_t i = 0; i < d->nregs; i++) { r[i].value = ni_rd(v, r[i].off); }
+	} else {
+		ni_wr(n2j.larb, 0x200 + 4 * 11, 1); ni_wr(n2j.larb, 0x200 + 4 * 12, 4);
+		ni_mask(n2j.larb, 0x380 + 4 * 11, 0xff01u, 0); ni_mask(n2j.larb, 0x380 + 4 * 12, 0xff01u, 0);
+		if ((ni_rd(n2j.larb, 0x380 + 4 * 11) | ni_rd(n2j.larb, 0x380 + 4 * 12)) & 0xff01u) {
+			d->out_status = RWJ_E_BUS;
+			err = EIO;
+		} else {
+			for (uint32_t i = 0; i < d->nregs; i++) { ni_wr(v, r[i].off, r[i].value); }
+			uint64_t t0 = mach_absolute_time(), ns = 0;
+			uint32_t st = 0;
+			for (uint32_t waited = 0;; ) {
+				st = ni_rd(v, 0x274) & 0x37u;
+				if (st) { break; }
+				absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+				if (ns >= (uint64_t)d->timeout_ms * 1000000u) { break; }
+				uint32_t step = waited < 2000u ? 20u : 100u;
+				n2j_us(step);
+				waited += step;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			d->out_hw_us = ns / 1000u > UINT32_MAX ? UINT32_MAX : (uint32_t)(ns / 1000u);
+			d->out_status = !st ? RWJ_E_TIMEOUT : (st & 1u) && !(st & 0x36u) ? 0 : RWJ_E_STALL;
+			if (d->out_status) { err = EIO; }
+		}
+	}
+	d->out_irq = ni_rd(v, 0x274); d->out_state = ni_rd(v, 0x278); d->out_mcu = ni_rd(v, 0x340);
+	if (!probe) {
+		ni_wr(v, 0x274, 0x37u);                                      /* clear, then the hybrid WAIT's reset 0x00/0x10 */
+		ni_wr(v, 0x090, 0); ni_wr(v, 0x090, 0x10u);
+	}
+	n2jd_dec_clock(false);
+	if (!err && !probe && d->dst_bytes) {
+		n2j_cache(n2jd.dbuf + (RWJD_OUT_PA - RWJD_PA), d->dst_bytes);
+		err = copyout(b + (RWJD_OUT_PA - RWJD_PA), (user_addr_t)d->dst, d->dst_bytes);
+	}
+	n2j_log("NORD2 JPEG: dec%s %u regs -> %u irq %#x mcu %u in %u us\n", probe ? " probe" : "", d->nregs, d->out_status,
+	    d->out_irq, d->out_mcu, d->out_hw_us);
+	return err;
+}
+
+/* RWJD_JOB: copyin + validation without the lock, the job under the one-job lock like an encode */
+static int
+n2jd_dec_ioctl(caddr_t data)
+{
+	struct rwjd_job d;
+	struct rwjd_reg r[RWJD_REGS_MAX];
+	if (copyin((user_addr_t)(uintptr_t)data, &d, sizeof(d)) != 0) { return EFAULT; }
+	bool probe = (d.flags & RWJD_PROBE) != 0;
+	if ((d.flags & ~RWJD_PROBE) || d.nregs == 0 || d.nregs > RWJD_REGS_MAX || !d.regs || d.timeout_ms > RWJD_TIMEOUT_MAX_MS) { return EINVAL; }
+	if (!probe && (!d.src || d.src_bytes < 4u || d.src_bytes > RWJD_SRC_MAX - 256u || d.dst_bytes > RWJD_OUT_MAX ||
+	    (d.dst_bytes && !n2jd_urange(d.dst, 0, d.dst_bytes)) || !n2jd_urange(d.src, 0, d.src_bytes))) { return EINVAL; }
+	if (copyin((user_addr_t)d.regs, r, d.nregs * sizeof(r[0])) != 0) { return EFAULT; }
+	for (uint32_t i = 0; i < d.nregs; i++) {
+		if (probe) { if ((r[i].off & 3u) || r[i].off >= 0x400u) { return EINVAL; } }
+		else { int e = n2jd_dec_check(&r[i]); if (e) { return e; } }
+	}
+	d.out_status = d.out_hw_us = d.out_irq = d.out_state = d.out_mcu = 0;
+	int err = n2jd_job_begin();
+	if (err) { return err; }
+	err = n2jd_dec_run(&d, r);
+	n2jd_job_end(d.out_hw_us, d.out_status, err);
+	if (probe && copyout(r, (user_addr_t)d.regs, d.nregs * sizeof(r[0])) != 0 && !err) { err = EFAULT; }
+	if (copyout(&d, (user_addr_t)(uintptr_t)data, sizeof(d)) != 0 && !err) { err = EFAULT; }
+	return err;
+}
+
