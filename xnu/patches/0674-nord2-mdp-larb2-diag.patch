 static uint32_t n2mdp_diag_logged;
 
+/* 0674: full pipe dump (RDMA / WROT / mutex / topology / direct-link valid-ready / larb2), read-only except the WROT debug
+ * selector 0x018 (vendor cmdq_mdp_dump_rot does the same).  Used before GO, shortly after GO and on every timeout. */
+static void
+n2mdp_diag(const struct n2mdp_prog *p, const char *when)
+{
+	uint32_t R = N2MDP_W_RDMA(p->pipe), W = N2MDP_W_WROT(p->pipe), X = N2MDP_W_MUTEX, mid = p->mutex;
+	uint32_t m0 = n2mdp_rd(R + 0x400u), m1 = n2mdp_rd(R + 0x408u), hv = n2mdp_rd(R + 0x4d0u);
+	N2MDP_LOG("NORD2 MDP DIAG %s: RDMA EN %#x INT_EN %#x INT_ST %#x CON %#x GMCIF %#x SRC_CON %#x BASE %#x END %#x PITCH %#x SIZE %#x CLIP %#x"
+	    " OFS %#x | MON0 %#x (ack %u req %u) MON1 %#x (state %#x grep %u) h/v %u/%u\n", when, n2mdp_rd(R + 0x0u), n2mdp_rd(R + 0x10u),
+	    n2mdp_rd(R + 0x18u), n2mdp_rd(R + 0x20u), n2mdp_rd(R + 0x28u), n2mdp_rd(R + 0x30u), n2mdp_rd(R + 0xf00u), n2mdp_rd(R + 0x100u),
+	    n2mdp_rd(R + 0x60u), n2mdp_rd(R + 0x70u), n2mdp_rd(R + 0x78u), n2mdp_rd(R + 0x118u), m0, (m0 >> 11) & 1u, (m0 >> 10) & 1u, m1,
+	    (m1 >> 8) & 0x7ffu, (m1 >> 20) & 1u, hv & 0xfffu, (hv >> 16) & 0xfffu);
+	uint32_t dbg[8];
+	for (unsigned k = 0; k < 8; k++) { n2mdp_wr(W + 0x018u, (k + 1u) << 8); dbg[k] = n2mdp_rd(W + 0x0d0u); }
+	N2MDP_LOG("NORD2 MDP DIAG %s: WROT CTRL %#x MAIN_BUF %#x SUB_BUF %#x INT %#x TAR %#x IN %#x STRIDE %#x BASE %#x OFST %#x ROT_EN %#x"
+	    " RST %#x/%#x EOL %#x PENDING0 %#x FRAME %#x | dbg1-8 %#x %#x %#x %#x %#x %#x %#x %#x\n", when, n2mdp_rd(W + 0x0u), n2mdp_rd(W + 0x8u),
+	    n2mdp_rd(W + 0xcu), n2mdp_rd(W + 0x1cu), n2mdp_rd(W + 0x24u), n2mdp_rd(W + 0x78u), n2mdp_rd(W + 0x30u), n2mdp_rd(W + 0xf00u),
+	    n2mdp_rd(W + 0x2cu), n2mdp_rd(W + 0x7cu), n2mdp_rd(W + 0x10u), n2mdp_rd(W + 0x14u), n2mdp_rd(W + 0x70u), n2mdp_rd(W + 0xe0u),
+	    n2mdp_rd(W + 0x28u), dbg[0], dbg[1], dbg[2], dbg[3], dbg[4], dbg[5], dbg[6], dbg[7]);
+	N2MDP_LOG("NORD2 MDP DIAG %s: MUTEX INTEN %#x INTSTA %#x (sof %u eof %u) EN %#x SOF %#x MOD0 %#x MOD1 %#x | TOPO RDMA0 MOUT %#x RDMA2 MOUT %#x"
+	    " WROT0 SEL %#x WROT2 SEL %#x MASK %#x %#x %#x | DL_VALID %#x %#x %#x DL_READY %#x %#x %#x | UNDERRUN %#x id %#x | CG %#x %#x %#x"
+	    " | ev wrot %u rdma %u | M4U1 FAULT %#x\n", when, n2mdp_rd(X + 0x0u), n2mdp_rd(X + 0x4u), (n2mdp_rd(X + 0x4u) >> mid) & 1u,
+	    (n2mdp_rd(X + 0x4u) >> (mid + 16u)) & 1u, n2mdp_rd(N2MDP_MUTEX_EN(mid)), n2mdp_rd(N2MDP_MUTEX_SOF(mid)), n2mdp_rd(N2MDP_MUTEX_MOD0(mid)),
+	    n2mdp_rd(N2MDP_MUTEX_MOD1(mid)), n2mdp_rd(0xf20u), n2mdp_rd(0xf28u), n2mdp_rd(0xf70u), n2mdp_rd(0xf78u), n2mdp_rd(0xfd0u),
+	    n2mdp_rd(0xfd4u), n2mdp_rd(0xfd8u), n2mdp_rd(0xfe0u), n2mdp_rd(0xfe4u), n2mdp_rd(0xfe8u), n2mdp_rd(0xff0u), n2mdp_rd(0xff4u),
+	    n2mdp_rd(0xff8u), n2mdp_rd(0xe00u), n2mdp_rd(0xe04u), n2mdp_rd(0x100u), n2mdp_rd(0x110u), n2mdp_rd(0x120u),
+	    n2mdp_gce_event(N2MDP_EV_WROT_DONE(p->pipe)), n2mdp_gce_event(N2MDP_EV_RDMA_DONE(p->pipe)), n2mdp_rd(0x27000u + 0x134u));
+	n2mdp_larb_dump(when);
+}
