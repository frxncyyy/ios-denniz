+				    ccif[0x100 / 4 + q + 4], ccif[0x100 / 4 + q + 5], ccif[0x100 / 4 + q + 6], ccif[0x100 / 4 + q + 7]);
+				delay_for_interval(20, NSEC_PER_MSEC);
+			}
+		}
+		if (answered && (k == 8 || k == 20 || k == 100 || k == 200 || k == 300 || k == 400 || k == 600)) {
+			printf("NORD2 MODEM: t=%u ms SRAM tail: %08x %08x %08x | start=%08x busy=%08x\n", k * 50,
+			    ccif[(0x100 + 0x1b8) / 4], ccif[(0x100 + 0x1bc) / 4], ccif[(0x100 + 0x1c0) / 4], ccif[0x08 / 4], ccif[0x04 / 4]);
+		}
+		if (answered && rch != last_rch && k > 0) {
+			unsigned q;
+			printf("NORD2 MODEM: start t=%u ms rch changed to %08x (busy=%08x)\n", k * 50, rch, busy);
