+/* Parse (and consume) all complete packets MD->AP in ring q; log header and the first payload words. */
+static unsigned sweet_rx_logged;
+static void
+sweet_ring_rx(unsigned q)
+{
+	volatile uint32_t *c = sweet_ring[q];
+	volatile uint8_t *data = (volatile uint8_t *)(c + 6);       /* rx data follows the control block */
+	uint32_t rd, wr, len;
+
+	if (c == NULL || sweet_rxq[q] == 0) {
+		return;
+	}
+	len = c[2];
+	for (;;) {
+		uint32_t hdr[2], size, plen, adv, i, w[16];
+		rd = c[0];
+		wr = c[1];
+		size = wr >= rd ? wr - rd : wr + len - rd;
+		if (size < 8 + 16 + 8) {
+			return;
+		}
+		for (i = 0; i < 2; i++) {
+			uint32_t o = (rd + 4 * i) % len;
+			hdr[i] = data[o] | (data[(o + 1) % len] << 8) | (data[(o + 2) % len] << 16) | ((uint32_t)data[(o + 3) % len] << 24);
+		}
+		if (hdr[0] != 0xAABBAABBU) {
+			printf("NORD2 MODEM: rx q%u bad header %08x at rd=%u wr=%u\n", q, hdr[0], rd, wr);
+			c[0] = wr;
+			return;
+		}
+		plen = hdr[1];
+		adv = (8 + plen + 8 + 7) & ~7U;
+		if (adv > size) {
+			return;                  /* incomplete */
+		}
+		for (i = 0; i < 16 && i * 4 < plen; i++) {
+			uint32_t o = (rd + 8 + 4 * i) % len;
+			w[i] = data[o] | (data[(o + 1) % len] << 8) | (data[(o + 2) % len] << 16) | ((uint32_t)data[(o + 3) % len] << 24);
+		}
+		if (sweet_rx_logged < 120) {
+			sweet_rx_logged++;
+			printf("NORD2 MODEM: rx q%u len=%u: %08x %08x %08x %08x | %08x %08x %08x %08x\n", q, plen,
+			    w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		}
+		c[0] = (rd + adv) % len;
+	}
+}
