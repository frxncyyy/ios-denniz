+/*
+ * 0206: start MD1 from XNU and watch CCIF (stage 3).  Linux order (modem_sys1.c md_cd_start, md_sys1_platform.c md_cd_power_on and
+ * md_cd_let_md_go): CCIF SRAM reset, MD SRCCLKENA, SPM sleep regs, flight mode off, MTCMOS (already on), SMC MD_KERNEL_BOOT_UP.
+ * Nothing answers the modem yet, so it is expected to stall at the CCIF handshake; the goal is to log what it sends first.
+ * Runs once, 20 s after policy registration, from a thread call; polling is bounded to 25 s.
+ */
+static thread_call_t sweet_modem_start_call;
+
+/*
+ * 0216: CCIF ring queues (Linux hif/ccci_hif_ccif.c md_ccif_ring_buf_init + ccci_ringbuf.c).  16 queues in CCISM_MCU (0x8e139000), then the
+ * 16 exception rings in CCISM_MCU_EXP (0x8e1ed400).  Per queue: u32 0xEE0000EE x2, {rx.read, rx.write, rx.length, tx.read, tx.write,
+ * tx.length}, rx data (MD->AP), tx data (AP->MD), u32 0xFF0000FF x2.  Packets: {0xAABBAABB, len} + ccci_header(16) + payload, padded to 8,
+ * + {0xCCDDEEFF, 0xCCDDEEFF}.  Shared memory is accessed with ml_io_map_wcomb: the Device-nGnRnE mapping of ml_io_map hangs on these ranges.
+ */
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+
+static const uint32_t sweet_rxq[16] = { 80 << 10, 80 << 10, 40 << 10, 80 << 10, 20 << 10, 20 << 10, 64 << 10, 0, 8 << 10, 0, 0, 0, 0, 0, 0, 0 };
+static const uint32_t sweet_txq[16] = { 128 << 10, 40 << 10, 8 << 10, 40 << 10, 20 << 10, 20 << 10, 64 << 10, 0, 8 << 10, 0, 0, 0, 0, 0, 0, 0 };
+/* exception ring sizes (rx = tx): 12,32,8,0,0,0,8 KiB - not created, see sweet_rings_init */
+
+static volatile uint32_t *sweet_ring[16];     /* ring i control block (after the 8-byte header), word pointer */
+static uint32_t sweet_ring_pa[16];
+
+static void
+sweet_ring_create(volatile uint32_t *b, uint32_t rx, uint32_t tx)
+{
+	uint32_t buflen = 40 + rx + tx, i;
+
+	for (i = 0; i < buflen / 4; i++) {
+		b[i] = 0;
+	}
+	b[0] = 0xEE0000EEU;
+	b[1] = 0xEE0000EEU;
+	b[2 + 2] = rx;                    /* rx_control.length (read=2, write=3? see struct: read, write, length) */
+	b[2 + 5] = tx;
+	b[buflen / 4 - 1] = 0xFF0000FFU;
+	b[buflen / 4 - 2] = 0xFF0000FFU;
+}
+
+static int
+sweet_rings_init(void)
+{
+	uintptr_t pa = 0x8e139000UL;
+	unsigned q;
+
+	for (q = 0; q < 16; q++) {
+		uint32_t buflen = 40 + sweet_rxq[q] + sweet_txq[q];
+		volatile uint32_t *b = (volatile uint32_t *)ml_io_map_wcomb(pa, (buflen + 0xfff) & ~0xfffU);
+		if (b == NULL) {
+			printf("NORD2 MODEM: ring %u map failed\n", q);
+			return -1;
+		}
+		sweet_ring_create(b, sweet_rxq[q], sweet_txq[q]);
+		sweet_ring[q] = b + 2;        /* control block: rx{read,write,length}, tx{read,write,length} */
+		sweet_ring_pa[q] = (uint32_t)pa;
+		pa += buflen;
+	}
+	printf("NORD2 MODEM: rings: 16 queues created, end pa %#lx (region end 0x8e20b800)\n", (unsigned long)pa);
+	{
+		/* 0225: exception rings (Linux md_ccif_exp_ring_buf_init) and the cacheable-bank clears Linux does at first boot,
+		 * now with MD1 still on and the system quiet (the earlier hangs were interference, not address specific) */
+		static const uint32_t rxe[16] = { 12 << 10, 32 << 10, 8 << 10, 0, 0, 0, 8 << 10, 0, 0, 0, 0, 0, 0, 0, 0, 0 };
+		static const struct { uintptr_t pa; uint32_t len; const char *name; } cl[] = {
+			{ 0x8ad80000UL, 0x700000,  "MD_NVRAM_CACHE" },
+			{ 0x8b500000UL, 0x200000,  "CCB" },
+			{ 0x8b700000UL, 0x1e00000, "RAW_DHL/MDM" },
+		};
+		unsigned qe, rr;
+		uintptr_t epa = 0x8e1ed400UL;
+
+		printf("NORD2 MODEM: step: exception rings next\n");
+		delay_for_interval(3000, NSEC_PER_MSEC);
+		for (qe = 0; qe < 16; qe++) {
+			uint32_t buflen = 40 + rxe[qe] * 2;
+			volatile uint32_t *b;
+			if (1 || rxe[qe] == 0) {            /* exception ring writes hang the AP (also with MD1 off): skipped */
+				epa += buflen;
+				continue;
+			}
+			printf("NORD2 MODEM: exp ring %u (Device mapping) pa %#lx len %#x: writing\n", qe, (unsigned long)epa, buflen);
+			delay_for_interval(3000, NSEC_PER_MSEC);
+			b = (volatile uint32_t *)ml_io_map_wcomb(epa, (buflen + 0xfff) & ~0xfffU);
+			if (b == NULL) {
+				printf("NORD2 MODEM: exp ring %u map failed\n", qe);
+				return -1;
+			}
+			sweet_ring_create(b, rxe[qe], rxe[qe]);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			printf("NORD2 MODEM: exp ring %u done\n", qe);
+			epa += buflen;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("NORD2 MODEM: rings: 16 exception queues created, end pa %#lx\n", (unsigned long)epa);
+		delay_for_interval(3000, NSEC_PER_MSEC);
+		for (rr = 0; rr < sizeof(cl) / sizeof(cl[0]); rr++) {
+			uint32_t off;
+			printf("NORD2 MODEM: clear(wcomb) %s pa %#lx len %#x\n", cl[rr].name, (unsigned long)cl[rr].pa, cl[rr].len);
+			delay_for_interval(3000, NSEC_PER_MSEC);
+			for (off = 0; off < cl[rr].len; off += 0x100000) {
+				volatile uint32_t *m;
+				if ((off & 0x3fffff) == 0) {
+					printf("NORD2 MODEM: %s MiB at %#lx (Device mapping): writing\n", cl[rr].name, (unsigned long)(cl[rr].pa + off));
+					delay_for_interval(3000, NSEC_PER_MSEC);
+				}
+				m = (volatile uint32_t *)ml_io_map(cl[rr].pa + off, 0x100000);
+				uint32_t j;
+				if (m == NULL) {
+					printf("NORD2 MODEM: map failed %#lx\n", (unsigned long)(cl[rr].pa + off));
+					return -1;
+				}
+				for (j = 0; j < 0x100000 / 4; j++) {
+					m[j] = 0;
+				}
+				__asm__ volatile ("dsb sy" ::: "memory");
+			}
+			printf("NORD2 MODEM: %s cleared\n", cl[rr].name);
+			delay_for_interval(3000, NSEC_PER_MSEC);
+		}
+	}
+	return 0;
+}
