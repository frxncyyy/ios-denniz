+/*
+ * 0641 (cpu-20261114): CPU platform parity with the vendor kernel, three independent bits of n2p_mode (0 = the pre-0641 behaviour bit for bit).
+ *   N2P_COL  the CCI (DSU/L3 + interconnect) row follows the FASTER big cluster.  Before, the CCI column was the B row alone, so with the UI floors
+ *            (L 2200 MHz on cpu4-6 where the UI threads run, B 1998 MHz) the CCI sat at row 8 = 1021 MHz.  The column is now the B row whose clock is
+ *            the first at or above max(L clock, B clock) (L 2200 -> B row 5 = 2284 -> CCI row 6 = 1182 MHz).  Every row this can select was already
+ *            selected by the old rule for some B row (rows 1..10, same 1000 mV LL/CCI rail).
+ *   N2P_LL   the LL cluster (cpu0-3, A55) at row 0 = 2000 MHz instead of the bootloader row 1 = 1800 MHz (vendor table: 160 x 6.25 mV = 1000 mV, the
+ *            voltage the shared LL/CCI rail already measures at boot).  Checked once by the CPU clock measurement; a miss puts row 1 back for the boot.
+ *   N2P_PERF the vendor CCI 'perf' half of the map (rows 16..31; mtk_cm_mgr_platform.c sets it for 100 ms on every cm_mgr perf hint through
+ *            mt_cpufreq_update_cci_mode(1)) while the UI animates, is touched or janks.  Its fastest row is CCI row 0 = 1700 MHz at the same 1000 mV.
+ * The DVFS thread sets n2p_mode after the bring-up (the bring-up itself runs with 0) and n2p_perf_now on every governor tick.
+ */
+#define N2P_COL   1u
+#define N2P_LL    2u
+#define N2P_PERF  4u
+static unsigned n2p_mode;
+static bool n2p_perf_now;
+static int n2p_cci_last = -1;          /* CCI row last stored by n2d_goto_row / n2d_set_row_fast / n2p_cci_refresh, -1 = not known */
+
+/* B row (0 = 3000 MHz .. 15) whose clock is the slowest still at or above mhz; 0 when none is */
+static inline unsigned
+n2p_b_row_for(unsigned mhz)
+{
+	for (unsigned i = N2DV_NR_FREQ; i-- > 0;) {
+		if (n2dv_l1_pvt[N2DV_NR_FREQ * N2DV_B + i][0] >= mhz) {
+			return i;
+		}
+	}
+	return 0;
+}
+
+/* the CCI row for the cluster rows r (LL, L, B) under n2p_mode / n2p_perf_now; n2p_mode == 0 is exactly n2dv_cci_row(r[LL], r[B]) */
+static inline uint32_t
+n2p_cci_for(const uint8_t r[3])
+{
+	unsigned ll = r[N2DV_LL] & 15u, col = r[N2DV_B] & 15u;
+	if (n2p_mode & N2P_COL) {
+		unsigned lmhz = n2dv_l1_pvt[N2DV_NR_FREQ * N2DV_L + (r[N2DV_L] & 15u)][0], bmhz = n2dv_l1_pvt[N2DV_NR_FREQ * N2DV_B + col][0];
+		col = n2p_b_row_for(lmhz > bmhz ? lmhz : bmhz);
+	}
+	if ((n2p_mode & N2P_PERF) && n2p_perf_now) {
+		return n2dv_l1_cci[16u + ll][col];
+	}
+	return n2dv_l1_cci[ll][col];
+}
+
+/* whether the CCI store goes before the cluster store: a faster CCI first, a slower one last; ties follow the cluster direction (the pre-0641 order) */
+static inline bool
+n2p_cci_first(uint32_t cci, int cur_cci, bool cluster_faster)
+{
+	if (cur_cci < 0) {
+		return cluster_faster;
+	}
+	return cluster_faster ? (int)cci <= cur_cci : (int)cci < cur_cci;
+}
