+/*
+ * 0641 (cpu-20261114): platform parity bits of nord2_dvfs.h (N2P_COL | N2P_LL | N2P_PERF), applied by the policy loop (kern.n2dvfs_mode >= 2) only.
+ * kern.n2cpuplat (run time) = the bits; boot default 7 (all), n2gdv +16 = 1 (CCI column only;
+ * n2gdv=25 fits the boot line; every other bit up to 65536 belongs to 0461-0633).  Full off = the chain without 0641.
+ * LL boost and the CCI perf half are dropped from thermal level 2 (battery 43.0 C) on and come back below it (ladder hysteresis).
+ * Every 2 s, next to the DECISION line: 'NORD2 CPUPLAT: mode= ll=MHz cci=MHz(row) perf=on|off | 2s: perf_ms= ll_fast_ms= cci_writes= ll_moves= | ll_bad='.
+ */
+static int nord2_cpuplat = -1;          /* -1 until the DVFS thread sets the boot default */
+SYSCTL_INT(_kern, OID_AUTO, n2cpuplat, CTLFLAG_RW | CTLFLAG_LOCKED, &nord2_cpuplat, 0, "0641: 1 CCI follows the faster big cluster, 2 LL at 2000 MHz, 4 CCI perf map while animating/touched");
+static struct {
+	bool ll_checked, ll_bad;
+	unsigned perf_ms, ll_fast_ms, cci_writes, ll_moves;
+	uint64_t last_ms;
+} n2p_st;
+
+static void
+n2p_tick(const struct n2d_ops *o, struct n2d_state *st, const struct n2s_gov *g, bool act)
+{
+	unsigned want_mode = nord2_cpuplat < 0 ? 0u : ((unsigned)nord2_cpuplat & (N2P_COL | N2P_LL | N2P_PERF));
+	uint64_t now = n2dv_now_ms(NULL);
+	unsigned dt = n2p_st.last_ms != 0 && now > n2p_st.last_ms && now - n2p_st.last_ms < 1000u ? (unsigned)(now - n2p_st.last_ms) : 0u;
+	n2p_st.last_ms = now;
+	if (!act || st->stopped || !st->inited) {
+		want_mode = 0;                                                     /* the 0172 governor or nothing acts: the pre-0641 CCI rule */
+	}
+	bool cool = g->th.level < 2u;
+	n2p_mode = want_mode;
+	n2p_perf_now = (want_mode & N2P_PERF) && cool && g->act.cls >= N2G_ANIM;
+	if (st->stopped || !st->inited) {
+		return;
+	}
+	unsigned ll_want = (want_mode & N2P_LL) && cool && !n2p_st.ll_bad ? 0u : st->orig[N2DV_LL];
+	if (st->cur[N2DV_LL] != ll_want) {
+		n2d_set_row_fast(o, NULL, st, N2DV_LL, ll_want);                  /* one row (1 <-> 0), CCI order included */
+		n2p_st.ll_moves++;
+		if (ll_want == 0 && !n2p_st.ll_checked) {
+			n2cf_sleep_ms(NULL, 20);
+			unsigned m = nord2_cpu_mhz(n2d_first_cpu[N2DV_LL]), want = n2d_row_mhz(N2DV_LL, 0);
+			n2p_st.ll_checked = true;
+			if (!n2d_within_pct(m, want, N2D_CLOCK_PCT)) {
+				n2p_st.ll_bad = true;
+				n2d_set_row_fast(o, NULL, st, N2DV_LL, st->orig[N2DV_LL]);
+				printf("NORD2 CPUPLAT: LL row 0 (%u MHz) NOT reached (cpu0 measures %u MHz): row %u back, LL boost off for this boot\n", want, m, st->orig[N2DV_LL]);
+			} else {
+				printf("NORD2 CPUPLAT: LL row 0 verified: cpu0 measures %u MHz (asked %u MHz, was %u MHz)\n", m, want, n2d_row_mhz(N2DV_LL, st->orig[N2DV_LL]));
+			}
+		}
+	}
+	if (n2p_cci_refresh(o, NULL, st)) {
+		n2p_st.cci_writes++;
+	}
+	if (n2p_perf_now) {
+		n2p_st.perf_ms += dt;
+	}
+	if (st->cur[N2DV_LL] == 0 && st->orig[N2DV_LL] != 0) {
+		n2p_st.ll_fast_ms += dt;
+	}
+}
+
+static void
+n2p_print(const struct n2d_state *st)
+{
+	int row = n2p_cci_last;
+	printf("NORD2 CPUPLAT: mode=%u ll=%uMHz cci=%dMHz(row %d) perf=%s | 2s: perf_ms=%u ll_fast_ms=%u cci_writes=%u ll_moves=%u | ll_bad=%u\n", n2p_mode,
+	    n2d_row_mhz(N2DV_LL, st->cur[N2DV_LL]), row >= 0 && row < 16 ? (int)n2d_row_mhz(N2DV_CCI, (unsigned)row) : -1, row, n2p_perf_now ? "on" : "off",
+	    n2p_st.perf_ms, n2p_st.ll_fast_ms, n2p_st.cci_writes, n2p_st.ll_moves, n2p_st.ll_bad);
+	n2p_st.perf_ms = n2p_st.ll_fast_ms = n2p_st.cci_writes = n2p_st.ll_moves = 0;
+}
