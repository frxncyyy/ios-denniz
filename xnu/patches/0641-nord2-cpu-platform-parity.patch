+/* 0641: store the CCI row the current cluster rows ask for when it differs from the last one stored (n2p_mode or n2p_perf_now changed).  true = stored. */
+static inline bool
+n2p_cci_refresh(const struct n2d_ops *o, void *ctx, const struct n2d_state *st)
+{
+	if (st->stopped || !st->inited) {
+		return false;
+	}
+	uint32_t cci = n2p_cci_for(st->cur);
+	if (n2p_cci_last == (int)cci) {
+		return false;
+	}
+	o->w32(ctx, N2DV_OFF_REQ + 4 * N2DV_CCI, cci);
+	n2p_cci_last = (int)cci;
+	return true;
+}
