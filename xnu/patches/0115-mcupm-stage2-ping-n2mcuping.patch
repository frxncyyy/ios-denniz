 		printf("NORD2 MCUPM: n2mcu=%d (read-only probe at boot+%us%s)\n", nord2_mcu_arg, N2CF_FIRST_S,
 		    nord2_mcu_arg >= 3 ? ", plus the unmapped gap" : (nord2_mcu_arg == 2 ? ", plus window map and liveness diff at +180 s" : ""));
