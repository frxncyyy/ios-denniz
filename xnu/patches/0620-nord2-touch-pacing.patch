+		n2tp_on = tp ? 1 : 0;
+		printf("NORD2 INPUT PACE: on=%u half_us=%u period_us=%u (0620; finger down only; off: n2gdv +2048 / n2tp=0 / kern.n2tpace=0)\n",
+		    n2tp_on, n2tp_half_us, n2tp_period_us);
