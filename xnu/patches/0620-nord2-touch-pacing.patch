     "0560 camera flash: 1 strobe requests use the MT6360 STROBE mode, 0 they become torch pulses");
 SYSCTL_PROC(_kern, OID_AUTO, n2torch_strobesel, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 5, n2t_sysctl_cfg, "I",
