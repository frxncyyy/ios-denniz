+        }
+        if (winUs && top[0].d) {
+                char b[160]; unsigned o = 0;
+                for (unsigned t = 0; t < 4 && top[t].d; t++) o += (unsigned)snprintf(b + o, sizeof(b) - o, "%s%s=%llums", t ? " " : "", n2_pcur[top[t].idx].name, top[t].d / 1000000ull);
