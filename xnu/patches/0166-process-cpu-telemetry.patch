+static int n2_proc_cb(proc_t p, void *) {
+        if (n2_pcur_n >= 128) return 0;
+        task_t tk = proc_task(p); if (!tk) return 0;
+        task_absolutetime_info_data_t ti = {}; mach_msg_type_number_t cnt = TASK_ABSOLUTETIME_INFO_COUNT;
