+        for (unsigned i = 0; i < n2_pcur_n; i++) {
+                uint64_t prev = 0; for (unsigned k = 0; k < n2_pprev_n; k++) if (n2_pprev[k].pid == n2_pcur[i].pid) { prev = n2_pprev[k].total; break; }
