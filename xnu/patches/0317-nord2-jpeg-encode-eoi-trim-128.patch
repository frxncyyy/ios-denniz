diff -ruN a/bsd/dev/nord2_jpegdev.inc b/bsd/dev/nord2_jpegdev.inc
--- a/bsd/dev/nord2_jpegdev.inc
+++ b/bsd/dev/nord2_jpegdev.inc
@@ -328,13 +328,17 @@
 	return 0;
 }
 
-/* the last FF D9 in the last 64 bytes (the block rounds its byte count up to 64); 0: no EOI found */
+/*
+ * The end of the JPEG: the FIRST FF D9 at or after max(2, size - 256). The block rounds its byte count up to 128 (phone
+ * run jp5: every size a multiple of 128, padding 0..127 bytes after the EOI; 0317, was "up to 64"), so the EOI is in the
+ * last 129 bytes. Entropy-coded data cannot contain FF D9 (FF is stuffed as FF 00), and searching forward ignores a stale
+ * EOI left in the padding by an earlier, longer job. 0: no EOI found.
+ */
 static uint32_t
 n2jd_cut(const uint8_t *o, uint32_t size)
 {
 	if (size < 4u) { return 0; }
-	for (uint32_t k = 0; k < 64u && k + 2u <= size; k++) {
-		uint32_t i = size - 2u - k;
+	for (uint32_t i = size > 258u ? size - 256u : 2u; i + 2u <= size; i++) {
 		if (o[i] == 0xffu && o[i + 1u] == 0xd9u) { return i + 2u; }
 	}
 	return 0;
@@ -433,7 +437,7 @@
 	}
 	uint32_t cut = n2jd_cut(o, size);
 	if (cut == 0) {
-		n2j_log("NORD2 JPEG: no FF D9 in the last 64 bytes of %u\n", size);
+		n2j_log("NORD2 JPEG: no FF D9 in the last 256 B of %u\n", size);
 		j->out_status = RWJ_E_SIZE;
 		return EIO;
 	}
