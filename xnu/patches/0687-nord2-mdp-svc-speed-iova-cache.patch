+/* 0687: IOVA mapping cache for the service path.  Key = FNV-1a over the page list + page count; a hit re-uses the IOVA range
+ * (no table writes, no TLB work).  The MDP only reaches a cached range when a request's page list hashes to the same key, i.e. the
+ * same physical pages, so a stale entry (surface freed) is never used for other memory; entries are evicted LRU (unmapped), and the
+ * whole cache is dropped on an IOVA fault.  8 entries ~ the camera's buffer rotation. */
+#define N2MDP_MC_N 8u
+static struct { uint64_t key; uint32_t n, iova, lru; } n2mdp_mc[N2MDP_MC_N];
+static uint32_t n2mdp_mc_tick, n2mdp_mc_hits, n2mdp_mc_miss;
+uint32_t n2mdp_last_map_us, n2mdp_last_run_us;     /* 0687: read by the service log (C linkage) */
+static uint64_t
+n2mdp_mc_key(const uint64_t *pages, uint32_t n)
+{
+	uint64_t h = 0xcbf29ce484222325ull ^ n;
+	for (uint32_t k = 0; k < n; k++) { h ^= pages[k] >> 12; h *= 0x100000001b3ull; }
+	return h ? h : 1u;
+}
+static void
+n2mdp_mc_drop(void)
+{
+	for (unsigned i = 0; i < N2MDP_MC_N; i++) {
+		if (n2mdp_mc[i].key) { n2mdp_iova_unmap(n2mdp_mc[i].iova, n2mdp_mc[i].n); n2mdp_mc[i].key = 0; }
+	}
+}
+static uint32_t
+n2mdp_mc_get(const uint64_t *pages, uint32_t n, uint32_t pin)
+{
+	uint64_t key = n2mdp_mc_key(pages, n);
+	unsigned victim = 0;
+	for (unsigned i = 0; i < N2MDP_MC_N; i++) {
+		if (n2mdp_mc[i].key == key && n2mdp_mc[i].n == n) { n2mdp_mc[i].lru = ++n2mdp_mc_tick; n2mdp_mc_hits++; return n2mdp_mc[i].iova; }
+		if (n2mdp_mc[i].key == 0) { victim = i; }
+	}
+	if (n2mdp_mc[victim].key) {          /* full: evict the least recently used entry that is not the one pinned for this job */
+		uint32_t best = 0xffffffffu;
+		for (unsigned i = 0; i < N2MDP_MC_N; i++) {
+			if (n2mdp_mc[i].iova != pin && n2mdp_mc[i].lru < best) { best = n2mdp_mc[i].lru; victim = i; }
+		}
+	}
+	for (int tries = 0; tries < 2; tries++) {
+		if (n2mdp_mc[victim].key) { n2mdp_iova_unmap(n2mdp_mc[victim].iova, n2mdp_mc[victim].n); n2mdp_mc[victim].key = 0; }
+		uint32_t iova = n2mdp_iova_map(pages, n);
+		if (iova) {
+			n2mdp_mc[victim].key = key; n2mdp_mc[victim].n = n; n2mdp_mc[victim].iova = iova; n2mdp_mc[victim].lru = ++n2mdp_mc_tick;
+			n2mdp_mc_miss++;
+			return iova;
+		}
+		/* IOVA window fragmented: drop every entry except the pinned one and retry once */
+		for (unsigned i = 0; i < N2MDP_MC_N; i++) {
+			if (n2mdp_mc[i].key && n2mdp_mc[i].iova != pin) { n2mdp_iova_unmap(n2mdp_mc[i].iova, n2mdp_mc[i].n); n2mdp_mc[i].key = 0; }
+		}
+	}
+	return 0;
+}
