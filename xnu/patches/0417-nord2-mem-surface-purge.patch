+	sweet_fb_iommu_surface_gone(s);         /* a cached IOVA of the old pages goes (nothing programmed: checked) */
+	OSIncrementAtomic((volatile SInt32 *)&sweet_purge_n);
+	if (bad != 0) {
+		OSAddAtomic((SInt32)bad, (volatile SInt32 *)&sweet_purge_remap_bad);
+	}
