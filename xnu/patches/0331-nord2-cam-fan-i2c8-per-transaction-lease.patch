 /*
  * I2C8 is the audio amplifiers' bus too (audio_i2c8.c drives its hardware controller and refuses to run unless GPIO122/123
  * are SCL8/SDA8; every refusal leaves the speaker offline). So the FAN53870 is set up ONCE, under the audio driver's own
  * lease flag (audio_hw_native.inc nah_native_bus_owned, compare-and-swap 0 -> 2), all the camera LDOs at their voltages
  * and on, the pins given back to function 1; the camera never touches I2C8 again (sensors are held in reset instead).
+ * 0331: the lease is taken for ONE transaction at a time (the longest, the 15-byte dump, is < 2 ms of bit-bang) and the
+ * pins are SCL8/SDA8 again before it is released, so a playback running meanwhile (its 20 ms amplifier status read,
+ * audio_hw_native.inc waits up to 4 ms for owner 2) is never refused; before the pins go back, a slave left holding SDA
+ * low is clocked free (9 SCL pulses + STOP), so the hardware controller never inherits a stuck bus.
  */
 static volatile unsigned nah_native_bus_owned;      /* tentative definition: audio_hw_native.inc defines it */
+static unsigned n2c_i2c8_clears, n2c_i2c8_busy;
 static void
 n2c_i2c_pins_back(const struct n2c_bus *b)
 {
 	n2c_mode(b->scl, 1);
 	n2c_mode(b->sda, 1);
 }
+static bool
+n2c_i2c8_take(void)
+{
+	for (unsigned tries = 0; tries < 2000; tries++) {        /* the audio worker holds it for whole amplifier sequences */
+		if (__sync_bool_compare_and_swap(&nah_native_bus_owned, 0, 2)) { n2c_bus_init(&n2c_i2c8); return true; }
+		n2c_sleep(1);
+	}
+	n2c_i2c8_busy++;
+	return false;
+}
+static void
+n2c_i2c8_give(void)
+{
+	if (!n2c_lvl(n2c_i2c8.sda)) {                             /* I2C bus clear (UM10204 3.1.16) */
+		n2c_i2c8_clears++;
+		for (unsigned i = 0; i < 9 && !n2c_lvl(n2c_i2c8.sda); i++) { n2c_line(n2c_i2c8.scl, false); (void)n2c_sclh(); }
+		(void)n2c_stop();
+	}
+	n2c_i2c_pins_back(&n2c_i2c8);
+	__sync_bool_compare_and_swap(&nah_native_bus_owned, 2, 0);
+}
+static bool
+n2c_fan_rd(uint8_t reg, uint8_t *data, unsigned n)
+{
+	if (!n2c_i2c8_take()) { return false; }
+	bool ok = n2c_rd(N2C_FAN, reg, 1, data, n);
+	n2c_i2c8_give();
+	return ok;
+}
+static bool
+n2c_fan_wr(uint8_t reg, uint8_t v)
+{
+	if (!n2c_i2c8_take()) { return false; }
+	bool ok = n2c_wr(N2C_FAN, reg, 1, v);
+	n2c_i2c8_give();
+	return ok;
+}
+static bool
+n2c_fan_upd(uint8_t reg, uint8_t mask, uint8_t val)
+{
+	uint8_t cur = 0;
+	if (!n2c_fan_rd(reg, &cur, 1)) { return false; }
+	return n2c_fan_wr(reg, (uint8_t)((cur & ~mask) | (val & mask)));
+}
 static bool n2c_fan_ready;
 static void n2c_fan_dump(void);
 
