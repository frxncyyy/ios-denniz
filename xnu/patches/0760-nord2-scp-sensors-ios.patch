+void
+SweetHIDSensor::status(char *buf, int len)
+{
+	snprintf(buf, (size_t)len, "%s c%u ri%s%u o%u e%u", fName, _clients ? _clients->getCount() : 0u, fIntervalSet ? "" : "?",
+	    (unsigned)fInterval, (unsigned)fOpens, (unsigned)fEvents);
+}
