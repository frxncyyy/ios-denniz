+static inline void
+n2dv_fallback_pin(const struct n2dv_ops *ops, void *ctx, const uint8_t row[3])
+{
+	for (unsigned c = 0; c < 3; c++) {
+		ops->w32(ctx, N2DV_OFF_PPM_LIMIT + 4 * c, (uint32_t)row[c] << 16 | row[c]);
