+			v = 0u << 16 | (N2DV_NR_FREQ - 1u);                                              /* default plan: full range, as the vendor driver */
+		}
+		ops->w32(ctx, off, v);
+	}
+	ops->w32(ctx, N2DV_OFF_DATA, N2DV_GUARD0);
