+static inline uint32_t
+n2dv_vproc_10uv(unsigned sel)
+{
+	return (sel >= 0x30u && sel <= 0xbfu) ? 30000u + (sel - 0x30u) * 625u : 0;
+}
+
+static inline uint32_t
+n2dv_vsram_10uv(unsigned sel)
+{
+	return sel <= 0x6fu ? 50000u + sel * 625u : 0;
+}
