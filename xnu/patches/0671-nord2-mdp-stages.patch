+
+struct n2mdp_pimg {
+	uint32_t fmt, w, h;
+	uint32_t pitch[2], off[2];      /* plane byte offsets from the first page */
+	uint8_t  full_range, bt709;
+	uint32_t npages;
+	const uint64_t *pages;          /* physical address of each 4 KiB page, in order */
+};
