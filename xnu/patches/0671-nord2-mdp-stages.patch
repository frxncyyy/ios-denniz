+/* ---- self-tests ----------------------------------------------------------------------------------------------------- */
+struct n2mdp_test {
+	const char *name;
+	uint8_t sfmt, dfmt, rot, flip, full, tile16, exact, stage;
+	uint16_t sw, sh, dw, dh;
+	uint32_t cap;
+};
+static const struct n2mdp_test n2mdp_tests[] = {
+	{ "copy256",     N2MF_BGRA, N2MF_BGRA, 0, 0, 0, 0,  1, 1, 256, 256, 256, 256, N2MDP_CAP_COPY },
+	{ "rot90",       N2MF_BGRA, N2MF_BGRA, 1, 0, 0, 0,  1, 1, 256, 256, 256, 256, N2MDP_CAP_ROT90 },
+	{ "rot180",      N2MF_BGRA, N2MF_BGRA, 2, 0, 0, 0,  1, 2, 256, 128, 256, 128, N2MDP_CAP_ROT180 },
+	{ "rot270",      N2MF_BGRA, N2MF_BGRA, 3, 0, 0, 0,  1, 2, 256, 128, 128, 256, N2MDP_CAP_ROT270 },
+	{ "flip",        N2MF_BGRA, N2MF_BGRA, 0, 1, 0, 0,  1, 2, 256, 128, 256, 128, N2MDP_CAP_FLIP },
+	{ "tilecopy",    N2MF_BGRA, N2MF_BGRA, 0, 0, 0, 16, 1, 2, 1024, 64, 1024, 64, N2MDP_CAP_TILE },
+	{ "tilerot90",   N2MF_BGRA, N2MF_BGRA, 1, 0, 0, 16, 1, 2, 1024, 64, 64, 1024, N2MDP_CAP_TILE },
+	{ "nv12v",       N2MF_NV12, N2MF_BGRA, 0, 0, 0, 0,  0, 2, 256, 256, 256, 256, N2MDP_CAP_NV12V },
+	{ "nv12f",       N2MF_NV12, N2MF_BGRA, 0, 0, 1, 0,  0, 2, 256, 256, 256, 256, N2MDP_CAP_NV12F },
+	{ "scaledown",   N2MF_BGRA, N2MF_BGRA, 0, 0, 0, 0,  0, 2, 512, 512, 256, 256, N2MDP_CAP_SCALE_DN },
+	{ "scaleup",     N2MF_BGRA, N2MF_BGRA, 0, 0, 0, 0,  0, 2, 128, 128, 256, 256, N2MDP_CAP_SCALE_UP },
+	{ "scalerot",    N2MF_NV12, N2MF_BGRA, 1, 0, 1, 0,  0, 2, 512, 256, 128, 256, N2MDP_CAP_SCALE_ROT },
+	{ "scaletile",   N2MF_BGRA, N2MF_BGRA, 0, 0, 0, 16, 0, 2, 1024, 64, 768, 48, N2MDP_CAP_TILE },
+};
+#define N2MDP_NTESTS (sizeof(n2mdp_tests) / sizeof(n2mdp_tests[0]))
