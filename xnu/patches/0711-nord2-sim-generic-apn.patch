+  size_t k = 0;
+  for (const char *q = c; *q;) {
+    if (!strncmp(q, from, fl) && q > c && q[-1] == '"' && q[fl] == '"') {
+      if (k + tl + 1 >= sizeof bb_ims_sub) return "AT";
+      memcpy(bb_ims_sub + k, to, tl); k += tl; q += fl;
