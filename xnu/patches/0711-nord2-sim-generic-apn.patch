+}
+static bool bb_apn_has(const uint8_t *a, uint32_t n, const char *w)
+{
+  const uint32_t l = (uint32_t)strlen(w);
+  for (uint32_t i = 0; i + l <= n; i++) {
+    uint32_t k = 0;
+    while (k < l && (a[i + k] | 32) == (uint8_t)w[k]) k++;
+    if (k == l) return true;
+  }
+  return false;
+}
+static void bb_apn_resync(void);
+// a CommCenter APN (profile or Start Network) for this SIM; src 2 profile, 3 Start Network (wins over a profile)
+static void bb_apn_learn(const uint8_t *a, uint32_t n, uint8_t src)
+{
+  if (!nord2_sim_apn || !a || !n || n > 30u || bb_apn_src == 1) return;     // <= 30: the AT+EAPNSET parameter line stays < 220
+  for (uint32_t i = 0; i < n; i++)                                    // an APN label (23.003): no quotes/commas for the AT lines
+    if (!((a[i] >= 'a' && a[i] <= 'z') || (a[i] >= 'A' && a[i] <= 'Z') || (a[i] >= '0' && a[i] <= '9') || a[i] == '.' || a[i] == '-' || a[i] == '_'))
+      return;
+  char v[48];
+  memcpy(v, a, n);
+  v[n] = 0;
+  if (bb_apn_has(a, n, "mms")) {
+    if (strcmp(bb_apn_mms, v)) { strlcpy(bb_apn_mms, v, sizeof bb_apn_mms); printf("NORD2 APN: MMS APN \"%s\" (from %s)\n", v, src == 3 ? "CommCenter Start Network" : "CommCenter profile"); }
+    return;
+  }
+  static const char *const aux[] = { "ims", "sos", "xcap", "ia", "emergency", "wap" };
+  for (const char *x : aux) if (strlen(x) == n && bb_apn_has(a, n, x)) return;
+  if (bb_apn[0] && (!strcmp(bb_apn, v) || src < bb_apn_src || (src == 2 && bb_apn_src == 2))) return;
+  strlcpy(bb_apn, v, sizeof bb_apn);
+  bb_apn_src = src;
+  printf("NORD2 APN: internet APN \"%s\" (from %s)%s\n", bb_apn, bb_apn_src_name(), bb_apn_synced ? ": adding it to the modem's APN table" : "");
+  if (bb_apn_synced && strcmp(bb_apn_synced_name, bb_apn)) bb_apn_resync();
+}
