+/* patch 0122: GPU_CONTROL performance counters (kbase mali_kbase_gpu_regmap.h): PRFCNT_BASE 0x60/0x64, PRFCNT_CONFIG 0x68 (mode 1 = manual, AS in bits 7:4),
+ * PRFCNT_JM_EN 0x6c, SHADER_EN 0x70, TILER_EN 0x74, MMU_L2_EN 0x7c; GPU_COMMAND 3 = clear, 4 = sample; GPU_IRQ_RAWSTAT bit 16 = sample completed.  The dump (blocks of 64
+ * 32-bit counters: job manager, tiler, memory-system/L2 slices, shader cores) is written to a 16 KiB kernel buffer mapped non-cacheable in AS0, which is the dummy-job
+ * workaround space and idle once the workaround ran; the stop path disables AS0 again.  Counters reset on every dump, so each printed block covers one stats window.
+ * Nothing but the dump buffer is written by the GPU. */
+#define N2PF_VA 0x200000000ull
+void Nord2GPU::prfcntSample() {
+        if (pfFailed || !core || core->state != N2C_CORE_READY || !core->gpu_powered) return;
+        if (!pfMd) {
+                pfMd = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut, 16384, 16384);
+                IOByteCount length = 0;
+                if (pfMd) { pfPa = pfMd->getPhysicalSegment(0, &length, kIOMemoryMapperNone); pfCpu = (uint8_t *)pfMd->getBytesNoCopy(); }
+                if (!pfMd || !valid_ram(pfPa) || length < 4096) { IOLog("NORD2 PRFCNT: no dump page\n"); pfFailed = true; return; }
+                pfBytes = length >= 16384 ? 16384 : 4096;
+                const nord2_gpu_mmu_ops mo = { allocTable, freeTable, flushTable, alloc_host, free_host, log_msg };
+                bool ok = nord2_gpu_mmu_init(&pfmmu, &mo, this, 4);
+                for (unsigned i = 0; ok && i < pfBytes / 4096; i++)
+                        ok = nord2_gpu_mmu_map(&pfmmu, N2PF_VA + i * 4096ull, pfPa + i * 4096ull, 4096, NORD2_GPU_MEMATTR_NON_CACHEABLE, true, false);
+                if (!ok) { IOLog("NORD2 PRFCNT: mapping failed\n"); pfFailed = true; return; }
+                bzero(pfCpu, 16384);
+                sync_page(NULL, pfPa, pfCpu, pfBytes, true);
+        }
+        if (read_bank(&gpu, 0x68) != 1u) {              /* reset or first use: program AS0 and the counters, the first window is only armed */
+                if (n2hw_as_configure(&hw, 0, pfmmu.root_pa) != N2HW_OK) { IOLog("NORD2 PRFCNT: AS0 configure failed\n"); pfFailed = true; return; }
+                write_bank(&gpu, 0x60, (uint32_t)N2PF_VA); write_bank(&gpu, 0x64, (uint32_t)(N2PF_VA >> 32));
+                write_bank(&gpu, 0x6c, 0xffffffffu); write_bank(&gpu, 0x70, 0xffffffffu);
+                write_bank(&gpu, 0x74, 0xffffffffu); write_bank(&gpu, 0x7c, 0xffffffffu);
+                write_bank(&gpu, 0x68, 1u);
+                write_bank(&gpu, 0x30, 3u);
+                pfLastUs = now_us(NULL);
+                IOLog("NORD2 PRFCNT: armed (AS0, VA %llx, %u bytes), l2_features=%08x shader_present=%08x%08x\n", N2PF_VA, pfBytes,
+                      read_bank(&gpu, N2HW_L2_FEATURES), read_bank(&gpu, N2HW_SHADER_PRESENT_HI), read_bank(&gpu, N2HW_SHADER_PRESENT_LO));
+                return;
+        }
+        bzero(pfCpu, pfBytes);
+        sync_page(NULL, pfPa, pfCpu, pfBytes, true);
+        write_bank(&gpu, 0x24, 1u << 16);
+        uint64_t t0 = now_us(NULL);
+        write_bank(&gpu, 0x30, 4u);
+        unsigned spin = 0;
+        while (!(read_bank(&gpu, 0x20) & (1u << 16)) && spin++ < 20000) IODelay(1);
+        if (!(read_bank(&gpu, 0x20) & (1u << 16))) { IOLog("NORD2 PRFCNT: sample timeout\n"); return; }
+        write_bank(&gpu, 0x24, 1u << 16);
+        sync_page(NULL, pfPa, pfCpu, pfBytes, true);
+        uint64_t t1 = now_us(NULL);
+        const uint32_t *w = (const uint32_t *)pfCpu;
+        unsigned nb = 0;
+        for (unsigned b = 0; b < pfBytes / 256; b++) { unsigned any = 0; for (unsigned i = 0; i < 64; i++) any |= w[b * 64 + i] != 0; nb += any != 0; }
+        IOLog("NORD2 PRFCNT: sample win_us=%llu took_us=%llu blocks=%u\n", t0 - pfLastUs, t1 - t0, nb);
+        pfLastUs = t1;
+        for (unsigned b = 0; b < pfBytes / 256; b++) {
+                unsigned any = 0; for (unsigned i = 0; i < 64; i++) any |= w[b * 64 + i] != 0;
+                if (!any) continue;
+                const uint32_t *q = w + b * 64;
+                IOLog("NORD2 PRFCNT b=%u:"
+                      " %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x"
+                      " %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x\n", b,
+                      q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], q[9], q[10], q[11], q[12], q[13], q[14], q[15],
+                      q[16], q[17], q[18], q[19], q[20], q[21], q[22], q[23], q[24], q[25], q[26], q[27], q[28], q[29], q[30], q[31],
+                      q[32], q[33], q[34], q[35], q[36], q[37], q[38], q[39], q[40], q[41], q[42], q[43], q[44], q[45], q[46], q[47],
+                      q[48], q[49], q[50], q[51], q[52], q[53], q[54], q[55], q[56], q[57], q[58], q[59], q[60], q[61], q[62], q[63]);
+        }
 }
