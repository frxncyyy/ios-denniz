+void
+AppleCLCD::blRequest(int32_t q16, const char *who)
+{
+	if (fBlLock == NULL) { return; }
+	IOLockLock(fBlLock);
+	struct sweet_bl_cfg c = sweet_bl_cfg_g;
+	uint32_t old = fBl.want_dbv, dbv = sweet_bl_request(&fBl, &c, q16);
+	uint32_t n = fBlLogN < 16 && dbv != old ? ++fBlLogN : 0;
+	IOLockUnlock(fBlLock);
+	if (n != 0) {
+		IOLog("NORD2 BL: %s %d.%02u nits -> DBV %u (floor %u max %u, %u nits at 2047, mode %u)%s\n", who, q16 >> 16,
+		    (unsigned)(((uint32_t)q16 & 0xffffu) * 100u >> 16), dbv, c.floor_dbv, c.max_dbv, c.nits_full, c.mode, n == 16 ? "; further requests in NORD2 BL SUM" : "");
+	}
+}
