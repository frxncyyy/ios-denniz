+	struct sweet_bl_cfg c = sweet_bl_cfg_g;
+	IOLockUnlock(fb->fBlLock);
+	uint32_t *field = arg2 == 0 ? &c.mode : arg2 == 1 ? &c.floor_dbv : arg2 == 2 ? &c.max_dbv : &c.nits_full;
