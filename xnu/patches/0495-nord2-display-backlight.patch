+	if (err != 0 || !changed) { return err; }
+	if (v < 0 || v > 4095) { return EINVAL; }
+	*field = (uint32_t)v;
+	sweet_bl_cfg_fix(&c);
+	IOLockLock(fb->fBlLock);
+	sweet_bl_cfg_g = c;
+	IOLockUnlock(fb->fBlLock);
+	fb->blConfigChanged();
+	IOLog("NORD2 BL: sysctl %s: mode %u floor %u max %u nits %u\n", oidp->oid_name, c.mode, c.floor_dbv, c.max_dbv, c.nits_full);
