+static void resv_sweep(struct n2c_core *c)
+{
+        uint64_t t = now(c);
+        for (unsigned i = 0; i < N2C_RESV_SLOTS; i++) {
+                struct n2c_resv *r = &c->resv[i];
+                if (!r->id)
+                        continue;
+                if (!r->seq) {
