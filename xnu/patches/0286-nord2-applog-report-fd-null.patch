 /* NORD2 applog (bsd/kern/kern_exec.c): the programs applog_name names are tee'd too */
 extern bool exec_applog_name_match(const char *name, size_t namelen);
 
+/* NORD2 applog (0286): is dev the null device this tee watches (kern_exec.c reports/redirects fd 1 and 2 with it) */
+bool nord2_applog_is_null_dev(dev_t dev);
+
+bool
+nord2_applog_is_null_dev(dev_t dev)
+{
+	return major(dev) >= 0 && major(dev) < nchrdev && minor(dev) == 2 &&
+	       (uintptr_t)(void *)cdevsw[major(dev)].d_write == (uintptr_t)(void *)mmwrite;
+}
+
+/* NORD2 applog (0286): one line the first time each such process is seen writing here */
+static int nord2_applog_seen_pid[8];
+static unsigned int nord2_applog_seen_next;
+
+static void
+nord2_applog_first_write(const char *name)
+{
+	int pid = proc_selfpid();
+
+	for (unsigned int i = 0; i < 8; i++) {
+		if (nord2_applog_seen_pid[i] == pid) {
+			return;
+		}
+	}
+	nord2_applog_seen_pid[nord2_applog_seen_next++ & 7] = pid;
+	printf("NORD2 APPLOG: first /dev/null write from %s pid %d\n", name, pid);
+}
