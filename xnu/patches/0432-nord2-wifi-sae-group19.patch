+ sae_curve_g(g,p->x);sae_mmul(t,p->y,p->y,&FP);return sae_is_equal(t,g)?0:-1;
+}
+static int sae_scalar_ok(const fe k){fe t;static const fe two={2,0,0,0,0,0,0,0};return !sae_sub_raw(t,k,two)&&sae_sub_raw(t,k,FN.m);} /* 1 < k < order */
