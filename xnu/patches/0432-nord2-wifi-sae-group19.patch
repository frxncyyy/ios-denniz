+ sae_mmul(gamma,gamma,gamma,&FP);sae_madd(gamma,gamma,gamma,&FP);sae_madd(gamma,gamma,gamma,&FP);sae_madd(gamma,gamma,gamma,&FP); /* 8 gamma^2 */
