+static const fe EXP_INV={0xfffffffd,0xffffffff,0xffffffff,0x00000000,0x00000000,0x00000000,0x00000001,0xffffffff}; /* p-2 */
+static const fe RAW_ONE={1,0,0,0,0,0,0,0};
+static void sae_wipe(void*v,size_t n){volatile uint8_t*p=v;while(n--)*p++=0;}
+static uint32_t sae_add_raw(fe r,const fe a,const fe b){uint64_t c=0;for(unsigned i=0;i<8;i++){c+=(uint64_t)a[i]+b[i];r[i]=(uint32_t)c;c>>=32;}return (uint32_t)c;}
