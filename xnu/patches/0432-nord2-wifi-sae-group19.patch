+/* y = sqrt(v) when v is a square; returns all ones when it is. */
+static uint32_t sae_field_sqrt(fe y,const fe v){fe t;sae_mpow(y,v,EXP_SQRT,&FP);sae_mmul(t,y,y,&FP);return sae_is_equal(t,v);}
