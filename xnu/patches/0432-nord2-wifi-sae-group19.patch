+}
+/* ---- curve: y^2 = x^3 - 3x + b, Jacobian coordinates in Montgomery form, z = 0 is infinity ---- */
+struct pt {fe x,y,z;};
+static void sae_curve_g(fe r,const fe x){
+ fe t,u,b;sae_mmul(t,x,x,&FP);sae_mmul(t,t,x,&FP);sae_madd(u,x,x,&FP);sae_madd(u,u,x,&FP);sae_msub(t,t,u,&FP);sae_to_mont(b,CURVE_B,&FP);sae_madd(r,t,b,&FP);
