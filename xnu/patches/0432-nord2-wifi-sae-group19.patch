+}
+static void sae_pt_mul(struct pt*r,const struct pt*p,const fe k){
+ struct pt acc,t;sae_wipe(&acc,sizeof acc);
+ for(int i=255;i>=0;i--){
+  sae_pt_dbl(&acc,&acc);sae_pt_add(&t,&acc,p);
+  uint32_t mask=0u-((k[i>>5]>>(i&31))&1u);sae_cmov(acc.x,t.x,mask);sae_cmov(acc.y,t.y,mask);sae_cmov(acc.z,t.z,mask);
+ }
+ *r=acc;sae_wipe(&acc,sizeof acc);sae_wipe(&t,sizeof t);
+}
+static int sae_pt_store(const struct pt*p,uint8_t out[64]){
+ fe zi,z2,x,y;if(sae_is_zero(p->z))return -1;
