+static void sae_order_addresses(const uint8_t a[6],const uint8_t b[6],uint8_t out[12]){
+ int first=memcmp(a,b,6)>0;memcpy(out,first?a:b,6);memcpy(out+6,first?b:a,6); /* max | min */
+}
+/* 12.4.4.2.2: forty iterations, the first valid candidate is kept by masked selection. */
+int nsae_pwe_loop(const uint8_t a[6],const uint8_t b[6],const uint8_t*password,size_t pn,uint8_t out[64]){
+ if(!out)return -1;
+ if(!a||!b||!password||!pn||pn>63){sae_wipe(out,64);return -1;}
+ uint8_t addresses[12],seed[32],value[32],prime[32];fe x,y,g,t,bx,by;uint32_t found=0,parity=0;
+ sae_order_addresses(a,b,addresses);sae_store(prime,FP.m);sae_wipe(bx,sizeof bx);sae_wipe(by,sizeof by);
+ for(unsigned counter=1;counter<=40;counter++){
+  uint8_t c=(uint8_t)counter;const uint8_t*parts[2]={password,&c};size_t sizes[2]={pn,1};
+  (void)nsc_hmac256(addresses,12,parts,sizes,2,seed);
+  (void)nsc_kdf256(seed,32,"SAE Hunting and Pecking",prime,32,value,32);
+  sae_load(x,value);uint32_t below=0u-sae_sub_raw(t,x,FP.m); /* value < p */
+  sae_reduce_once(x,x,FP.m);sae_to_mont(x,x,&FP);sae_curve_g(g,x);
+  uint32_t take=sae_field_sqrt(y,g)&below&~found;
+  sae_cmov(bx,x,take);sae_cmov(by,y,take);parity^=(parity^(uint32_t)(seed[31]&1u))&take;found|=take;
+ }
+ sae_from_mont(x,bx,&FP);sae_from_mont(y,by,&FP);
+ sae_msub(t,FP.m,y,&FP); /* p - y (y is never zero on this curve) */
+ sae_cmov(y,t,0u-((y[0]&1u)^parity));
+ sae_store(out,x);sae_store(out+32,y);
+ sae_wipe(seed,32);sae_wipe(value,32);sae_wipe(x,sizeof x);sae_wipe(y,sizeof y);sae_wipe(bx,sizeof bx);sae_wipe(by,sizeof by);sae_wipe(g,sizeof g);sae_wipe(t,sizeof t);
+ if(!found){sae_wipe(out,64);return -1;}
+ return 0;
+}
+/* 12.4.4.2.3 simplified SWU for a = -3, z = -10; u in Montgomery form. */
+static void sae_sswu(struct pt*r,const fe u){
+ fe z,u2,m,t,x1,x2,gx1,gx2,y,c,plain,neg;static const fe ten={10,0,0,0,0,0,0,0};
+ sae_to_mont(t,ten,&FP);sae_wipe(z,sizeof z);sae_msub(z,z,t,&FP); /* -10 */
+ sae_mmul(u2,u,u,&FP);sae_mmul(u2,u2,z,&FP); /* z u^2 */
+ sae_mmul(m,u2,u2,&FP);sae_madd(m,m,u2,&FP); /* z^2 u^4 + z u^2 */
+ uint32_t zero=sae_is_zero(m);
+ sae_mpow(t,m,EXP_INV,&FP); /* 0 stays 0 */
+ sae_madd(t,t,FP.one,&FP);sae_to_mont(c,SSWU_C2,&FP);sae_mmul(x1,t,c,&FP);sae_to_mont(c,SSWU_C1,&FP);sae_cmov(x1,c,zero);
+ sae_curve_g(gx1,x1);sae_mmul(x2,u2,x1,&FP);sae_curve_g(gx2,x2);
+ uint32_t square=sae_field_sqrt(y,gx1);
