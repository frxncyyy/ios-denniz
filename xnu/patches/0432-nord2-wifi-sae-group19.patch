+static void sae_madd(fe r,const fe a,const fe b,const struct mod*M){fe t,d;uint32_t carry=sae_add_raw(t,a,b),borrow=sae_sub_raw(d,t,M->m);sae_cmov(t,d,0u-(carry|(1u-borrow)));sae_copy(r,t);}
