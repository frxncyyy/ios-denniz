+static void sae_cmov(fe r,const fe a,uint32_t mask){for(unsigned i=0;i<8;i++)r[i]^=(r[i]^a[i])&mask;}
+static void sae_copy(fe r,const fe a){for(unsigned i=0;i<8;i++)r[i]=a[i];}
+static uint32_t sae_is_zero(const fe a){uint32_t d=0;for(unsigned i=0;i<8;i++)d|=a[i];return 0u-(uint32_t)(((uint64_t)d-1)>>63);} /* all ones when zero */
