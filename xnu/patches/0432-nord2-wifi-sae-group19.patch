+ if(!inf1&&!inf2&&sae_is_zero(h)){ /* same x: doubling or the inverse; never reached with a scalar in 1..order-1 */
+  if(sae_is_zero(rr)){sae_pt_dbl(r,p);return;}
+  sae_wipe(r,sizeof *r);return;
+ }
+ sae_mmul(hh,h,h,&FP);sae_mmul(hhh,hh,h,&FP);sae_mmul(v,u1,hh,&FP);
+ sae_mmul(t,rr,rr,&FP);sae_msub(t,t,hhh,&FP);sae_msub(t,t,v,&FP);sae_msub(o.x,t,v,&FP);
+ sae_msub(t,v,o.x,&FP);sae_mmul(t,t,rr,&FP);sae_mmul(s1,s1,hhh,&FP);sae_msub(o.y,t,s1,&FP);
+ sae_mmul(t,p->z,q->z,&FP);sae_mmul(o.z,t,h,&FP);
