+}
+static void sae_to_mont(fe r,const fe a,const struct mod*M){sae_mmul(r,a,M->r2,M);}
+static void sae_from_mont(fe r,const fe a,const struct mod*M){sae_mmul(r,a,RAW_ONE,M);}
+/* r = a^e, a and r in Montgomery form, fixed 256 squarings and products. */
+static void sae_mpow(fe r,const fe a,const fe e,const struct mod*M){
