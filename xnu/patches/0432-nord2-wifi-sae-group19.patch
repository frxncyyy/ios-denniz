+ sae_cmov(y,neg,0u-((plain[0]^t[0])&1u)); /* LSB(y) = LSB(u) */
+ sae_copy(r->y,y);sae_copy(r->z,FP.one);
+ sae_wipe(u2,sizeof u2);sae_wipe(m,sizeof m);sae_wipe(t,sizeof t);sae_wipe(x1,sizeof x1);sae_wipe(x2,sizeof x2);sae_wipe(y,sizeof y);sae_wipe(plain,sizeof plain);
+}
+/* HKDF-Expand(seed, label, 48) reduced modulo p, in Montgomery form. */
+static void sae_hash_to_field(fe u,const uint8_t seed[32],const char*label){
+ uint8_t t1[32],t2[32],one=1,two=2;size_t ln=strlen(label);fe hi,lo;
+ const uint8_t*p1[2]={(const uint8_t*)label,&one};size_t n1[2]={ln,1};(void)nsc_hmac256(seed,32,p1,n1,2,t1);
+ const uint8_t*p2[3]={t1,(const uint8_t*)label,&two};size_t n2[3]={32,ln,1};(void)nsc_hmac256(seed,32,p2,n2,3,t2);
+ /* value = t1 | t2[0..15]: 384 bits = hi(128) * 2^256 + lo(256) */
+ uint8_t wide[32]={0};memcpy(wide+16,t1,16);sae_load(hi,wide);memcpy(wide,t1+16,16);memcpy(wide+16,t2,16);sae_load(lo,wide);
+ sae_reduce_once(lo,lo,FP.m);sae_to_mont(lo,lo,&FP);sae_to_mont(hi,hi,&FP);sae_to_mont(hi,hi,&FP);sae_madd(u,lo,hi,&FP);
+ sae_wipe(t1,32);sae_wipe(t2,32);sae_wipe(wide,32);sae_wipe(hi,sizeof hi);sae_wipe(lo,sizeof lo);
+}
+int nsae_pt(const uint8_t*ssid,size_t sn,const uint8_t*password,size_t pn,const uint8_t*identifier,size_t in,uint8_t out[64]){
+ if(!out)return -1;
+ if(!ssid||!sn||sn>32||!password||!pn||pn>63||(!identifier&&in)||in>255){sae_wipe(out,64);return -1;}
+ uint8_t seed[32];fe u;struct pt p1,p2;const uint8_t*parts[2]={password,identifier};size_t sizes[2]={pn,in};
+ (void)nsc_hmac256(ssid,sn,parts,sizes,in?2:1,seed);
+ sae_hash_to_field(u,seed,"SAE Hash to Element u1 P1");sae_sswu(&p1,u);
+ sae_hash_to_field(u,seed,"SAE Hash to Element u2 P2");sae_sswu(&p2,u);
+ sae_pt_add(&p1,&p1,&p2);int e=sae_pt_store(&p1,out);
+ sae_wipe(seed,32);sae_wipe(u,sizeof u);sae_wipe(&p1,sizeof p1);sae_wipe(&p2,sizeof p2);if(e)sae_wipe(out,64);return e;
+}
+int nsae_pwe_pt(const uint8_t pt[64],const uint8_t a[6],const uint8_t b[6],uint8_t out[64]){
+ if(!out)return -1;
+ if(!pt||!a||!b){sae_wipe(out,64);return -1;}
+ uint8_t addresses[12],zero[32]={0},digest[32];fe val,limit,t;struct pt p,r;const uint8_t*parts[1]={addresses};size_t sizes[1]={12};
+ sae_order_addresses(a,b,addresses);(void)nsc_hmac256(zero,32,parts,sizes,1,digest);
+ sae_load(val,digest);sae_sub_raw(limit,FN.m,RAW_ONE);sae_reduce_once(val,val,limit);sae_add_raw(t,val,RAW_ONE); /* val mod (r-1) + 1 */
+ int e=sae_pt_load(&p,pt);if(!e){sae_pt_mul(&r,&p,t);e=sae_pt_store(&r,out);}
+ sae_wipe(digest,32);sae_wipe(val,sizeof val);sae_wipe(t,sizeof t);sae_wipe(&p,sizeof p);sae_wipe(&r,sizeof r);if(e)sae_wipe(out,64);return e;
+}
+void nsae_cancel(struct nsae*s){if(s)sae_wipe(s,sizeof *s);}
+static int sae_refuse(struct nsae*s){nsae_cancel(s);return -1;}
+static int sae_unicast(const uint8_t*p){unsigned any=0;for(unsigned i=0;i<6;i++)any|=p[i];return any&&!(p[0]&1);}
+static int sae_draw(nsae_rng rng,void*ctx,fe out){
+ uint8_t raw[32];
+ for(unsigned tries=0;tries<8;tries++){
+  if(rng(ctx,raw,32)){sae_wipe(raw,32);return -1;}
+  sae_load(out,raw);sae_reduce_once(out,out,FN.m);if(sae_scalar_ok(out)){sae_wipe(raw,32);return 0;}
+ }
+ sae_wipe(raw,32);return -1;
+}
+int nsae_begin(struct nsae*s,const uint8_t own[6],const uint8_t peer[6],const uint8_t*password,size_t pn,const uint8_t*ssid,size_t sn,unsigned h2e,nsae_rng rng,void*ctx){
+ if(!s)return -1;
+ nsae_cancel(s);
