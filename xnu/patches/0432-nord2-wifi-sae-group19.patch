+ sae_from_mont(x,x,&FP);sae_from_mont(y,y,&FP);sae_store(out,x);sae_store(out+32,y);return 0;
+}
+static int sae_pt_load(struct pt*p,const uint8_t in[64]){
+ fe x,y,t,g;sae_load(x,in);sae_load(y,in+32);
+ if(!sae_sub_raw(t,x,FP.m)||!sae_sub_raw(t,y,FP.m))return -1; /* coordinates below p */
