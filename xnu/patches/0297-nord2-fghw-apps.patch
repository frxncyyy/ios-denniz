--- a/bsd/kern/proc_info.c
+++ b/bsd/kern/proc_info.c
@@ -1815,8 +1815,23 @@
 		case TASK_THROTTLE_APPLICATION:
 		case TASK_UNSPECIFIED:
 		default:
-			/* non-focal, non-ui apps don't get access */
-			reason = PROC_FGHW_LEADER_NONUI;
+			/*
+			 * NORD2: nothing on this port gives an application its role (what the Camera application has while it is on screen was not
+			 * measured: said below, once a process), and the answer "no" is what VideoToolbox takes as
+			 * "do not use Metal" (VTPixelTransferSessionCanUseMetalInTheBackground). With no hardware scaler
+			 * (AppleM2ScalerCSCDriver) a pixel transfer in an application then fails with -12914: the Camera's
+			 * thumbnail of a photograph, and with it the saving of the photograph (run q10ig-vt11). An
+			 * application that is not marked background (checked above) is granted, whatever its role.
+			 */
+			{
+				static int nord2_fghw_said;      /* one line when the asking process changes, not one per call */
+				if (nord2_fghw_said != proc_getpid(p)) {
+					nord2_fghw_said = proc_getpid(p);
+					printf("NORD2 FGHW: %s[%d] role %d: granted\n", proc_best_name(p), proc_getpid(p), role);
+				}
+			}
+			*retval = 1;
+			reason = PROC_FGHW_OK;
 			goto out;
 		}
 	}
