+// 0710: UIM PIN operations (libqmi qmi-service-uim.json: 0x0025 Set PIN Protection {pin id, enabled, pin}, 0x0026 Verify PIN {pin id,
+// pin}, 0x0027 Unblock PIN {pin id, puk, new pin}, 0x0028 Change PIN {pin id, old, new}, all in TLV 0x02 with u8-length strings;
+// answer TLV 0x10 retries left {verify, unblock}). 0277 answered none of them (INVALID_QMI_CMD): a card that really has its PIN on
+// could never be unlocked from iOS. PIN1 through AT+CPIN / AT+CPWD="SC" / AT+CLCK="SC"; PIN2 is not offered (NOT_SUPPORTED). The
+// digits live only in this function's stack and the AT queue entry; the AT log shows these commands up to their '=' (sweet_amfi.c).
+static bool bb_has_substr(const char *h, const char *n);         // (IMS section below)
+static bool bb_pin_take(const uint8_t *v, uint32_t len, uint32_t *at, char *out)    // out: 9 bytes
+{
+  if (*at >= len) return false;
+  const uint32_t n = v[*at];
+  if (n < 4u || n > 8u || *at + 1u + n > len) return false;
+  for (uint32_t i = 0; i < n; i++) {
+    if (v[*at + 1u + i] < '0' || v[*at + 1u + i] > '9') return false;
+    out[i] = (char)v[*at + 1u + i];
+  }
+  out[n] = 0;
+  *at += 1u + n;
+  return true;
+}
+static void bb_wipe(void *p, uint32_t n)
+{
+  volatile uint8_t *b = static_cast<volatile uint8_t *>(p);
+  while (n--) *b++ = 0;
+}
+static const char *bb_pin_op_name(uint32_t message)
+{
+  return message == 0x0025u ? "Set PIN Protection" : message == 0x0026u ? "Verify PIN" : message == 0x0027u ? "Unblock PIN" : "Change PIN";
+}
+static int bb_uim_pin_start(uint32_t qmux, uint32_t cid, const uint8_t *sdu, uint32_t n, uint32_t *error)
+{
+  const uint32_t message = nbq_rd16(sdu + 3), tl = n >= 7u ? nbq_rd16(sdu + 5) : 0u;
+  uint32_t len = 0, at = 1;
+  char a[9], b[9], cmd[64];
+  uint8_t id = 0, en = 0;
+  const uint8_t *v = nullptr;
+  *error = 0;
+  a[0] = b[0] = 0;
+  if (n < 7u || 7u + tl > n) *error = NBQ_ERR_MALFORMED_MESSAGE;
+  else if (!(v = nbq_tlv(sdu + 7, tl, 0x02, &len)) || len < 2u) *error = NBQ_ERR_MISSING_ARGUMENT;
+  if (!*error) {
+    id = v[0];
+    if (message == 0x0025u) { en = v[1]; at = 2; }
+    if (!bb_pin_take(v, len, &at, a) || ((message == 0x0027u || message == 0x0028u) && !bb_pin_take(v, len, &at, b)))
+      *error = NBQ_ERR_INVALID_ARG;
+  }
+  if (!*error && id != 1u) *error = NBQ_ERR_NOT_SUPPORTED;       // PIN2 / UPIN: not offered through this modem's AT
+  if (!*error && bb_pinq.used) *error = BB_QMI_ERR_DEVICE_IN_USE;
+  if (!*error) {
+    if (message == 0x0026u) snprintf(cmd, sizeof cmd, "AT+CPIN=\"%s\"", a);
+    else if (message == 0x0027u) snprintf(cmd, sizeof cmd, "AT+CPIN=\"%s\",\"%s\"", a, b);
+    else if (message == 0x0028u) snprintf(cmd, sizeof cmd, "AT+CPWD=\"SC\",\"%s\",\"%s\"", a, b);
+    else snprintf(cmd, sizeof cmd, "AT+CLCK=\"SC\",%u,\"%s\"", en ? 1u : 0u, a);
+    bb_pin_gen = (bb_pin_gen + 1u) & 0xffffu;
+    bb_pinq = { 1, (uint8_t)qmux, (uint8_t)cid, 1, id, nbq_rd16(sdu + 1), (uint16_t)message, bb_pin_gen, 0 };
+    const int e = nord2_at_query(cmd, bb_at_done, reinterpret_cast<void *>(static_cast<uintptr_t>(BB_CTX_PIN | bb_pin_gen << 8 | 1u)));
+    bb_wipe(cmd, sizeof cmd);
+    if (e) { bb_pinq.used = 0; *error = NBQ_ERR_DEVICE_NOT_READY; }
+  }
+  bb_wipe(a, sizeof a); bb_wipe(b, sizeof b);
+  if (*error) {
+    bb_reply(qmux, NBQ_SVC_UIM, cid, sdu, *error, nullptr, 0);
+    bb_pin_fail++;
+    printf("NORD2 SIM: UIM %s (PIN%u) refused, err 0x%x\n", bb_pin_op_name(message), id, *error);
+    return BB_ANSWERED;
+  }
+  bb_pin_ops++;
+  printf("NORD2 SIM: UIM %s (PIN%u%s) -> AT (digits not logged)\n", bb_pin_op_name(message), id,
+         message == 0x0025u ? (en ? ", on" : ", off") : "");
+  return BB_DEFERRED;
+}
+// "+EPINC: <pin1>, <pin2>, <puk1>, <puk2>" (MediaTek): retries, kept + 1 in bb_st (0 unknown)
+static void bb_epinc_parse(const char *text, unsigned len)
+{
+  for (unsigned i = 0; i + 7u <= len; i++) {
+    if (memcmp(text + i, "+EPINC:", 7)) continue;
+    long f[4] = { -1, -1, -1, -1 };
+    unsigned k = 0, j = i + 7u;
+    while (j < len && k < 4u && text[j] != '\n') {
+      while (j < len && (text[j] == ' ' || text[j] == ',')) j++;
+      if (j >= len || text[j] < '0' || text[j] > '9') break;
+      long x = 0;
+      while (j < len && text[j] >= '0' && text[j] <= '9') x = x * 10 + (text[j++] - '0');
+      f[k++] = x;
+    }
+    if (k >= 3u && f[0] >= 0 && f[0] < 255 && f[2] >= 0 && f[2] < 255) {
+      bb_st.pin1_left = (uint8_t)(f[0] + 1); bb_st.puk1_left = (uint8_t)(f[2] + 1);
+    }
+    return;
+  }
+}
+static void bb_pin_done(uint32_t ctx, int final, const char *text, unsigned len)
+{
+  const uint32_t phase = ctx & 0xffu, gen = ctx >> 8 & 0xffffu;
+  if (phase == 0xffu) { if (final == NORD2_AT_FINAL_OK) bb_epinc_parse(text, len); return; }
+  if (!bb_pinq.used || bb_pinq.gen != gen) return;
+  bb_pin_op &o = bb_pinq;
+  if (phase == 1u) {
+    uint32_t err = 0;
+    if (final == NORD2_AT_FINAL_TIMEOUT) err = NBQ_ERR_INTERNAL;
+    else if (final != NORD2_AT_FINAL_OK) {
+      unsigned e = len;
+      while (e && (text[e - 1] == '\n' || text[e - 1] == '\r')) e--;
+      unsigned s0 = e;
+      while (s0 && text[s0 - 1] != '\n') s0--;
+      char last[64];
+      unsigned m = e - s0 < sizeof last - 1 ? e - s0 : (unsigned)sizeof last - 1;
+      for (unsigned i = 0; i < m; i++) last[i] = text[s0 + i];
+      last[m] = 0;
+      err = bb_has_substr(last, "PUK required") || bb_has_substr(last, ": 12") ? BB_QMI_ERR_PIN_BLOCKED :
+            bb_has_substr(last, "blocked") ? BB_QMI_ERR_PIN_PERM_BLOCKED :
+            bb_has_substr(last, "incorrect") || bb_has_substr(last, ": 16") ? BB_QMI_ERR_INCORRECT_PIN : NBQ_ERR_INTERNAL;
+    }
+    o.error = err;
+    o.phase = 2;
+    if (!nord2_at_query("AT+EPINC?", bb_at_done, reinterpret_cast<void *>(static_cast<uintptr_t>(BB_CTX_PIN | o.gen << 8 | 2u)))) return;
+  } else if (final == NORD2_AT_FINAL_OK) {
+    bb_epinc_parse(text, len);
+  }
+  o.used = 0;
+  bb_epinc_ms = bb_now_ms();
+  if (nbq_client_find(&bb_qmux, o.channel, NBQ_SVC_UIM, o.cid) >= 0) {
+    uint8_t sdu[7], r[2];
+    uint32_t t = 0;
+    sdu[0] = 0; nbq_wr16(sdu + 1, o.txn); nbq_wr16(sdu + 3, o.message); nbq_wr16(sdu + 5, 0);
+    if (bb_st.pin1_left) {
+      const bool unblock = o.message == 0x0027u;
+      r[0] = (uint8_t)(bb_st.pin1_left - 1u);
+      r[1] = bb_st.puk1_left ? (uint8_t)(bb_st.puk1_left - 1u) : 10u;
