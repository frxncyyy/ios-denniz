+  }
+  printf("NORD2 SIM: UIM %s (PIN%u) -> %s (err 0x%x), retries PIN1 %d PUK1 %d\n", bb_pin_op_name(o.message), o.pin_id,
+         o.error ? "failed" : "OK", o.error, bb_st.pin1_left ? (int)bb_st.pin1_left - 1 : -1, bb_st.puk1_left ? (int)bb_st.puk1_left - 1 : -1);
+  if (o.error) bb_pin_fail++;
+  bb_refresh_soon(300);                                           // the card status indication with the new state
+}
