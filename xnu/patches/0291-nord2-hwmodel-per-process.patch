--- a/bsd/kern/kern_mib.c
+++ b/bsd/kern/kern_mib.c
@@ -279,6 +279,59 @@
  * Supporting some variables requires us to do "real" work.  We
  * gather some of that here.
  */
+/*
+ * NORD2 (0291): hw.model for one program. The port says it is an iPhone X (hw.model D22AP) and everything keeps hearing that.
+ * The Camera application takes which lenses to offer from a per-model table in AVFCapture (AVGestaltGetDeviceFeatures; the
+ * name is hw.model without its "AP": FigCaptureGetModelSpecificName in CMCapture), and D22 has no ultra-wide camera in it.
+ * n2hwmodel=NAME=MODEL[,NAME=MODEL...]: a process whose name is exactly NAME is answered MODEL for hw.model (the string and
+ * the CTL_HW/HW_MODEL number are this same handler); hw.target, hw.product, hw.machine and the device tree are not touched.
+ * NORD2_HWMODEL_DEFAULT is the value when the boot-arg is absent (the Nord 2 command line is full); empty: nobody is told
+ * anything else. One line for each process it is applied to (the last one remembered).
+ */
+#ifndef NORD2_HWMODEL_DEFAULT
+#define NORD2_HWMODEL_DEFAULT ""
+#endif
+static TUNABLE_STR(nord2_hwmodel, 128, "n2hwmodel", NORD2_HWMODEL_DEFAULT);
+
+static void
+nord2_hwmodel_override(struct sysctl_req *req, char *model, size_t len)
+{
+	const char *t = nord2_hwmodel;
+	char name[2 * MAXCOMLEN + 1];
+	static int said_pid;
+
+	if (*t == 0 || req == NULL || req->p == NULL) {
+		return;
+	}
+	strlcpy(name, req->p->p_name, sizeof(name));
+	size_t n = strlen(name);
+	while (*t != 0) {
+		const char *eq = t, *end;
+
+		while (*eq != 0 && *eq != '=' && *eq != ',') {
+			eq++;
+		}
+		end = eq;
+		while (*end != 0 && *end != ',') {
+			end++;
+		}
+		if (*eq == '=' && n > 0 && (size_t)(eq - t) == n && strncmp(t, name, n) == 0 &&
+		    end > eq + 1 && (size_t)(end - eq - 1) < len) {
+			int pid = proc_getpid(req->p);
+
+			if (said_pid != pid) {
+				said_pid = pid;
+				printf("NORD2 HWMODEL: hw.model for %s pid %d: %.*s (everybody else: %s)\n", name, pid,
+				    (int)(end - eq - 1), eq + 1, model);
+			}
+			bzero(model, len);
+			memcpy(model, eq + 1, (size_t)(end - eq - 1));
+			return;
+		}
+		t = *end == ',' ? end + 1 : end;
+	}
+}
+
 static int
 sysctl_hw_generic(__unused struct sysctl_oid *oidp, void *arg1,
     int arg2, struct sysctl_req *req)
