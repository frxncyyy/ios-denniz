+	IOLockLock(fLock);
+	uint8_t *rec = fWorkRec;
+	sweet_fb_pending_surfaces surfaces = fWorkSurfaces;
+	fWorkRec = NULL;
+	sweet_fb_pending_surfaces_init(&fWorkSurfaces);
