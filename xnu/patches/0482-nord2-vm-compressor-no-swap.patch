--- /dev/null
+++ b/bsd/kern/nord2_vmcomp.h
@@ -0,0 +1,53 @@
+/*
+ * 0482 (memwod-20261113): the VM compressor runs WITHOUT swap by default (vm_compressor_mode 2, VM_PAGER_COMPRESSOR_NO_SWAP).
+ * SPDX-License-Identifier: MIT
+ *
+ * This XNU is built with the macOS defaults: the static default is 4 (compressor + swap, osfmk/vm/vm_compressor.c), the boot log says
+ * '"vm_compressor_mode" is 4' and 'Failed to open swap file 2' -- there is no swap volume and there will be none (the root file system is
+ * nearly full).  In mode 4 with no swap file the swap machinery still runs: the compactor counts on swapping whenever non-compressed
+ * memory is under 40 % (wake-ups of the swap thread, minor compaction cut short after ~30 segments), a task that owns more than 25 %
+ * of the compressed pages is hard-throttled 10 ms per page-creating fault once memory is short (vm_wants_task_throttled), and if a swap
+ * file could ever be opened on the full disk, no_paging_space_action() would start to SIGKILL the biggest compressed process.  Mode 2
+ * removes all of that; compressor sizes, limits and the pressure levels sent to applications are the same in both modes.
+ *
+ * Where: vm_fault_init() (osfmk/vm/vm_fault.c) takes boot-arg "vm_compressor" if valid, else the device-tree default
+ * "kern.vm_compressor", else leaves the variable alone, then calls vm_config_init().  The command line has 12 free characters and the
+ * static default is in an object we do not rebuild, so the variable is set by a STARTUP hook that runs before vm_fault_init
+ * (kernel_startup_bootstrap / the KMEM phase come first, vm_init.c).  Nothing is changed at run time: the mode is fixed before the
+ * pageout and compressor threads exist.
+ *   boot-arg vm_compressor=N   as always (vm_fault_init validates it): this hook then does nothing
+ *   boot-arg n2vc=4            the old default (compressor + swap) without a rebuild;  n2vc=2 = this default
+ * Boot log: 'NORD2 VMCOMP: ...' then XNU's own '"vm_compressor_mode" is 2'; 'Failed to open swap file' must be gone.
+ */
+#ifndef NORD2_VMCOMP_H
+#define NORD2_VMCOMP_H
+
+#define NORD2_VMCOMP_NO_SWAP    2       /* VM_PAGER_COMPRESSOR_NO_SWAP */
+#define NORD2_VMCOMP_WITH_SWAP  4       /* VM_PAGER_COMPRESSOR_WITH_SWAP */
+
+/* The mode to boot with.  has_std: "vm_compressor" is on the command line (XNU's business); n2vc: only the two modes this build can
+ * run are taken, anything else keeps the new default. */
+static inline int
+nord2_vmcomp_pick(bool has_std, bool has_n2vc, int n2vc, int current)
+{
+	if (has_std) { return current; }
+	if (has_n2vc && n2vc == NORD2_VMCOMP_WITH_SWAP) { return NORD2_VMCOMP_WITH_SWAP; }
+	return NORD2_VMCOMP_NO_SWAP;
+}
+
+#ifdef KERNEL
+extern int vm_compressor_mode;
+
+__startup_func
+static void
+nord2_vmcomp_default(void)
+{
+	int std = 0, n2vc = 0, old = vm_compressor_mode;
+	bool has_std = PE_parse_boot_argn("vm_compressor", &std, sizeof(std));
+	bool has = PE_parse_boot_argn("n2vc", &n2vc, sizeof(n2vc));
+	vm_compressor_mode = nord2_vmcomp_pick(has_std, has, n2vc, old);
+	printf("NORD2 VMCOMP: compressor mode default %d -> %d (2 = no swap; boot-args n2vc=4 / vm_compressor=N override)\n", old, vm_compressor_mode);
+}
+STARTUP(KMEM, STARTUP_RANK_LAST, nord2_vmcomp_default);
+#endif /* KERNEL */
+#endif /* NORD2_VMCOMP_H */
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -7749,4 +7749,5 @@
 		thread_call_enter_delayed(sweet_modem_start_call, dl);
 	}
 }
+#include "nord2_vmcomp.h"       /* 0482: VM compressor without swap by default (STARTUP hook before vm_fault_init) */
 #endif /* ARM64_BOARD_CONFIG_SWEET */
