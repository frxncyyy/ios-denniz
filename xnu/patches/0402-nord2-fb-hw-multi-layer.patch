+/*
+ * 0402 H6, state 5 in the HW modes: true = still waiting (timer set) or dropped for a newer swap; false = present it now.  A layer
+ * is ready when the GPU writes submitted for it by SwapEnd are done (write_seq snapshot); a 0112 reservation (frame promised, not
+ * submitted) holds it and the snapshot is taken again when the reservation retires.  After 2 panel refreshes from the swap's
+ * arrival it is shown anyway (fence_forced): the panel keeps the previous picture meanwhile, the CPU never composes it.
+ */
+struct sweet_fb_h6_ctx { void *const *obj; const uint8_t *rec; };
+static bool
+sweet_fb_h6_busy(void *c, unsigned l)
+{
+	return nord2_gpu_surface_busy(((sweet_fb_h6_ctx *)c)->obj[l]);
+}
+static bool
+sweet_fb_h6_resv(void *c, unsigned l)
+{
+	uint32_t m, st, inf, q, rv = 0; uint64_t age, oid;
+	nord2_gpu_surface_busy_why(((sweet_fb_h6_ctx *)c)->obj[l], &m, &age, &oid, &st, &inf, &q, &rv);
+	return rv != 0;
+}
+static uint64_t
+sweet_fb_h6_seq(void *c, unsigned l)
+{
+	return nord2_gpu_surface_write_seq(get32(((sweet_fb_h6_ctx *)c)->rec, 0x54 + 4 * l));
+}
+static bool
+sweet_fb_h6_done(void *c, unsigned l, uint64_t sq)
+{
+	return nord2_gpu_surface_writes_done(get32(((sweet_fb_h6_ctx *)c)->rec, 0x54 + 4 * l), sq);
+}
