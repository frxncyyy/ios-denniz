+                if (valid[k]) seq[k] = n2lr_rd(n2lr_map[k], 1);
+        }
+        int newest = -1; if (valid[0] && (!valid[1] || seq[0] >= seq[1])) newest = 0; else if (valid[1]) newest = 1;
+        uint32_t mySeq = newest >= 0 ? seq[newest] + 1 : 1;
+        if (newest >= 0) {      /* print the tail of the previous boot's ring before it is reused */
+                volatile uint8_t *r = n2lr_map[newest]; uint32_t wpos = n2lr_rd(r, 2);
+                uint32_t have = wpos < cap ? wpos : cap, show = have < 24576 ? have : 24576;
+                IOLog("NORD2 PREV: previous boot seq=%u wrote %u bytes, last %u follow\n", seq[newest], wpos, show);
+                char line[400]; unsigned ll = 0; bool skipFirst = show < have;   /* the first line is cut when the tail does not start at the beginning */
+                for (uint32_t i = 0; i < show; i++) {
+                        char ch = (char)r[N2LR_HDR + ((wpos - show + i) % cap)];
+                        if (ch == '\n' || ll >= sizeof(line) - 1) {
+                                line[ll] = 0; if (!skipFirst && ll) IOLog("NORD2 PREV: %s\n", line);
+                                skipFirst = false; ll = 0;
+                                if (ch != '\n' && ch >= 32 && ch < 127) line[ll++] = ch;
+                        } else if (ch >= 32 && ch < 127) line[ll++] = ch;
+                }
+                if (ll) { line[ll] = 0; IOLog("NORD2 PREV: %s (unterminated: the log ends here)\n", line); }
+                IOLog("NORD2 PREV: end of the previous boot's log\n");
+        } else IOLog("NORD2 PREV: no previous log ring\n");
+        int mine = newest == 0 ? 1 : 0;      /* reuse the older ring (or ring 0 when none is valid) */
+        n2lr_cur = n2lr_map[mine];
