+/* 0169: persistent last-log ring.  The USB capture and the 4 MiB live stream die with the phone; a crash (p69) left no trace.  Two alternating 256 KiB rings in the unused Android
+ * pstore area (0x48090000, 0x480D0000; the pmsg ring at 0x48160000 is separate) get a copy of the live stream every 100 ms.  The next boot prints the tail of the newest ring as
+ * "NORD2 PREV:" lines, so whatever the previous boot said last is in the capture.  Header: magic, boot_seq, wpos (total bytes written, wraps in the data area), cap (data bytes). */
+extern "C" {
+uint32_t nord2_log_stream_read(uint32_t offset, uint8_t *out, uint32_t max);
+void nord2_log_stream_info(uint32_t info[2]);
+}
+#define N2LR_BASE0 0x48090000ull
+#define N2LR_BASE1 0x480D0000ull
+#define N2LR_SIZE  0x40000u
+#define N2LR_HDR   16u
+#define N2LR_MAGIC 0x4e324c52u   /* "N2LR" */
+static volatile uint8_t *n2lr_map[2];
+static volatile uint8_t *n2lr_cur;         /* ring of this boot */
+static uint32_t n2lr_wpos, n2lr_off;       /* bytes written, next stream offset */
+static IOWorkLoop *n2lr_loop; static IOTimerEventSource *n2lr_timer;
+static inline uint32_t n2lr_rd(volatile uint8_t *r, unsigned w) { return ((volatile uint32_t *)r)[w]; }
+static inline void n2lr_wr(volatile uint8_t *r, unsigned w, uint32_t v) { ((volatile uint32_t *)r)[w] = v; }
+static void n2lr_tick(OSObject *, IOTimerEventSource *sender) {
+        uint8_t buf[2048];
+        uint32_t cap = N2LR_SIZE - N2LR_HDR;
+        for (unsigned round = 0; round < 8; round++) {
+                uint32_t n = nord2_log_stream_read(n2lr_off, buf, sizeof(buf));
+                if (!n) break;
+                for (uint32_t i = 0; i < n; i++) n2lr_cur[N2LR_HDR + ((n2lr_wpos + i) % cap)] = buf[i];
+                __asm__ volatile("dsb sy" ::: "memory");
+                n2lr_wpos += n; n2lr_off += n;
+                n2lr_wr(n2lr_cur, 2, n2lr_wpos);
+        }
+        if (sender) sender->setTimeoutMS(100);
+}
+static void n2lr_start(OSObject *owner) {
