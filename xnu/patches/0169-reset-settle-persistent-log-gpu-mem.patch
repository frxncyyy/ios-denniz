+        n2lr_map[1] = (volatile uint8_t *)ml_io_map(N2LR_BASE1, N2LR_SIZE);
+        if (!n2lr_map[0] || !n2lr_map[1]) { IOLog("NORD2 PREV: cannot map the log rings\n"); return; }
+        uint32_t cap = N2LR_SIZE - N2LR_HDR, seq[2] = {0, 0}; bool valid[2];
