+        n2lr_off = info[1] > 16384 ? info[1] - 16384 : 0;   /* a little context of this boot, then everything new */
+        n2lr_loop = IOWorkLoop::workLoop();
+        n2lr_timer = IOTimerEventSource::timerEventSource(owner, n2lr_tick);
+        if (n2lr_loop && n2lr_timer && n2lr_loop->addEventSource(n2lr_timer) == kIOReturnSuccess) {
+                IOLog("NORD2 PREV: this boot is seq %u in ring %d, mirrored every 100 ms\n", mySeq, mine);
+                n2lr_timer->setTimeoutMS(100);
+        } else IOLog("NORD2 PREV: cannot start the mirror\n");
+}
