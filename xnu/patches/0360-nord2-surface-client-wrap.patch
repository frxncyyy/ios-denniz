  * images without a pixel-format code).  The surface keeps a SNAPSHOT copy of `used` bytes taken at creation: correct for the
  * immutable images this path is used for (icons, layer contents), unlike zeros.  Returns 0 if the range is unusable.
  */
+/*
+ * 0360: how much of the creator's memory a client-memory surface WRAPS (its pages, wired, shared with the GPU and every other
+ * process) instead of copying once: the whole allocation when the creator's range is page aligned and covers it, else the used
+ * range rounded up to pages (then the surface is no longer than its memory: importSurface refuses an import past the end and the
+ * driver converts on the CPU), else 0: keep the snapshot.  `page` is a power of two.
+ */
+static inline uint64_t
+sweet_client_wrap_bytes(uint64_t address, uint64_t used, uint64_t alloc, uint64_t page)
+{
+	if (address == 0 || used == 0 || page == 0 || (page & (page - 1)) != 0 || (address & (page - 1)) != 0 || used > alloc) {
+		return 0;
+	}
+	uint64_t round_alloc = (alloc + page - 1) & ~(page - 1), round_used = (used + page - 1) & ~(page - 1);
+	if (address + round_alloc < address || address + round_used < address) {
+		return 0;
+	}
+	return round_used >= alloc ? round_alloc : round_used;
+}
