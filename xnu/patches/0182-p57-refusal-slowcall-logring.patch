+        if (n2lr_loop && n2lr_timer && n2lr_loop->addEventSource(n2lr_timer) == kIOReturnSuccess) {
+                IOLog("NORD2 PREV: this boot is seq %u in ring %d, mirrored every 20 ms\n", mySeq, mine);
