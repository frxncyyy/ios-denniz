+void
+AppleCLCD::prepFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+#if defined(NORD2)
+	if (!fb->fDbl || __atomic_load_n(&fb->fSwapLifecycle.stopped, __ATOMIC_ACQUIRE)) { fb->fPrepArmed = false; return; }
+	fb->prepNext();
+	if (fb->fNextState == 1) { sender->setTimeoutUS(100); return; }       /* still waiting for the GPU */
+	fb->fPrepArmed = false;
+	if (fb->fNextState == 2 && fb->fPState == 0) { fb->handOver(0); }        /* the transfer ended while the copy ran: start it now */
+#else
+	(void)fb; (void)sender;
+#endif
+}
