+
+/*
+ * 0493: watch.  The same eight loads again every 2 s (no sleep, nothing written); a line only when the shuffle level or the decoded rate differs from
+ * the previous read.  n2dr_watch_update returns true when that line is due: the first read, every one of the first 32 changes, then every 32nd.
+ */
+#include <stdbool.h>
+struct n2dr_watch { unsigned lv, mbps, reads, changes; };
+
+static inline bool
+n2dr_watch_update(struct n2dr_watch *w, const struct n2dr *r)
+{
+	bool first = w->reads == 0;
+	w->reads++;
+	if (!first && r->shu_lv == w->lv && r->mbps == w->mbps) {
+		return false;
+	}
+	if (!first) {
+		w->changes++;
+	}
+	w->lv = r->shu_lv; w->mbps = r->mbps;
+	return first || w->changes <= 32u || (w->changes & 31u) == 0;
+}
