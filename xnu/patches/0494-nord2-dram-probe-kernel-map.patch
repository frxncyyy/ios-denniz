+/* 0494: every register map of the optional DRAM reads below (0121 n2dram, 0462/0493 kern.n2dramprobe / n2drp / n2gdv +16) is made with ml_io_map_unmappable
+ * (kernel_map), never from XNU's 8 MiB io_submap (the 0410 rule).  The io_submap is permanent, KMA_NOFAIL and nearly full on this kernel: 501 of its 512 pages are
+ * taken before the SCP thread's delayed maps at boot + 90 s, which need 8 more (3 left).  0493's probe took 4 pages from it when the governor loop started, so the
+ * SCP's FIFO map (or the next late map of anything else) found it full and panicked inside ml_io_map, invisible on the pulled console: q10jcc reset to fastboot
+ * 75..110 s after boot, twice (wall4, wall4_retry: io_submap range and SCP IOMAP lines of both logs).  Each map is logged; nothing else changes. */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+#define N2CF_WIMG_IO 0x7u       /* VM_WIMG_IO (osfmk/arm/memory_types.h) */
+
+static volatile uint32_t *
+n2cf_iomap_late(const char *what, uint32_t pa, uint32_t size)
+{
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)pa, (vm_size_t)size, N2CF_WIMG_IO);
+	printf("NORD2 DRAM IOMAP: %s pa %#x +%#x -> %#lx (ml_io_map_unmappable, outside io_submap)%s\n", what, pa, size, (unsigned long)va, va ? "" : " FAILED");
+	return (volatile uint32_t *)va;
+}
