+static int
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	int rc = sweet_sandbox_syscall_inner(p, call, arg);
+	sweet_sblog_sandbox(p, call, arg, rc);         /* 0731 */
+	return rc;
+}
