+/* 0248: after the answer, read back (one page at a time, log + pause before each) our AP runtime data and the MD runtime data the MD should write. */
+static void
+sweet_rt_peek(unsigned t_ms)
+{
+	static const struct { uintptr_t pa; const char *name; } pk[] = {
+		{ 0x8e11e800UL, "AP_RT" }, { 0x8e11f000UL, "MD_RT" }, { 0x8e11f800UL, "MD_RT+800" },
+	};
+	for (unsigned i = 0; i < 3; i++) {
+		volatile uint32_t *w;
+		printf("NORD2 MODEM: rt-peek t=%u %s @%#lx: reading\n", t_ms, pk[i].name, (unsigned long)pk[i].pa);
+		delay_for_interval(1500, NSEC_PER_MSEC);
+		w = (volatile uint32_t *)ml_io_map(pk[i].pa & ~0xfffUL, 0x1000);
+		if (w == NULL) {
+			continue;
+		}
+		w += (pk[i].pa & 0xfff) / 4;
+		printf("NORD2 MODEM: rt-peek %s: %08x %08x %08x %08x %08x %08x %08x %08x\n", pk[i].name, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+	}
+}
