 	printf("SWEET Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	sweet_arm_fastboot();
 	sweet_modem_probe();
 	sweet_modem_power();
 	sweet_modem_late_start();
+	sweet_modem_start_call = thread_call_allocate(sweet_modem_start, NULL);
+	if (sweet_modem_start_call != NULL) {
