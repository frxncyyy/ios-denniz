+static bool opp_target(struct nord2_gpu_board *b) {
+        int khz = 0; PE_parse_boot_argn("nord2_gpu_khz", &khz, sizeof(khz));
+        b->target_khz = khz > 0 ? (uint32_t)khz : 0;
