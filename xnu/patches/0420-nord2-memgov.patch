+/*
+ * ---------------------------------------------------------------- 0420 (memgov-20261113): NORD2 MEMGOV (policy: nord2_memgov.h)
+ * A kernel thread, started by the first execve (launchd), samples free + pageable external pages every 250 ms.  Under the low mark it
+ * kicks the SweetSurface purge pass (0417/0418); under the critical mark it picks the lowest-band victim and, in mode 2 only, kills it
+ * through memorystatus_kill_on_zone_map_exhaustion(pid) (the non-jetsam kern_memorystatus.c's one exported kill-by-pid path:
+ * memorystatus_kill_specific_process -> P_MEMSTAT_TERMINATED, snapshot, exit_with_reason(SIGKILL), compactor).  Mode 1 (default) logs
+ * "NORD2 MEMGOV would kill ..." instead.  The candidate walk holds proc_list_lock (memstat_bucket lists); the kill runs unlocked.
+ */
+#include "nord2_memgov.h"
+
+extern unsigned int vm_page_free_count, vm_page_pageable_external_count, vm_page_purgeable_count, vm_page_wire_count;
+extern unsigned long gPhysSize;
+extern void sweet_surface_purge_kick_memgov(void);      /* SweetSurface.cpp (0420) */
+
+static int n2mg_mode = N2MG_LOG;
+static int n2mg_low_pm = N2MG_DEF_LOW_PM;
+static int n2mg_crit_pm = N2MG_DEF_CRIT_PM;
+static int n2mg_maxband = N2MG_DEF_MAXBAND;
+static uint32_t n2mg_kills, n2mg_would, n2mg_kicks, n2mg_kill_failed;
+static uint32_t n2mg_started;
+SYSCTL_INT(_kern, OID_AUTO, n2memgov, CTLFLAG_RW | CTLFLAG_LOCKED, &n2mg_mode, 0, "NORD2 MEMGOV: 0 off, 1 log only, 2 kill");
+SYSCTL_INT(_kern, OID_AUTO, n2memgov_low, CTLFLAG_RW | CTLFLAG_LOCKED, &n2mg_low_pm, 0, "NORD2 MEMGOV: purge mark, permille of RAM");
+SYSCTL_INT(_kern, OID_AUTO, n2memgov_crit, CTLFLAG_RW | CTLFLAG_LOCKED, &n2mg_crit_pm, 0, "NORD2 MEMGOV: kill mark, permille of RAM");
+SYSCTL_INT(_kern, OID_AUTO, n2memgov_maxband, CTLFLAG_RW | CTLFLAG_LOCKED, &n2mg_maxband, 0, "NORD2 MEMGOV: highest victim band (< 100)");
+SYSCTL_UINT(_kern, OID_AUTO, n2memgov_kills, CTLFLAG_RD | CTLFLAG_LOCKED, &n2mg_kills, 0, "NORD2 MEMGOV: processes killed");
+SYSCTL_UINT(_kern, OID_AUTO, n2memgov_would, CTLFLAG_RD | CTLFLAG_LOCKED, &n2mg_would, 0, "NORD2 MEMGOV: victims chosen in log-only mode");
+
+struct n2mg_pick {
+	int32_t  pid, band;
+	uint64_t footprint;
+	uint32_t eligible, why[N2MG_NREASONS];
+	char     name[MAXCOMLEN * 2 + 1];
+};
+
+static uint64_t
+n2mg_now_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+static uint32_t
+n2mg_sample(void)
+{
+	return n2mg_avail(vm_page_free_count, vm_page_pageable_external_count);
+}
+
+/* The best victim in bands 0..maxband (memstat_bucket order), under proc_list_lock.  pick->pid 0 = none. */
+static void
+n2mg_choose(int32_t maxband, struct n2mg_pick *pick)
+{
+	unsigned int b = 0;
+	struct n2mg_cand best = { .pid = 0 };
+	bzero(pick, sizeof(*pick));
+	proc_list_lock();
+	for (proc_t p = memorystatus_get_first_proc_locked(&b, TRUE); p != NULL; p = memorystatus_get_next_proc_locked(&b, p, TRUE)) {
+		if ((int32_t)b > maxband || b >= N2MG_BAND_FOREGROUND) {
+			break;
+		}
+		task_t t = proc_task(p);
+		struct n2mg_cand c = {
+			.pid = proc_getpid(p),
+			.band = p->p_memstat_effectivepriority,
+			.memstat_state = p->p_memstat_state,
+			.system_or_exiting = (p->p_flag & P_SYSTEM) != 0 || (p->p_lflag & (P_LEXIT | P_LPEXIT)) != 0 || t == TASK_NULL,
+			.footprint = 0,
+			.name = proc_best_name(p),
+		};
+		uint32_t v = n2mg_verdict(&c, maxband);
+		pick->why[v]++;
+		if (v != N2MG_OK) {
+			continue;
+		}
+		pick->eligible++;
+		c.footprint = get_task_phys_footprint(t);
+		if (best.pid == 0 || n2mg_better(&c, &best)) {
+			best = c;
+			strlcpy(pick->name, c.name, sizeof(pick->name));
+		}
+	}
+	proc_list_unlock();
+	pick->pid = best.pid;
+	pick->band = best.band;
+	pick->footprint = best.footprint;
+}
+
+/* Same pid, same name, still in an eligible band: the pid was not recycled between the walk and the kill. */
+static bool
+n2mg_still_same(const struct n2mg_pick *pick, int32_t maxband)
+{
+	bool same = false;
+	proc_t p = proc_find(pick->pid);
+	if (p != PROC_NULL) {
+		same = strncmp(proc_best_name(p), pick->name, sizeof(pick->name)) == 0 && p->p_memstat_effectivepriority <= maxband &&
+		    p->p_memstat_effectivepriority < N2MG_BAND_FOREGROUND && (p->p_memstat_state & N2MG_ST_EXCLUDE) == 0;
+		proc_rele(p);
+	}
+	return same;
+}
+
+static void
+n2mg_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	struct n2mg_limits lim;
+	struct n2mg_pick pick;
+	uint32_t crit_run = 0, last_low_pm = 0, last_crit_pm = 0;
+	uint64_t last_kill_ms = 0, last_kick_ms = 0, last_line_ms = 0, last_would_ms = 0;
+	int32_t last_would_pid = 0;
+	/* after a kill: A again 1 s later */
+	int32_t after_pid = 0;
+	uint32_t after_a = 0;
+	uint64_t after_ms = 0;
+	uint64_t ram = gPhysSize != 0 ? (uint64_t)gPhysSize : max_mem;
+	int chan = 0;
+
+	for (;;) {
+		int mode = n2mg_mode;
+		if ((uint32_t)n2mg_low_pm != last_low_pm || (uint32_t)n2mg_crit_pm != last_crit_pm || last_low_pm == 0) {
+			last_low_pm = (uint32_t)n2mg_low_pm;
+			last_crit_pm = (uint32_t)n2mg_crit_pm;
+			n2mg_limits_for(ram, (uint32_t)PAGE_SIZE, last_low_pm, last_crit_pm, &lim);
+			printf("NORD2 MEMGOV: mode %d (kern.n2memgov 0 off/1 log/2 kill), RAM %llu MiB = %u pages; purge kick under %u pages "
+			    "(kern.n2memgov_low %d permille), victim under %u pages (kern.n2memgov_crit %d permille), bands <= %d, one per %u ms\n",
+			    mode, ram >> 20, lim.pages, lim.low, n2mg_low_pm, lim.crit, n2mg_crit_pm, n2mg_maxband, N2MG_KILL_GAP_MS);
+		}
+		if (mode != N2MG_OFF) {
+			uint64_t now = n2mg_now_ms();
+			uint32_t a = n2mg_sample();
+			int level = n2mg_level(a, &lim);
+			int32_t maxband = n2mg_maxband;
+
+			if (after_pid != 0 && now - after_ms >= 1000) {
+				printf("NORD2 MEMGOV: after killing pid=%d: A %u -> %u pages (%+d)\n", after_pid, after_a, a, (int)(a - after_a));
+				after_pid = 0;
+			}
+			if (level != N2MG_LEVEL_OK && now - last_kick_ms >= 1000) {
+				last_kick_ms = now;
+				n2mg_kicks++;
+				sweet_surface_purge_kick_memgov();
+			}
+			if (level != N2MG_LEVEL_OK && now - last_line_ms >= 10000) {
+				last_line_ms = now;
+				printf("NORD2 MEMGOV: A=%u pages (free %u + pageable ext %u; purgeable %u, wired %u) level %s low %u crit %u; kicks %u "
+				    "would %u kills %u failed %u\n", a, vm_page_free_count, vm_page_pageable_external_count, vm_page_purgeable_count,
+				    vm_page_wire_count, level == N2MG_LEVEL_CRIT ? "CRIT" : "low", lim.low, lim.crit, n2mg_kicks, n2mg_would, n2mg_kills,
+				    n2mg_kill_failed);
+			}
+			if (n2mg_should_pick(level, &crit_run, now, last_kill_ms, (uint32_t)(now / 1000))) {
+				last_kill_ms = now;
+				n2mg_choose(maxband, &pick);
+				if (pick.pid == 0) {
+					printf("NORD2 MEMGOV: A=%u < crit %u but no victim in bands <= %d (skipped: pid %u band %u state %u system %u name %u)\n",
+					    a, lim.crit, maxband, pick.why[N2MG_NO_PID], pick.why[N2MG_NO_BAND], pick.why[N2MG_NO_STATE],
+					    pick.why[N2MG_NO_SYSTEM], pick.why[N2MG_NO_NAME]);
+				} else if (mode == N2MG_LOG) {
+					n2mg_would++;
+					if (pick.pid != last_would_pid || now - last_would_ms >= 30000) {
+						last_would_pid = pick.pid;
+						last_would_ms = now;
+						printf("NORD2 MEMGOV would kill band=%d pid=%d name=%s footprint=%llu MiB A=%u crit=%u (eligible %u; skipped: "
+						    "state %u system %u name %u) (kern.n2memgov=2 to act)\n", pick.band, pick.pid, pick.name, pick.footprint >> 20,
+						    a, lim.crit, pick.eligible, pick.why[N2MG_NO_STATE], pick.why[N2MG_NO_SYSTEM], pick.why[N2MG_NO_NAME]);
+					}
+				} else if (!n2mg_still_same(&pick, maxband)) {
+					printf("NORD2 MEMGOV: victim pid=%d name=%s changed before the kill; skipped\n", pick.pid, pick.name);
+				} else {
+					boolean_t ok = memorystatus_kill_on_zone_map_exhaustion(pick.pid);
+					if (ok) {
+						n2mg_kills++;
+						after_pid = pick.pid;
+						after_a = a;
+						after_ms = now;
+					} else {
+						n2mg_kill_failed++;
+					}
+					printf("NORD2 MEMGOV killed band=%d pid=%d name=%s footprint=%llu MiB A=%u crit=%u %s (kills %u)\n", pick.band, pick.pid,
+					    pick.name, pick.footprint >> 20, a, lim.crit, ok ? "ok" : "FAILED", n2mg_kills);
+				}
+			}
+		}
+		(void)tsleep((caddr_t)&chan, PVM, "n2memgov", (hz * (int)N2MG_PERIOD_MS + 999) / 1000);
+	}
+}
+
+static void
+nord2_memgov_start_once(void)
+{
+	thread_t th = THREAD_NULL;
+	if (!OSCompareAndSwap(0, 1, &n2mg_started)) {
+		return;
+	}
+	if (kernel_thread_start(n2mg_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("NORD2 MEMGOV: thread not started\n");
+		return;
+	}
+	thread_set_thread_name(th, "nord2_memgov");
+	thread_deallocate(th);
+}
