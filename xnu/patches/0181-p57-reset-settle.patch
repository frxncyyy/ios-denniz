 /* ------------------------------------------------------------------ */
 /* Buffers                                                             */
 
+/* 0181: a reset requested by a fault/timeout was only carried out by n2c_poll, i.e. by a WAIT call.  A client that meanwhile allocates, syncs or submits got
+ * N2C_E_STATE ("not ready") and retried for up to 10 s (the shim's 100 x 100 ms loop) while nobody ran the reset.  Those paths now run it themselves. */
+static void settle_reset(struct n2c_core *c)
+{
+        if (c && c->reset_pending && c->state == N2C_CORE_READY)
+                n2c_poll(c);
+}
+
 enum n2c_error n2c_bo_map(struct n2c_core *c, unsigned idx,
                           const struct n2c_page *pages, unsigned nr_pages,
                           uint32_t flags, void *cookie, uint64_t charged,
@@ -763,6 +771,7 @@
