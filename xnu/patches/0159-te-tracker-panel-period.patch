+/* 0159: one precise TE observation: phase error of the last predicted start, period estimate, reference. */
+void
+AppleCLCD::teObserve(uint64_t obsUs)
+{
+	if (fFireValid) {
+		fFireValid = false;
+		int64_t pe = (int64_t)obsUs - (int64_t)fFireTeUs;
+		uint64_t ap = pe < 0 ? (uint64_t)(-pe) : (uint64_t)pe;
+		fPhaseBin[ap <= 300 ? 0 : ap <= 600 ? 1 : ap <= 1000 ? 2 : ap <= 2000 ? 3 : 4]++;
+	}
+	if (fTeLastUs != 0 && obsUs > fTeLastUs && obsUs - fTeLastUs < 2000000) {
+		uint64_t d = obsUs - fTeLastUs, P = fTePeriodUs, n = (d + P / 2) / P;
+		int64_t err = n ? (int64_t)d - (int64_t)(n * P) : 0;
+		if (n >= 1 && n <= 200 && err > -(int64_t)(P / 4) && err < (int64_t)(P / 4)) {
+			fTeSpanUs += d; fTeN += (uint32_t)n;
+			fTePeriodUs = (uint64_t)((int64_t)P + err / (int64_t)(8 * n));
+			if (fTePeriodUs < 8000) { fTePeriodUs = 8000; } else if (fTePeriodUs > 20000) { fTePeriodUs = 20000; }
+		}
+	}
+	fTeLastUs = obsUs;
+}
+
+/* 0159: while idle, look for the TE now and then (tightly, a fraction of a ms) so the first frame after a pause still starts ahead of it. */
+void
+AppleCLCD::trackArm(void)
+{
+#if defined(NORD2)
+	if (fPresentTimer == NULL || fTeLastUs == 0 || fDsi == NULL || !fRefGood) { return; }
+	uint64_t nowUs = sweet_fb_abs_to_us(mach_absolute_time()), P = fTePeriodUs;
+	uint64_t k = (nowUs + 100000 + 400 - fTeLastUs) / P + 1;      /* a predicted TE at least 100 ms from now */
+	uint64_t target = fTeLastUs + k * P - 400;
+	fTrackAtUs = target;
+	fPresentTimer->setTimeoutUS((uint32_t)(target - nowUs));
+#endif
+}
+
+void
+AppleCLCD::trackTe(IOTimerEventSource *sender)
+{
+#if defined(NORD2)
+	(void)sender;
+	if (fDsi == NULL || fTeLastUs == 0 || fTrackAtUs == 0 || __atomic_load_n(&fSwapLifecycle.stopped, __ATOMIC_ACQUIRE)) { return; }
+	if (sweet_fb_abs_to_us(mach_absolute_time()) + 300 < fTrackAtUs) { return; }      /* woken for something else */
+	fTrackAtUs = 0;
+	fDsi[SWEET_FB_DSI_INTSTA / 4] = ~SWEET_FB_DSI_TE_RDY;
+	uint64_t s0 = sweet_fb_abs_to_us(mach_absolute_time()), tn = s0;
+	bool seen = false;
+	while (tn - s0 < 1000) {
+		if (fDsi[SWEET_FB_DSI_INTSTA / 4] & SWEET_FB_DSI_TE_RDY) { seen = true; break; }
+		IODelay(5);
+		tn = sweet_fb_abs_to_us(mach_absolute_time());
+	}
+	if (seen) { teObserve(tn); fRefGood = true; fTrackHit++; }
+	else { fRefGood = false; fTrackMiss++; }
+	if (fPState == 0) { trackArm(); }
+#endif
+}
