+static unsigned fall_settle_us(uint32_t delta_uv, unsigned fixed)
+{
+        /* __calculate_v{gpu,sram}_settletime(falling): dV / 5 mV + c. */
+        return delta_uv / 5000u + fixed;
+}
+
+static bool set_diff_ok(uint32_t vgpu, uint32_t vsram)
+{
+        int32_t d = (int32_t)vsram - (int32_t)vgpu;
+        return d <= N2RAIL_BUCK_DIFF_MAX_UV && d >= N2RAIL_BUCK_DIFF_MIN_UV;
+}
+
+static enum n2rail_error set_vsram(struct n2rail *r, uint8_t sel, uint32_t from_uv, uint32_t to_uv)
+{
+        if (!r->vsram_raised && !r->vsram_enabled_by_us) {
+                uint16_t elr = 0;
+                if (r->ops.mt6359_read(r->ctx, N2RAIL_VSRAM_ELR, &elr))
+                        return N2RAIL_E_IO;
+                r->vsram_orig_elr = (uint16_t)(elr & 0x7fu);
+        }
+        enum n2rail_error e = upd16(r, N2RAIL_VSRAM_ELR, 0x007f, sel);
+        if (e != N2RAIL_OK)
+                return e;
+        r->vsram_raised = sel != r->vsram_orig_elr;
+        r->ops.udelay(r->ctx, to_uv > from_uv ? rise_settle_us(to_uv - from_uv, 8) : fall_settle_us(from_uv - to_uv, 8));
+        uint16_t vosel1 = 0;
+        if (r->ops.mt6359_read(r->ctx, N2RAIL_VSRAM_VOSEL1, &vosel1))
+                return N2RAIL_E_IO;
+        return ((vosel1 >> 8) & 0x7fu) == sel ? N2RAIL_OK : N2RAIL_E_VERIFY;
+}
+
+static enum n2rail_error set_vgpu(struct n2rail *r, uint8_t sel, uint32_t from_uv, uint32_t to_uv)
+{
+        if (!r->vgpu_raised && !r->vgpu_enabled_by_us) {
+                uint8_t v = 0;
+                if (r->ops.mt6315_read(r->ctx, N2RAIL_VGPU_VOSEL, &v))
+                        return N2RAIL_E_IO;
+                r->vgpu_orig_sel = v;
+        }
+        enum n2rail_error e = upd8(r, N2RAIL_VGPU_VOSEL, 0xff, sel);
+        if (e != N2RAIL_OK)
+                return e;
+        r->vgpu_raised = sel != r->vgpu_orig_sel;
+        r->ops.udelay(r->ctx, to_uv > from_uv ? rise_settle_us(to_uv - from_uv, 9) : fall_settle_us(from_uv - to_uv, 9));
+        uint8_t da = 0;
+        if (r->ops.mt6315_read(r->ctx, N2RAIL_VGPU_DA_VOSEL, &da))
+                return N2RAIL_E_IO;
+        return da == sel ? N2RAIL_OK : N2RAIL_E_VERIFY;
+}
+
+enum n2rail_error n2rail_set(struct n2rail *r, uint32_t vgpu_uv, uint32_t vsram_uv)
+{
+        if (!r)
+                return N2RAIL_E_ARGS;
+        if (!r->on || r->uncertain)
+                return N2RAIL_E_STATE;
+        if (vgpu_uv < N2RAIL_SET_VGPU_MIN_UV || vgpu_uv > n2rail_opp_table[0].vgpu_uv ||
+            vsram_uv < N2RAIL_SET_VSRAM_MIN_UV || vsram_uv > n2rail_opp_table[0].vsram_uv)
+                return N2RAIL_E_OVERVOLT;
+        uint8_t gsel = n2rail_vgpu_sel_for_uv(vgpu_uv), ssel = n2rail_vsram_sel_for_uv(vsram_uv);
+        uint32_t g_new = 0, s_new = 0;
+        if (!n2rail_vgpu_uv(gsel, &g_new) || !n2rail_vsram_uv(ssel, &s_new) ||
+            g_new > n2rail_opp_table[0].vgpu_uv || s_new > n2rail_opp_table[0].vsram_uv)
+                return N2RAIL_E_SELECTOR;
+        r->step = 20;
+        uint8_t g_sel_now = 0, en = 0;
+        uint16_t elr = 0, mon = 0;
+        if (r->ops.mt6315_read(r->ctx, N2RAIL_VGPU_DA_VOSEL, &g_sel_now) || r->ops.mt6315_read(r->ctx, N2RAIL_VGPU_DA_EN, &en) ||
+            r->ops.mt6359_read(r->ctx, N2RAIL_VSRAM_ELR, &elr) || r->ops.mt6359_read(r->ctx, N2RAIL_VSRAM_MON, &mon))
+                return N2RAIL_E_IO;
+        uint32_t g_now = 0, s_now = 0;
+        if (!(en & 1u) || !(mon & 1u))
+                return N2RAIL_E_STATE;          /* a rail that is not on is not changed here */
+        if (!n2rail_vgpu_uv(g_sel_now, &g_now) || !n2rail_vsram_uv((uint8_t)(elr & 0x7fu), &s_now))
+                return N2RAIL_E_SELECTOR;
+        /* every intermediate state within BUCK_DIFF: VSRAM up first, VGPU, VSRAM down last */
+        uint32_t s_mid = s_new > s_now ? s_new : s_now;
+        if (!set_diff_ok(g_now, s_mid) || !set_diff_ok(g_new, s_mid) || !set_diff_ok(g_new, s_new))
+                return N2RAIL_E_DIFF;
+        enum n2rail_error e = N2RAIL_OK;
+        if (s_new > s_now) {
+                r->step = 21;
+                e = set_vsram(r, ssel, s_now, s_new);
+        }
+        if (e == N2RAIL_OK && g_new != g_now) {
+                r->step = 22;
+                e = set_vgpu(r, gsel, g_now, g_new);
+        }
+        if (e == N2RAIL_OK && s_new < s_now) {
+                r->step = 23;
+                e = set_vsram(r, ssel, s_now, s_new);
+        }
+        if (e != N2RAIL_OK) {
+                r->uncertain = true;
+                note(r, "Nord2 GPU rail: live voltage change failed; rails uncertain");
+                return e;
+        }
+        r->step = 24;
+        r->point.vgpu_uv = g_new;
+        r->point.vsram_uv = s_new;
+        (void)n2rail_capture(r, &r->after);
+        return N2RAIL_OK;
+}
