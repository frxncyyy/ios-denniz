diff -ruN a/bsd/dev/nord2_vcodec.inc b/bsd/dev/nord2_vcodec.inc
--- a/bsd/dev/nord2_vcodec.inc
+++ b/bsd/dev/nord2_vcodec.inc
@@ -139,6 +139,10 @@
 
 #define N2VC_POOL_PAGES  (RW_CLAIM_VCODEC_BYTES / 4096u)
 #define N2VC_POOL_WORDS  ((N2VC_POOL_PAGES + 31u) / 32u)
+/* 0313: the pool must stay below 4 GB (32-bit DMA addresses, IOMMU bypassed) inside the free gap SCP-reserved end ..
+ * vpu_binary (live FDT mblocks), and a whole number of bitmap words (n2vc_pool_free_pages counts words). */
+_Static_assert(RW_CLAIM_VCODEC_PA >= 0x9ff00000u && (uint64_t)RW_CLAIM_VCODEC_PA + RW_CLAIM_VCODEC_BYTES <= 0xbd6c0000ull &&
+    (RW_CLAIM_VCODEC_PA & 0xfffu) == 0 && N2VC_POOL_PAGES % 32u == 0, "vcodec pool outside the free low-DRAM gap");
 #define N2VC_DMA_MAX     1024u
 #define N2VC_DMA_PER_FILE 128u
 #define N2VC_MAX_FILES   16u
@@ -697,7 +701,7 @@
 n2vc_pool_free_pages(void)
 {
 	uint32_t n = 0;
-	for (uint32_t p = 0; p < N2VC_POOL_PAGES; p++) { if (n2vc_pg_free(p)) { n++; } }
+	for (uint32_t w = 0; w < N2VC_POOL_WORDS; w++) { n += 32u - (uint32_t)__builtin_popcount(n2vc.pool_bits[w]); }
 	return n;
 }
 
diff -ruN a/bsd/dev/redwood_vcodec.h b/bsd/dev/redwood_vcodec.h
--- a/bsd/dev/redwood_vcodec.h
+++ b/bsd/dev/redwood_vcodec.h
@@ -104,11 +104,14 @@
 #define RWVC_MSG_RECV   RWVC_IOC(0xc0000000u, 11, struct rwvc_msg)
 #define RWVC_DMA_INFO   RWVC_IOC(0xc0000000u, 12, struct rwvc_dma_info)
 
-/* Fixed physical claims below 4 GB (nothing is carved out in 0xC0000000..0xDFE70000; cameras use 0xD0000000..0xD8000000):
+/* Fixed physical claims below 4 GB, all in DRAM rank 0 below XNU's window (0x1_42000000 + 3776 MiB), so none costs iOS RAM;
+ * free = not in the live FDT's mblock list (dtb/nord2/live.dts) nor in the loader, Wi-Fi, DVFS-share or camera claims:
+ *   vcodec 0xA0000000 .. 0xB8000000  (the RWVC pool, 384 MiB; 0313: was 0xDA800000 + 86 MiB; SCP-reserved ends 0x9FF00000,
+ *                                     vpu_binary starts 0xBD6C0000)                        bsd/dev/nord2_vcodec.inc
  *   JPEG   0xD8000000 .. 0xDA800000  (source 24 MiB at +0, output 16 MiB at +0x1800000)   bsd/dev/nord2_jpegdev.inc
- *   vcodec 0xDA800000 .. 0xDFE00000  (the RWVC pool, 86 MiB)                              bsd/dev/nord2_vcodec.inc */
+ *   (cameras 0xD0000000..0xD8000000; 0xDA800000..0xDFE70000 is now unused) */
 #define RW_CLAIM_JPEG_PA    0xd8000000u
 #define RW_CLAIM_JPEG_BYTES 0x02800000u
-#define RW_CLAIM_VCODEC_PA    0xda800000u
-#define RW_CLAIM_VCODEC_BYTES 0x05600000u
+#define RW_CLAIM_VCODEC_PA    0xa0000000u
+#define RW_CLAIM_VCODEC_BYTES 0x18000000u
 #endif
