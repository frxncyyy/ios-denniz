+	n2mdp_wr(W + W_ROT_EN, 0);
+	n2mdp_wr(W + W_SOFT_RST, 1u);
+	bool w_ok = n2mdp_poll_bits(W + W_SOFT_RST_STAT, 1u, 1u, 100);
