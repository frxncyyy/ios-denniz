 // ICCID and GIDs for the whole boot (they are read once), so a second card was announced with the first one's identity in the
 // activation indication, and its SIM-bound setup (IMS, APN table, SMS/call settings) was never redone. Forget all of it; the next
 // ready card is read again (bb_identity_tries reset).
+// 0712 (sim-20261115, kern.n2nr): NR (5G) visibility. The modem already runs with the stock RIL's RAT mode (AT+EGRAT=22 / AT+ERAT=22,128 in
+// sweet_amfi.c's boot script: 2G/3G/4G/5G, NR preferred) and +CEREG reports AcT 13 (E-UTRA-NR dual connectivity) on Very's cells, so
+// NR NSA is the modem's business; iOS cannot show it: this identity is an iPhone X (Mav17 baseband, LTE only; CommCenter keeps
+// activation_5g_support kFalse), and nbm_radio maps AcT 10/13 to LTE on purpose. What was missing is any way to see whether the NR leg
+// is up: the stock RIL's reports are enabled here (AT+ECAPABILITY=1, AT+ENRCABAND=1, as mtkfusionrild after the radio is on; on
+// Android "+ENRCABAND: 1,78" = NR leg on band n78) and AT+E5GOPT? is read once (stock ROM: 5). Log "NORD2 NR:", kern.n2nr_state.
+static uint8_t bb_nr_setup;
+static uint32_t bb_nr_urcs;
+static void bb_nr_done(void *ctx, int final, const char *text, unsigned len)
+{
+  static const char *const cmds[] = { "AT+ECAPABILITY=1", "AT+ENRCABAND=1", "AT+E5GOPT?", "AT+ECAPABILITY?", "AT+ENRCABAND?" };
+  const uint32_t i = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(ctx)) % 5u;
+  char shown[96];
+  unsigned k = 0;
+  for (unsigned j = 0; j < len && k + 2 < sizeof shown; j++) shown[k++] = text[j] == '\n' ? '|' : text[j] >= 32 && text[j] < 127 ? text[j] : '?';
+  while (k && shown[k - 1] == '|') k--;
+  shown[k] = 0;
+  printf("NORD2 NR: %s -> %s [%s]\n", cmds[i], final == NORD2_AT_FINAL_OK ? "OK" : final == NORD2_AT_FINAL_TIMEOUT ? "timeout" : "ERROR", shown);
+}
+static void bb_nr_check(void)                                     // bb_lock held, snapshot
+{
+  if (!nord2_nr || bb_nr_setup || bb_st.cfun != 1 || (bb_flags & NBB_NO_AT) || (nord2_modem_state() & NORD2_MODEM_DEAD)) return;
+  static const char *const cmds[] = { "AT+ECAPABILITY=1", "AT+ENRCABAND=1", "AT+E5GOPT?", "AT+ECAPABILITY?", "AT+ENRCABAND?" };
+  int e = 0;
+  for (uintptr_t i = 0; i < 5u && !e; i++) e = nord2_at_query(cmds[i], bb_nr_done, reinterpret_cast<void *>(i));
+  bb_nr_setup = 1;
+  printf("NORD2 NR: reporting enabled (AT+ECAPABILITY=1, AT+ENRCABAND=1, AT+E5GOPT?)%s; EPS AcT %d now (13 = NR dual connectivity cell)\n",
+         e ? " - queue full, partly" : "", bb_st.eps_act);
+}
+static long bb_nr_num(const char **p)
+{
+  while (**p == ' ' || **p == ',') (*p)++;
+  long v = -1;
+  if (**p == '-') { (*p)++; while (**p >= '0' && **p <= '9') (*p)++; return -1; }
+  if (**p >= '0' && **p <= '9') { v = 0; while (**p >= '0' && **p <= '9') v = v * 10 + (*(*p)++ - '0'); }
+  return v;
+}
+static bool bb_nr_urc(const char *line)                           // modem service thread; never an identity in these lines
+{
+  const bool band = nbm_prefix(line, "+ENRCABAND:"), cap = nbm_prefix(line, "+ECAPABILITY:");
+  if (!band && !cap && !nbm_prefix(line, "+E5GOPT:")) return false;
+  const char *p = line + (band ? 11 : cap ? 13 : 8);
+  uint32_t st = nord2_nr_state & 0x7fffffffu;
+  if (band) {
+    const long a = bb_nr_num(&p), b = bb_nr_num(&p);
+    if (a >= 0) st = (st & ~0x00ffffffu) | (uint32_t)(a & 0xff) | (b > 0 ? (uint32_t)(b & 0xffff) << 8 : 0u);
+  } else if (cap) {
+    const long a = bb_nr_num(&p);
+    if (a >= 0) st = (st & 0x00ffffffu) | (uint32_t)(a & 0x7f) << 24;
+  }
+  nord2_nr_state = st | 0x80000000u;
+  if (bb_nr_urcs++ < 200) printf("NORD2 NR: URC %.80s -> NR leg %s, band n%u\n", line, (st & 0xffu) ? "UP" : "down", (st >> 8) & 0xffffu);
+  return true;
+}
