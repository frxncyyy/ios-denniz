+static struct n2c_bo *tracked_bo(struct n2c_core *c, unsigned idx, uint32_t handle,
+                                 enum n2c_error *e)
+{
+        struct n2c_ctx *x = c ? ctx_at(c, idx) : NULL;
+        if (!x) {
+                *e = N2C_E_NO_CTX;
+                return NULL;
+        }
+        struct n2c_bo *b = bo_at(x, handle);
