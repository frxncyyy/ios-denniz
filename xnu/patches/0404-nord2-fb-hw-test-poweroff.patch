+/* ---- 0404 (hwfix-20261113): test pattern vs display power-off ---------------------------------------------------------------
+ * Device (night12/night10/night8, q10jfw): backboardd turned the display off (RequestPowerChange 0) during the 3 s hold of the
+ * 0399 colour self-test.  The power-off fade (vsync thread) then drew black into panel buffer 0 and pushed it while the test still
+ * owned the panel (present state 7), and at the test end the CPU path was restored and the front buffer pushed: buffer 0 = the
+ * fade's black, buffer 1 = a stale UI frame lit on a display that is off.  Nothing woke the display afterwards in night12/10 (no
+ * power key: the scenario's touches do not wake an off screen), so no present followed -- the "frozen" display.
+ * Rules: the fade waits while a test owns the panel; a test that ends with the display off restores the CPU path onto buffer 0
+ * (the buffer the fade draws into), never re-applies a HW frame and pushes nothing; the fade then runs from its first step. */
+#define SWEET_FB_HW_PSTATE_TEST     7u      /* AppleCLCD::fPState while an H2 test pattern owns the panel */
+static inline bool
+sweet_fb_hw_fade_may_run(uint32_t pstate)
+{
+	return pstate != SWEET_FB_HW_PSTATE_TEST;
+}
+struct sweet_fb_hw_test_end { bool select_buffer0, push, reapply; };
+static inline struct sweet_fb_hw_test_end
+sweet_fb_hw_test_end_action(bool power_off, bool dbl, uint32_t front, bool reapply_wanted)
+{
+	struct sweet_fb_hw_test_end e;
+	e.select_buffer0 = power_off && dbl && front != 0;
+	e.push = !power_off;
+	e.reapply = !power_off && reapply_wanted;
+	return e;
+}
+/* the panel buffer the CPU path shows: what layer 0 is restored to */
+static inline uint64_t
+sweet_fb_hw_front_base(bool dbl, uint32_t front, uint64_t buf_a, uint64_t buf_b)
+{
+	return (dbl && front) ? buf_b : buf_a;
+}
