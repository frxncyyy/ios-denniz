+/// A stage whose code a consumer compiles itself from the same Metal function (not this crate's
+/// SPIR-V), stated for the binder by its stage, entry point and specialization layout. `spirv` is
+/// the consumer's interface-facts module (a valid module header and decorations only, no code;
+/// [`RenderPipeline::from_parts`]); every other fact is empty. Not API: an unstable internal for a
+/// consumer that plans its draws through [`RenderPipeline::plan`] with metadata it derived itself.
+impl StageModule {
+    #[doc(hidden)]
+    pub fn external(
+        stage: vk::ShaderStage,
+        entry_point: String,
+        specialization: SpecializationLayout,
+        spirv: Arc<[u32]>,
+    ) -> StageModule {
+        StageModule {
+            stage,
+            entry_point,
+            spirv,
+            specialization,
+            required_subgroup_size: None,
+            stage_flags: vk::PipelineShaderStageCreateFlags::empty(),
+            reconvergence: Reconvergence::Guaranteed,
+            precision_notes: Vec::new(),
+            strategies: StrategyCensus::default(),
+            constant_blob: None,
+            rounded_colors: Vec::new(),
+            specialized_notes: Vec::new(),
+            half_bit_colors: Vec::new(),
+        }
+    }
+}
+
+/// A render pipeline from metadata a consumer derived itself (its own compiler's view of the
+/// same Metal functions, in this crate's vocabulary), for planning its draws through
+/// [`RenderPipeline::plan`]; its stages are [`StageModule::external`]. The requirements are
+/// empty: the consumer creates no Vulkan pipeline from it. Not API: an unstable internal.
+impl RenderPipeline {
+    #[doc(hidden)]
+    #[allow(clippy::too_many_arguments)]
+    pub fn from_parts(
+        key: PipelineKey,
+        profile: Hash256,
+        stages: Vec<StageModule>,
+        layout: PipelineLayout,
+        vertex_input: VertexInputState,
+        graphics: GraphicsState,
+        dependencies: Vec<RuntimeDependency>,
+        interface: PipelineInterface,
+        variant_bits: u32,
+    ) -> RenderPipeline {
+        RenderPipeline {
+            key,
+            profile,
+            stages,
+            layout,
+            vertex_input,
+            graphics,
+            dependencies,
+            interface,
+            requirements: Requirements::default(),
+            variant_bits,
+        }
+    }
+}
