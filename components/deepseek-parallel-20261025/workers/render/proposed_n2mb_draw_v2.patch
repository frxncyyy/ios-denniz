Proposed compute-owned additive bridge change; NOT applied by render.
Render already calls this exact symbol weakly from compositor_submit.inc once
linked. All old n2mb_draw/n2r_build bytes remain unchanged.

--- a/gpu/metal/nord2_metal_bridge.h
+++ b/gpu/metal/nord2_metal_bridge.h
@@
 int n2mb_draw(uintptr_t,const struct tegu_generic_draw_shader *,const struct tegu_generic_draw_request *,uint64_t *,unsigned *);
+/* Additive v2 texture/sampler sidecar; pass NULL/empty resources to preserve
+ * the old n2mb_draw bytes. */
+int n2mb_draw_v2(uintptr_t,const struct tegu_generic_draw_shader *,
+ const struct tegu_generic_draw_request *,const struct n2r_texture_resources *,
+ uint64_t *,unsigned *);

--- a/gpu/metal/nord2_metal_bridge.c
+++ b/gpu/metal/nord2_metal_bridge.c
@@
 static int draw_locked(struct bridge *b,const struct tegu_generic_draw_shader *s,const struct tegu_generic_draw_request *q,
- uint64_t *out,unsigned *count,struct diag *d){
+ const struct n2r_texture_resources *tr,uint64_t *out,unsigned *count,struct diag *d){
@@
- e=n2r_build(m,s,q,&a,q->load_action==1?2:1,0);if(e){e=BAD;goto done;}
+ e=tr?n2r_build_v2(m,s,q,&a,tr,q->load_action==1?2:1,0):
+          n2r_build(m,s,q,&a,q->load_action==1?2:1,0);
+ if(e){e=BAD;goto done;}
@@
 int n2mb_draw(uintptr_t value,const struct tegu_generic_draw_shader *s,const struct tegu_generic_draw_request *q,uint64_t *out,unsigned *count){
@@
- int e=draw_locked(b,s,q,out,count,NULL);
+ int e=draw_locked(b,s,q,NULL,out,count,NULL);
  b->ops.unlock(b->ops.opaque);return e;
 }
+int n2mb_draw_v2(uintptr_t value,const struct tegu_generic_draw_shader *s,
+ const struct tegu_generic_draw_request *q,const struct n2r_texture_resources *tr,
+ uint64_t *out,unsigned *count){
+ struct bridge *b=(void *)value;
+ if(!b||!out||!count||*count<2||!tr||
+    n2r_validate_v2(s,q,tr))return BAD;
+ b->ops.lock(b->ops.opaque);
+ if(b->matrix==1&&!b->broken)tiler_matrix(b);
+ int e=draw_locked(b,s,q,tr,out,count,NULL);
+ b->ops.unlock(b->ops.opaque);return e;
+}

Notes:
- draw_locked already resolves the complete q->bindings[i].memory.bytes span
  and retains the BO; n2r_build_v2 checks sidecar.backing_length <= that span.
- n2mb_clear and tiler_matrix continue to call n2mb_draw/NULL, preserving old
  bytes. No Dispatch field or cleanup change is needed: render rebuilds the
  sidecar at submit from Dispatch and calls n2mb_draw_v2 synchronously.
- The render weak declaration uses __attribute__((weak_import)) on Apple and
  weak elsewhere; a strong definition here resolves it.
