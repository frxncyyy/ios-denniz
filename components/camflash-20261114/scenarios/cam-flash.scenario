# camflash-20261114 scenario B: the flash photograph (after the camflashon transaction: Camera's flash = ON, so CMCapture asks for a
# flash photograph = ForceFlashOn + StillImageCaptureNow; or after camflashtest: every photograph forced through the strobe).
# Run: python3 $B/autotest/phone.py scenario $B/camflash-20261114/scenarios/cam-flash.scenario $B/autotest/runs/cfB --wait-s 6
launch camera
sleep 5
logs
# three flash photographs, >= 6 s apart (the strobe's 1/5 duty cool-down is 4 x its length: < 1 s)
shutter --watch 12
sleep 6
logs
shutter --watch 12
sleep 6
logs
# ultra-wide with the flash
lens 0.5
sleep 4
shutter --watch 12
sleep 6
lens 1
sleep 3
logs
# torch during a video (Camera turns the LED on as a torch when flash = ON in video mode), then back
mode video
sleep 4
shutter
sleep 8
shutter
sleep 5
mode photo
sleep 3
logs
