# camflash-20261114 scenario A (q10jcr, NO camflash payload: Camera's own flash setting, Auto by default): every camera function once.
# Run: python3 $B/autotest/phone.py scenario $B/camflash-20261114/scenarios/cam-all.scenario $B/autotest/runs/cfA --wait-s 6
# No screenshots (overlay mode); everything is judged from the kernel log (camflash_check.py) and the files of the next snapshot.
launch camera
sleep 5
logs
# 1. photograph, back wide (1x)
shutter --watch 10
sleep 4
logs
# 2. ultra-wide (0.5x) photograph, back to 1x
lens 0.5
sleep 4
shutter --watch 10
sleep 4
lens 1
sleep 3
logs
# 3. zoom: pinch in / out, a tap to focus, a photograph at 2x+
pinch 540 1000 200 800 --ms 700
sleep 3
focus 540 900
sleep 3
shutter --watch 10
sleep 4
pinch 540 1000 800 200 --ms 700
sleep 3
logs
# 4. front camera photograph, then back
lens flip
sleep 5
shutter --watch 10
sleep 4
lens flip
sleep 5
logs
# 5. video 12 s (1080p30 H.264/HEVC hardware encoder, microphone), back to photo
mode video
sleep 4
shutter
sleep 12
shutter
sleep 5
mode photo
sleep 3
logs
