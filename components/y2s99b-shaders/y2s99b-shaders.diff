+/* y2s99b: THE MATH FUNCTIONS WITH A SECOND RESULT THROUGH A POINTER, which math_op cannot take (it resolves every
+ * argument as a number, so they stopped at "a pointer where a number belongs" -- PridePoster's ribbonVertex,
+ * shadowVertex and updateParticles: air.fast_sincos.f32 / air.sincos.f16 into an alloca):
+ *   air.[fast_]sincos.T(x, ptr cos_out) -> sin(x), *cos_out = cos(x)
+ *   air.[fast_]modf.T(x, ptr int_out)   -> x - trunc(x) (sign of x; inf -> +-0), *int_out = trunc(x)
+ *   air.[fast_]frexp.T(x, ptr exp_out)  -> mantissa in [0.5, 1), *exp_out = exponent (i32 or vector of them)
+ */
+static bool
+ptr_result_op(struct air_ctx *c, const struct air_inst *in, const struct air_name *n, bool *handled)
+{
+   const char *op = n->part[0];
+
+   if (!strncmp(op, "fast_", 5))
+      op += 5;
+   *handled = false;
+   if (!air_y2s99b || (strcmp(op, "sincos") && strcmp(op, "modf") && strcmp(op, "frexp")))
+      return true;
+   if (in->num_operands != 3)
+      return true;            /* not the pointer form: math_op says what it is */
+   struct air_val *p = air_get(c, in->operands[2]);
+   if (!p)
+      return false;
+   if (p->kind != AIR_VAL_PTR)
+      return true;
+   *handled = true;
+   nir_def *x = air_get_ssa(c, in->operands[1]);
+   if (!x)
+      return false;
+   nir_builder *b = &c->b;
+   bool was_exact = b->exact;
+   nir_def *r, *second;
+
+   b->exact = false;
+   if (!strcmp(op, "sincos")) {
+      r = nir_fsin(b, x);
+      second = nir_fcos(b, x);
+   } else if (!strcmp(op, "modf")) {
+      second = nir_ftrunc(b, x);
+      /* x - trunc(x), and an infinity gives a zero of its sign (Metal = C's modf) */
+      r = nir_bcsel(b, nir_feq(b, nir_fabs(b, x), nir_imm_floatN_t(b, INFINITY, x->bit_size)),
+                    nir_iand_imm(b, x, 1ull << (x->bit_size - 1)), nir_fsub(b, x, second));
+   } else {
+      nir_def *x32 = x->bit_size == 32 ? x : nir_f2f32(b, x);
+
+      second = nir_frexp_exp(b, x32);
+      r = nir_frexp_sig(b, x32);
+      if (x->bit_size != 32)
+         r = nir_f2fN(b, r, x->bit_size);
+   }
+   b->exact = was_exact;
+   air_y2s99b_count[0]++;
+   if (!air_store_ptr(c, p->ptr, second, 0))
+      return false;
+   air_set(c, &in->base, air_val_ssa(c, r));
+   return true;
+}
