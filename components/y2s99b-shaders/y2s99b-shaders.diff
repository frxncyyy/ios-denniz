+ * y2s99b, HOST TESTS ONLY (linked into blur_chain_host_test; air_metal.c calls it only when built with -DRWA_HOST_WIDEN16):
+ * softpipe (nir_to_tgsi) has no 16-bit values, and CoreAnimation's blur functions are all `_lph` (half precision). This turns a
+ * translated shader's 16-bit values into 32-bit ones with the same numbers: every 16-bit def becomes 32-bit, a 16-bit float
+ * constant is widened as a float (an integer one as an integer, decided by its uses), conversions to or from 16 bits become
+ * moves or the 32-bit conversion, a 16-bit texture result a 32-bit one, a 16-bit store_output a 32-bit one, and a 16-bit
+ * load_ubo reads the 32-bit words that hold the halves and unpacks them (unpack_half_2x16_split_x/y).
+ * What this changes against the phone: intermediate values are not rounded to half after each operation (the CPU model rounds
+ * the taps and weights, where the shader's own conversions are); the test's tolerance carries that.
+ */
+#include "nir.h"
+#include "nir_builder.h"
+#include <stdlib.h>
+
+static bool
+used_as_float(nir_def *def)
+{
+	nir_foreach_use(src, def) {
+		nir_instr *u = nir_src_parent_instr(src);
+		if (u->type == nir_instr_type_alu) {
+			nir_alu_instr *a = nir_instr_as_alu(u);
+			unsigned i = (unsigned)((nir_alu_src *)src - a->src);
+			if (i < nir_op_infos[a->op].num_inputs &&
+			    nir_alu_type_get_base_type(nir_op_infos[a->op].input_types[i]) == nir_type_float)
+				return true;
+		}
+		if (u->type == nir_instr_type_intrinsic) {
+			nir_intrinsic_instr *x = nir_instr_as_intrinsic(u);
+			if (x->intrinsic == nir_intrinsic_store_output &&
+			    nir_alu_type_get_base_type(nir_intrinsic_src_type(x)) == nir_type_float)
+				return true;
+		}
+	}
+	return false;
+}
+
+static nir_def *
+unpack_half_at(nir_builder *b, unsigned index, nir_def *byte_off, const nir_intrinsic_instr *orig)
+{
+	nir_def *aligned = nir_iand_imm(b, byte_off, ~3u);
+	nir_def *word = nir_load_ubo(b, 1, 32, nir_imm_int(b, index), aligned, .align_mul = 4, .align_offset = 0,
+				     .range_base = nir_intrinsic_range_base(orig), .range = nir_intrinsic_range(orig));
+	nir_def *hi = nir_ine_imm(b, nir_iand_imm(b, byte_off, 2), 0);
+	nir_def *both = nir_unpack_half_2x16(b, word);
+	return nir_bcsel(b, hi, nir_channel(b, both, 1), nir_channel(b, both, 0));
+}
+
+void rwa_host_widen16(nir_shader *nir);
+void
+rwa_host_widen16(nir_shader *nir)
+{
+	nir_foreach_variable_with_modes(var, nir, nir_var_shader_in | nir_var_shader_out) {
+		const struct glsl_type *t = glsl_without_array(var->type);
+		if (glsl_type_is_vector_or_scalar(t) && glsl_get_bit_size(t) == 16 && !glsl_type_is_array(var->type))
+			var->type = glsl_vector_type(glsl_get_base_type(t) == GLSL_TYPE_FLOAT16 ? GLSL_TYPE_FLOAT :
+						     glsl_get_base_type(t) == GLSL_TYPE_INT16 ? GLSL_TYPE_INT : GLSL_TYPE_UINT,
+						     glsl_get_vector_elements(t));
+	}
+	nir_foreach_function_impl(impl, nir) {
+		nir_builder b = nir_builder_create(impl);
+		nir_foreach_block(block, impl) {
+			nir_foreach_instr_safe(instr, block) {
+				switch (instr->type) {
+				case nir_instr_type_load_const: {
+					nir_load_const_instr *k = nir_instr_as_load_const(instr);
+					if (k->def.bit_size != 16)
+						break;
+					bool f = used_as_float(&k->def);
+					for (unsigned i = 0; i < k->def.num_components; i++) {
+						uint16_t raw = k->value[i].u16;
+						if (f)
+							k->value[i] = nir_const_value_for_float(_mesa_half_to_float(raw), 32);
+						else
+							k->value[i] = nir_const_value_for_int((int16_t)raw, 32);
+					}
+					k->def.bit_size = 32;
+					break;
+				}
+				case nir_instr_type_undef: {
+					nir_undef_instr *u = nir_instr_as_undef(instr);
+					if (u->def.bit_size == 16)
+						u->def.bit_size = 32;
+					break;
+				}
+				case nir_instr_type_phi: {
+					nir_phi_instr *p = nir_instr_as_phi(instr);
+					if (p->def.bit_size == 16)
+						p->def.bit_size = 32;
+					break;
+				}
+				case nir_instr_type_alu: {
+					nir_alu_instr *a = nir_instr_as_alu(instr);
+					const nir_op_info *info = &nir_op_infos[a->op];
+					unsigned out_size = nir_alu_type_get_type_size(info->output_type);
+					unsigned in_size = info->num_inputs ? nir_alu_type_get_type_size(info->input_types[0]) : 0;
+					bool conv = info->num_inputs == 1 && out_size != 0 && (in_size == 0 || in_size != out_size) &&
+						    nir_op_is_vec(a->op) == false && (out_size == 16 || nir_src_bit_size(a->src[0].src) == 16 ||
+						    out_size == 32);
+					if (a->def.bit_size == 16)
+						a->def.bit_size = 32;
+					if (conv && (out_size == 16 || out_size == 32) && info->num_inputs == 1) {
+						nir_alu_type st = info->input_types[0], dt = info->output_type;
+						unsigned sbits = nir_src_bit_size(a->src[0].src);
+						if (sbits == 16)
+							sbits = 32;          /* (the source is widened too, or will be) */
+						if (nir_alu_type_get_base_type(dt) == nir_type_bool)
+							break;
+						if (nir_alu_type_get_base_type(st) == nir_type_bool) {
+							a->op = nir_type_conversion_op(nir_type_bool1, nir_alu_type_get_base_type(dt) | 32,
+										       nir_rounding_mode_undef);
+							break;
+						}
+						nir_alu_type s2 = nir_alu_type_get_base_type(st) | sbits;
+						nir_alu_type d2 = nir_alu_type_get_base_type(dt) | 32;
+						nir_op op = s2 == d2 || (nir_alu_type_get_base_type(st) != nir_type_float &&
+									 nir_alu_type_get_base_type(dt) != nir_type_float && sbits == 32)
+							    ? nir_op_mov : nir_type_conversion_op(s2, d2, nir_rounding_mode_undef);
+						a->op = op;
+					}
+					break;
+				}
+				case nir_instr_type_tex: {
+					nir_tex_instr *t = nir_instr_as_tex(instr);
+					/* TGSI (softpipe) names the unit by ONE index: the texture's, with the sampler bound there too by the
+					 * test (Panfrost and Metal keep the two apart; this is the host's limitation, as y2s46's txf note says) */
+					t->sampler_index = t->texture_index;
+					/* (diagnosis switch: an explicit level 0 sample as an implicit one -- the same texel on a one-level texture) */
+					if (getenv("WIDEN_TXL_AS_TEX") && t->op == nir_texop_txl) {
+						int li = nir_tex_instr_src_index(t, nir_tex_src_lod);
+						if (li >= 0 && nir_src_is_const(t->src[li].src) && nir_src_as_float(t->src[li].src) == 0.0) {
+							nir_tex_instr_remove_src(t, li);
+							t->op = nir_texop_tex;
+						}
+					}
+					if (t->def.bit_size == 16) {
+						t->def.bit_size = 32;
+						t->dest_type = nir_alu_type_get_base_type(t->dest_type) | 32;
+					}
+					break;
+				}
+				case nir_instr_type_intrinsic: {
+					nir_intrinsic_instr *x = nir_instr_as_intrinsic(instr);
+					if (x->intrinsic == nir_intrinsic_store_output) {
+						nir_alu_type st = nir_intrinsic_src_type(x);
+						if (nir_alu_type_get_type_size(st) == 16)
+							nir_intrinsic_set_src_type(x, nir_alu_type_get_base_type(st) | 32);
+						break;
+					}
+					if (x->intrinsic == nir_intrinsic_load_ubo && x->def.bit_size == 16 && nir_src_is_const(x->src[0])) {
+						b.cursor = nir_before_instr(instr);
+						nir_def *comps[4];
+						for (unsigned i = 0; i < x->def.num_components; i++)
+							comps[i] = unpack_half_at(&b, nir_src_as_uint(x->src[0]),
+										  nir_iadd_imm(&b, x->src[1].ssa, 2 * i), x);
+						nir_def *v = nir_vec(&b, comps, x->def.num_components);
+						nir_def_rewrite_uses(&x->def, v);
+						nir_instr_remove(instr);
+						break;
+					}
+					if (nir_intrinsic_infos[x->intrinsic].has_dest && x->def.bit_size == 16)
+						x->def.bit_size = 32;    /* (anything else: let validation say it) */
+					break;
+				}
+				case nir_instr_type_deref: {
+					nir_deref_instr *dr = nir_instr_as_deref(instr);
+					if (dr->deref_type == nir_deref_type_var && (dr->var->data.mode & (nir_var_shader_in | nir_var_shader_out)))
+						dr->type = dr->var->type;
+					break;
+				}
+				default:
+					break;
+				}
+			}
+		}
+		nir_metadata_preserve(impl, nir_metadata_none);
+	}
+	nir_validate_shader(nir, "after rwa_host_widen16");
+}
diff -ruN base-src/shader99b_numeric.ll src/shader99b_numeric.ll
--- base-src/shader99b_numeric.ll	1970-01-01 01:00:00.000000000 +0100
+++ src/shader99b_numeric.ll	2026-11-14 01:05:46.263218893 +0100
@@ -0,0 +1,185 @@
+; y2s99b host test kernel, written by hand for this driver (no Apple shader data): the translator pieces added in y2s99b, each result
+; stored for shader99b_numeric_host_test.c to compare against plain C.  Per thread: 8 words in (two raw words, four floats, two spare),
+; 16 words out.  The input buffer's metadata has NO air.address_space key (Metal 2.3 modules: VectorKit's AlloyCommonLibrary):
+; the address space must come from the pointer type.
+source_filename = "nord2_shader99b_numeric.metal"
+
+%struct.WithArray = type { [3 x float], half, i32 }
+%struct.Nested = type { i32, [2 x i32] }
+
+declare float @air.fast_sincos.f32(float, ptr)
+declare half @air.sincos.f16(half, ptr)
+declare float @air.modf.f32(float, ptr)
+declare float @air.frexp.f32(float, ptr)
+declare float @air.fmin3.f32(float, float, float)
+declare float @air.fmax3.f32(float, float, float)
+declare float @air.fmedian3.f32(float, float, float)
+declare i32 @air.pack.snorm4x8.v4f32(<4 x float>)
+declare <4 x float> @air.unpack.snorm4x8.v4f32(i32)
+declare i32 @air.pack.snorm2x16.v2f32(<2 x float>)
+declare void @llvm.lifetime.start.p0(ptr)
+declare void @llvm.lifetime.end.p0(ptr)
+
+; a callee returning a struct with an ARRAY member, built from undef by nested insertvalue (PridePoster's makeParticle shape)
+define internal fastcc %struct.WithArray @make(float %a, float %b, float %c, ptr %state) {
+  %t = fmul float %a, 2.0
+  %u = fadd float %b, 1.0
+  %v = fsub float %c, %a
+  %w = load i32, ptr %state, align 4
+  %w2 = add i32 %w, 7
+  store i32 %w2, ptr %state, align 4
+  %s0 = insertvalue %struct.WithArray undef, float %t, 0, 0
+  %s1 = insertvalue %struct.WithArray %s0, float %u, 0, 1
+  %s2 = insertvalue %struct.WithArray %s1, float %v, 0, 2
+  %s3 = insertvalue %struct.WithArray %s2, half 0xH3C00, 1
+  %s4 = insertvalue %struct.WithArray %s3, i32 %w2, 2
+  ret %struct.WithArray %s4
+}
+
+define void @nord2_translator_numeric(ptr addrspace(1) %in, ptr addrspace(1) %out, i32 %tid) {
+  %cosp = alloca float, align 4
+  %intp = alloca float, align 4
+  %expp = alloca i32, align 4
+  %statep = alloca i32, align 4
+  %cosh = alloca half, align 2
+  %ibase = mul i32 %tid, 8
+  %obase = mul i32 %tid, 16
+  %pw0 = getelementptr i32, ptr addrspace(1) %in, i32 %ibase
+  %w0 = load i32, ptr addrspace(1) %pw0, align 4
+  %i1 = add i32 %ibase, 1
+  %pw1 = getelementptr i32, ptr addrspace(1) %in, i32 %i1
+  %w1 = load i32, ptr addrspace(1) %pw1, align 4
+  %i2 = add i32 %ibase, 2
+  %pf0 = getelementptr float, ptr addrspace(1) %in, i32 %i2
+  %f0 = load float, ptr addrspace(1) %pf0, align 4
+  %i3 = add i32 %ibase, 3
+  %pf1 = getelementptr float, ptr addrspace(1) %in, i32 %i3
+  %f1 = load float, ptr addrspace(1) %pf1, align 4
+  %i4 = add i32 %ibase, 4
+  %pf2 = getelementptr float, ptr addrspace(1) %in, i32 %i4
+  %f2 = load float, ptr addrspace(1) %pf2, align 4
+  %i5 = add i32 %ibase, 5
+  %pf3 = getelementptr float, ptr addrspace(1) %in, i32 %i5
+  %f3 = load float, ptr addrspace(1) %pf3, align 4
+  %v0 = insertelement <4 x float> undef, float %f0, i32 0
+  %v1 = insertelement <4 x float> %v0, float %f1, i32 1
+  %v2 = insertelement <4 x float> %v1, float %f2, i32 2
+  %v4 = insertelement <4 x float> %v2, float %f3, i32 3
+  %v2a = insertelement <2 x float> undef, float %f0, i32 0
+  %v2f = insertelement <2 x float> %v2a, float %f1, i32 1
+
+  ; 0-1: sincos (fast form, float): sin returned, cos through the alloca
+  call void @llvm.lifetime.start.p0(ptr %cosp)
+  %sin = call float @air.fast_sincos.f32(float %f0, ptr %cosp)
+  %cos = load float, ptr %cosp, align 4
+  call void @llvm.lifetime.end.p0(ptr %cosp)
+  %r0 = bitcast float %sin to i32
+  %r1 = bitcast float %cos to i32
+  ; 2-3: modf
+  %fr = call float @air.modf.f32(float %f1, ptr %intp)
+  %ip = load float, ptr %intp, align 4
+  %r2 = bitcast float %fr to i32
+  %r3 = bitcast float %ip to i32
+  ; 4-5: frexp
+  %mant = call float @air.frexp.f32(float %f2, ptr %expp)
+  %r5 = load i32, ptr %expp, align 4
+  %r4 = bitcast float %mant to i32
+  ; 6-8: fmin3 / fmax3 / fmedian3
+  %mn = call float @air.fmin3.f32(float %f0, float %f1, float %f2)
+  %mx = call float @air.fmax3.f32(float %f0, float %f1, float %f2)
+  %md = call float @air.fmedian3.f32(float %f0, float %f1, float %f2)
+  %r6 = bitcast float %mn to i32
+  %r7 = bitcast float %mx to i32
+  %r8 = bitcast float %md to i32
+  ; 9: pack snorm4x8 of the four floats; 10: unpack snorm4x8 of w0, component 1 + component 3 (as float bits)
+  %r9 = call i32 @air.pack.snorm4x8.v4f32(<4 x float> %v4)
+  %un = call <4 x float> @air.unpack.snorm4x8.v4f32(i32 %w0)
+  %un1 = extractelement <4 x float> %un, i32 1
+  %un3 = extractelement <4 x float> %un, i32 3
+  %unsum = fadd float %un1, %un3
+  %r10 = bitcast float %unsum to i32
+  ; 11: pack snorm2x16
+  %r11 = call i32 @air.pack.snorm2x16.v2f32(<2 x float> %v2f)
+  ; 12-14: the struct-with-array callee (and its pointer argument: the state word goes through scratch)
+  store i32 %w1, ptr %statep, align 4
+  %st = call fastcc %struct.WithArray @make(float %f0, float %f1, float %f2, ptr %statep)
+  %e0 = extractvalue %struct.WithArray %st, 0, 0
+  %arr = extractvalue %struct.WithArray %st, 0
+  %e1 = extractvalue [3 x float] %arr, 1
+  %e2 = extractvalue [3 x float] %arr, 2
+  %r12 = bitcast float %e0 to i32
+  %e1i = bitcast float %e1 to i32
+  %ew = extractvalue %struct.WithArray %st, 2
+  %r13 = xor i32 %e1i, %ew
+  %r14 = bitcast float %e2 to i32
+  ; 15: nested insertvalue into an undef aggregate in the kernel itself, and half sincos through an alloca
+  %n0 = insertvalue %struct.Nested undef, i32 %w1, 1, 1
+  %n1 = insertvalue %struct.Nested %n0, i32 %w0, 0
+  %g = extractvalue %struct.Nested %n1, 1, 1
+  %h0 = fptrunc float %f3 to half
+  %hs = call half @air.sincos.f16(half %h0, ptr %cosh)
+  %hc = load half, ptr %cosh, align 2
+  %hsi = bitcast half %hs to i16
+  %hci = bitcast half %hc to i16
+  %hsw = zext i16 %hsi to i32
+  %hcw = zext i16 %hci to i32
+  %hcs = shl i32 %hcw, 16
+  %hh = or i32 %hsw, %hcs
+  %r15 = xor i32 %g, %hh
+
+  %o0 = getelementptr i32, ptr addrspace(1) %out, i32 %obase
+  store i32 %r0, ptr addrspace(1) %o0, align 4
+  %x1 = add i32 %obase, 1
+  %o1 = getelementptr i32, ptr addrspace(1) %out, i32 %x1
+  store i32 %r1, ptr addrspace(1) %o1, align 4
+  %x2 = add i32 %obase, 2
+  %o2 = getelementptr i32, ptr addrspace(1) %out, i32 %x2
+  store i32 %r2, ptr addrspace(1) %o2, align 4
+  %x3 = add i32 %obase, 3
+  %o3 = getelementptr i32, ptr addrspace(1) %out, i32 %x3
+  store i32 %r3, ptr addrspace(1) %o3, align 4
+  %x4 = add i32 %obase, 4
+  %o4 = getelementptr i32, ptr addrspace(1) %out, i32 %x4
+  store i32 %r4, ptr addrspace(1) %o4, align 4
+  %x5 = add i32 %obase, 5
+  %o5 = getelementptr i32, ptr addrspace(1) %out, i32 %x5
+  store i32 %r5, ptr addrspace(1) %o5, align 4
+  %x6 = add i32 %obase, 6
+  %o6 = getelementptr i32, ptr addrspace(1) %out, i32 %x6
+  store i32 %r6, ptr addrspace(1) %o6, align 4
+  %x7 = add i32 %obase, 7
+  %o7 = getelementptr i32, ptr addrspace(1) %out, i32 %x7
+  store i32 %r7, ptr addrspace(1) %o7, align 4
+  %x8 = add i32 %obase, 8
+  %o8 = getelementptr i32, ptr addrspace(1) %out, i32 %x8
+  store i32 %r8, ptr addrspace(1) %o8, align 4
+  %x9 = add i32 %obase, 9
+  %o9 = getelementptr i32, ptr addrspace(1) %out, i32 %x9
+  store i32 %r9, ptr addrspace(1) %o9, align 4
+  %x10 = add i32 %obase, 10
+  %o10 = getelementptr i32, ptr addrspace(1) %out, i32 %x10
+  store i32 %r10, ptr addrspace(1) %o10, align 4
+  %x11 = add i32 %obase, 11
+  %o11 = getelementptr i32, ptr addrspace(1) %out, i32 %x11
+  store i32 %r11, ptr addrspace(1) %o11, align 4
+  %x12 = add i32 %obase, 12
+  %o12 = getelementptr i32, ptr addrspace(1) %out, i32 %x12
+  store i32 %r12, ptr addrspace(1) %o12, align 4
+  %x13 = add i32 %obase, 13
+  %o13 = getelementptr i32, ptr addrspace(1) %out, i32 %x13
+  store i32 %r13, ptr addrspace(1) %o13, align 4
+  %x14 = add i32 %obase, 14
+  %o14 = getelementptr i32, ptr addrspace(1) %out, i32 %x14
+  store i32 %r14, ptr addrspace(1) %o14, align 4
+  %x15 = add i32 %obase, 15
+  %o15 = getelementptr i32, ptr addrspace(1) %out, i32 %x15
+  store i32 %r15, ptr addrspace(1) %o15, align 4
+  ret void
+}
+!air.kernel = !{!0}
+!0 = !{ptr @nord2_translator_numeric, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.buffer_size", i32 32, !"air.location_index", i32 0, i32 1, !"air.read", !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"in"}
+!4 = !{i32 1, !"air.buffer", !"air.buffer_size", i32 64, !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"out"}
+!5 = !{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"tid"}
diff -ruN base-src/shader99b_numeric_host_test.c src/shader99b_numeric_host_test.c
--- base-src/shader99b_numeric_host_test.c	1970-01-01 01:00:00.000000000 +0100
+++ src/shader99b_numeric_host_test.c	2026-11-14 01:07:18.427443363 +0100
@@ -0,0 +1,301 @@
+/*
+ * y2s99b: shader99b_numeric.ll (sincos/modf/frexp through a pointer, fmin3/fmax3/fmedian3, snorm packing, a callee returning a
+ * struct with an array member built from undef, nested insertvalue into undef, a buffer without air.address_space) through the
+ * translator, evaluated with NIR's constant folder, against plain C; then Panfrost's compiler.  The evaluator is y2s42's:
+ * y2s42 host test (no GPU, no phone): translator_numeric.ll through the translator (air_to_nir, the files this library is built from), the
+ * NIR it gives EVALUATED instruction by instruction with NIR's own constant folder (nir_eval_const_opcode: the definition of every opcode,
+ * which every back end implements), every stored word against plain C; then the same NIR through finalize_for_gallium and Panfrost's
+ * Valhall compiler for the Mali-G77.  What it shows: the translator's air.pack.* / air.unpack.* (float and half), its vector bitcasts and
+ * its memset/memcpy of lengths that are not multiples of four mean what Metal defines, and the GPU's compiler takes the result.  What it
+ * cannot show: the execution of Panfrost's code (only the phone has a Mali), and VideoToolbox's own kernel, whose specialised module exists
+ * only on the phone.  (softpipe is not used: it has no 16-bit types, and the kernel is about them.)
+ *   translator_numeric_host_test numeric.bc      (llvm-as translator_numeric.ll; see host-tests.sh for the reader's one host-only line)
+ */
+#include "air_metal.c"
+#include "panfrost/compiler/bifrost_compile.h"
+#include "panfrost/util/pan_ir.h"
+#include "util/u_dynarray.h"
+#include "nir_constant_expressions.h"
+#include <math.h>
+
+enum { THREADS = 8192, IN = 8, OUT = 16 };
+
+/* -- the evaluator: one block, constants, ALU, and the five intrinsics the kernel is made of -- */
+struct machine {
+	nir_const_value (*values)[NIR_MAX_VEC_COMPONENTS];
+	const uint8_t *in;
+	uint8_t *out, scratch[256];
+	unsigned tid;
+};
+
+static void
+bytes_of(const nir_const_value *v, unsigned comps, unsigned bits, uint8_t *to)
+{
+	for (unsigned i = 0; i < comps; i++) {
+		uint64_t u = nir_const_value_as_uint(v[i], bits);
+		memcpy(to + i * bits / 8, &u, bits / 8);
+	}
+}
+
+static void
+values_of(const uint8_t *from, unsigned comps, unsigned bits, nir_const_value *v)
+{
+	for (unsigned i = 0; i < comps; i++) {
+		uint64_t u = 0;
+		memcpy(&u, from + i * bits / 8, bits / 8);
+		v[i] = nir_const_value_for_raw_uint(u, bits);
+	}
+}
+
+static int
+evaluate(nir_shader *nir, struct machine *m)
+{
+	nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+	if (nir_start_block(impl) != nir_impl_last_block(impl)) {
+		fprintf(stderr, "the kernel is not one block\n");
+		return -1;
+	}
+	nir_foreach_block(block, impl) {
+		nir_foreach_instr(instr, block) {
+			if (instr->type == nir_instr_type_load_const) {
+				nir_load_const_instr *k = nir_instr_as_load_const(instr);
+				memcpy(m->values[k->def.index], k->value, sizeof(nir_const_value) * k->def.num_components);
+			} else if (instr->type == nir_instr_type_alu) {
+				nir_alu_instr *alu = nir_instr_as_alu(instr);
+				nir_const_value src[NIR_MAX_VEC_COMPONENTS][NIR_MAX_VEC_COMPONENTS], *srcs[NIR_MAX_VEC_COMPONENTS];
+				unsigned bit_size = alu->def.bit_size;
+
+				for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++) {
+					for (unsigned c = 0; c < nir_ssa_alu_instr_src_components(alu, i); c++)
+						src[i][c] = m->values[alu->src[i].src.ssa->index][alu->src[i].swizzle[c]];
+					srcs[i] = src[i];
+					if (nir_alu_type_get_type_size(nir_op_infos[alu->op].input_types[i]) == 0)
+						bit_size = alu->src[i].src.ssa->bit_size;
+				}
+				if (nir_alu_type_get_type_size(nir_op_infos[alu->op].output_type) == 0)
+					bit_size = alu->def.bit_size;
+				nir_eval_const_opcode(alu->op, m->values[alu->def.index], alu->def.num_components, bit_size, srcs,
+						      nir->info.float_controls_execution_mode);
+			} else if (instr->type == nir_instr_type_intrinsic) {
+				nir_intrinsic_instr *x = nir_instr_as_intrinsic(instr);
+#define U32(n) ((unsigned)nir_const_value_as_uint(m->values[x->src[n].ssa->index][0], 32))
+				switch (x->intrinsic) {
+				case nir_intrinsic_load_global_invocation_id:
+					m->values[x->def.index][0] = nir_const_value_for_uint(m->tid, 32);
+					m->values[x->def.index][1] = m->values[x->def.index][2] = nir_const_value_for_uint(0, 32);
+					break;
+				case nir_intrinsic_load_ssbo:
+					if (U32(0) != 0 || U32(1) + x->def.num_components * x->def.bit_size / 8 > THREADS * IN * 4)
+						return fprintf(stderr, "a load outside the input buffer\n"), -1;
+					values_of(m->in + U32(1), x->def.num_components, x->def.bit_size, m->values[x->def.index]);
+					break;
+				case nir_intrinsic_store_ssbo:
+					if (U32(1) != 1 || U32(2) + x->src[0].ssa->num_components * x->src[0].ssa->bit_size / 8 > THREADS * OUT * 4)
+						return fprintf(stderr, "a store outside the output buffer\n"), -1;
+					bytes_of(m->values[x->src[0].ssa->index], x->src[0].ssa->num_components, x->src[0].ssa->bit_size, m->out + U32(2));
+					break;
+				case nir_intrinsic_load_scratch:
+					if (U32(0) + x->def.num_components * x->def.bit_size / 8 > sizeof(m->scratch))
+						return fprintf(stderr, "a load outside the scratch\n"), -1;
+					values_of(m->scratch + U32(0), x->def.num_components, x->def.bit_size, m->values[x->def.index]);
+					break;
+				case nir_intrinsic_store_scratch:
+					if (U32(1) + x->src[0].ssa->num_components * x->src[0].ssa->bit_size / 8 > sizeof(m->scratch))
+						return fprintf(stderr, "a store outside the scratch\n"), -1;
+					bytes_of(m->values[x->src[0].ssa->index], x->src[0].ssa->num_components, x->src[0].ssa->bit_size, m->scratch + U32(1));
+					break;
+				case nir_intrinsic_nop:
+					break;
+				default:
+					return fprintf(stderr, "an intrinsic this evaluator does not know: %s\n", nir_intrinsic_infos[x->intrinsic].name), -1;
+				}
+#undef U32
+			} else if (instr->type == nir_instr_type_undef) {
+				nir_undef_instr *u = nir_instr_as_undef(instr);       /* (an insertelement's first operand: any value will do) */
+				memset(m->values[u->def.index], 0xa5, sizeof(nir_const_value) * u->def.num_components);
+			} else {
+				return fprintf(stderr, "an instruction this evaluator does not know (type %d)\n", instr->type), -1;
+			}
+		}
+	}
+	return 0;
+}
+
+
+static int
+near(float got, float want, float tol)
+{
+	if (isnan(want))
+		return isnan(got);
+	return fabsf(got - want) <= tol * (1.0f + fabsf(want));
+}
+
+static float
+f_of(uint32_t u)
+{
+	float f;
+	memcpy(&f, &u, 4);
+	return f;
+}
+
+static uint32_t
+u_of(float f)
+{
+	uint32_t u;
+	memcpy(&u, &f, 4);
+	return u;
+}
+
+static uint32_t
+snorm(float x, unsigned bits)
+{
+	float most = (float)((1u << (bits - 1)) - 1), c = x < -1.0f ? -1.0f : x > 1.0f ? 1.0f : x;
+	return (uint32_t)(int32_t)nearbyintf(c * most) & ((1u << bits) - 1);
+}
+
+int
+main(int argc, char **argv)
+{
+	static const char *const what[OUT] = {
+		"sincos: sin", "sincos: cos (pointer)", "modf: fraction", "modf: integer (pointer)", "frexp: mantissa",
+		"frexp: exponent (pointer)", "fmin3", "fmax3", "fmedian3", "pack snorm4x8", "unpack snorm4x8 y+w", "pack snorm2x16",
+		"struct callee: array[0]", "struct callee: array[1] ^ i32 field", "struct callee: array[2]", "nested undef insert + half sincos" };
+	static const float special[] = { 0.0f, 1.0f, -0.0f, 0.5f, 1e30f, -1e30f, 1e-30f, 0.999999f, 1.000001f, -0.25f, 0.25f, 2.0f,
+					 -1.0f, -1.5f, 3.75f, -7.25f, INFINITY, -INFINITY, 100.5f, -0.75f };
+	unsigned bad[OUT] = { 0 };
+
+	if (argc != 2) {
+		fprintf(stderr, "usage: %s numeric.bc\n", argv[0]);
+		return 2;
+	}
+	FILE *f = fopen(argv[1], "rb");
+	static unsigned char bitcode[1 << 20];
+	size_t size = f ? fread(bitcode, 1, sizeof(bitcode), f) : 0;
+	if (size <= 4) {
+		fprintf(stderr, "FAILED: %s is not a module\n", argv[1]);
+		return 1;
+	}
+	fclose(f);
+
+	glsl_type_singleton_init_or_ref();      /* (as rwa_device_open does in the library before any translation) */
+	void *mem_ctx = ralloc_context(NULL);
+	struct air_shader_info info = { 0 };
+	const struct air_to_nir_options options = { 0 };
+	const char *error = NULL;
+	nir_shader *nir = air_to_nir(mem_ctx, bitcode, size, "nord2_translator_numeric", &options, &bifrost_nir_options_v9, &info, &error);
+	if (!nir) {
+		fprintf(stderr, "FAILED: not translated: %s\n", error ? error : "?");
+		return 1;
+	}
+	nir_validate_shader(nir, "after the translator");
+	nir_index_ssa_defs(nir_shader_get_entrypoint(nir));
+	if (info.num_resources < 2 || info.resources[0].kind != AIR_RESOURCE_DEVICE_BUFFER) {
+		fprintf(stderr, "FAILED: the buffer without air.address_space is not a device buffer\n");
+		return 1;
+	}
+	static uint32_t iw[THREADS * IN], ow[THREADS * OUT];
+	struct machine m = { .values = calloc(nir_shader_get_entrypoint(nir)->ssa_alloc, sizeof(*m.values)), .in = (const uint8_t *)iw,
+			     .out = (uint8_t *)ow };
+
+	srand(99);
+	for (unsigned t = 0; t < THREADS; t++) {
+		uint32_t *w = iw + t * IN;
+		float v[4];
+
+		w[0] = t < 4 ? (uint32_t[]){ 0, 0xffffffffu, 0x80808080u, 0x7f817f01u }[t] : ((uint32_t)rand() << 16) ^ (uint32_t)rand();
+		w[1] = ((uint32_t)rand() << 16) ^ (uint32_t)rand();
+		for (unsigned i = 0; i < 4; i++) {
+			unsigned kind = (t + i) % 4;
+
+			if (kind == 0)
+				v[i] = special[(t / 4 + i) % (sizeof(special) / sizeof(special[0]))];
+			else if (kind == 1)
+				v[i] = (float)rand() / (float)RAND_MAX * 4.0f - 2.0f;
+			else if (kind == 2)
+				v[i] = (float)(rand() % 2001 - 1000) / 8.0f;
+			else
+				v[i] = (float)rand() / (float)RAND_MAX * 20.0f - 10.0f;
+		}
+		if (t % 7 == 3)
+			v[3] = 1.0f;      /* keep some half inputs ordinary */
+		memcpy(w + 2, v, sizeof(v));
+		w[6] = w[7] = 0;
+	}
+	memset(ow, 0xee, sizeof(ow));
+	for (m.tid = 0; m.tid < THREADS; m.tid++) {
+		memset(m.scratch, 0xcc, sizeof(m.scratch));
+		if (evaluate(nir, &m) != 0)
+			return 1;
+	}
+	for (unsigned t = 0; t < THREADS; t++) {
+		const uint32_t *w = iw + t * IN, *o = ow + t * OUT, w0 = w[0], w1 = w[1];
+		float v[4];
+		int ok[OUT];
+
+		memcpy(v, w + 2, sizeof(v));
+		/* sin/cos: the evaluator's fsin is libm's; only finite inputs of a sane size are compared (the phone's would differ anyway) */
+		int sane = isfinite(v[0]) && fabsf(v[0]) < 1e6f;
+		ok[0] = !sane || near(f_of(o[0]), sinf(v[0]), 1e-6f);
+		ok[1] = !sane || near(f_of(o[1]), cosf(v[0]), 1e-6f);
+		float ip = truncf(v[1]), fr = isinf(v[1]) ? copysignf(0.0f, v[1]) : v[1] - ip;
+		ok[2] = u_of(f_of(o[2])) == u_of(fr) || (fr == 0.0f && f_of(o[2]) == 0.0f);
+		ok[3] = f_of(o[3]) == ip || (isnan(ip) && isnan(f_of(o[3])));
+		int e = 0;
+		float mant = frexpf(v[2], &e);
+		ok[4] = !isfinite(v[2]) || v[2] == 0.0f || f_of(o[4]) == mant;
+		ok[5] = !isfinite(v[2]) || v[2] == 0.0f || (int)o[5] == e;
+		ok[6] = f_of(o[6]) == fminf(fminf(v[0], v[1]), v[2]);
+		ok[7] = f_of(o[7]) == fmaxf(fmaxf(v[0], v[1]), v[2]);
+		float lo = fminf(v[0], v[1]), hi = fmaxf(v[0], v[1]);
+		ok[8] = f_of(o[8]) == fmaxf(lo, fminf(hi, v[2]));
+		uint32_t p4 = 0;
+		for (unsigned i = 0; i < 4; i++)
+			p4 |= snorm(v[i], 8) << (8 * i);
+		ok[9] = o[9] == p4;
+		float y = fmaxf((float)(int8_t)(w0 >> 8) / 127.0f, -1.0f), ww = fmaxf((float)(int8_t)(w0 >> 24) / 127.0f, -1.0f);
+		ok[10] = near(f_of(o[10]), y + ww, 1e-6f);
+		ok[11] = o[11] == (snorm(v[0], 16) | snorm(v[1], 16) << 16);
+		ok[12] = u_of(f_of(o[12])) == u_of(v[0] * 2.0f) || (isnan(v[0] * 2.0f) && isnan(f_of(o[12])));
+		float e1 = v[1] + 1.0f, e2 = v[2] - v[0];
+		ok[13] = (o[13] ^ (w1 + 7u)) == u_of(e1) || (isnan(e1) && isnan(f_of(o[13] ^ (w1 + 7u))));
+		ok[14] = o[14] == u_of(e2) || (isnan(e2) && isnan(f_of(o[14])));
+		uint32_t hh = o[15] ^ w1;
+		_Float16 hs, hc, h0 = (_Float16)v[3];
+		uint16_t a = (uint16_t)hh, b = (uint16_t)(hh >> 16);
+		memcpy(&hs, &a, 2);
+		memcpy(&hc, &b, 2);
+		int hsane = isfinite((float)h0) && fabsf((float)h0) < 100.0f;
+		ok[15] = !hsane || (near((float)hs, sinf((float)h0), 2e-3f) && near((float)hc, cosf((float)h0), 2e-3f));
+		for (unsigned k = 0; k < OUT; k++)
+			if (!ok[k] && bad[k]++ < 3)
+				printf("  %s, thread %u: got %08x (words %08x %08x, floats %g %g %g %g)\n", what[k], t, o[k], w0, w1, v[0], v[1],
+				       v[2], v[3]);
+	}
+	unsigned total = 0;
+	for (unsigned k = 0; k < OUT; k++) {
+		printf("%-40s %u of %u differ\n", what[k], bad[k], THREADS);
+		total += bad[k];
+	}
+	nir_shader *clone = nir_shader_clone(NULL, nir);
+	setenv("RWA_SOFTWARE", "1", 1);
+	char why[512] = "";
+	struct rwa_device *device = rwa_device_open(why, sizeof(why));
+	if (!device) {
+		fprintf(stderr, "FAILED: no device for finalize_for_gallium: %s\n", why);
+		return 1;
+	}
+	finalize_for_gallium(clone, device->screen);
+	nir_shader_gather_info(clone, nir_shader_get_entrypoint(clone));
+	bifrost_preprocess_nir(clone, 0x9091);
+	struct panfrost_compile_inputs inputs = { .gpu_id = 0x9091 };
+	struct util_dynarray binary;
+	struct pan_shader_info pinfo = { 0 };
+	util_dynarray_init(&binary, NULL);
+	bifrost_compile_shader_nir(clone, &inputs, &binary, &pinfo);
+	printf("shader99b_numeric_host_test: %u threads evaluated, %u results differ; Valhall code %u bytes, thread storage %u bytes\n",
+	       THREADS, total, (unsigned)binary.size, pinfo.tls_size);
+	if (total == 0 && binary.size != 0)
+		printf("shader99b_numeric: ok\n");
+	return total != 0 || binary.size == 0;
+}
diff -ruN base-src/tgmem_kernel.ll src/tgmem_kernel.ll
--- base-src/tgmem_kernel.ll	1970-01-01 01:00:00.000000000 +0100
+++ src/tgmem_kernel.ll	2026-11-14 01:42:59.418180438 +0100
@@ -0,0 +1,41 @@
+; y2s99b host test kernel (hand-written, no Apple data): a kernel with BOTH a static threadgroup array and a dispatch-sized
+; threadgroup buffer [[threadgroup(0)]] (MPS's MinFilter/MaxFilter shape has the second alone). Each thread writes both, waits at
+; the barrier and reads its neighbours' words: if the dynamic buffer overlapped the static array (it sat at offset 0 before
+; y2s99b) the sums are wrong.  64 threads a group.
+source_filename = "nord2_tgmem.metal"
+
+@st = internal addrspace(3) global [64 x i32] undef, align 4
+
+declare void @air.wg.barrier(i32, i32)
+
+define void @nord2_tgmem(ptr addrspace(1) %out, ptr addrspace(3) %dyn, i32 %tid, i32 %lid) {
+  %a = mul i32 %lid, 3
+  %ps = getelementptr [64 x i32], ptr addrspace(3) @st, i32 0, i32 %lid
+  store i32 %a, ptr addrspace(3) %ps, align 4
+  %b0 = mul i32 %lid, 7
+  %b = add i32 %b0, 1
+  %pd = getelementptr i32, ptr addrspace(3) %dyn, i32 %lid
+  store i32 %b, ptr addrspace(3) %pd, align 4
+  call void @air.wg.barrier(i32 2, i32 1)
+  %n1 = add i32 %lid, 1
+  %i1 = and i32 %n1, 63
+  %n3 = add i32 %lid, 3
+  %i3 = and i32 %n3, 63
+  %qs = getelementptr [64 x i32], ptr addrspace(3) @st, i32 0, i32 %i1
+  %vs = load i32, ptr addrspace(3) %qs, align 4
+  %qd = getelementptr i32, ptr addrspace(3) %dyn, i32 %i3
+  %vd = load i32, ptr addrspace(3) %qd, align 4
+  %m = mul i32 %vd, 1000
+  %r = add i32 %vs, %m
+  %po = getelementptr i32, ptr addrspace(1) %out, i32 %tid
+  store i32 %r, ptr addrspace(1) %po, align 4
+  ret void
+}
+!air.kernel = !{!0}
+!0 = !{ptr @nord2_tgmem, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5, !6}
+!3 = !{i32 0, !"air.buffer", !"air.buffer_size", i32 1024, !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"out"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 3, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"dyn"}
+!5 = !{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"tid"}
+!6 = !{i32 3, !"air.thread_position_in_threadgroup", !"air.arg_type_name", !"uint", !"air.arg_name", !"lid"}
