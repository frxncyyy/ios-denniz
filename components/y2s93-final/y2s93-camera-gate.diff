 /*
+ * y2s93 (final3): THE CAMERA PROCESSES KEEP THE THUMBFIX5 BEHAVIOUR. mediaserverd, cameracaptured and Camera (the camera bring-up,
+ * which had black-screen incidents) get no y2s84 texture holds (with kernel 0398 their CVPixelBufferPools would see every buffer with
+ * a live texture as in use), no y2s91 exact odd-size pass and no y2s86 slow-commit anatomy -- as y2s91's rttouch already excluded them.
+ * /var/db/nord2-metal/final-camera gives them those three back (to test them there on purpose). Read once per process.
+ */
+static int
+rw_final_camera_excluded(void)
+{
+	static int ex = -1;
+
+	if (ex < 0) {
+		const char *n = getprogname();
+		int cam = n != NULL && (strcmp(n, "mediaserverd") == 0 || strcmp(n, "cameracaptured") == 0 || strcmp(n, "Camera") == 0);
+
+		ex = cam && access("/var/db/nord2-metal/final-camera", F_OK) != 0;
+	}
+	return ex;
+}
+
