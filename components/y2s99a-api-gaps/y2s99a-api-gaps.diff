+/* y2s99a (plib): see rw_api99a_pure.h and rw_plc_init_hook */
+- (id)newPipelineLibraryWithFilePath:(NSString *)path error:(NSError **)error
+{
+	const char *p = [path isKindOfClass:[NSString class]] ? [path UTF8String] : NULL;
+	static int all = -1;
+	NSError *e = nil;
+	id library;
+
+	if (all < 0) {
+		all = access("/var/db/nord2-metal/plib-all", F_OK) == 0;
+	}
+	if (!rw_api99a_on(RW_A_PLIB) || rw_plc_init == NULL || rw_plib_excluded(p, all)) {
+		return [super newPipelineLibraryWithFilePath:path error:error];
+	}
+	rw_plib_opening++;
+	library = [super newPipelineLibraryWithFilePath:path error:&e];
+	rw_plib_opening--;
+	if (library != nil) {
+		objc_setAssociatedObject(library, &rw_plib_key, @YES, OBJC_ASSOCIATION_RETAIN);
+	}
+	{
+		char what[300];
+
+		snprintf(what, sizeof(what), "library %s %s", p, library != nil ? "opened" : "REFUSED");
+		rw_api99a_count(RW_A_PLIB, library != nil, what);
+		RW_AGAIN(library != nil ? 'I' : 'W', "RES", "plib: pipeline library %s %s%s%s\n", p,
+		    library != nil ? "opened (its pipelines are compiled from their descriptors)" : "refused by Metal",
+		    e != nil ? ": " : "", e != nil ? [[e description] UTF8String] : "");
+	}
+	if (error != NULL) {
+		*error = e;
+	}
+	return library;
+}
