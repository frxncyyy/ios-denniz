+/*
+ * y2s99a (events): the event is signalled when this command buffer has completed (Metal signals it when the GPU gets there,
+ * which is no later), and a wait is kept until -commit, which waits for the value (bounded: 1 s) before running anything.
+ * Metal's own -newEvent and -newSharedEvent make an _MTLSharedEvent (0x181aaf640), whose -setSignaledValue: is all a
+ * signal is.  Before: both were no-ops, and a listener or a CPU waiter never saw the value.
+ */
+- (void)encodeSignalEvent:(id)event value:(uint64_t)value
+{
+	if (!rw_api99a_on(RW_A_EVENTS) || event == nil || ![event respondsToSelector:@selector(setSignaledValue:)]) {
+		if (event != nil && rw_api99a_on(RW_A_EVENTS)) {
+			rw_api99a_count(RW_A_EVENTS, 0, class_getName(object_getClass(event)));
+		}
+		return;
+	}
+	id kept = [event retain];
+
+	[self addCompletedHandler:^(id buffer) {
+		(void)buffer;
+		[kept setSignaledValue:value];
+		[kept release];
+	}];
+	rw_api99a_count(RW_A_EVENTS, 1, "signal");
+}
+- (void)encodeWaitForEvent:(id)event value:(uint64_t)value
+{
+	NSMutableArray *waits;
+
+	if (!rw_api99a_on(RW_A_EVENTS) || event == nil || ![event respondsToSelector:@selector(signaledValue)]) {
+		return;
+	}
+	waits = objc_getAssociatedObject(self, &rw_event_waits_key);
+	if (waits == nil) {
+		waits = [NSMutableArray array];
+		objc_setAssociatedObject(self, &rw_event_waits_key, waits, OBJC_ASSOCIATION_RETAIN);
+	}
+	[waits addObject:@[ event, @(value) ]];
+}
