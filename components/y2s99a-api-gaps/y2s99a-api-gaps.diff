+/* ---- famlog ---- */
+static struct rw_famseen rw_fam_seen;
+static pthread_mutex_t rw_fam_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+rw_fam_note(unsigned kind, uint64_t family, BOOL answer, void *caller)
+{
+	uint64_t key;
+	int first;
+
+	if (!rw_api99a_on(RW_A_FAMLOG)) {
+		return;
+	}
+	key = rw_fam_key(kind, family, answer, NULL) ^ ((uint64_t)(uintptr_t)caller * 0x100000001b3ull);
+	pthread_mutex_lock(&rw_fam_lock);
+	first = rw_fam_first(&rw_fam_seen, key == 0 ? 1 : key);
+	pthread_mutex_unlock(&rw_fam_lock);
+	if (first) {
+		Dl_info who;
+		const char *image = "?", *symbol = "?";
+		unsigned long offset = 0;
+
+		if (dladdr(caller, &who) != 0) {
+			image = who.dli_fname != NULL ? (strrchr(who.dli_fname, '/') != NULL ? strrchr(who.dli_fname, '/') + 1 :
+			    who.dli_fname) : "?";
+			symbol = who.dli_sname != NULL ? who.dli_sname : "?";
+			offset = (unsigned long)((char *)caller - (char *)who.dli_fbase);
+		}
+		m2m_log('I', "DEV", "family: <%s> %s(%llu%s%s) asked by %s+%#lx (%s) -> %s\n", getprogname(),
+		    kind == 0 ? "supportsFamily" : "supportsFeatureSet", (unsigned long long)family,
+		    kind == 0 && rw_family_name(family) != NULL ? " " : "", kind == 0 && rw_family_name(family) != NULL ?
+		    rw_family_name(family) : "", image, offset, symbol, answer ? "YES" : "NO");
+		rw_api99a_count(RW_A_FAMLOG, answer, image);
+	}
+}
