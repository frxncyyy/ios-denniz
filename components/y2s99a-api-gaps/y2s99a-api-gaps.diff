+/*
+ * ==== y2s99a (API gaps) =====================================================================================================
+ * The decisions are in rw_api99a_pure.h (with the evidence); here is the Objective-C around them.  Every feature has a switch
+ * file /var/db/nord2-metal/no-<feature> and all of them /var/db/nord2-metal/no-api99a, read once per process.
+ * Lines: 'NORD2 GPU APIGAP: pid= name= config plib=ON subrect=ON ... y2s99a' once per process that uses one;
+ *        'NORD2 GPU APIGAP: pid= name= <feature> ok=N refused=R (last: ...)' at the 1st, 2nd, 4th, 8th ... event;
+ *        'I RES plib: ...' / 'W RES plib: ...', 'I DEV family: ...', 'W CMD event: ...' for the first ones.
+ * Functions and methods of y2s99a: rw_api99a_* (here), rw_plc_init_hook, rw_plib_*_hook, RedwoodMetalFence,
+ * -[RedwoodMetalDevice newPipelineLibraryWithFilePath:error: newFence supportsFamily: supportsFeatureSet:],
+ * -[RedwoodMetalCommandBuffer encodeSignalEvent:value: encodeWaitForEvent:value: redwoodWaitEvents (from -commit)],
+ * -[RedwoodMetalTexture numFaces], the 'left empty' texture warning in -runDraw:, and rwd_texture_from_surface's sub-rectangle
+ * (redwooddrawable.m).
+ */
+#include "rw_api99a_pure.h"
+
+enum { RW_A_PLIB, RW_A_SUBRECT, RW_A_FENCE, RW_A_EVENTS, RW_A_FACES, RW_A_FAMLOG, RW_A_EMPTYSLOT, RW_A_N };
+static const char *const rw_a_names[RW_A_N] = { "plib", "subrect", "fence", "events", "faces", "famlog", "emptyslot" };
+static int rw_a_off[RW_A_N];
+static unsigned long rw_a_ok[RW_A_N], rw_a_bad[RW_A_N];
+static pthread_mutex_t rw_a_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+rw_api99a_config(void)
+{
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		int all = access("/var/db/nord2-metal/no-api99a", F_OK) == 0;
+		char line[256] = "";
+		size_t used = 0;
+
+		for (int i = 0; i < RW_A_N; i++) {
+			char path[96];
+
+			snprintf(path, sizeof(path), "/var/db/nord2-metal/no-%s", rw_a_names[i]);
+			rw_a_off[i] = all || access(path, F_OK) == 0;
+			used += (size_t)snprintf(line + used, sizeof(line) - used, " %s=%s", rw_a_names[i], rw_a_off[i] ? "OFF" : "ON");
+			if (used >= sizeof(line)) {
+				used = sizeof(line) - 1;
+			}
+		}
+		m2m_log('I', "DEV", "NORD2 GPU APIGAP: pid=%d name=%s config%s%s y2s99a\n", getpid(), getprogname(), line,
+		    all ? " (no-api99a)" : "");
+	});
+}
+
+/* (also called from redwooddrawable.m) */
+int
+rw_api99a_on(int feature)
+{
+	rw_api99a_config();
+	return feature >= 0 && feature < RW_A_N && !rw_a_off[feature];
+}
+
+void
+rw_api99a_count(int feature, int ok, const char *what)
+{
+	unsigned long n, a, b;
+
+	if (feature < 0 || feature >= RW_A_N) {
+		return;
+	}
+	pthread_mutex_lock(&rw_a_lock);
+	if (ok) {
+		rw_a_ok[feature]++;
+	} else {
+		rw_a_bad[feature]++;
+	}
+	a = rw_a_ok[feature];
+	b = rw_a_bad[feature];
+	n = a + b;
+	pthread_mutex_unlock(&rw_a_lock);
+	if (rw_pow2_report(n)) {
+		m2m_log('I', "DEV", "NORD2 GPU APIGAP: pid=%d name=%s %s ok=%lu refused=%lu (last: %s)\n", getpid(), getprogname(),
+		    rw_a_names[feature], a, b, what != NULL ? what : "-");
+	}
+}
+
+/* ---- plib ---- */
+static __thread int rw_plib_opening;
+static char rw_plib_key;
+static id (*rw_plc_init)(id, SEL, id, BOOL, const void *);
+static id (*rw_plib_render_named)(id, SEL, id, NSUInteger, id *, NSError **);
+static id (*rw_plib_compute_named)(id, SEL, id, NSUInteger, id *, NSError **);
+static id (*rw_plib_function_cache)(id, SEL);
+static id (*rw_plib_pipeline_cache)(id, SEL);
+
+static BOOL
+rw_plib_ours(id library)
+{
+	return library != nil && objc_getAssociatedObject(library, &rw_plib_key) != nil;
+}
+
+/*
+ * -[_MTLPipelineCache initWithFilePath:readOnly:deviceInfo:] while this driver opens a pipeline library: a read-only cache
+ * file of the library that Metal cannot open (no pipelines.<this GPU>, or a function cache of another GPU's version) is
+ * answered with the EMPTY cache Metal itself makes for a nil path.  Metal's init releases the object when it fails, so it
+ * is retained first; the C++ cache it left at +0x10 (the slot -dealloc reads, 0x181a47fbc) is deleted the way -dealloc
+ * deletes it (vtable +0x8) before the object is initialised again.
+ */
+struct rw_plc_call {
+	SEL sel;
+	id path;
+	BOOL read_only;
+	const void *info;
+};
+
+static void *
+rw_plc_op_init(void *ctx, void *self, int use_path)
+{
+	struct rw_plc_call *c = ctx;
+
+	return (void *)rw_plc_init((id)self, c->sel, use_path ? c->path : nil, c->read_only, c->info);
+}
+
+static void rw_plc_op_retain(void *ctx, void *self)  { (void)ctx; [(id)self retain]; }
+static void rw_plc_op_release(void *ctx, void *self) { (void)ctx; [(id)self release]; }
+
+static void *
+rw_plc_op_take_cache(void *ctx, void *self)
+{
+	void **slot = (void **)((char *)self + 0x10);   /* the slot -[_MTLPipelineCache dealloc] reads (0x181a47fbc) */
+	void *cache = *slot;
+
+	(void)ctx;
+	*slot = NULL;
+	return cache;
+}
+
+static void
+rw_plc_op_delete_cache(void *ctx, void *cache)
+{
+	void (**vtable)(void *) = *(void (***)(void *))cache;
+
+	(void)ctx;
+	vtable[1](cache);                               /* as -dealloc: ldr x8, [x8, #0x8]; blr x8 */
+}
+
+static const struct rw_plc_ops rw_plc_objc_ops = {
+	rw_plc_op_init, rw_plc_op_retain, rw_plc_op_release, rw_plc_op_take_cache, rw_plc_op_delete_cache
+};
+
+static id
+rw_plc_init_hook(id self, SEL sel, id path, BOOL read_only, const void *info)
+{
+	const char *p;
+	id r;
+
+	if (rw_plib_opening <= 0 || path == nil || !read_only || ![path isKindOfClass:[NSString class]] ||
+	    !rw_plib_cache_path((p = [path UTF8String])) || class_getInstanceSize(object_getClass(self)) < 0x19) {
+		return rw_plc_init(self, sel, path, read_only, info);
+	}
+	{
+		struct rw_plc_call call = { sel, path, read_only, info };
+		int emptied = 0;
+
+		r = (id)rw_plc_dance(&rw_plc_objc_ops, &call, (void *)self, &emptied);
+		if (!emptied) {
+			return r;
+		}
+	}
+	{
+		static unsigned said;
+
+		if (__sync_fetch_and_add(&said, 1) < 24) {
+			m2m_log('I', "RES", "plib: %s cannot be opened for this GPU; an EMPTY cache stands for it (every pipeline of the "
+			    "library is compiled from its descriptor)%s\n", p, r == nil ? " -- and even that failed" : "");
+		}
+	}
+	return r;
+}
+
+/* the function and pipeline caches of a library opened with an empty cache are no caches at all, and say so */
+static id
+rw_plib_function_cache_hook(id self, SEL sel)
+{
+	return rw_plib_ours(self) ? nil : rw_plib_function_cache(self, sel);
+}
+
+static id
+rw_plib_pipeline_cache_hook(id self, SEL sel)
+{
+	return rw_plib_ours(self) ? nil : rw_plib_pipeline_cache(self, sel);
+}
+
+static void
+rw_plib_note(const char *kind, id library, id name, id made, NSError *e)
+{
+	static unsigned said;
+	char what[200];
+
+	if (!rw_plib_ours(library)) {
+		return;
+	}
+	snprintf(what, sizeof(what), "%s pipeline %s %s", kind, [name isKindOfClass:[NSString class]] ? [name UTF8String] : "?",
+	    made != nil ? "made" : "REFUSED");
+	rw_api99a_count(RW_A_PLIB, made != nil, what);
+	if (made == nil || __sync_fetch_and_add(&said, 1) < 32) {
+		RW_AGAIN(made != nil ? 'I' : 'W', "RES", "plib: %s%s%s\n", what, e != nil ? ": " : "",
+		    e != nil ? [[e description] UTF8String] : "");
+	}
+}
+
+static id
+rw_plib_render_named_hook(id self, SEL sel, id name, NSUInteger options, id *reflection, NSError **error)
+{
+	NSError *e = nil;
+	id made = rw_plib_render_named(self, sel, name, options, reflection, &e);
+
+	rw_plib_note("render", self, name, made, made == nil ? e : nil);
+	if (error != NULL) {
+		*error = e;
+	}
+	return made;
+}
+
+static id
+rw_plib_compute_named_hook(id self, SEL sel, id name, NSUInteger options, id *reflection, NSError **error)
+{
+	NSError *e = nil;
+	id made = rw_plib_compute_named(self, sel, name, options, reflection, &e);
+
+	rw_plib_note("compute", self, name, made, made == nil ? e : nil);
+	if (error != NULL) {
+		*error = e;
+	}
+	return made;
+}
+
+__attribute__((constructor)) static void
+rw_plib_install(void)
+{
+	Class cache = objc_getClass("_MTLPipelineCache");
+	Class library = objc_getClass("_MTLPipelineLibrary");
+
+	if (access("/var/db/nord2-metal/no-plib", F_OK) == 0 || access("/var/db/nord2-metal/no-api99a", F_OK) == 0) {
+		return;    /* nothing of Metal's is touched */
+	}
+	rw_plc_init = (void *)rw_swizzle(cache, sel_getUid("initWithFilePath:readOnly:deviceInfo:"), (IMP)rw_plc_init_hook);
+	rw_plib_render_named = (void *)rw_swizzle(library, sel_getUid("newRenderPipelineStateWithName:options:reflection:error:"),
+	    (IMP)rw_plib_render_named_hook);
+	rw_plib_compute_named = (void *)rw_swizzle(library, sel_getUid("newComputePipelineStateWithName:options:reflection:error:"),
+	    (IMP)rw_plib_compute_named_hook);
+	rw_plib_function_cache = (void *)rw_swizzle(library, sel_getUid("functionCache"), (IMP)rw_plib_function_cache_hook);
+	rw_plib_pipeline_cache = (void *)rw_swizzle(library, sel_getUid("pipelineCache"), (IMP)rw_plib_pipeline_cache_hook);
+}
