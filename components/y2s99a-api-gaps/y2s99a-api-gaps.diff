-- (id)newFence                                      { return nil; }
+/* y2s99a (fence): an object, not nil -- the encoders' -updateFence:/-waitForFence: are already no-ops, which is exact on a
+ * driver that runs one command buffer at a time, in order (VectorKit and Metal itself ask for fences) */
+- (id)newFence
+{
+	if (!rw_api99a_on(RW_A_FENCE)) {
+		return nil;
