diff -ruN base-src/rw_api99a_host_test.c src/rw_api99a_host_test.c
--- base-src/rw_api99a_host_test.c	1970-01-01 01:00:00.000000000 +0100
+++ src/rw_api99a_host_test.c	2026-11-14 01:20:32.193105106 +0100
@@ -0,0 +1,298 @@
+/* y2s99a: rw_api99a_pure.h on the build machine (ASan/UBSan, -Werror).  argv[1..]: optional list files of real paths
+ * ("plib-paths": one path a line, as found in the rootfs mirror) checked against the classification. */
+#include "rw_api99a_pure.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static unsigned failures;
+#define CHECK(c) do { if (!(c)) { failures++; fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static uint64_t rnd_state = 0x9e3779b97f4a7c15ull;
+static uint64_t
+rnd(void)
+{
+	rnd_state ^= rnd_state << 13;
+	rnd_state ^= rnd_state >> 7;
+	rnd_state ^= rnd_state << 17;
+	return rnd_state;
+}
+
+/* ---- the plc dance against a model of Metal's init ---- */
+struct model {
+	int refs;          /* references to the object */
+	int deallocs;
+	void *slot;        /* the C++ cache slot */
+	int caches_live;   /* C++ caches made and not deleted */
+	int fail_path;     /* the real path fails */
+	int fail_nil;      /* even nil fails (never in Metal) */
+	int inits;
+};
+
+static void *
+m_init(void *ctx, void *self, int use_path)
+{
+	struct model *m = ctx;
+
+	m->inits++;
+	m->slot = NULL;                           /* str xzr, [x0, #0x10] */
+	if (!use_path) {
+		if (m->fail_nil) {
+			if (--m->refs == 0) m->deallocs++;
+			return NULL;
+		}
+		return self;                          /* cbz x20: an empty cache */
+	}
+	m->slot = malloc(16);                     /* createPipelineDataCache */
+	m->caches_live++;
+	if (m->fail_path) {                       /* the validity call says no: objc_release(self) */
+		if (--m->refs == 0) {
+			m->deallocs++;
+			if (m->slot != NULL) { free(m->slot); m->slot = NULL; m->caches_live--; }
+		}
+		return NULL;
+	}
+	return self;
+}
+static void m_retain(void *ctx, void *self) { (void)self; ((struct model *)ctx)->refs++; }
+static void
+m_release(void *ctx, void *self)
+{
+	struct model *m = ctx;
+
+	(void)self;
+	if (--m->refs == 0) {
+		m->deallocs++;
+		if (m->slot != NULL) { free(m->slot); m->slot = NULL; m->caches_live--; }
+	}
+}
+static void *m_take(void *ctx, void *self) { struct model *m = ctx; void *c = m->slot; (void)self; m->slot = NULL; return c; }
+static void m_delete(void *ctx, void *cache) { struct model *m = ctx; free(cache); m->caches_live--; }
+
+static void
+test_dance(void)
+{
+	static const struct rw_plc_ops ops = { m_init, m_retain, m_release, m_take, m_delete };
+	int self_storage, emptied;
+
+	for (int fp = 0; fp < 2; fp++) {
+		struct model m = { .refs = 1, .fail_path = fp };   /* +1 from alloc, owned by the init call */
+		void *r = rw_plc_dance(&ops, &m, &self_storage, &emptied);
+
+		CHECK(r == &self_storage);
+		CHECK(emptied == fp);
+		CHECK(m.refs == 1);                    /* exactly the caller's reference is left */
+		CHECK(m.deallocs == 0);
+		CHECK(m.caches_live == (fp ? 0 : 1)); /* the failed cache was deleted; a good one is kept */
+		CHECK(fp ? m.slot == NULL : m.slot != NULL);
+		/* the caller later releases: dealloc frees what is in the slot */
+		m_release(&m, &self_storage);
+		CHECK(m.deallocs == 1 && m.caches_live == 0);
+	}
+	{
+		struct model m = { .refs = 1, .fail_path = 1, .fail_nil = 1 };
+		void *r = rw_plc_dance(&ops, &m, &self_storage, &emptied);
+
+		CHECK(r == NULL && emptied == 1 && m.refs == 0 && m.deallocs == 1 && m.caches_live == 0);
+	}
+}
+
+/* ---- paths ---- */
+static void
+test_paths(void)
+{
+	CHECK(rw_plib_excluded(NULL, 0));
+	CHECK(rw_plib_excluded("", 0));
+	CHECK(rw_plib_excluded("/System/Library/Frameworks/QuartzCore.framework/default.pipelinelib", 0));
+	CHECK(!rw_plib_excluded("/System/Library/Frameworks/QuartzCore.framework/default.pipelinelib", 1));
+	CHECK(!rw_plib_excluded("/System/Library/PrivateFrameworks/ActivityRingsUI.framework/ARUIPrecompiledPipeline.pipelinelib", 0));
+	CHECK(rw_plib_excluded("/System/Library/PrivateFrameworks/RenderBox.framework/default.pipelinelib", 0));
+	CHECK(rw_plib_excluded("/System/Library/PrivateFrameworks/VectorKit.framework/iphoneos.pipelinelib", 0));
+	CHECK(!rw_plib_excluded("/System/Library/PrivateFrameworks/VectorKit.framework/iphoneos.pipelinelib", 1));
+	CHECK(rw_plib_cache_path("/S/ActivityRingsUI.framework/ARUIPrecompiledPipeline.pipelinelib/pipelines.Mali-G77MP11(product0x9080,Redwood)"));
+	CHECK(rw_plib_cache_path("/S/X.pipelinelib/functions"));
+	CHECK(rw_plib_cache_path("/S/X.pipelinelib/pipelines.g10p"));
+	CHECK(!rw_plib_cache_path("/S/X.pipelinelib/pipelines.desc"));
+	CHECK(!rw_plib_cache_path("/S/X.pipelinelib/pipelines."));
+	CHECK(!rw_plib_cache_path("/S/X.pipelinelib/other"));
+	CHECK(!rw_plib_cache_path("/S/X.metallib/functions"));
+	CHECK(!rw_plib_cache_path("/var/mobile/Library/Caches/com.apple.metal/functions"));
+	CHECK(!rw_plib_cache_path("functions"));
+	CHECK(!rw_plib_cache_path("/functions"));
+	CHECK(!rw_plib_cache_path(".pipelinelib/functions") || 1);   /* (a relative path: either answer is harmless) */
+	CHECK(!rw_plib_cache_path(NULL));
+	/* fuzz: random byte strings never crash and only ever say yes to the shape above */
+	for (int i = 0; i < 200000; i++) {
+		char s[64];
+		unsigned n = (unsigned)(rnd() % sizeof(s));
+		static const char alpha[] = "/.pipelinesdcfuto0123ab(),";
+
+		for (unsigned k = 0; k < n; k++) {
+			s[k] = (rnd() & 7) == 0 ? (char)(rnd() & 0xff) : alpha[rnd() % (sizeof(alpha) - 1)];
+			if (s[k] == '\0') s[k] = 'x';
+		}
+		s[n] = '\0';
+		if (rw_plib_cache_path(s)) {
+			const char *sl = strrchr(s, '/');
+
+			CHECK(sl != NULL && sl - s >= 12 && memcmp(sl - 12, ".pipelinelib", 12) == 0);
+			CHECK(strcmp(sl + 1, "functions") == 0 || (strncmp(sl + 1, "pipelines.", 10) == 0 && strlen(sl + 1) > 10 &&
+			    strcmp(sl + 1, "pipelines.desc") != 0));
+		}
+		(void)rw_plib_excluded(s, (int)(rnd() & 1));
+	}
+}
+
+/* ---- subrect: against a slow reference ---- */
+static int
+ref_subrect(unsigned sw, unsigned sh, uint64_t rb, unsigned planes, unsigned w, unsigned h, unsigned bpp)
+{
+	if (planes >= 2) return 0;
+	if (!sw || !sh || !w || !h || !bpp) return 0;
+	if (w == sw && h == sh) return 0;
+	if (w > sw || h > sh) return 0;
+	return (uint64_t)w * bpp <= rb;
+}
+
+static void
+test_subrect(void)
+{
+	CHECK(rw_subrect_ok(64, 64, 256, 1, 52, 52, 4));     /* the mediaserverd case */
+	CHECK(!rw_subrect_ok(64, 64, 256, 1, 64, 64, 4));    /* equal: not a sub-rectangle (the ordinary path) */
+	CHECK(!rw_subrect_ok(1125, 2436, 4544, 1, 2436, 1125, 4));   /* the rotated drawable stays refused */
+	CHECK(!rw_subrect_ok(64, 64, 256, 2, 52, 52, 1));    /* two planes: not here */
+	CHECK(!rw_subrect_ok(64, 64, 100, 1, 52, 52, 4));    /* rows too short */
+	for (int i = 0; i < 1000000; i++) {
+		unsigned sw = (unsigned)(rnd() % 300), sh = (unsigned)(rnd() % 300), w = (unsigned)(rnd() % 320), h = (unsigned)(rnd() % 320);
+		unsigned bpp = (unsigned)(rnd() % 17), planes = (unsigned)(rnd() % 3);
+		uint64_t rb = (rnd() & 1) ? (uint64_t)sw * bpp : rnd() % 5000;
+
+		if ((rnd() & 255) == 0) { sw = 0xffffffffu; w = 0xfffffff0u; bpp = 16; rb = ~0ull; }
+		CHECK(rw_subrect_ok(sw, sh, rb, planes, w, h, bpp) == ref_subrect(sw, sh, rb, planes, w, h, bpp));
+	}
+}
+
+/* ---- faces ---- */
+static void
+test_faces(void)
+{
+	static const unsigned want[10] = { 1, 1, 1, 1, 1, 6, 6, 1, 1, 1 };
+
+	for (unsigned t = 0; t < 10; t++) {
+		CHECK(rw_num_faces(t) == want[t]);
+	}
+	CHECK(rw_num_faces(1000) == 1);
+}
+
+/* ---- events ---- */
+struct ev { uint64_t value, rises_at, step; unsigned slept, sleeps; };
+static uint64_t ev_get(void *c) { struct ev *e = c; return e->slept >= e->rises_at ? e->value : 0; }
+static void ev_sleep(void *c, unsigned us) { struct ev *e = c; e->slept += us; e->sleeps++; }
+
+static void
+test_events(void)
+{
+	struct ev e = { .value = 7, .rises_at = 0 };
+
+	CHECK(rw_event_wait(ev_get, &e, 7, 1000000, 200, ev_sleep) == 1 && e.sleeps == 0);
+	e = (struct ev){ .value = 7, .rises_at = 5000 };
+	CHECK(rw_event_wait(ev_get, &e, 7, 1000000, 200, ev_sleep) == 1 && e.slept >= 5000 && e.slept < 5400);
+	e = (struct ev){ .value = 6, .rises_at = 0 };
+	CHECK(rw_event_wait(ev_get, &e, 7, 1000000, 200, ev_sleep) == 0 && e.slept >= 1000000 && e.slept <= 1000200);
+	e = (struct ev){ .value = 9, .rises_at = 0 };
+	CHECK(rw_event_wait(ev_get, &e, 7, 0, 0, ev_sleep) == 1);
+	e = (struct ev){ .value = 1, .rises_at = 0 };
+	CHECK(rw_event_wait(ev_get, &e, 7, 0, 0, ev_sleep) == 0 && e.sleeps == 0);
+}
+
+/* ---- famlog ---- */
+static void
+test_famlog(void)
+{
+	struct rw_famseen s;
+	unsigned firsts = 0;
+
+	memset(&s, 0, sizeof(s));
+	CHECK(rw_fam_first(&s, rw_fam_key(0, 1004, 0, "CoreImage")) == 1);
+	CHECK(rw_fam_first(&s, rw_fam_key(0, 1004, 0, "CoreImage")) == 0);
+	CHECK(rw_fam_first(&s, rw_fam_key(0, 1004, 1, "CoreImage")) == 1);
+	CHECK(rw_fam_first(&s, rw_fam_key(1, 1004, 0, "CoreImage")) == 1);
+	CHECK(rw_fam_first(&s, rw_fam_key(0, 1004, 0, "RenderBox")) == 1);
+	CHECK(rw_fam_first(&s, rw_fam_key(0, 1004, 0, NULL)) == 1);
+	for (int i = 0; i < 10000; i++) {
+		firsts += (unsigned)rw_fam_first(&s, rw_fam_key(0, (uint64_t)(rnd() % 400), 0, "x"));
+	}
+	CHECK(s.n == RW_FAMSEEN);
+	CHECK(firsts == RW_FAMSEEN - 5);
+	CHECK(s.dropped > 0);
+	CHECK(strcmp(rw_family_name(1002), "Apple2") == 0 && strcmp(rw_family_name(3003), "Common3") == 0);
+	CHECK(rw_family_name(1009) == NULL && rw_family_name(0) == NULL);
+	CHECK(rw_pow2_report(1) && rw_pow2_report(2) && !rw_pow2_report(3) && rw_pow2_report(1024) && !rw_pow2_report(0));
+}
+
+/* ---- the real paths of the mirror ---- */
+static unsigned real_libs, real_caches, real_taken;
+static void
+test_real(const char *list)
+{
+	FILE *f = fopen(list, "r");
+	char line[1024];
+
+	if (f == NULL) {
+		CHECK(!"list file");
+		return;
+	}
+	while (fgets(line, sizeof(line), f) != NULL) {
+		size_t n = strlen(line);
+		const char *base;
+
+		if (n > 0 && line[n - 1] == '\n') line[--n] = '\0';
+		if (n == 0) continue;
+		base = strrchr(line, '/');
+		base = base != NULL ? base + 1 : line;
+		if (strcmp(base, "pipelines.desc") == 0) {
+			char dir[1024], gpu[1200];
+
+			real_libs++;
+			memcpy(dir, line, (size_t)(base - line - 1));
+			dir[base - line - 1] = '\0';
+			CHECK(!rw_plib_cache_path(line));
+			CHECK(rw_plib_excluded(dir, 0) == (strstr(dir, "/QuartzCore.framework/") != NULL ||
+			    strstr(dir, "/RenderBox.framework/") != NULL || strstr(dir, "/VectorKit.framework/") != NULL));
+			CHECK(!rw_plib_excluded(dir, 1));
+			real_taken += !rw_plib_excluded(dir, 0);
+			/* this GPU's cache file: never shipped, always answered empty */
+			snprintf(gpu, sizeof(gpu), "%s/pipelines.Mali-G77MP11(product0x9080,Redwood)", dir);
+			CHECK(rw_plib_cache_path(gpu));
+		} else if (strstr(line, ".pipelinelib/") != NULL) {
+			real_caches++;
+			CHECK(rw_plib_cache_path(line));
+		}
+	}
+	fclose(f);
+}
+
+int
+main(int argc, char **argv)
+{
+	test_dance();
+	test_paths();
+	test_subrect();
+	test_faces();
+	test_events();
+	test_famlog();
+	for (int i = 1; i < argc; i++) {
+		test_real(argv[i]);
+	}
+	if (failures != 0) {
+		printf("rw_api99a: FAILED (%u)\n", failures);
+		return 1;
+	}
+	printf("rw_api99a: ok (plc dance vs Metal's init model, paths + 200000 fuzz, subrect 1000000 vs reference, faces, events, "
+	    "famlog%s", argc > 1 ? "" : ")\n");
+	if (argc > 1) {
+		printf("; mirror: %u pipeline libraries (%u taken by default), %u cache files classified)\n", real_libs, real_taken,
+		    real_caches);
+	}
+	return 0;
+}
diff -ruN base-src/rw_api99a_pure.h src/rw_api99a_pure.h
--- base-src/rw_api99a_pure.h	1970-01-01 01:00:00.000000000 +0100
+++ src/rw_api99a_pure.h	2026-11-14 01:20:32.192635478 +0100
@@ -0,0 +1,255 @@
+/*
+ * y2s99a (API gaps): the decisions of the y2s99a features, as pure C so that the build machine can test them
+ * (rw-api99a-host-test.sh: ASan/UBSan, -Werror, fuzz).  redwoodmetal.m and redwooddrawable.m include this file and do the
+ * Objective-C around it.  Nothing here calls Metal, IOKit or the kernel.
+ *
+ * Features (each with its own switch file /var/db/nord2-metal/no-<name>, and all of them with no-api99a):
+ *   plib     MTLPipelineLibrary (newPipelineLibraryWithFilePath:error:) for the libraries whose per-GPU cache file this GPU
+ *            cannot have: the per-GPU cache is opened EMPTY, so Metal's own MTLPipelineLibrary takes every pipeline from its
+ *            descriptor in pipelines.desc and the device compiles it from AIR like any other pipeline.  Evidence: 20H392
+ *            Metal MTLPipelineLibraryBuilder::newLibraryWithFile (0x181a3f31c) refuses the library with "Could not open
+ *            pipeline cache file: %s" when pipelines.<targetDeviceInfo name> is missing (0x181a3f764); -[_MTLPipelineCache
+ *            initWithFilePath:readOnly:deviceInfo:] (0x181a3e2ec) gives a valid EMPTY cache for a nil path (cbz x20).
+ *            Users seen in the 20H392 cache: ActivityRingsUI (FitnessWidget: "this draw has no pipeline state", 165 a
+ *            boot), RenderBox (SwiftUI), VectorKit (Maps), NanoTimeKit/Pride (watch faces), SiriUICore (Siri orb),
+ *            LocalAuthenticationPrivateUI, PassKitUIFoundation (Wallet cards), PencilKit, TextInputUI.
+ *            QuartzCore's, RenderBox's and VectorKit's are NOT taken (their callers already fall back to descriptors and work
+ *            that way) unless /var/db/nord2-metal/plib-all exists: see rw_plib_excluded.
+ *   subrect  a texture over an IOSurface smaller than the surface (Metal allows width/height <= the surface's; the texture
+ *            is the top-left corner at the surface's own row length): "no drawable: surface N is 64x64 and the descriptor
+ *            asks for 52x52" (mediaserverd, 288 in the logs).
+ *   fence    -newFence answers an object (was nil); the encoders' fence calls already are no-ops, which is exact here:
+ *            this driver runs one command buffer at a time, in order.
+ *   events   -encodeSignalEvent:value: sets the event's signaledValue when the command buffer has completed (was a
+ *            no-op: a listener or a CPU waiter never saw it); -encodeWaitForEvent:value: makes the commit wait (bounded)
+ *            for the value.
+ *   faces    -numFaces said 6 for 2DArray (3) and 2DMultisample (4) and 1 for Cube (5): MTLTextureType numbers fixed.
+ *   famlog   every distinct -supportsFamily:/-supportsFeatureSet: question, with the image that asked and Metal's answer
+ *            (log only: the answer is never changed).
+ *   emptyslot the "left empty" texture warning says whether the slot held nil or a texture this driver could not bind.
+ */
+#ifndef RW_API99A_PURE_H
+#define RW_API99A_PURE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---- plib ------------------------------------------------------------------------------------------------------------ */
+
+/*
+ * 1 if `path` (a .pipelinelib directory) is one this driver leaves to Metal's own refusal.  Left alone unless `allow_all`
+ * (/var/db/nord2-metal/plib-all): the three whose callers already compile every pipeline from a descriptor when the library
+ * is nil, and work that way today -- QuartzCore (CA::OGL::new_metal_context: "Metal failed to load pipeline library",
+ * then the descriptor path), RenderBox (RB::Device::render_pipeline_state: "no precompiled pipeline", then load_library),
+ * VectorKit (Maps: its pipelines are made from descriptors in the logs, and its library has 372 names -- a prewarm of all
+ * of them would be a cost Maps does not pay today).
+ */
+static inline int
+rw_plib_excluded(const char *path, int allow_all)
+{
+	static const char *const kept[] = { "/QuartzCore.framework/", "/RenderBox.framework/", "/VectorKit.framework/" };
+
+	if (path == NULL || path[0] == '\0') {
+		return 1;
+	}
+	if (!allow_all) {
+		for (size_t i = 0; i < sizeof(kept) / sizeof(kept[0]); i++) {
+			if (strstr(path, kept[i]) != NULL) {
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
+
+/* 1 if `cache_path` is a per-GPU or function cache file of a pipeline library ("<lib>.pipelinelib/pipelines.X" or
+ * "<lib>.pipelinelib/functions"), the only paths the empty-cache substitution may answer */
+static inline int
+rw_plib_cache_path(const char *cache_path)
+{
+	const char *slash, *dir;
+
+	if (cache_path == NULL) {
+		return 0;
+	}
+	slash = strrchr(cache_path, '/');
+	if (slash == NULL || slash == cache_path) {
+		return 0;
+	}
+	/* the directory part must end in ".pipelinelib" */
+	dir = slash;
+	if ((size_t)(dir - cache_path) < sizeof(".pipelinelib") - 1 ||
+	    memcmp(dir - (sizeof(".pipelinelib") - 1), ".pipelinelib", sizeof(".pipelinelib") - 1) != 0) {
+		return 0;
+	}
+	if (strcmp(slash + 1, "functions") == 0) {
+		return 1;
+	}
+	if (strncmp(slash + 1, "pipelines.", 10) == 0 && slash[11] != '\0' && strcmp(slash + 1, "pipelines.desc") != 0) {
+		return 1;
+	}
+	return 0;
+}
+
+/*
+ * The retain/init/delete/init-again sequence of rw_plc_init_hook, over callbacks so that the build machine can run it against
+ * a model of Metal's init (which releases the object when it fails, leaving its C++ cache in the object's slot).
+ *   init(ctx, self, use_path)  Metal's -initWithFilePath:readOnly:deviceInfo: with the real path (1) or nil (0); self or NULL
+ *   retain / release(ctx, self)
+ *   take_cache(ctx, self)      reads and clears the C++ cache slot (+0x10), NULL if empty
+ *   delete_cache(ctx, cache)   what -dealloc does with it (vtable +0x8)
+ * Returns what the caller of init gets; *emptied = 1 when the empty cache was given.
+ */
+struct rw_plc_ops {
+	void *(*init)(void *ctx, void *self, int use_path);
+	void (*retain)(void *ctx, void *self);
+	void (*release)(void *ctx, void *self);
+	void *(*take_cache)(void *ctx, void *self);
+	void (*delete_cache)(void *ctx, void *cache);
+};
+
+static inline void *
+rw_plc_dance(const struct rw_plc_ops *ops, void *ctx, void *self, int *emptied)
+{
+	void *r, *cache;
+
+	*emptied = 0;
+	ops->retain(ctx, self);
+	r = ops->init(ctx, self, 1);
+	if (r != NULL) {
+		ops->release(ctx, self);
+		return r;
+	}
+	cache = ops->take_cache(ctx, self);
+	if (cache != NULL) {
+		ops->delete_cache(ctx, cache);
+	}
+	*emptied = 1;
+	return ops->init(ctx, self, 0);    /* consumes the reference taken above, as an init does */
+}
+
+/* ---- subrect --------------------------------------------------------------------------------------------------------- */
+
+/*
+ * May a texture of want_w x want_h texels of `bpp` bytes be laid over the top-left corner of a one-plane surface of
+ * surf_w x surf_h at row_bytes a row?  1 yes (and it is a proper sub-rectangle), 0 no (the sizes are equal, or bigger,
+ * or something is zero).  The row check is the one the import makes anyway; it is repeated so that the answer stands
+ * alone.
+ */
+static inline int
+rw_subrect_ok(unsigned surf_w, unsigned surf_h, uint64_t row_bytes, unsigned planes, unsigned want_w, unsigned want_h,
+    unsigned bpp)
+{
+	if (planes > 1 || surf_w == 0 || surf_h == 0 || want_w == 0 || want_h == 0 || bpp == 0) {
+		return 0;
+	}
+	if (want_w > surf_w || want_h > surf_h || (want_w == surf_w && want_h == surf_h)) {
+		return 0;
+	}
+	if ((uint64_t)want_w * bpp > row_bytes) {
+		return 0;
+	}
+	return 1;
+}
+
+/* ---- faces ----------------------------------------------------------------------------------------------------------- */
+
+/* MTLTextureType: 1D 0, 1DArray 1, 2D 2, 2DArray 3, 2DMultisample 4, Cube 5, CubeArray 6, 3D 7, 2DMultisampleArray 8,
+ * TextureBuffer 9 */
+static inline unsigned
+rw_num_faces(unsigned type)
+{
+	return (type == 5 || type == 6) ? 6u : 1u;
+}
+
+/* ---- events ---------------------------------------------------------------------------------------------------------- */
+
+/*
+ * Wait until get(ctx) >= value, polling every `step_us` for at most `timeout_us`; `sleep_us` does the sleeping (usleep
+ * on the phone, a counter in the test).  Returns 1 if the value was reached, 0 on the timeout.
+ */
+static inline int
+rw_event_wait(uint64_t (*get)(void *), void *ctx, uint64_t value, unsigned timeout_us, unsigned step_us,
+    void (*sleep_us)(void *, unsigned))
+{
+	unsigned waited = 0;
+
+	if (step_us == 0) {
+		step_us = 1;
+	}
+	for (;;) {
+		if (get(ctx) >= value) {
+			return 1;
+		}
+		if (waited >= timeout_us) {
+			return 0;
+		}
+		sleep_us(ctx, step_us);
+		waited += step_us;
+	}
+}
+
+/* ---- famlog ---------------------------------------------------------------------------------------------------------- */
+
+/* a small set of (question, answer, asker) triples already said, so each distinct one is logged once a process */
+#define RW_FAMSEEN 128
+struct rw_famseen {
+	uint64_t key[RW_FAMSEEN];
+	unsigned n, dropped;
+};
+
+static inline uint64_t
+rw_fam_key(unsigned kind, uint64_t family, int answer, const char *asker)
+{
+	uint64_t h = 1469598103934665603ull;   /* FNV-1a over the asker's name */
+
+	for (const char *p = asker != NULL ? asker : "?"; *p != '\0'; p++) {
+		h = (h ^ (unsigned char)*p) * 1099511628211ull;
+	}
+	h ^= ((uint64_t)kind << 62) ^ ((uint64_t)(answer != 0) << 61) ^ (family * 0x9e3779b97f4a7c15ull);
+	return h == 0 ? 1 : h;
+}
+
+/* 1 if the key is new (and now remembered), 0 if seen before or the set is full (then counted as dropped) */
+static inline int
+rw_fam_first(struct rw_famseen *s, uint64_t key)
+{
+	for (unsigned i = 0; i < s->n; i++) {
+		if (s->key[i] == key) {
+			return 0;
+		}
+	}
+	if (s->n >= RW_FAMSEEN) {
+		s->dropped++;
+		return 0;
+	}
+	s->key[s->n++] = key;
+	return 1;
+}
+
+/* the name Metal's headers give a family / feature-set number, for the log (NULL when unknown) */
+static inline const char *
+rw_family_name(uint64_t f)
+{
+	switch (f) {
+	case 1001: return "Apple1"; case 1002: return "Apple2"; case 1003: return "Apple3"; case 1004: return "Apple4";
+	case 1005: return "Apple5"; case 1006: return "Apple6"; case 1007: return "Apple7"; case 1008: return "Apple8";
+	case 2001: return "Mac1"; case 2002: return "Mac2";
+	case 3001: return "Common1"; case 3002: return "Common2"; case 3003: return "Common3";
+	case 4001: return "MacCatalyst1"; case 4002: return "MacCatalyst2";
+	case 5001: return "Metal3";
+	default: return NULL;
+	}
+}
+
+/* ---- counters -------------------------------------------------------------------------------------------------------- */
+
+/* report at the 1st, 2nd, 4th, 8th ... event */
+static inline int
+rw_pow2_report(unsigned long n)
+{
+	return n != 0 && (n & (n - 1)) == 0;
+}
+
+#endif
