+/*
+ * libmerge6: the RGB picture from the one made per different sensor column and row (texture 0, uc x ur), through the index tables (1: the
+ * columns', 2: the rows', R16Uint). isp_cells_shader looks at nothing of a pixel but the sensor place its two tables give, so every pixel of the
+ * picture is the texel of its place in the smaller one, byte for byte (an 8-bit texel read and written back as the same byte).
+ */
+static nir_shader *
+isp_expand_shader(const struct nir_shader_compiler_options *options)
+{
+   nir_variable *uv, *out;
+   nir_builder b = isp_fragment_begin(options, "isp_expand", &uv, &out);
+   nir_def *x, *y, *zero = nir_imm_int(&b, 0);
+
+   isp_pixel_xy(&b, uv, &x, &y);
+   nir_def *i = nir_channel(&b, isp_fetch(&b, 1, x, zero, nir_type_uint32), 0);
+   nir_def *j = nir_channel(&b, isp_fetch(&b, 2, y, zero, nir_type_uint32), 0);
+
+   nir_store_var(&b, out, isp_fetch(&b, 0, i, j, nir_type_float32), 0xf);
+   return isp_fragment_end(&b, 3);
+}
