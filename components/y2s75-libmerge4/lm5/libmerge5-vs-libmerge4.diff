 static struct rwa_device *isp_device;           /* the process's, opened by the first rwa_isp_create and kept */
+/*
+ * libmerge5 (y2s75/lm5): the three libmerge4 changes that only a real Mali can judge are OFF unless asked for, so that each can be tried on the
+ * phone in one boot. Run of 12 November (txn lm4): the GPU's pictures without noise reduction (the ones the bundle compares) were up to 14..35 of
+ * 255 off the processor's from the FIRST picture, previews (cells) and stills (full) alike, where libmerge3 had 0; softpipe gives 0 with all of
+ * them. Asked by words in /private/var/db/nord2-isp-features (or RWA_ISP_FEATURES), read once at the first rwa_isp_create:
+ *   fold   the luma pass folded into the ISP pass (two attachments: RGB and Y)           -- off: the ISP pass, then libmerge3's luma pass
+ *   r32    the frame read as 32-bit words (ISP cells without zoom, the statistics' cells) -- off: byte by byte, as libmerge3
+ *   mrt    the apply passes write the plane and the next picture before in one pass       -- off: two passes, as libmerge3
+ *   all    the three
+ */
+static bool isp_feat_fold, isp_feat_r32, isp_feat_mrt;
+static pthread_once_t isp_feat_once = PTHREAD_ONCE_INIT;
+static char isp_feat_text[96];
+
+static void
+isp_features_load(void)
+{
+   char text[256] = "";
+   const char *env = getenv("RWA_ISP_FEATURES");
+
+   if (env != NULL) {
+      snprintf(text, sizeof(text), "%s", env);
+   } else {
+      int fd = open("/private/var/db/nord2-isp-features", O_RDONLY);
+
+      if (fd >= 0) {
+         ssize_t n = read(fd, text, sizeof(text) - 1);
+
+         text[n > 0 ? n : 0] = 0;
+         close(fd);
+      }
+   }
+   bool all = strstr(text, "all") != NULL;
+
+   isp_feat_fold = all || strstr(text, "fold") != NULL;
+   isp_feat_r32 = all || strstr(text, "r32") != NULL;
+   isp_feat_mrt = all || strstr(text, "mrt") != NULL;
+   snprintf(isp_feat_text, sizeof(isp_feat_text), "fold %s, r32 %s, mrt %s", isp_feat_fold ? "ON" : "off", isp_feat_r32 ? "ON" : "off",
+            isp_feat_mrt ? "ON" : "off");
+}
