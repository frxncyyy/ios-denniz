+/// How many decoded modules [`decode_reused`] keeps per process (least recently used first out).
+const DECODED_KEPT: usize = 4;
+
+/// [`air::decode`] of `bitcode`, whose SHA-256 is `air_hash`, reusing this process's last decodes:
+/// a pipeline's stages decode the same function modules again and again (QuartzCore's
+/// `fixed_vert`/`fixed_frag` for every variant), and decoding is a pure function of the bytes.
+/// The kept module is cloned out, so the caller owns and consumes its copy as before. A failed
+/// decode is not kept: it fails again the same way.
+fn decode_reused(air_hash: &Hash256, bitcode: &[u8], m: &mut Meter) -> Result<air::Decoded, Error> {
+    use std::sync::{Mutex, OnceLock};
+    static KEPT: OnceLock<Mutex<VecDeque<(Hash256, Arc<air::Decoded>)>>> = OnceLock::new();
+    let kept = KEPT.get_or_init(|| Mutex::new(VecDeque::new()));
+    if let Ok(mut k) = kept.lock() {
+        if let Some(i) = k.iter().position(|(h, _)| h == air_hash) {
+            let hit = k.remove(i).expect("position is in range");
+            let decoded = air::Decoded::clone(&hit.1);
+            k.push_back(hit);
+            return Ok(decoded);
+        }
+    }
+    let decoded = air::decode(bitcode, m)?;
+    if let Ok(mut k) = kept.lock() {
+        if k.len() >= DECODED_KEPT {
+            k.pop_front();
+        }
+        k.push_back((*air_hash, Arc::new(decoded.clone())));
+    }
+    Ok(decoded)
+}
