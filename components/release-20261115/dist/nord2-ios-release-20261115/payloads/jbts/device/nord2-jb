#!/var/jb/bin/sh
# nord2-jb: on-phone helper for the jbts1 userland (Sileo + OpenSSH + TrollStore). Run as root (ssh root@phone, or "sudo").
#   nord2-jb status               jobs, sshd, addresses, TrollStore, last log lines
#   nord2-jb ssh on|off           switch the SSH server (kill switch file /var/jb/etc/nord2-jb/ssh-disabled) and (re)start/stop it
#   nord2-jb password-auth on|off PasswordAuthentication in /var/jb/etc/ssh/sshd_config (keys always work), restarts sshd
#   nord2-jb register             register /var/jb/Applications/*.app with LaunchServices again (uicache -p)
#   nord2-jb trollstore           install TrollStore from the bundled tar now (+ ldid), as the boot job would
#   nord2-jb refresh              TrollStore: re-register all TrollStore apps (after an icon-cache/LaunchServices rebuild)
#   nord2-jb disable|enable       global kill switch (/var/jb/etc/nord2-jb/disabled): takes effect at the next boot
# Passwords: "passwd root" / "passwd mobile" (Procursus passwd rewrites master.passwd + pwd.db).
PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
C=/var/jb/etc/nord2-jb
SH=/var/jb/usr/share/nord2-jb
TSH=/var/jb/Applications/TrollStorePersistenceHelper.app/trollstorehelper
CFG=/var/jb/etc/ssh/sshd_config
[ "$(id -u)" = 0 ] || { echo "nord2-jb: run as root" >&2; exit 1; }
restart_sshd() {
	launchctl kickstart -k system/com.nord2.jb.sshd 2>/dev/null ||
		{ kill $(cat /var/jb/var/run/sshd.pid 2>/dev/null) 2>/dev/null; echo "nord2-jb: launchctl kickstart failed; sshd killed (launchd restarts it unless disabled)"; }
}
case "$1" in
status)
	for f in disabled ssh-disabled install-trollstore postinst-done; do [ -e "$C/$f" ] && echo "flag: $f"; done
	launchctl print system/com.nord2.jb.sshd 2>/dev/null | grep -E "state|pid" | head -3
	launchctl list 2>/dev/null | grep com.nord2.jb; echo "sshd pid file: $(cat /var/jb/var/run/sshd.pid 2>/dev/null)"
	ifconfig 2>/dev/null | grep -E "^[a-z]|inet " | grep -B1 "inet " | grep -v -- "--"
	grep -E "^(PermitRootLogin|PasswordAuthentication|Port)" "$CFG"
	ls -d /var/containers/Bundle/Application/*/TrollStore.app 2>/dev/null | sed 's/^/TrollStore: /'
	tail -n 15 /var/jb/var/log/nord2-jb.log 2>/dev/null
	;;
ssh)
	case "$2" in
	on) rm -f "$C/ssh-disabled"; restart_sshd ;;
	off) touch "$C/ssh-disabled"; launchctl kill SIGTERM system/com.nord2.jb.sshd 2>/dev/null || kill $(cat /var/jb/var/run/sshd.pid 2>/dev/null) ;;
	*) echo "usage: nord2-jb ssh on|off"; exit 2 ;;
	esac ;;
password-auth)
	case "$2" in on) v=yes ;; off) v=no ;; *) echo "usage: nord2-jb password-auth on|off"; exit 2 ;; esac
	sed -i "s/^PasswordAuthentication .*/PasswordAuthentication $v/" "$CFG" && grep "^PasswordAuthentication" "$CFG" && restart_sshd ;;
register)
	for app in /var/jb/Applications/*.app; do echo "$app: $(uicache -p "$app" 2>&1)"; done ;;
trollstore)
	timeout 300 "$TSH" install-trollstore "$SH/TrollStore.tar"; rc=$?; echo "install-trollstore rc=$rc"
	[ $rc -eq 0 ] && "$TSH" install-ldid "$SH/ldid" "$(cat "$SH/ldid.version")" && echo "ldid installed" && rm -f "$C/install-trollstore" ;;
refresh)
	"$TSH" refresh; echo "rc=$?" ;;
disable) touch "$C/disabled"; echo "disabled from the next boot" ;;
enable) rm -f "$C/disabled"; echo "enabled from the next boot" ;;
*) sed -n '2,12p' "$0"; exit 2 ;;
esac
