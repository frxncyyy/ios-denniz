+/* slotdiag: the first 48 (pipeline, slot) pairs that draw with an empty texture slot, by the pipeline's label */
+static void
+rw_gfx_slot_note(id render, unsigned slot, unsigned bound, unsigned reads)
+{
+	static const void *seen[48];
+	static unsigned seen_slot[48];
+	static volatile unsigned count;
+	static volatile int lock;
+
+	if (count >= 48 || !rw_gfx_on(RW_G_SLOTDIAG)) {
+		return;
+	}
+	while (__sync_lock_test_and_set(&lock, 1)) {
+	}
+	unsigned c = count;
+	for (unsigned i = 0; i < c; i++) {
+		if (seen[i] == (const void *)render && seen_slot[i] == slot) {
+			__sync_lock_release(&lock);
+			return;
+		}
+	}
+	if (c < 48) {
+		seen[c] = (const void *)render;
+		seen_slot[c] = slot;
+		count = c + 1;
+	}
+	__sync_lock_release(&lock);
+	if (c < 48) {
+		m2m_log('I', "CMD", "gfx100a slot: pipeline %s reads texture %u of %u and the application bound %u: empty (one clear texel)\n",
+		    [render respondsToSelector:@selector(label)] && [(id)render label] != nil ? [[(id)render label] UTF8String] : "(no label)",
+		    slot, reads, bound);
+	}
+}
+
+/* slotdiag: the first 64 IOSurface textures refused, with what was asked */
+static void
+rw_gfx_surface_refused(unsigned pf, unsigned asked, unsigned w, unsigned h, unsigned usage, NSUInteger plane, const char *why)
+{
+	static volatile unsigned n;
+
+	if (!rw_gfx_on(RW_G_SLOTDIAG) || __sync_add_and_fetch(&n, 1) > 64) {
+		return;
+	}
+	m2m_log('W', "SURF", "gfx100a refused: IOSurface texture format %u (asked %u) %ux%u usage 0x%x plane %lu: %s\n", pf, asked, w, h,
+	    usage, (unsigned long)plane, why);
+}
