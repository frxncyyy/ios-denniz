+/*
+ * ---- gfx100a (2026-11-14): app switcher / App Library / Safari ----
+ * rw_gfx100a_pure.h has the why of the two fixes (XR alias, ASTC edge). Besides them, two diagnostics:
+ *   filelog   every record this process gives m2m_log is also appended to /var/db/nord2-metal/log/<process>.<pid>.log (when that
+ *             directory exists; payload gfx100a makes it 1777), at most 4 MiB a process. The kernel's log selector has a budget
+ *             of 16 KiB per client (patch 0084, logBytes), so a backboardd hours old says nothing on the console any more.
+ *   slotdiag  which pipelines draw with an empty texture slot (first 48 pipeline+slot pairs, by label), and the first 64 refused
+ *             IOSurface textures with their format, size and usage (the console's RW_AGAIN shows only every power of two).
+ * Switches (/var/db/nord2-metal/, read once per process): no-gfx100a (all), no-xralias, no-astcedge, no-filelog, no-slotdiag.
+ * Lines: 'I DEV NORD2 GPU GFX100A: pid= name= config ...' once; 'I RES gfx100a xralias: ...' at 1, 2, 4, 8... aliases.
+ */
+#include "rw_gfx100a_pure.h"
+
+enum { RW_G_XRALIAS, RW_G_ASTCEDGE, RW_G_FILELOG, RW_G_SLOTDIAG, RW_G_N };
+static const char *const rw_g_names[RW_G_N] = { "xralias", "astcedge", "filelog", "slotdiag" };
+static int rw_g_off[RW_G_N];
+static volatile int rw_g_ready;
+
+static void
+rw_gfx_config(void)
+{
+	static dispatch_once_t once;
+
+	if (rw_g_ready) {
+		return;
+	}
+	dispatch_once(&once, ^{
+		int all = access("/var/db/nord2-metal/no-gfx100a", F_OK) == 0;
+		char line[200] = "";
+		size_t used = 0;
+
+		for (int i = 0; i < RW_G_N; i++) {
+			char path[96];
+
+			snprintf(path, sizeof(path), "/var/db/nord2-metal/no-%s", rw_g_names[i]);
+			rw_g_off[i] = all || access(path, F_OK) == 0;
+			used += (size_t)snprintf(line + used, sizeof(line) - used, " %s=%s", rw_g_names[i], rw_g_off[i] ? "OFF" : "ON");
+			if (used >= sizeof(line)) {
+				used = sizeof(line) - 1;
+			}
+		}
+		__sync_synchronize();
+		rw_g_ready = 1;
+		m2m_log('I', "DEV", "NORD2 GPU GFX100A: pid=%d name=%s config%s%s gfx100a\n", getpid(), getprogname(), line,
+		    all ? " (no-gfx100a)" : "");
+	});
+}
+
+static int
+rw_gfx_on(int feature)
+{
+	rw_gfx_config();
+	return feature >= 0 && feature < RW_G_N && !rw_g_off[feature];
+}
+
+/* the format a texture/attachment of `pf` is made as (rw_gfx100a_pure.h); `where` names the caller in the log */
+static unsigned
+rw_gfx_alias(unsigned pf, const char *where)
+{
+	unsigned to = rw_gfx_xr_alias_of(pf);
+	static unsigned long n;
+
+	if (to == pf || !rw_gfx_on(RW_G_XRALIAS)) {
+		return pf;
+	}
+	unsigned long k = __sync_add_and_fetch(&n, 1);
+
+	if ((k & (k - 1)) == 0) {
+		m2m_log('I', "RES", "gfx100a xralias: pixel format %u served as %u (%s) [%lu so far]\n", pf, to, where, k);
+	}
+	return to;
+}
