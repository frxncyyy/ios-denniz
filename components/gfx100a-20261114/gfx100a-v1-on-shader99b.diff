+/*
+ * The file sink, called by m2m_vlog (m2m.h) for every record of this process. No locks (it is also reached from the crash
+ * handler): the first caller opens, a caller that meets the open in progress drops its record.
+ */
+void
+rw_gfx_file_sink(const char *rec, size_t n)
+{
+	static int fd = -2;              /* -2 not tried yet, -1 off */
+	static volatile int opening;
+	static volatile unsigned long bytes;
+	char buf[1200];
+	size_t used;
+
+	if (fd == -1 || rec == NULL) {
+		return;
+	}
+	if (fd == -2) {
+		int f = -1;
+
+		if (__sync_lock_test_and_set(&opening, 1)) {
+			return;
+		}
+		if (access("/var/db/nord2-metal/no-gfx100a", F_OK) != 0 && access("/var/db/nord2-metal/no-filelog", F_OK) != 0 &&
+		    access("/var/db/nord2-metal/log", W_OK) == 0) {
+			char path[200];
+
+			snprintf(path, sizeof(path), "/var/db/nord2-metal/log/%s.%d.log", getprogname(), getpid());
+			f = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+		}
+		__sync_synchronize();
+		fd = f >= 0 ? f : -1;
+		if (fd < 0) {
+			return;
+		}
+	}
+	if (bytes > (4ul << 20)) {
+		return;
+	}
+	{
+		struct timespec ts;
+		struct tm tm;
+
+		clock_gettime(CLOCK_REALTIME, &ts);
+		localtime_r(&ts.tv_sec, &tm);
+		used = (size_t)snprintf(buf, sizeof(buf), "%02d:%02d:%02d.%03ld ", tm.tm_hour, tm.tm_min, tm.tm_sec, ts.tv_nsec / 1000000);
+	}
+	if (n > sizeof(buf) - used - 1) {
+		n = sizeof(buf) - used - 1;
+	}
+	memcpy(buf + used, rec, n);
+	used += n;
+	buf[used++] = '\n';
+	__sync_add_and_fetch(&bytes, used);
+	(void)write(fd, buf, used);
+}
