--- !tapi-tbd
tbd-version:      4
targets:          [ arm64-ios ]
install-name:     '/usr/lib/libSystem.B.dylib'
current-version:  1336
compatibility-version: 1
exports:
  - targets:      [ arm64-ios ]
    symbols:
      - ___error
      - ___stack_chk_fail
      - ___stack_chk_guard
      - _close
      - _kill
      - _open
      - _proc_listallpids
      - _proc_name
      - _read
      - _sleep
      - _snprintf
      - _strcmp
      - _strlen
      - _sysctlbyname
      - _write
      - dyld_stub_binder
...
