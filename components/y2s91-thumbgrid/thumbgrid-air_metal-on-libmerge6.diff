+   if (end > left)
+      memset(p + left, 0, end - left);
+   p_atomic_add(&rwa_tg_ubo_zeroed, (uint64_t)(end > left ? end - left : 0));
+   p_atomic_add(&rwa_tg_ubo_saved, (uint64_t)(can_read - MAX2(end, left)));
+   /* [can_read, old dirty) was not cleared when can_read is the smaller: still dirty */
+   *dirty = *dirty > can_read ? *dirty : left;
