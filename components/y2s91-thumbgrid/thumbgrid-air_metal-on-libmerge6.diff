+static void
+rwa_tg_ubo_tail(char *p, size_t left, size_t can_read, size_t *dirty)
+{
+   static int on = -1;
+
+   if (on < 0)
+      on = access("/var/db/nord2-metal/no-thumbgrid-ubo", F_OK) != 0 && access("/var/db/nord2-metal/no-thumbgrid", F_OK) != 0;
+   size_t end = on == 1 ? MIN2(MAX2(*dirty, left), can_read) : can_read;
