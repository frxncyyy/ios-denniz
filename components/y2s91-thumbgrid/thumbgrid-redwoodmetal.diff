+/* the buffer's owner let it go: kept for the next request of its class instead of destroyed. NO: not taken (destroy it). */
+static BOOL
+rw_tg_buf_park(struct rwa_buffer *b)
+{
+	rw_tg_init();
+	if (!rw_tg.bufpool || b == NULL || mesa.buffer_map(b) == NULL) {
+		return NO;
+	}
+	size_t cap = rw_tg.buffer_recycle(b);   /* (also forgets its argument-buffer records now) */
+
+	if (cap == 0 || cap > RW_TG_BUF_MAX_BYTES / 2 || cap != rw_tg_class(cap)) {
+		return NO;              /* not one of ours (made before the pool, or with an odd size) */
+	}
+	struct rw_tg_pbuf *e = calloc(1, sizeof(*e));
+
+	if (e == NULL) {
+		return NO;
+	}
+	e->b = b;
+	e->cap = cap;
+	e->mark = rw_tg_mark();
+	e->parked = rw_now_ns();
+	e->busy = cap >= RW_TG_BUF_BIG;
+	pthread_mutex_lock(&rw_tg_buf_lock);
+	e->next = rw_tg_bufs;
+	rw_tg_bufs = e;
+	rw_tg_buf_bytes += cap;
+	rw_tg_buf_count++;
+	pthread_mutex_unlock(&rw_tg_buf_lock);
+	__sync_add_and_fetch(&rw_tg_n.buf_park, 1);
+	if (e->busy) {
+		/* zeroed off the caller's thread once the GPU is done with it (kernel zeroing of 3-16 MB was 2-9 ms on the allocating thread) */
+		dispatch_async(rw_tg_janitor(), ^{
+			uint64_t t0 = rw_now_ns();
+
+			while (!rw_tg_safe(e->mark) && rw_now_ns() - t0 < 1000000000ULL) {
+				usleep(2000);
+			}
+			if (rw_tg_safe(e->mark)) {
+				memset(mesa.buffer_map(e->b), 0, e->cap);
+				e->clean = 1;
+				__sync_add_and_fetch(&rw_tg_n.buf_bgzero, 1);
+			}
+			pthread_mutex_lock(&rw_tg_buf_lock);
+			e->busy = 0;
+			pthread_mutex_unlock(&rw_tg_buf_lock);
+		});
+	}
+	rw_tg_buf_sweep();
+	return YES;
+}
+
+/* ---- the texture pool (textures of -newTextureWithDescriptor:, not over a surface or a buffer, not views) ---- */
+#define RW_TG_TEX_MAX 64
+#define RW_TG_TEX_MAX_BYTES (40u << 20)
+struct rw_tg_ptex {
+	struct rwa_texture *t;
+	struct rwa_texture_shape shape;
+	size_t bytes;
+	uint64_t mark, parked;
+	struct rw_tg_ptex *next;
+};
+static struct rw_tg_ptex *rw_tg_texs;
+static unsigned rw_tg_tex_count;
+static size_t rw_tg_tex_bytes;
+static pthread_mutex_t rw_tg_tex_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL
+rw_tg_same_shape(const struct rwa_texture_shape *a, const struct rwa_texture_shape *b)
+{
+	return a->pixel_format == b->pixel_format && a->type == b->type && a->width == b->width && a->height == b->height &&
+	       a->depth == b->depth && a->array_length == b->array_length && a->mip_levels == b->mip_levels &&
+	       a->sample_count == b->sample_count && a->usage == b->usage;
+}
+
+static size_t
+rw_tg_shape_bytes(const struct rwa_texture_shape *s)
+{
+	size_t px = (size_t)s->width * (s->height ? s->height : 1) * (s->depth ? s->depth : 1) * (s->array_length ? s->array_length : 1) *
+		    (s->sample_count ? s->sample_count : 1);
+
+	return px * 8 * (s->mip_levels > 1 ? 4 : 3) / 3 / 2;   /* ~4 bytes a texel (8 for the wide formats, averaged), mips +1/3 */
+}
+
+static struct rwa_texture *
+rw_tg_tex_take(const struct rwa_texture_shape *shape)
+{
+	rw_tg_init();
+	if (!rw_tg.texpool) {
+		return NULL;
+	}
+	struct rw_tg_ptex *e = NULL, **pp;
+
+	pthread_once(&rw_tg_q_once, rw_tg_q_init);
+	pthread_mutex_lock(&rw_tg_tex_lock);
+	for (pp = &rw_tg_texs; *pp != NULL; pp = &(*pp)->next) {
+		if (rw_tg_same_shape(&(*pp)->shape, shape) && rw_tg_safe((*pp)->mark)) {
+			e = *pp;
+			*pp = e->next;
+			rw_tg_tex_count--;
+			rw_tg_tex_bytes -= e->bytes;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_tex_lock);
+	if (e == NULL) {
+		__sync_add_and_fetch(&rw_tg_n.tex_miss, 1);
+		return NULL;
+	}
+	struct rwa_texture *t = e->t;
+
+	free(e);
+	if (rw_tg.texture_recycle(t) != 0) {
+		mesa.texture_destroy(t);
+		return NULL;
+	}
+	__sync_add_and_fetch(&rw_tg_n.tex_hit, 1);
+	return t;
+}
+
+static BOOL
+rw_tg_tex_park(struct rwa_texture *t, const struct rwa_texture_shape *shape)
+{
+	rw_tg_init();
+	size_t bytes = rw_tg_shape_bytes(shape);
+
+	if (!rw_tg.texpool || t == NULL || bytes > RW_TG_TEX_MAX_BYTES / 4 || shape->sample_count > 1) {
+		return NO;
+	}
+	struct rw_tg_ptex *e = calloc(1, sizeof(*e)), *drop = NULL;
+
+	if (e == NULL) {
+		return NO;
+	}
+	e->t = t;
+	e->shape = *shape;
+	e->bytes = bytes;
+	e->mark = rw_tg_mark();
+	e->parked = rw_now_ns();
+	pthread_mutex_lock(&rw_tg_tex_lock);
+	e->next = rw_tg_texs;
+	rw_tg_texs = e;
+	rw_tg_tex_count++;
+	rw_tg_tex_bytes += bytes;
+	/* past the budget or too old (newest first: cut from the back) */
+	{
+		struct rw_tg_ptex **pp = &rw_tg_texs;
+		unsigned k = 0;
+		size_t sum = 0;
+		uint64_t now = rw_now_ns();
+
+		while (*pp != NULL) {
+			struct rw_tg_ptex *c = *pp;
+
+			k++;
+			sum += c->bytes;
+			if ((k > RW_TG_TEX_MAX || sum > RW_TG_TEX_MAX_BYTES || now - c->parked > RW_TG_AGE_NS) && rw_tg_safe(c->mark)) {
+				*pp = c->next;
+				rw_tg_tex_count--;
+				rw_tg_tex_bytes -= c->bytes;
+				sum -= c->bytes;
+				k--;
+				c->next = drop;
+				drop = c;
+				continue;
+			}
+			pp = &c->next;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_tex_lock);
+	__sync_add_and_fetch(&rw_tg_n.tex_park, 1);
+	while (drop != NULL) {
+		struct rw_tg_ptex *n = drop->next;
+
+		mesa.texture_destroy(drop->t);
+		free(drop);
+		drop = n;
+		__sync_add_and_fetch(&rw_tg_n.tex_drop, 1);
+	}
+	return YES;
+}
+
+/* ---- the converted-thumbnail cache: (surface, shape) -> its RGB texture and planes import, with the seed/probe they hold ---- */
+#define RW_TG_THUMBS 24
+#define RW_TG_THUMB_MAX_BYTES (32u << 20)
+struct rw_tg_thumb {
+	void *surface;                  /* retained by the cache */
+	unsigned plane;
+	struct rwa_texture_shape shape; /* as asked (format 500) */
+	struct rwa_texture *own, *src, *pad;
+	BOOL padded, exact, copiedOnce;
+	uint32_t seed, probe;
+	size_t bytes;
+	uint64_t mark, parked;
+	struct rw_tg_thumb *next;
+};
+static struct rw_tg_thumb *rw_tg_thumbs;
+static pthread_mutex_t rw_tg_thumb_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+rw_tg_thumb_free(struct rw_tg_thumb *e)
+{
+	if (e->src != NULL) {
+		mesa.texture_destroy(e->src);
+	}
+	if (e->pad != NULL) {
+		mesa.texture_destroy(e->pad);
+	}
+	if (e->own != NULL) {
+		mesa.texture_destroy(e->own);
+	}
+	if (e->surface != NULL) {
+		CFRelease(e->surface);
+	}
+	free(e);
+}
