+/*
+ * ==== y2s91 (thumbgrid): THE PHOTOS GRID, DETERMINISTIC AND VERIFIED, AND ITS PER-FRAME COSTS ====
+ * Everything here is rw_tg_*; the existing code calls it at a handful of marked places ("y2s91"). Switches, read once per process
+ * from /var/db/nord2-metal/ (a file that exists turns the feature OFF):
+ *   no-thumbgrid             all of this off: thumbfix5 (y2s83) behaviour, the library's old paths
+ *   no-thumbgrid-exact       odd sizes through the 376x668 picture + copy again (y2s63/y2s73) instead of one exact pass
+ *   no-thumbgrid-live        MobileSlideShow keeps the y2s83 freeze rule even with a real kernel use count
+ *   no-thumbgrid-pending     no "write in flight" deferral (keep the last good conversion while this process's GPU writes the surface)
+ *   no-thumbgrid-rttouch     a render pass that writes a YCbCr surface's plane in place does not move the seed at completion
+ *   no-thumbgrid-check       no CPU-reference check of converted thumbnails
+ *   no-thumbgrid-bufpool / -texpool / -thumbcache / -async   the pools / the converted-thumbnail cache / deferred dispatches
+ *   no-thumbgrid-ubo         (read by the library) every padded constant-buffer copy zeroes its whole tail again
+ *   no-thumbgrid-log         no 'NORD2 PERF PHOTOS TG' lines (the CHECK line stays)
+ * and, to widen the scope beyond MobileSlideShow (off by default): thumbgrid-pools-all, thumbgrid-async-all, thumbgrid-check-all;
+ * rttouch is on everywhere except mediaserverd, cameracaptured and Camera (thumbgrid-rttouch-all: there too).
+ * Merge note (y2s90-final): with y2s84 (usecount) in the same file, define RW_TG_HAVE_USECOUNT before this block: the texture holds
+ * are then y2s84's (every IOSurface texture) and rw_tg_use_* only reads its kernel state.
+ */
+#include "rw_thumbgrid_pure.h"
+
+static struct {
+	pthread_once_t once;
+	int master, exact, live, pending, rttouch, check, bufpool, texpool, thumbcache, async, log;
+	int photos, pools_all, async_all, check_all;
+	int (*convert_exact)(struct rwa_texture *, struct rwa_texture *, int, int, char *, size_t);
+	int (*dispatch_deferred)(struct rwa_compute *, const struct rwa_bindings *, const struct rwa_buffer_bind *, unsigned,
+				 const unsigned[3], const unsigned[3], char *, size_t);
+	size_t (*buffer_recycle)(struct rwa_buffer *);
+	int (*texture_recycle)(struct rwa_texture *);
+	void (*ubo_stats)(uint64_t *, uint64_t *);
+} rw_tg = { .once = PTHREAD_ONCE_INIT };
+
+static struct {
+	volatile long conv_live, conv_skip, conv_deferred, conv_exact, conv_padded, conv_gpu, conv_cpu;
+	volatile long thumb_hit, thumb_miss, thumb_park, thumb_evict;
+	volatile long buf_hit, buf_miss, buf_park, buf_bgzero, buf_drop, buf_nozero;
+	volatile long tex_hit, tex_miss, tex_park, tex_drop;
+	volatile long async_n, async_flush, rt_touch, pending_defer, pending_max;
+	volatile long check_n, check_mismatch, check_gross, check_stale, check_raced, check_edge, check_cpu, check_fail;
+	volatile long check_maxdiff;
+} rw_tg_n;
+
+static int
+rw_tg_off(const char *name)
+{
+	char path[128];
+
+	snprintf(path, sizeof(path), "/var/db/nord2-metal/no-thumbgrid-%s", name);
+	return access(path, F_OK) == 0;
+}
+
+static void
+rw_tg_load(void)
+{
+	rw_tg.master = access("/var/db/nord2-metal/no-thumbgrid", F_OK) != 0;
+	rw_tg.photos = rw_is_photos_proc();
+	rw_tg.pools_all = access("/var/db/nord2-metal/thumbgrid-pools-all", F_OK) == 0;
+	rw_tg.async_all = access("/var/db/nord2-metal/thumbgrid-async-all", F_OK) == 0;
+	rw_tg.check_all = access("/var/db/nord2-metal/thumbgrid-check-all", F_OK) == 0;
+	if (mesa.handle != NULL) {
+		*(void **)&rw_tg.convert_exact = dlsym(mesa.handle, "rwa_texture_convert_ycbcr_exact");
+		*(void **)&rw_tg.dispatch_deferred = dlsym(mesa.handle, "rwa_dispatch_buffers_deferred");
+		*(void **)&rw_tg.buffer_recycle = dlsym(mesa.handle, "rwa_buffer_recycle");
+		*(void **)&rw_tg.texture_recycle = dlsym(mesa.handle, "rwa_texture_recycle");
+		*(void **)&rw_tg.ubo_stats = dlsym(mesa.handle, "rwa_tg_ubo_stats");
+	}
+	int m = rw_tg.master;
+	int scope_pools = rw_tg.photos || rw_tg.pools_all;
+
+	rw_tg.exact = m && !rw_tg_off("exact") && rw_tg.convert_exact != NULL;
+	rw_tg.live = m && !rw_tg_off("live") && rw_tg.photos;
+	rw_tg.pending = m && !rw_tg_off("pending");
+	/* not where the camera bring-up renders into YCbCr planes every frame (unless thumbgrid-rttouch-all) */
+	rw_tg.rttouch = m && !rw_tg_off("rttouch") && (access("/var/db/nord2-metal/thumbgrid-rttouch-all", F_OK) == 0 ||
+	    (strcmp(getprogname(), "mediaserverd") != 0 && strcmp(getprogname(), "cameracaptured") != 0 && strcmp(getprogname(), "Camera") != 0));
+	rw_tg.check = m && !rw_tg_off("check") && (rw_tg.photos || rw_tg.check_all) && mesa.texture_read != NULL;
+	rw_tg.bufpool = m && !rw_tg_off("bufpool") && scope_pools && rw_tg.buffer_recycle != NULL;
+	rw_tg.texpool = m && !rw_tg_off("texpool") && scope_pools && rw_tg.texture_recycle != NULL;
+	rw_tg.thumbcache = m && !rw_tg_off("thumbcache") && rw_tg.photos;
+	rw_tg.async = m && !rw_tg_off("async") && (rw_tg.photos || rw_tg.async_all) && rw_tg.dispatch_deferred != NULL;
+	rw_tg.log = m && !rw_tg_off("log");
+	if (rw_tg.photos || rw_tg.pools_all || rw_tg.async_all || rw_tg.check_all) {
+		m2m_log('I', "TG", "NORD2 PERF PHOTOS TG %s: thumbgrid %s: exact %d (library call %s), live %d, pending %d, rttouch %d, check %d, "
+		    "bufpool %d, texpool %d, thumbcache %d, async %d (library call %s), log %d\n", getprogname(), m ? "on" : "OFF (no-thumbgrid)",
+		    rw_tg.exact, rw_tg.convert_exact != NULL ? "found" : "missing", rw_tg.live, rw_tg.pending, rw_tg.rttouch, rw_tg.check,
+		    rw_tg.bufpool, rw_tg.texpool, rw_tg.thumbcache, rw_tg.async, rw_tg.dispatch_deferred != NULL ? "found" : "missing", rw_tg.log);
+	}
+}
+
+static inline void
+rw_tg_init(void)
+{
+	pthread_once(&rw_tg.once, rw_tg_load);
+}
+
+/* ---- the IOSurface use count of converted textures ---- */
+#ifndef RW_TG_HAVE_USECOUNT
+/* (standalone, over thumbfix5) a converted YCbCr texture in MobileSlideShow holds its surface's use count while it exists, as y2s84
+ * does for every IOSurface texture; the first hold probes whether the kernel counts (0398) */
+static struct {
+	pthread_once_t once;
+	void (*inc)(void *), (*dec)(void *);
+	unsigned char (*in_use)(void *);
+	volatile int kernel;
+	volatile long live, taken;
+} rw_tg_use = { .once = PTHREAD_ONCE_INIT, .kernel = -1 };
+
+static void
+rw_tg_use_load(void)
+{
+	*(void **)&rw_tg_use.inc = dlsym(RTLD_DEFAULT, "IOSurfaceIncrementUseCount");
+	*(void **)&rw_tg_use.dec = dlsym(RTLD_DEFAULT, "IOSurfaceDecrementUseCount");
+	*(void **)&rw_tg_use.in_use = dlsym(RTLD_DEFAULT, "IOSurfaceIsInUse");
+}
+
+static int
+rw_tg_use_kernel(void)
+{
+	return rw_tg_use.kernel;
+}
+
+static BOOL
+rw_tg_use_take(void *surface)
+{
+	pthread_once(&rw_tg_use.once, rw_tg_use_load);
+	if (surface == NULL || rw_tg_use.inc == NULL || rw_tg_use.dec == NULL) {
+		return NO;
+	}
+	rw_tg_use.inc(surface);
+	if (rw_tg_use.kernel < 0 && rw_tg_use.in_use != NULL) {
+		int k = rw_tg_use.in_use(surface) ? 1 : 0;
+
+		if (__sync_bool_compare_and_swap(&rw_tg_use.kernel, -1, k)) {
+			m2m_log('I', "TG", "NORD2 PERF PHOTOS TG %s: kernel use count %s (surface %u): follow-live %s\n", getprogname(),
+			    k ? "REAL (0398)" : "a no-op (no 0398)", rwd_surface_id(surface), k ? "possible" : "off, the freeze rule stays");
+		}
+	}
+	__sync_add_and_fetch(&rw_tg_use.live, 1);
+	__sync_add_and_fetch(&rw_tg_use.taken, 1);
+	return YES;
+}
+
+static void
+rw_tg_use_give(void *surface)
+{
+	if (surface != NULL && rw_tg_use.dec != NULL) {
+		rw_tg_use.dec(surface);
+		__sync_sub_and_fetch(&rw_tg_use.live, 1);
+	}
+}
+#else
+/* (merged with y2s84) every IOSurface texture already holds the count: only its probe is read */
+static int rw_tg_use_kernel(void) { return rw_use_kernel_state(); }
+static BOOL rw_tg_use_take(void *surface) { (void)surface; return NO; }
+static void rw_tg_use_give(void *surface) { (void)surface; }
+#endif
+
+/* follow-live (instead of the y2s83 freeze): MobileSlideShow, switch on, and the kernel count real with the texture holding it */
+static BOOL
+rw_tg_live_active(void)
+{
+	rw_tg_init();
+	return rw_tg.live && rw_tg_use_kernel() == 1;
+}
+
+/* ---- surfaces this process's GPU is writing (committed, not completed) ---- */
+#define RW_TG_PENDING 64
+static struct { uint32_t sid; int n; } rw_tg_pend[RW_TG_PENDING];
+static pthread_mutex_t rw_tg_pend_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+rw_tg_pending_add(void *surface)
+{
+	uint32_t sid = rwd_surface_id(surface);
+	long used = 0;
+
+	rw_tg_init();
+	if (!rw_tg.pending || sid == 0) {
+		return;
+	}
+	pthread_mutex_lock(&rw_tg_pend_lock);
+	int free_slot = -1, i;
+
+	for (i = 0; i < RW_TG_PENDING; i++) {
+		if (rw_tg_pend[i].n > 0 && rw_tg_pend[i].sid == sid) {
+			rw_tg_pend[i].n++;
+			break;
+		}
+		if (rw_tg_pend[i].n == 0 && free_slot < 0) {
+			free_slot = i;
+		}
+	}
+	if (i == RW_TG_PENDING && free_slot >= 0) {
+		rw_tg_pend[free_slot].sid = sid;
+		rw_tg_pend[free_slot].n = 1;
+	}
+	for (i = 0; i < RW_TG_PENDING; i++) {
+		used += rw_tg_pend[i].n > 0;
+	}
+	pthread_mutex_unlock(&rw_tg_pend_lock);
+	if (used > rw_tg_n.pending_max) {
+		rw_tg_n.pending_max = used;
+	}
+}
+
+static void
+rw_tg_pending_del(void *surface)
+{
+	uint32_t sid = rwd_surface_id(surface);
+
+	if (!rw_tg.pending || sid == 0) {
+		return;
+	}
+	pthread_mutex_lock(&rw_tg_pend_lock);
+	for (int i = 0; i < RW_TG_PENDING; i++) {
+		if (rw_tg_pend[i].n > 0 && rw_tg_pend[i].sid == sid) {
+			rw_tg_pend[i].n--;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_pend_lock);
+}
+
+static BOOL
+rw_tg_pending_has(void *surface)
+{
+	uint32_t sid = rwd_surface_id(surface);
+	BOOL has = NO;
+
+	if (!rw_tg.pending || sid == 0) {
+		return NO;
+	}
+	pthread_mutex_lock(&rw_tg_pend_lock);
+	for (int i = 0; i < RW_TG_PENDING && !has; i++) {
+		has = rw_tg_pend[i].n > 0 && rw_tg_pend[i].sid == sid;
+	}
+	pthread_mutex_unlock(&rw_tg_pend_lock);
+	return has;
+}
+
+/* the textures of a command buffer's write-back/touch list: each was rw_tg_pending_add'ed when it was put on the list */
+static void
+rw_tg_pending_release(NSArray *list)
+{
+	for (id t in list) {
+		rw_tg_pending_del((void *)[t iosurface]);
+	}
+}
+
+/* ---- which command buffers are still on the GPU (pool quarantine) ---- */
+static struct rw_tg_seq rw_tg_q;
+static pthread_once_t rw_tg_q_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t rw_tg_q_lock = PTHREAD_MUTEX_INITIALIZER;
+#define RW_TG_FENCES 512
+static struct { void *fence; uint64_t seq; } rw_tg_fences[RW_TG_FENCES];
+
+static void
+rw_tg_q_init(void)
+{
+	rw_tg_seq_init(&rw_tg_q);
+}
+
+/* at the submit of `fence` (NULL: nothing was queued, nothing to wait for) */
+static void
+rw_tg_seq_bind(void *fence)
+{
+	pthread_once(&rw_tg_q_once, rw_tg_q_init);
+	rw_tg_init();
+	if (fence == NULL || !(rw_tg.bufpool || rw_tg.texpool || rw_tg.thumbcache)) {
+		return;                 /* (nothing pooled in this process: nobody asks) */
+	}
+	pthread_mutex_lock(&rw_tg_q_lock);
+	uint64_t s = rw_tg_seq_submit(&rw_tg_q);
+	int i;
+
+	for (i = 0; i < RW_TG_FENCES && rw_tg_fences[i].fence != NULL; i++) {
+	}
+	if (i < RW_TG_FENCES) {
+		rw_tg_fences[i].fence = fence;
+		rw_tg_fences[i].seq = s;
+	} else {
+		/* no slot to find the number again at completion: it is counted as back now and the pools stop for good (512 command
+		 * buffers on the GPU at once does not happen; this only keeps the quarantine honest if it ever does) */
+		rw_tg_seq_done(&rw_tg_q, s);
+		rw_tg.bufpool = rw_tg.texpool = rw_tg.thumbcache = 0;
+	}
+	pthread_mutex_unlock(&rw_tg_q_lock);
+}
+
+/* on the fence queue, BEFORE the fence is waited for and let go (its address is unique until then) */
+static uint64_t
+rw_tg_seq_take(void *fence)
+{
+	uint64_t s = UINT64_MAX;
+
+	if (fence == NULL) {
+		return s;
+	}
+	pthread_once(&rw_tg_q_once, rw_tg_q_init);
+	pthread_mutex_lock(&rw_tg_q_lock);
+	for (int i = 0; i < RW_TG_FENCES; i++) {
+		if (rw_tg_fences[i].fence == fence) {
+			s = rw_tg_fences[i].seq;
+			rw_tg_fences[i].fence = NULL;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_q_lock);
+	return s;
+}
+
+/* after the fence came back (or failed: the GPU is not running it any more either way) */
+static void
+rw_tg_seq_back(uint64_t s)
+{
+	if (s == UINT64_MAX) {
+		return;
+	}
+	pthread_mutex_lock(&rw_tg_q_lock);
+	rw_tg_seq_done(&rw_tg_q, s);
+	pthread_mutex_unlock(&rw_tg_q_lock);
+}
+
+static uint64_t
+rw_tg_mark(void)
+{
+	pthread_once(&rw_tg_q_once, rw_tg_q_init);
+	pthread_mutex_lock(&rw_tg_q_lock);
+	uint64_t m = rw_tg_seq_mark(&rw_tg_q);
+	pthread_mutex_unlock(&rw_tg_q_lock);
+	return m;
+}
+
+static BOOL
+rw_tg_safe(uint64_t mark)
+{
+	pthread_mutex_lock(&rw_tg_q_lock);
+	BOOL ok = rw_tg_seq_safe(&rw_tg_q, mark);
+	pthread_mutex_unlock(&rw_tg_q_lock);
+	return ok;
+}
+
+/* ---- the buffer pool ---- */
+#define RW_TG_BUF_MAX_BYTES (48u << 20)
+#define RW_TG_BUF_MAX_COUNT 384
+#define RW_TG_BUF_BIG (256u << 10)            /* from here zeroed on a background queue after the quarantine, before reuse */
+#define RW_TG_AGE_NS 3000000000ULL
+struct rw_tg_pbuf {
+	struct rwa_buffer *b;
+	size_t cap;
+	uint64_t mark, parked;
+	int clean, busy;
+	struct rw_tg_pbuf *next;
+};
+static struct rw_tg_pbuf *rw_tg_bufs;
+static size_t rw_tg_buf_bytes;
+static unsigned rw_tg_buf_count;
+static pthread_mutex_t rw_tg_buf_lock = PTHREAD_MUTEX_INITIALIZER;
+static __thread int rw_tg_nozero_next;         /* -newBufferWithBytes: overwrites what it asks for */
+
+/* the capacity a new buffer of `length` is made with while the pool is on (so it can be handed to the next request of its class) */
+static size_t
+rw_tg_buf_capacity(size_t length)
+{
+	rw_tg_init();
+	return rw_tg.bufpool ? rw_tg_class(length) : length;
+}
+
+static struct rwa_buffer *
+rw_tg_buf_take(size_t length, size_t *cap_out)
+{
+	int nozero = rw_tg_nozero_next;
+
+	rw_tg_nozero_next = 0;
+	rw_tg_init();
+	if (!rw_tg.bufpool || length == 0) {
+		return NULL;
+	}
+	size_t cls = rw_tg_class(length);
+	struct rw_tg_pbuf *e = NULL, **pp;
+
+	pthread_once(&rw_tg_q_once, rw_tg_q_init);
+	pthread_mutex_lock(&rw_tg_buf_lock);
+	for (pp = &rw_tg_bufs; *pp != NULL; pp = &(*pp)->next) {
+		struct rw_tg_pbuf *c = *pp;
+
+		if (!c->busy && c->cap >= cls && c->cap <= cls + cls / 8 && (c->cap < RW_TG_BUF_BIG ? rw_tg_safe(c->mark) : c->clean)) {
+			*pp = c->next;
+			e = c;
+			rw_tg_buf_bytes -= c->cap;
+			rw_tg_buf_count--;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_buf_lock);
+	if (e == NULL) {
+		__sync_add_and_fetch(&rw_tg_n.buf_miss, 1);
+		return NULL;
+	}
+	struct rwa_buffer *b = e->b;
+	uint8_t *map = mesa.buffer_map(b);
+
+	if (!e->clean && map != NULL) {
+		/* Metal's new buffers read zero; -newBufferWithBytes: writes [0, length) itself, the rest (read by padded constant
+		 * buffers, see air_metal.c) is zeroed all the same */
+		size_t from = nozero ? length : 0;
+
+		memset(map + from, 0, e->cap - from);
+		if (nozero) {
+			__sync_add_and_fetch(&rw_tg_n.buf_nozero, 1);
+		}
+	}
+	rw_tg.buffer_recycle(b);
+	*cap_out = e->cap;
+	free(e);
+	__sync_add_and_fetch(&rw_tg_n.buf_hit, 1);
+	return b;
+}
+
+static void
+rw_tg_buf_sweep(void)
+{
+	struct rw_tg_pbuf *drop = NULL, **pp;
+	uint64_t now = rw_now_ns();
+
+	pthread_mutex_lock(&rw_tg_buf_lock);
+	/* the list is newest first: past the budget or too old, from the back */
+	unsigned k = 0;
+	size_t bytes = 0;
+
+	for (pp = &rw_tg_bufs; *pp != NULL;) {
+		struct rw_tg_pbuf *c = *pp;
+
+		k++;
+		bytes += c->cap;
+		if (!c->busy && (now - c->parked > RW_TG_AGE_NS || bytes > RW_TG_BUF_MAX_BYTES || k > RW_TG_BUF_MAX_COUNT) &&
+		    rw_tg_safe(c->mark)) {
+			*pp = c->next;
+			rw_tg_buf_bytes -= c->cap;
+			rw_tg_buf_count--;
+			bytes -= c->cap;
+			k--;
+			c->next = drop;
+			drop = c;
+			continue;
+		}
+		pp = &c->next;
+	}
+	pthread_mutex_unlock(&rw_tg_buf_lock);
+	while (drop != NULL) {
+		struct rw_tg_pbuf *n = drop->next;
+
+		mesa.buffer_destroy(drop->b);
+		free(drop);
+		drop = n;
+		__sync_add_and_fetch(&rw_tg_n.buf_drop, 1);
+	}
+}
+
+static dispatch_queue_t
+rw_tg_janitor(void)
+{
+	static dispatch_once_t once;
+	static dispatch_queue_t q;
+
+	dispatch_once(&once, ^{
+		q = dispatch_queue_create("com.redwood.metal.thumbgrid", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+		    QOS_CLASS_UTILITY, 0));
+	});
+	return q;
+}
