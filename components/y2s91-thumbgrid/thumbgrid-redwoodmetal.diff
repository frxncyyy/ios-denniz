+		__sync_add_and_fetch(&rw_tg_n.check_fail, 1);
+		RW_AGAIN('W', "TG", "NORD2 PERF PHOTOS CHECK: read-back failed: %s\n", why);
+		return;
+	}
+	if (_tgGen != gen) {
+		__sync_add_and_fetch(&rw_tg_n.check_raced, 1);
+		return;
+	}
