+/* which conversions are checked: the first 16 of the process, then 1 in 64 */
+static BOOL
+rw_tg_check_due(unsigned long *k_out)
+{
+	static volatile unsigned long n;
+	unsigned long k = __sync_add_and_fetch(&n, 1);
+
+	*k_out = k;
+	return k <= 16 || k % 64 == 0;
+}
