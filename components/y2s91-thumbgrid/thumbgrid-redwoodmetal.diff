+/* a converted texture for `surface` from the cache (its RGB texture, planes import and state), or nil */
+static RedwoodMetalTexture *
+rw_tg_thumb_take(RedwoodMetalDevice *device, void *surface, NSUInteger plane, const struct rwa_texture_shape *shape)
+{
+	rw_tg_init();
+	if (!rw_tg.thumbcache || !rw_tg_live_active() || surface == NULL) {
+		return nil;
+	}
+	struct rw_tg_thumb *e = NULL, **pp;
+
+	pthread_mutex_lock(&rw_tg_thumb_lock);
+	for (pp = &rw_tg_thumbs; *pp != NULL; pp = &(*pp)->next) {
+		struct rw_tg_thumb *c = *pp;
+
+		if (c->surface == surface && c->plane == plane && rw_tg_same_shape(&c->shape, shape) && rw_tg_safe(c->mark)) {
+			*pp = c->next;
+			e = c;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_thumb_lock);
+	if (e == NULL) {
+		__sync_add_and_fetch(&rw_tg_n.thumb_miss, 1);
+		return nil;
+	}
+	RedwoodMetalTexture *t = [[RedwoodMetalTexture alloc] initWithRedwoodDevice:device texture:e->own shape:shape];
+
+	e->own = NULL;
+	if (t == nil) {
+		rw_tg_thumb_free(e);
+		return nil;
+	}
+	[t redwoodSetIOSurface:surface plane:plane];
+	[t redwoodSetYCbCrSource:e->src];
+	[t redwoodSetPadded:e->pad];
+	e->src = NULL;
+	e->pad = NULL;
+	[t redwoodTGSetExact:e->exact];
+	[t redwoodTGHold];
+	[t redwoodTGAdoptSeed:e->seed probe:e->probe once:e->copiedOnce];
+	rw_tg_thumb_free(e);            /* (only the cache's surface reference is left in it) */
+	__sync_add_and_fetch(&rw_tg_n.thumb_hit, 1);
+	/* converted again here only if the surface moved since (live rule) */
+	if (![t redwoodRefreshConverted]) {
+		[t release];
+		return nil;
+	}
+	return t;
+}
+
+static void
+rw_tg_thumb_put(struct rw_tg_thumb *e)
+{
+	struct rw_tg_thumb *drop = NULL;
+
+	pthread_mutex_lock(&rw_tg_thumb_lock);
+	e->next = rw_tg_thumbs;
+	rw_tg_thumbs = e;
+	{
+		struct rw_tg_thumb **pp = &rw_tg_thumbs;
+		unsigned k = 0;
+		size_t sum = 0;
+		uint64_t now = rw_now_ns();
+
+		while (*pp != NULL) {
+			struct rw_tg_thumb *c = *pp;
+
+			k++;
+			sum += c->bytes;
+			if ((k > RW_TG_THUMBS || sum > RW_TG_THUMB_MAX_BYTES || now - c->parked > RW_TG_AGE_NS) && rw_tg_safe(c->mark)) {
+				*pp = c->next;
+				sum -= c->bytes;
+				k--;
+				c->next = drop;
+				drop = c;
+				continue;
+			}
+			pp = &c->next;
+		}
+	}
+	pthread_mutex_unlock(&rw_tg_thumb_lock);
+	__sync_add_and_fetch(&rw_tg_n.thumb_park, 1);
+	while (drop != NULL) {
+		struct rw_tg_thumb *n = drop->next;
+
+		rw_tg_thumb_free(drop);
+		drop = n;
+		__sync_add_and_fetch(&rw_tg_n.thumb_evict, 1);
+	}
+}
