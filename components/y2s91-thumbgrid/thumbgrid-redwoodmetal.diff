+		if (c.gross) {
+			__sync_add_and_fetch(&rw_tg_n.check_gross, 1);
+		}
+		if (m <= 32 || m % 16 == 0) {
+			m2m_log('W', "TG", "NORD2 PERF PHOTOS CHECK MISMATCH n=%ld: surface %u (%ux%u '%c%c%c%c' %s) block %u,%u %ux%u%s: %u px over 10, "
+			    "%u gross, max %u, mean %.2f; gpu %02x%02x%02x ref %02x%02x%02x at its first pixel; %s conversion gen %llu\n", m,
+			    rwd_surface_id(_iosurface), pl.width, pl.height, (char)(pl.fourcc >> 24), (char)(pl.fourcc >> 16), (char)(pl.fourcc >> 8),
+			    (char)pl.fourcc, matrix == 1 ? "709" : matrix == 2 ? "2020" : "601", bx, by, bw, bh, edge ? " (edge)" : "", c.over, c.gross,
+			    c.maxdiff, c.sumdiff / (3.0 * bw * bh), gpu[2], gpu[1], gpu[0], ref[2], ref[1], ref[0],
+			    _tgExact ? "exact" : _padded ? "padded+copy" : "direct", (unsigned long long)gen);
+		}
+	} else if (k <= 4) {
+		m2m_log('I', "TG", "NORD2 PERF PHOTOS CHECK ok n=%lu: surface %u (%ux%u) block %u,%u%s max %u (%s)\n", k, rwd_surface_id(_iosurface),
+		    pl.width, pl.height, bx, by, edge ? " (edge)" : "", c.maxdiff, _tgExact ? "exact" : _padded ? "padded+copy" : "direct");
+	}
+}
