+		return;
+	}
+	if (pthread_mutex_trylock(&lk) != 0) {
+		return;
+	}
+	if (now - last < 5000000000ULL) {
+		pthread_mutex_unlock(&lk);
+		return;
+	}
+	last = now;
+	pthread_mutex_unlock(&lk);
+	uint64_t zeroed = 0, saved = 0;
+
+	if (rw_tg.ubo_stats != NULL) {
+		rw_tg.ubo_stats(&zeroed, &saved);
+	}
+	if (rw_tg.log) {
+		m2m_log('I', "TG", "NORD2 PERF PHOTOS TG %s: live %d | conv gpu %ld (exact %ld padded %ld) cpu %ld, reconverted-live %ld skipped %ld "
+		    "deferred-pending %ld | thumbcache hit %ld miss %ld park %ld evict %ld | buf hit %ld miss %ld park %ld bgzero %ld nozero %ld drop %ld "
+		    "(%u parked, %zu KiB) | tex hit %ld miss %ld park %ld drop %ld (%u parked) | async dispatch %ld (flush before CPU blit %ld) | "
+		    "rttouch %ld | pending max %ld | ubo tail zeroed %llu KiB saved %llu KiB (since load)\n", getprogname(), rw_tg_live_active(),
+		    rw_tg_n.conv_gpu, rw_tg_n.conv_exact, rw_tg_n.conv_padded, rw_tg_n.conv_cpu, rw_tg_n.conv_live, rw_tg_n.conv_skip,
+		    rw_tg_n.conv_deferred, rw_tg_n.thumb_hit, rw_tg_n.thumb_miss, rw_tg_n.thumb_park, rw_tg_n.thumb_evict, rw_tg_n.buf_hit,
+		    rw_tg_n.buf_miss, rw_tg_n.buf_park, rw_tg_n.buf_bgzero, rw_tg_n.buf_nozero, rw_tg_n.buf_drop, rw_tg_buf_count,
+		    rw_tg_buf_bytes >> 10, rw_tg_n.tex_hit, rw_tg_n.tex_miss, rw_tg_n.tex_park, rw_tg_n.tex_drop, rw_tg_tex_count,
+		    rw_tg_n.async_n, rw_tg_n.async_flush, rw_tg_n.rt_touch, rw_tg_n.pending_max, (unsigned long long)(zeroed >> 10),
+		    (unsigned long long)(saved >> 10));
+	}
+	if (rw_tg.check) {
+		m2m_log('I', "TG", "NORD2 PERF PHOTOS CHECK: mismatches=%ld checks=%ld gross=%ld edge=%ld stale=%ld raced=%ld failed=%ld cpu-unchecked=%ld "
+		    "maxdiff=%ld proc=%s\n", rw_tg_n.check_mismatch, rw_tg_n.check_n, rw_tg_n.check_gross, rw_tg_n.check_edge, rw_tg_n.check_stale,
+		    rw_tg_n.check_raced, rw_tg_n.check_fail, rw_tg_n.check_cpu, rw_tg_n.check_maxdiff, getprogname());
+	}
+}
