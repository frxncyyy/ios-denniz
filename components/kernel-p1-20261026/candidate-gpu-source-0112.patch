+static bool ctx_jobs_pending_upto(struct n2c_core *c, unsigned idx, uint64_t seq)
+{
+        for (unsigned i = 0; i < N2C_MAX_JOBS; i++) {
+                const struct n2c_job *j = &c->jobs[i];
