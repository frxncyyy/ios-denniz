+/* Host test for the SwapEnd surface-retention bookkeeping (SweetFramebuffer). */
+#include "sweet_fb_pending_surfaces.h"
+#include <assert.h>
+#include <stdio.h>
+static int live[16], next_fail_id;
+static void *retain(uint32_t id) { if (id == (uint32_t)next_fail_id) return 0; live[id]++; return (void *)(uintptr_t)id; }
+static void release(void *o) { live[(uintptr_t)o]--; assert(live[(uintptr_t)o] >= 0); }
+static int total(void) { int t = 0; for (int i = 0; i < 16; i++) t += live[i]; return t; }
+int main(void) {
+	sweet_fb_swap_lifecycle l; sweet_fb_pending_surfaces in, old, taken;
+	uint32_t ids[4] = {1, 2, 3, 4};
+	sweet_fb_swap_lifecycle_init(&l);
+	/* mask limits what is retained; id 0 never retained */
+	sweet_fb_pending_surfaces_capture(&in, ids, 0x5, retain);
+	assert(live[1] == 1 && live[2] == 0 && live[3] == 1 && live[4] == 0);
+	assert(sweet_fb_swap_lifecycle_queue(&l, &in, &old) && !sweet_fb_pending_surfaces_any(&in));
+	assert(!sweet_fb_pending_surfaces_any(&old));
+	/* newer swap supersedes: old refs come back for release outside the lock */
+	uint32_t ids2[4] = {5, 0, 3, 0};
+	sweet_fb_pending_surfaces_capture(&in, ids2, 0xf, retain);
+	assert(sweet_fb_swap_lifecycle_queue(&l, &in, &old));
+	sweet_fb_pending_surfaces_release(&old, release);
+	assert(live[1] == 0 && live[3] == 1 && live[5] == 1 && total() == 2 + 0 + 0 - 0 + 0 && total() == 2);
+	/* retain failure (surface already gone) leaves NULL, no leak */
+	next_fail_id = 7; uint32_t ids3[4] = {7, 0, 0, 0};
+	sweet_fb_pending_surfaces_capture(&in, ids3, 1, retain);
+	assert(!sweet_fb_pending_surfaces_any(&in)); next_fail_id = -1;
+	/* present takes ownership; failed present requeues when nothing newer */
+	assert(sweet_fb_swap_lifecycle_take(&l, &taken) && !sweet_fb_pending_surfaces_any(&l.pending));
+	assert(sweet_fb_swap_lifecycle_requeue(&l, false, &taken) && !sweet_fb_pending_surfaces_any(&taken));
+	assert(total() == 2);
+	/* ...but a newer pending record wins; stale refs stay with the caller */
+	assert(sweet_fb_swap_lifecycle_take(&l, &taken));
+	assert(!sweet_fb_swap_lifecycle_requeue(&l, true, &taken) && sweet_fb_pending_surfaces_any(&taken));
+	sweet_fb_pending_surfaces_release(&taken, release); assert(total() == 0);
+	/* stop releases queued refs; later swaps are refused without leaking */
+	sweet_fb_pending_surfaces_capture(&in, ids, 0xf, retain);
+	assert(sweet_fb_swap_lifecycle_queue(&l, &in, &old)); assert(total() == 4);
+	sweet_fb_swap_lifecycle_stop(&l, &taken); sweet_fb_pending_surfaces_release(&taken, release);
+	assert(total() == 0);
+	sweet_fb_pending_surfaces_capture(&in, ids, 0xf, retain);
+	assert(!sweet_fb_swap_lifecycle_queue(&l, &in, &old)); sweet_fb_pending_surfaces_release(&old, release);
+	assert(total() == 0 && !sweet_fb_swap_lifecycle_take(&l, &taken));
+	assert(!sweet_fb_swap_lifecycle_requeue(&l, false, &taken));
+	puts("sweet_fb_pending_surfaces: lifecycle PASS");
+	return 0;
+}
