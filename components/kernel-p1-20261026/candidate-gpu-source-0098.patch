--- a/gpu/tests/sweet_surface_abi_test.c
+++ b/gpu/tests/sweet_surface_abi_test.c
@@ -0,0 +1,50 @@
+/* IOSurface ABI helpers (host): selector policy, plane record layout, purgeable semantics, client-memory range. */
+#include "sweet_surface_abi.h"
+#include <assert.h>
+#include <stdio.h>
+
+static uint32_t rd32(const uint8_t *p, unsigned o) { uint32_t v; memcpy(&v, p + o, 4); return v; }
+
+int main(void)
+{
+	/* (f) every known selector has an explicit answer; the unidentified ones are named, not defaulted silently */
+	assert(sweet_selector_policy(0) == SWEET_POLICY_HANDLED && sweet_selector_policy(4) == SWEET_POLICY_HANDLED &&
+	       sweet_selector_policy(13) == SWEET_POLICY_HANDLED && sweet_selector_policy(34) == SWEET_POLICY_HANDLED && sweet_selector_policy(35) == SWEET_POLICY_HANDLED);
+	assert(sweet_selector_policy(5) == SWEET_POLICY_ACCEPT && sweet_selector_policy(9) == SWEET_POLICY_ACCEPT &&
+	       sweet_selector_policy(11) == SWEET_POLICY_ACCEPT && sweet_selector_policy(12) == SWEET_POLICY_ACCEPT && sweet_selector_policy(27) == SWEET_POLICY_ACCEPT);
+	assert(sweet_selector_policy(10) == SWEET_POLICY_NOT_FOUND && sweet_selector_policy(20) == SWEET_POLICY_PURGEABLE);
+	assert(sweet_selector_policy(6) == SWEET_POLICY_UNSUPPORTED && sweet_selector_policy(7) == SWEET_POLICY_UNSUPPORTED);
+	const uint32_t unknown[] = {1, 2, 3, 8, 14, 21, 26, 28, 33, 36, 40, 41, 43, 44, 200};
+	for (unsigned i = 0; i < sizeof(unknown) / sizeof(unknown[0]); i++) assert(sweet_selector_policy(unknown[i]) == SWEET_POLICY_UNKNOWN);
+	/* the selectors seen in c6k: 5, 9, 20, 27 are named; 40, 41, 43 stay tolerated-unknown (never an error) */
+	assert(sweet_selector_policy(40) == SWEET_POLICY_UNKNOWN && sweet_selector_policy(41) == SWEET_POLICY_UNKNOWN && sweet_selector_policy(43) == SWEET_POLICY_UNKNOWN);
+
+	/* purgeable: query leaves the state, set returns the old one */
+	uint32_t st = 0;
+	assert(sweet_purgeable_update(&st, 3) == 0 && st == 0);
+	assert(sweet_purgeable_update(&st, 1) == 0 && st == 1);
+	assert(sweet_purgeable_update(&st, 3) == 1 && st == 1);
+	assert(sweet_purgeable_update(&st, 0) == 1 && st == 0);
+
+	/* (d) plane record: bytes-per-row at +0x10, +0x08 stays zero, the fields that already matched do not move */
+	struct sweet_plane_abi pl = { .width = 780, .height = 208, .bytesPerRow = 3200, .offset = 0x30000, .size = 3200 * 208, .bytesPerElement = 4, .elementWidth = 1, .elementHeight = 1 };
+	uint8_t rec[SWEET_PLANE_RECORD_BYTES + 8]; memset(rec, 0xee, sizeof(rec));
+	sweet_plane_record(rec, &pl);
+	assert(rd32(rec, 0x00) == 780 && rd32(rec, 0x04) == 208 && rd32(rec, 0x08) == 0 && rd32(rec, 0x0c) == 0x30000 &&
+	       rd32(rec, 0x10) == 3200 && rd32(rec, 0x14) == 3200u * 208);
+	assert(rec[0x18] == 4 && rec[0x19] == 0 && rec[0x1a] == 1 && rec[0x1b] == 1);
+	assert(rd32(rec, 0x54) == 0);                         /* compression type 0: getters work */
+	for (unsigned i = 0x1c; i < SWEET_PLANE_RECORD_BYTES; i++) if (i < 0x1c || i >= 0x1c) assert(rec[i] == 0);
+	assert(rec[SWEET_PLANE_RECORD_BYTES] == 0xee);         /* never writes past the record */
+
+	/* (e) client memory range */
+	assert(sweet_client_range_bytes(0x100000000ull, 0, 4096 * 64, 0, 1u << 20) == 4096u * 64);
+	assert(sweet_client_range_bytes(0x100000000ull, 128, 4096 * 64, 0, 1u << 20) == 128 + 4096u * 64);
+	assert(sweet_client_range_bytes(0x100000000ull, 0, 1000, 0x30000 + 5000, 1u << 20) == 0x30000 + 5000);          /* planes extend it */
+	assert(sweet_client_range_bytes(0, 0, 4096, 0, 1u << 20) == 0);                                                  /* no address */
+	assert(sweet_client_range_bytes(0x1000, 0, 0, 0, 1u << 20) == 0);                                                /* empty */
+	assert(sweet_client_range_bytes(0x1000, 0, 2u << 20, 0, 1u << 20) == 0);                                         /* larger than the surface */
+	assert(sweet_client_range_bytes(~0ull - 100, 0, 4096, 0, 1u << 20) == 0);                                        /* wraps */
+	puts("sweet_surface_abi_test: selector policy (every selector explicit), plane record bytes-per-row at +0x10, purgeable, client range pass");
+	return 0;
+}
