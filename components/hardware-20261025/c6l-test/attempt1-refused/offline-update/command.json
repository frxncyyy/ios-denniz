[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "$NORD2_WORK/gpu/build/vm-runtime/vmlinuz-7.2.9-arch1-1",
  "-initrd",
  "$NORD2_WORK/gpu/build/hardware-20261025/c6l-test/offline-update/metal-initrd.gz",
  "-append",
  "console=ttyS0 rdinit=/init panic=-1 loglevel=4",
  "-drive",
  "file=$NORD2_WORK/gpu/build/hardware-20261025/c6l-test/offline-update/overlay.qcow2,format=qcow2,if=virtio,cache=unsafe",
  "-virtfs",
  "local,path=$NORD2_WORK/gpu/build/hardware-20261025/c6l-test/offline-update/inputs,mount_tag=inputs,security_model=none,readonly=on"
]
