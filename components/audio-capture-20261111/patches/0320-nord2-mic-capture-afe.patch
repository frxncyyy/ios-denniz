+/* 0320: the microphone alone (recording: /dev/redwood-mic), on an AFE that is running (speaker path or silent DMA). */
+int
+nac_mic_afe_up(struct nau_hw *h)
+{
+	return nac_afe_up_mode(h, 0);
+}
