+/* 0320: drain VUL12 (mono 16-bit 48 kHz) for the recording; statistics as the call's probe keeps them. 0 if none. */
+unsigned
+nac_mic_take(struct nau_hw *h, int16_t *mono, unsigned max)
+{
+	unsigned n, i;
+	if (!nac_afe_live || nac_mode != NAC_MODE_MIC || !h || !mono) return 0;
+	nac_dl_calls++;
+	if ((nac_dl_calls & 255u) == 1u) {
+		(void)nac_rd(h, AFE_ADDA_UL_SRC_MON0, &nac_ul_mon);
+		(void)nac_rd(h, AFE_ADDA_UL_SRC_MON1, &nac_ul_mon1);
+		(void)nac_rd(h, AFE_ADDA_MTKAIF_MON0, &nac_aif_mon);
+		(void)nac_rd(h, AFE_ADDA_MTKAIF_MON1, &nac_aif_mon1);
+	}
+	n = nac_ring_take(h, AFE_VUL12_CUR, NAC_VUL_SRAM, NAC_VUL_BYTES, &nac_vul_rd, mono, max, &nac_vul_cur);
+	for (i = 0; i < n; i++) {
+		unsigned a = (unsigned)(mono[i] < 0 ? -mono[i] : mono[i]);
+		if (a > nac_mic_peak) nac_mic_peak = a;
+		if (a > 4) nac_mic_nz++;
+	}
+	nac_mic_frames += n;
+	return n;
+}
+
+/* 0320: MT6359 uplink on/off without blocking the worker: nac_up / nac_down run whole on the input thread through the
+ * async slot (waiting for a pending monitor read first). submit: 0 queued, -1 slot busy (try again next pass). */
+int
+nac_mic_pmic_submit(unsigned up)
+{
+	int err = 0;
+	if (__atomic_load_n(&nac_as.state, __ATOMIC_ACQUIRE) == AS_DONE) (void)nac_async_poll(&err);   /* a finished monitor read */
+	return up ? nac_async_submit_static(nac_up, sizeof nac_up / sizeof nac_up[0]) :
+	       nac_async_submit_static(nac_down, sizeof nac_down / sizeof nac_down[0]);
+}
+
+/* 1 = the submitted table finished (its result in *error), 0 = still running on the input thread */
+int
+nac_mic_pmic_poll(int *error)
+{
+	return nac_async_poll(error);
+}
