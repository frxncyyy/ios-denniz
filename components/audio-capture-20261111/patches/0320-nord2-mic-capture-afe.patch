+/* 0320: a whole static table (nac_up/nac_down) through the same slot, not copied: the worker never blocks on the input
+ * thread while the AFE runs (a >= 20 ms worker stall stops the speaker path with NAH_E_DEADLINE). */
+static int
+nac_async_submit_static(const struct nac_pop *ops, unsigned n)
+{
+	if (__atomic_load_n(&nac_as.state, __ATOMIC_ACQUIRE) != AS_IDLE || !n2owner_ready(&nac_owner)) return -1;
+	nac_as.j = (struct nac_job){ ops, n, 0, 0, 0, 0 };
+	__atomic_store_n(&nac_as.state, AS_QUEUED, __ATOMIC_RELEASE);
+	return 0;
+}
