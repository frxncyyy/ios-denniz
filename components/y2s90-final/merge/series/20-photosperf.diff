+/* the window's allocation and commit numbers come from rw_perf_tick's own copy of rw_perf (zeroed there) */
+static void
+rw_pp_tick(uint64_t commits, uint64_t commit_ns, uint64_t buf_made, uint64_t buf_ns, uint64_t tex_made, uint64_t tex_ns)
+{
+	uint64_t frames = __atomic_exchange_n(&rw_pp.frames, 0, __ATOMIC_RELAXED);
+	uint64_t frame_ns = __atomic_exchange_n(&rw_pp.frame_ns, 0, __ATOMIC_RELAXED);
+	uint64_t frame_max = __atomic_exchange_n(&rw_pp.frame_max, 0, __ATOMIC_RELAXED);
+	uint64_t compute_cb = __atomic_exchange_n(&rw_pp.compute_cb, 0, __ATOMIC_RELAXED);
+	uint64_t compute_ns = __atomic_exchange_n(&rw_pp.compute_ns, 0, __ATOMIC_RELAXED);
+	uint64_t dispatch_ns = __atomic_exchange_n(&rw_pp.dispatch_ns, 0, __ATOMIC_RELAXED);
+	uint64_t conv_gpu = __atomic_exchange_n(&rw_pp.conv_gpu, 0, __ATOMIC_RELAXED);
+	uint64_t conv_odd = __atomic_exchange_n(&rw_pp.conv_odd, 0, __ATOMIC_RELAXED);
+	uint64_t conv_cpu = __atomic_exchange_n(&rw_pp.conv_cpu, 0, __ATOMIC_RELAXED);
+	uint64_t conv_same = __atomic_exchange_n(&rw_pp.conv_same, 0, __ATOMIC_RELAXED);
+	uint64_t frozen_hits = __atomic_exchange_n(&rw_pp.frozen_hits, 0, __ATOMIC_RELAXED);
+	uint64_t released = __atomic_exchange_n(&rw_pp.released, 0, __ATOMIC_RELAXED);
+	uint64_t iostex = __atomic_exchange_n(&rw_pp.iostex, 0, __ATOMIC_RELAXED);
+	uint64_t iostex_ns = __atomic_exchange_n(&rw_pp.iostex_ns, 0, __ATOMIC_RELAXED);
+	uint64_t iostex_max = __atomic_exchange_n(&rw_pp.iostex_max, 0, __ATOMIC_RELAXED);
+	uint64_t probe_skips = __atomic_exchange_n(&rw_pp.probe_skips, 0, __ATOMIC_RELAXED);
+	uint64_t conv = conv_gpu + conv_odd + conv_cpu;
+
+	if (!rw_pp_logs() || (commits == 0 && frames == 0 && conv == 0 && iostex == 0)) {
+		return;
+	}
+	const char *n = getprogname();
+	int opt = rw_pp_opt() ? 1 : 0;
+
+	m2m_log('I', "PERF", "NORD2 PERF PHOTOS A %.12s opt=%d fps=%.1f fr=%llu cb=%llu lat=%.2f/%.1fms commit=%.2fms drvcpu=%.1fms/s\n", n, opt,
+	    frames / 5.0, (unsigned long long)frames, (unsigned long long)commits, frames ? frame_ns / 1e6 / frames : 0.0, frame_max / 1e6,
+	    commits ? commit_ns / 1e6 / commits : 0.0, (commit_ns + iostex_ns + buf_ns + tex_ns) / 5e6);
+	m2m_log('I', "PERF", "NORD2 PERF PHOTOS B %.12s conv=%llu odd=%llu cpu=%llu same=%llu frz=%llu c/fr=%.2f rel=%llu\n", n,
+	    (unsigned long long)conv_gpu, (unsigned long long)conv_odd, (unsigned long long)conv_cpu, (unsigned long long)conv_same,
+	    (unsigned long long)frozen_hits, frames ? (double)conv / frames : 0.0, (unsigned long long)released);
+	m2m_log('I', "PERF", "NORD2 PERF PHOTOS C %.12s iostex=%llu/%.1fms(max %.1f) buf=%llu/%.1fms tex=%llu/%.1fms comp=%llu/%.1fms disp=%.1fms "
+	    "skip=%llu\n", n, (unsigned long long)iostex, iostex_ns / 1e6, iostex_max / 1e6, (unsigned long long)buf_made, buf_ns / 1e6,
+	    (unsigned long long)tex_made, tex_ns / 1e6, (unsigned long long)compute_cb, compute_ns / 1e6, dispatch_ns / 1e6,
+	    (unsigned long long)probe_skips);
+}
