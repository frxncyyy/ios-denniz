+/*
+ * y2s85 (photosperf): THE PHOTOS SCROLL'S COUNTERS, one compact record of three lines every 5 s in MobileSlideShow and backboardd,
+ * so that the same scenario (fbhw_scenario.py --scenarios photos) can be compared build against build:
+ *   NORD2 PERF PHOTOS A <proc> opt=<0|1> fps= fr= cb= lat=<avg>/<max>ms commit=<ms a buffer> drvcpu=<ms a second>
+ *   NORD2 PERF PHOTOS B <proc> conv= odd= cpu= same= frz= c/fr= rel=
+ *   NORD2 PERF PHOTOS C <proc> iostex=<n>/<ms>(max) buf=<n>/<ms> tex=<n>/<ms> comp=<n>/<ms> disp=<ms> skip=
+ * fr = command buffers that drew to a full-screen colour target (>= 1000x2000: the app's drawable, the window server's frame);
+ * lat = submit -> GPU fence of those (queue + GPU, the kernel's PRFCNT gives the GPU's busy time); commit = CPU in -commit;
+ * drvcpu = CPU of this driver a second (commits + iosurface textures + buffer/texture allocations); conv/odd/cpu = YCbCr
+ * conversions (GPU direct, GPU through the even padding + copy, CPU); same = uses that found the surface unchanged; frz = uses
+ * served frozen (thumbfix5); rel = frozen thumbnails whose planes import and padding picture were given back; iostex =
+ * -newTextureWithDescriptor:iosurface:plane:; comp = compute-only command buffers and their commit time, disp = time inside
+ * the library's dispatch call; skip = Photos diagnostic read-backs not made. Short lines: the kernel takes 256 KiB of driver
+ * text per connection (Nord2GPU SEL_LOG), which the thumbnail diagnostics used up in the first minute of run fbhwlive.
+ * Not while /var/db/nord2-metal/no-photosperf-log exists; the behaviour changes (opt=1) not while .../no-photosperf exists.
+ */
+static struct {
+	uint64_t frames, frame_ns, frame_max, compute_cb, compute_ns, dispatch_ns;
+	uint64_t conv_gpu, conv_odd, conv_cpu, conv_same, frozen_hits, released;
+	uint64_t iostex, iostex_ns, iostex_max, probe_skips;
+} rw_pp;
+
+#define RW_PP_ADD(field, v) ((void)__atomic_fetch_add(&rw_pp.field, (uint64_t)(v), __ATOMIC_RELAXED))
+
+static void
+rw_pp_max(uint64_t *field, uint64_t v)
+{
+	uint64_t cur = __atomic_load_n(field, __ATOMIC_RELAXED);
+
+	while (v > cur && !__atomic_compare_exchange_n(field, &cur, v, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+	}
+}
+
+/* the behaviour changes of y2s85: MobileSlideShow only (where thumbfix5's freeze and the Photos probes run) */
+static bool
+rw_pp_opt(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		on = strcmp(getprogname(), "MobileSlideShow") == 0 && access("/var/db/nord2-metal/no-photosperf", F_OK) != 0;
+	}
+	return on == 1;
+}
+
+static bool
+rw_pp_logs(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		const char *n = getprogname();
+
+		on = (strcmp(n, "MobileSlideShow") == 0 || strcmp(n, "backboardd") == 0) &&
+		    access("/var/db/nord2-metal/no-photosperf-log", F_OK) != 0;
+	}
+	return on == 1;
+}
