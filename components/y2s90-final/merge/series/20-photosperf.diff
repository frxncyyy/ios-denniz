+/*
+ * y2s85 (photosperf): A FROZEN THUMBNAIL GIVES ITS SOURCES BACK. Once thumbfix5 has frozen a converted texture (its picture was
+ * finished, or 3 s old) it is never converted again, so the in-place import of its two planes (a GPU mapping of the other process's
+ * surface: a handle, its page-table entries) and, for an odd-sized surface, the even-sized padding picture (376x668 BGRA, 1 MiB)
+ * are dead weight for the texture's whole life -- the grid keeps hundreds of them. They are destroyed at the first use after the
+ * frozen conversion was queued (_ppReady); the GPU work already queued keeps its own references (Gallium/Panfrost batches hold the
+ * resources and BOs, the kernel keeps a busy BO's backing). MobileSlideShow only; not while /var/db/nord2-metal/no-photosperf exists.
+ */
+static pthread_mutex_t rw_pp_release_lock = PTHREAD_MUTEX_INITIALIZER;
+
+- (void)redwoodPPReleaseSources
+{
+	if (!rw_pp_opt()) {
+		return;
+	}
+	pthread_mutex_lock(&rw_pp_release_lock);
+	if (_ppReady && _frozen && (_ycbcrSource != NULL || _padTmp != NULL)) {
+		if (_ycbcrSource != NULL) {
+			mesa.texture_destroy(_ycbcrSource);
+			_ycbcrSource = NULL;
+		}
+		if (_padTmp != NULL) {
+			mesa.texture_destroy(_padTmp);
+			_padTmp = NULL;
+		}
+		_padded = NO;
+		RW_PP_ADD(released, 1);
+	}
+	_ppReady = NO;
+	pthread_mutex_unlock(&rw_pp_release_lock);
+}
+
+- (void)redwoodPPConverted
+{
+	if (_frozen && rw_pp_opt()) {
+		pthread_mutex_lock(&rw_pp_release_lock);
+		_ppReady = YES;
+		pthread_mutex_unlock(&rw_pp_release_lock);
+	}
+}
