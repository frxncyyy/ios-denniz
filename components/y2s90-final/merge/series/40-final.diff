 /*
+ * ===================================================================================== FINAL (y2s90)
+ * y2s90-final = y2s83-thumbfix5 + y2s84-usecount + y2s85-photosperf + y2s86-gamepipe (+ the diffs of
+ * y2s90-final/extra_diffs.txt), merged by y2s90-final/merge_final.sh. Every switch of the three stays:
+ *   usecount-off, usecount-keepfreeze   (y2s84; photos-ycbcr-live as before)
+ *   no-photosperf, no-photosperf-log    (y2s85)
+ *   no-gamepipe                         (y2s86)
+ * and one MASTER switch over them, /var/db/nord2-metal/no-final: the thumbfix5 behaviour -- no texture holds
+ * (so the freeze rule is thumbfix5's), no photosperf behaviour changes (opt=0: frozen thumbnails keep their
+ * sources, the Photos probes run), no gamepipe (no pipeline reuse, no asynchronous builds, no slow commit
+ * anatomy). The PERF PHOTOS counters stay (opt=0), as with no-photosperf, so final and no-final can be
+ * compared with the same binary; no-photosperf-log silences them. Read once per process.
+ * Lines: one banner per process, 'FINAL ... final (y2s90) features: usecount=.. photosperf=.. gamepipe=..'.
+ */
+static int
+rw_final_off(void)
+{
+	static int off = -1;
+
+	if (off < 0) {
+		off = access("/var/db/nord2-metal/no-final", F_OK) == 0;
+	}
+	return off;
+}
