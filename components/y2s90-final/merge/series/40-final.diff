+/*
+ * y2s90 (final): the version banner, once per process at its first command buffer. Read-only: the switches as files (the
+ * features read them themselves, once, when first used), so printing it changes nothing. On the console it reads
+ *   NORD2 GPU USER: I FINAL <proc> Nord2Metal final (y2s90) features: usecount=on photosperf=on gamepipe=on | ...
+ * usecount: on/off (texture holds; the freeze rule then drops once the kernel count is seen real, see 'NORD2 SURF USE');
+ * photosperf: on/off (its behaviour changes act in MobileSlideShow only; counters per no-photosperf-log);
+ * gamepipe: on/off (pipeline reuse + asynchronous builds act in third-party applications only; slow commit anatomy everywhere).
+ */
+#define RW_FINAL_VERSION "final (y2s90)"
+#define RW_FINAL_DB "/var/db/nord2-metal/"
+
+static int
+rw_final_flag(const char *name)
+{
+	char path[128];
+
+	snprintf(path, sizeof(path), RW_FINAL_DB "%s", name);
+	return access(path, F_OK) == 0;
+}
+
+static void
+rw_final_banner_once(void)
+{
+	int off = rw_final_off();
+	int uc_off = rw_final_flag("usecount-off"), uc_keep = rw_final_flag("usecount-keepfreeze");
+	int pp_off = rw_final_flag("no-photosperf"), pp_nolog = rw_final_flag("no-photosperf-log");
+	int gp_off = rw_final_flag("no-gamepipe"), live = rw_final_flag("photos-ycbcr-live");
+
+	m2m_log('I', "FINAL", "Nord2Metal " RW_FINAL_VERSION " features: usecount=%s photosperf=%s gamepipe=%s | master no-final %s"
+	    " | flags usecount-off %d usecount-keepfreeze %d no-photosperf %d no-photosperf-log %d no-gamepipe %d photos-ycbcr-live %d"
+	    " | base y2s83-thumbfix5 f90a091b + y2s84-usecount + y2s85-photosperf + y2s86-gamepipe\n",
+	    off || uc_off ? "off" : uc_keep ? "on(keepfreeze)" : "on",
+	    off || pp_off ? "off" : "on", off || gp_off ? "off" : "on",
+	    off ? "PRESENT (thumbfix5 behaviour)" : "absent", uc_off, uc_keep, pp_off, pp_nolog, gp_off, live);
+}
+
+static void
+rw_final_banner(void)
+{
+	static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+	pthread_once(&once, rw_final_banner_once);
+}
