-		freeze_rule = rw_is_photos_proc() && access("/var/db/nord2-metal/photos-ycbcr-live", F_OK) != 0;
+	/*
+	 * y2s84 (usecount): the freeze rule only stood in for the missing use count. With the kernel's count real (rw_use_kernel_state()
+	 * 1: probed by the first hold) and this texture holding it, the pool no longer reuses the buffer while the texture exists, so the
+	 * texture follows its surface again (seed / probe / young rules) and a picture decoded after the texture was made is converted
+	 * when it lands. Kept with usecount-keepfreeze, with usecount-off, or when the kernel counts nothing; decided per call until the
+	 * probe has answered.
+	 */
+	if (rule < 0) {
+		int base = rw_is_photos_proc() && access("/var/db/nord2-metal/photos-ycbcr-live", F_OK) != 0;
+		int k = base ? rw_use_kernel_state() : 0;
