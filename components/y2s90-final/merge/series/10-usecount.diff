+/*
+ * y2s84 (usecount): A TEXTURE OVER AN IOSURFACE HOLDS THE SURFACE'S USE COUNT WHILE IT EXISTS. Kernel 0398 made the IOSurface use
+ * count real (IOSurfaceIsInUse = state page +0x18, counted across processes); CVPixelBufferPool (CVPixelBufferBacking::okToReuse) and
+ * CoreAnimation's backing stores (buffer_is_unused) reuse a surface only when it is not in use. So with this hold a pool no longer hands
+ * out a buffer whose texture still exists (the root cause behind y2s76's freeze rule: thumbfix2/thumbfix5). One hold per texture, taken
+ * in -redwoodSetIOSurface:plane:, given back when the texture lets the surface go (another surface, or -dealloc).
+ * The first hold probes the kernel: IOSurfaceIsInUse right after IOSurfaceIncrementUseCount is true only when the count is real (an
+ * older kernel answers the traps and counts nothing). Flags (read once per process, /var/db/nord2-metal/):
+ *   usecount-off           no holds (the y2s83 behaviour);
+ *   usecount-keepfreeze    keep the MobileSlideShow freeze rule even when the kernel count is real (to compare);
+ *   photos-ycbcr-live      (as before) no freeze rule at all.
+ * Without flags: holds on; the freeze rule is dropped once the probe says the kernel count is real, kept when it is not.
+ * Logs: SURF "NORD2 SURF USE: metal ..." (probe, first holds, then every power of two / 1024th, and live/max).
+ */
+static struct {
+	pthread_once_t once;
+	void (*inc)(void *), (*dec)(void *);
+	unsigned char (*in_use)(void *);
+	int off, keepfreeze;
+	volatile int kernel;            /* -1 not probed, 0 the kernel counts nothing, 1 real */
+	volatile long taken, given, live, max_live;
+} rw_use = { .once = PTHREAD_ONCE_INIT, .kernel = -1 };
+
+static void
+rw_use_load(void)
+{
+	*(void **)&rw_use.inc = dlsym(RTLD_DEFAULT, "IOSurfaceIncrementUseCount");
+	*(void **)&rw_use.dec = dlsym(RTLD_DEFAULT, "IOSurfaceDecrementUseCount");
+	*(void **)&rw_use.in_use = dlsym(RTLD_DEFAULT, "IOSurfaceIsInUse");
+	rw_use.off = access("/var/db/nord2-metal/usecount-off", F_OK) == 0 || rw_use.inc == NULL || rw_use.dec == NULL;
+	rw_use.keepfreeze = access("/var/db/nord2-metal/usecount-keepfreeze", F_OK) == 0;
+	m2m_log('I', "SURF", "NORD2 SURF USE: metal: texture holds %s (usecount-off %d, IncrementUseCount %s), freeze rule %s\n",
+	    rw_use.off ? "OFF" : "on", access("/var/db/nord2-metal/usecount-off", F_OK) == 0, rw_use.inc != NULL ? "found" : "missing",
+	    rw_use.keepfreeze ? "kept (usecount-keepfreeze)" : "dropped once the kernel count is seen real");
+}
+
+/* 1 = the kernel's use count is real, 0 = not (old kernel), -1 = not known yet (no hold taken so far) or holds off */
+static int
+rw_use_kernel_state(void)
+{
+	pthread_once(&rw_use.once, rw_use_load);
+	return rw_use.off ? 0 : rw_use.kernel;
+}
+
+static BOOL
+rw_use_take(void *surface)
+{
+	pthread_once(&rw_use.once, rw_use_load);
+	if (rw_use.off || surface == NULL) {
+		return NO;
+	}
+	rw_use.inc(surface);
+	if (rw_use.kernel < 0 && rw_use.in_use != NULL) {
+		int k = rw_use.in_use(surface) ? 1 : 0;
+
+		if (__sync_bool_compare_and_swap(&rw_use.kernel, -1, k)) {
+			m2m_log('I', "SURF", "NORD2 SURF USE: metal: kernel use count %s (surface %u: IOSurfaceIsInUse after IncrementUseCount = %d)\n",
+			    k ? "REAL (0398)" : "a no-op (kernel without 0398): the freeze rule stays", rwd_surface_id(surface), k);
+		}
+	}
+	long n = __sync_add_and_fetch(&rw_use.taken, 1), live = __sync_add_and_fetch(&rw_use.live, 1), m = rw_use.max_live;
+
+	while (live > m && !__sync_bool_compare_and_swap(&rw_use.max_live, m, live)) {
+		m = rw_use.max_live;
+	}
+	if (n <= 4 || (n & (n - 1)) == 0 || n % 1024 == 0) {
+		m2m_log('I', "SURF", "NORD2 SURF USE: metal: hold n=%ld on surface %u (live %ld, max %ld, given back %ld)\n", n,
+		    rwd_surface_id(surface), live, rw_use.max_live, rw_use.given);
+	}
+	return YES;
+}
+
+static void
+rw_use_give(void *surface)
+{
+	rw_use.dec(surface);
+	long n = __sync_add_and_fetch(&rw_use.given, 1), live = __sync_sub_and_fetch(&rw_use.live, 1);
+
+	if (live < 0 || n <= 4 || (n & (n - 1)) == 0 || n % 1024 == 0) {
+		m2m_log(live < 0 ? 'E' : 'I', "SURF", "NORD2 SURF USE: metal: give-back n=%ld on surface %u (live %ld%s, max %ld, taken %ld)\n", n,
+		    rwd_surface_id(surface), live, live < 0 ? ": IMBALANCE" : "", rw_use.max_live, rw_use.taken);
+	}
+}
+
