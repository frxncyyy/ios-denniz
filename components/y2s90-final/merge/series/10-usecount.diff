 	}
 	BOOL freeze_now = NO, unfinished = NO;
 
-	if (freeze_rule == 1 && _ycbcr && _iosurface != NULL && rw_ios.lock(_iosurface, 1 /* read-only */, NULL) == 0) {
+	if (rule == 1 && _ycbcr && _iosurface != NULL && rw_ios.lock(_iosurface, 1 /* read-only */, NULL) == 0) {
