 	 * every use converts again (the young rule's GPU pass); after 3 s the picture is taken as it is (a photo that is black indeed).
 	 */
-	if (freeze_rule == 1 && _frozen && _ycbcr) {
+	if (rule == 1 && _frozen && _ycbcr) {
