+			m2m_log('I', "SURF", "NORD2 SURF USE: metal: MobileSlideShow freeze rule (thumbfix2/5) DROPPED: textures hold their "
+			    "surfaces' use count (usecount-keepfreeze keeps it)\n");
+		} else {
+			rule = base;            /* probe not answered yet: freeze this time, decide again at the next call */
+		}
 	}
 	/*
 	 * y2s83 (thumbfix5): ... but only once the picture IS finished. Run v (q10jfe): the grid stays, but some cells are black or show a
@@ -6016,12 +6123,12 @@
