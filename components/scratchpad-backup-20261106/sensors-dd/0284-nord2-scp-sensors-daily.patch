+static int n2scp_chan;
+static void
+n2scp_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&n2scp_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
