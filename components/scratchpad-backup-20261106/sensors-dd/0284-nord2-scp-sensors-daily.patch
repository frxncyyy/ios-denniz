+/*
+ * nord2_seninf.inc - the MT6893 (ISP6s) CSI-2 receiver for the Nord 2's cameras.
+ *
+ * The register layer is MediaTek's own ISP6s seninf driver (GPL-2.0, TCLOpenSource/mt9653
+ * drivers/media/platform/mtk-isp/isp_60s/cam/mtk_cam-seninf-hw.c and its register headers), unchanged but for the
+ * Linux shims in n2seninf/compat.h. The addresses are the Nord 2's (OnePlus kernel mt6885/seninf/seninf_cfg.h):
+ * SENINF 0x1A004000 (+0xA000), MIPI RX analog 0x11C80000 (+0x10000).
+ * Power and clocks (OnePlus clk-mt6885-pg.c / clk-mt6885.c): the CAM MTCMOS (SPM 0x35c, status bit 23, bus
+ * protection steps), topckgen cam_sel (CLK_CFG_2 bits 16-19 = 3 univpll_d4, update bit 10), seninf/seninf1-3_sel
+ * (CLK_CFG_10 bits 16/24, CLK_CFG_11 bits 0/8 = 5 univpll_d6 416 MHz, CLK_CFG_UPDATE1 bits 11-14), camsys_main CG
+ * (0x1A000000, clear 0x8: larb13 0, dfp 1, larb14 2, larb15 3, cam 6, camtg 7, seninf 8, camsv0-3 9-12).
+ */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunused-but-set-variable"
+#pragma clang diagnostic ignored "-Wunused-parameter"
+#pragma clang diagnostic ignored "-Wsign-compare"
+#pragma clang diagnostic ignored "-Wunused-function"
+#pragma clang diagnostic ignored "-Wmissing-prototypes"
+#pragma clang diagnostic ignored "-Wshadow"
+#pragma clang diagnostic ignored "-Wcast-qual"
+#pragma clang diagnostic ignored "-Wformat"
+#pragma clang diagnostic ignored "-Wpointer-arith"
+#pragma clang diagnostic ignored "-Wgnu-pointer-arith"
+#pragma clang diagnostic ignored "-Wvoid-pointer-to-int-cast"
+#define PAGE_SIZE_N2SENINF 4096
+#include "n2seninf/seninf_hw.c"
+#pragma clang diagnostic pop
+
+static vm_offset_t n2s_if, n2s_ana, n2s_spm, n2s_infra, n2s_camsys, n2s_mdp, n2s_camsub, n2s_dispsmi, n2s_larb13, n2s_larb14;
+static struct seninf_ctx n2s_ctx;
+
+static bool
+n2s_wait(vm_offset_t b, uint32_t off, uint32_t mask, uint32_t want)
+{
+	for (unsigned i = 0; i < 2000; i++) { if ((ni_rd(b, off) & mask) == want) { return true; } delay(10); }
+	return false;
+}
+
+
+/*
+ * The MDP domain and the SMI path (measured on stock Android 2026-11-09, gpu/build/cam-android-regs-20261109/REPORT.md):
+ * larb13 goes out through mdp_smi_common (0x1f002000), larb13 and larb14 both through sysram_smi_common (0x1f022000), and the
+ * camsys registers themselves sit behind the MDP bus. spm_mtcmos_ctrl_mdp (clk-mt6885-pg.c): MDP_PWR_CON 0x34c, status bit 19,
+ * then its bus protection; mdp_sel = CLK_CFG_1 bits 8-11 = 3, update bit 5; mdpsys CG1 (0x110, clear 0x118): APMCU_GALS 1,
+ * SMI0 4, SMI1 8, SMI2 12. The SMI values are smi_conf.h (mt6885) = the stock readback.
+ */
+static bool
+n2s_mdp_power(void)
+{
+	const uint32_t con = 0x34c, sta = 1u << 19;
+	ni_wr(n2s_spm, 0x000, (0xb16u << 16) | 1u);
+	printf("NORD2 SENINF: before: pwr status %#x/%#x mdp con %#x cam con %#x prot %#x 1 %#x mm %#x mm2 %#x 2 %#x vdnr %#x CLK_CFG_1 %#x\n",
+	    ni_rd(n2s_spm, 0x16c), ni_rd(n2s_spm, 0x170), ni_rd(n2s_spm, con), ni_rd(n2s_spm, 0x35c), ni_rd(n2s_infra, 0x228), ni_rd(n2s_infra, 0x258),
+	    ni_rd(n2s_infra, 0x2ec), ni_rd(n2s_infra, 0xdd8), ni_rd(n2s_infra, 0x724), ni_rd(n2s_infra, 0xbc4), ni_rd(n2c_top, 0x20));
+	/* mdp_sel = mainpll_d4_d2 (stock: CLK_CFG_1 0x09090304), ungated */
+	ni_wr(n2c_top, 0x28, 0x8fu << 8); ni_wr(n2c_top, 0x24, 3u << 8); ni_wr(n2c_top, 0x04, 1u << 5);
+	if ((ni_rd(n2s_spm, 0x16c) & sta) && (ni_rd(n2s_spm, 0x170) & sta)) {
+		printf("NORD2 SENINF: MDP domain already on (con %#x)\n", ni_rd(n2s_spm, con));
+	} else {
+		ni_mask(n2s_spm, con, 1u << 2, 1u << 2);
+		ni_mask(n2s_spm, con, 1u << 3, 1u << 3);
+		if (!n2s_wait(n2s_spm, 0x16c, sta, sta) || !n2s_wait(n2s_spm, 0x170, sta, sta)) { printf("NORD2 SENINF: MDP power status timeout\n"); return false; }
+		ni_mask(n2s_spm, con, 1u << 4, 0);
+		ni_mask(n2s_spm, con, 1u << 1, 0);
+		ni_mask(n2s_spm, con, 1u << 0, 1u << 0);
+		ni_mask(n2s_spm, con, 1u << 8, 0);
+		if (!n2s_wait(n2s_spm, con, 1u << 12, 0)) { printf("NORD2 SENINF: MDP SRAM ack timeout\n"); return false; }
+	}
+	/* bus protection off: step 2 (0..3), then step 1 (0..2) */
+	ni_wr(n2s_infra, 0x2a4, 1u << 23);
+	ni_wr(n2s_infra, 0x2d8, (1u << 3) | (1u << 5) | (1u << 7) | (1u << 9) | (1u << 19) | (1u << 23) | (1u << 29) | (1u << 31));
+	ni_wr(n2s_infra, 0xdd0, (1u << 1) | (1u << 7) | (1u << 9) | (1u << 11));
+	ni_wr(n2s_infra, 0xbbc, 1u << 20);
+	ni_wr(n2s_infra, 0x2a4, 1u << 10);
+	ni_wr(n2s_infra, 0x2d8, (1u << 2) | (1u << 4) | (1u << 6) | (1u << 8) | (1u << 18) | (1u << 22) | (1u << 28) | (1u << 30));
+	ni_wr(n2s_infra, 0xdd0, (1u << 0) | (1u << 2) | (1u << 4) | (1u << 6) | (1u << 8));
+	delay(100);
+	ni_wr(n2s_mdp, 0x118, (1u << 1) | (1u << 4) | (1u << 8) | (1u << 12));
+	delay(100);
+	printf("NORD2 SENINF: MDP on: con %#x status %#x/%#x prot %#x mm %#x mm2 %#x vdnr %#x mdp CG %#x/%#x\n", ni_rd(n2s_spm, con), ni_rd(n2s_spm, 0x16c),
+	    ni_rd(n2s_spm, 0x170), ni_rd(n2s_infra, 0x228), ni_rd(n2s_infra, 0x2ec), ni_rd(n2s_infra, 0xdd8), ni_rd(n2s_infra, 0xbc4),
+	    ni_rd(n2s_mdp, 0x100), ni_rd(n2s_mdp, 0x110));
+	return true;
+}
+
+static void
+n2s_smi_common(vm_offset_t b)
+{
+	ni_wr(b, 0x100, 0xb); ni_wr(b, 0x220, 0x4514); ni_wr(b, 0x234, 0x0e100e10); ni_wr(b, 0x238, 0x0506090a); ni_wr(b, 0x23c, 0x0506090a);
+	ni_wr(b, 0x300, 0x4f1); ni_wr(b, 0x444, 1);
+}
+static void
+n2s_smi_subcom(vm_offset_t b)
+{
+	ni_wr(b, 0x100, 0xa); ni_wr(b, 0x244, 0x2105); ni_wr(b, 0x300, 0x4f1); ni_wr(b, 0x444, 1);
+}
+static void
+n2s_smi_larb(vm_offset_t b, const uint8_t *ostd, unsigned ports)
+{
+	ni_wr(b, 0x24, 0x370256); ni_wr(b, 0x40, 1); ni_wr(b, 0xf0, 1); ni_wr(b, 0x524, 0x370256); ni_wr(b, 0x5f0, 1);
+	for (unsigned p = 0; p < ports; p++) { ni_wr(b, 0x200 + 4 * p, ostd[p]); }
+	for (unsigned p = 0; p < 32; p++) { ni_mask(b, 0x380 + 4 * p, 1u, 0); }    /* IOMMU off: the DMA takes physical addresses */
+}
+/* after MDP and CAM are on and the CAM clocks run */
+static void
+n2s_smi(void)
+{
+	static const uint8_t o13[12] = { 2, 0xc, 0xc, 0xe, 6, 6, 6, 6, 6, 0x12, 6, 1 }, o14[6] = { 2, 0xc, 0xc, 0x28, 0x12, 6 };
+	printf("NORD2 SENINF: SMI before: mdp common %#x/%#x sysram %#x/%#x disp common %#x/%#x cam subcom %#x %#x %#x larb13 %#x/%#x larb14 %#x/%#x\n",
+	    ni_rd(n2s_mdp, 0x2100), ni_rd(n2s_mdp, 0x2220), ni_rd(n2s_mdp, 0x22100), ni_rd(n2s_mdp, 0x22220), ni_rd(n2s_dispsmi, 0x100),
+	    ni_rd(n2s_dispsmi, 0x220), ni_rd(n2s_camsub, 0x100), ni_rd(n2s_camsub, 0x1100), ni_rd(n2s_camsub, 0x2100), ni_rd(n2s_larb13, 0x24),
+	    ni_rd(n2s_larb13, 0x398), ni_rd(n2s_larb14, 0x24), ni_rd(n2s_larb14, 0x38c));
+	n2s_smi_common(n2s_mdp + 0x2000);
+	ni_wr(n2s_mdp, 0x22100, 2); ni_wr(n2s_mdp, 0x22220, 0x1111); ni_wr(n2s_mdp, 0x22300, 0x4f1); ni_wr(n2s_mdp, 0x22444, 1);   /* sysram */
+	n2s_smi_subcom(n2s_mdp + 0x23000); n2s_smi_subcom(n2s_mdp + 0x24000);
+	if (ni_rd(n2s_dispsmi, 0x220) != 0x4514) { n2s_smi_common(n2s_dispsmi); }       /* the display's: only when not set up */
+	if (ni_rd(n2s_dispsmi, 0x1100) != 0xa) { n2s_smi_subcom(n2s_dispsmi + 0x1000); }
+	if (ni_rd(n2s_dispsmi, 0x2100) != 0xa) { n2s_smi_subcom(n2s_dispsmi + 0x2000); }
+	n2s_smi_subcom(n2s_camsub); n2s_smi_subcom(n2s_camsub + 0x1000); n2s_smi_subcom(n2s_camsub + 0x2000);
+	n2s_smi_larb(n2s_larb13, o13, 12); n2s_smi_larb(n2s_larb14, o14, 6);
+	printf("NORD2 SENINF: SMI after: mdp common %#x/%#x sysram %#x disp common %#x/%#x larb13 stat %#x larb14 stat %#x port3 %#x\n",
+	    ni_rd(n2s_mdp, 0x2100), ni_rd(n2s_mdp, 0x2220), ni_rd(n2s_mdp, 0x22220), ni_rd(n2s_dispsmi, 0x100), ni_rd(n2s_dispsmi, 0x220),
+	    ni_rd(n2s_larb13, 0x0), ni_rd(n2s_larb14, 0x0), ni_rd(n2s_larb14, 0x38c));
+}
+
+/* the CAM MTCMOS: spm_mtcmos_ctrl_cam (clk-mt6885-pg.c), STA_POWER_ON */
+static bool
+n2s_cam_power(void)
+{
+	const uint32_t con = 0x35c, sta = 1u << 23;
+	ni_wr(n2s_spm, 0x000, (0xb16u << 16) | 1u);                      /* POWERON_CONFIG_EN key */
+	if ((ni_rd(n2s_spm, 0x16c) & sta) && (ni_rd(n2s_spm, 0x170) & sta)) {
+		printf("NORD2 SENINF: CAM domain already on (con %#x)\n", ni_rd(n2s_spm, con));
+	} else {
+		printf("NORD2 SENINF: CAM domain on (con %#x)\n", ni_rd(n2s_spm, con));
+		ni_mask(n2s_spm, con, 1u << 2, 1u << 2);                  /* PWR_ON */
+		ni_mask(n2s_spm, con, 1u << 3, 1u << 3);                  /* PWR_ON_2ND */
+		if (!n2s_wait(n2s_spm, 0x16c, sta, sta) || !n2s_wait(n2s_spm, 0x170, sta, sta)) {
+			printf("NORD2 SENINF: CAM power status timeout\n");
+			return false;
+		}
+		ni_mask(n2s_spm, con, 1u << 4, 0);                        /* PWR_CLK_DIS */
+		ni_mask(n2s_spm, con, 1u << 1, 0);                        /* PWR_ISO */
+		ni_mask(n2s_spm, con, 1u << 0, 1u << 0);                  /* PWR_RST_B */
+		ni_mask(n2s_spm, con, 1u << 8, 0);                        /* SRAM_PDN */
+		if (!n2s_wait(n2s_spm, con, 1u << 12, 0)) { printf("NORD2 SENINF: CAM SRAM ack timeout\n"); return false; }
+	}
+#ifdef N2S_KEEP_PROT
+	/* q10g6..g8: clearing the bus protection with the MDP domain off killed the system 27-44 s later. */
+	printf("NORD2 SENINF: CAM bus protection left alone: prot1 %#x/%#x mm %#x/%#x prot2 %#x/%#x\n", ni_rd(n2s_infra, 0x250),
+	    ni_rd(n2s_infra, 0x258), ni_rd(n2s_infra, 0x2d0), ni_rd(n2s_infra, 0x2ec), ni_rd(n2s_infra, 0x710), ni_rd(n2s_infra, 0x724));
+	if (1) { return true; }
+#endif
+	printf("NORD2 SENINF: CAM bus protection off\n");
+	ni_wr(n2s_infra, 0x2ac, 1u << 22);                               /* PROTECTEN_1_CLR: STEP2_0 */
+	ni_wr(n2s_infra, 0x2d8, (1u << 1) | (1u << 3) | (1u << 5));      /* PROTECTEN_MM_CLR: STEP2_1 */
+	ni_wr(n2s_infra, 0x718, 1u << 1);                                /* PROTECTEN_2_CLR: STEP1_0 */
+	ni_wr(n2s_infra, 0x2d8, (1u << 0) | (1u << 2) | (1u << 4));      /* PROTECTEN_MM_CLR: STEP1_1 */
+	delay(200);
+	printf("NORD2 SENINF: CAM on: con %#x status %#x/%#x prot1 sta %#x mm sta %#x prot2 sta %#x (bit1 must be 0)\n", ni_rd(n2s_spm, con),
+	    ni_rd(n2s_spm, 0x16c), ni_rd(n2s_spm, 0x170), ni_rd(n2s_infra, 0x258), ni_rd(n2s_infra, 0x2ec), ni_rd(n2s_infra, 0x724));
+	return true;
+}
+
+static void __attribute__((unused))
+n2s_clock_muxes(void)
+{
+	ni_wr(n2c_top, 0x38, 0x8fu << 16); ni_wr(n2c_top, 0x34, 3u << 16); ni_wr(n2c_top, 0x04, 1u << 10);
+	ni_wr(n2c_top, 0xb8, (0x87u << 16) | (0x87u << 24)); ni_wr(n2c_top, 0xb4, (5u << 16) | (5u << 24));
+	ni_wr(n2c_top, 0xc8, 0x87u | (0x87u << 8)); ni_wr(n2c_top, 0xc4, 5u | (5u << 8));
+	ni_wr(n2c_top, 0x08, 0xfu << 11);
+	printf("NORD2 SENINF: muxes: CLK_CFG_2 %#x CLK_CFG_10 %#x CLK_CFG_11 %#x\n", ni_rd(n2c_top, 0x30), ni_rd(n2c_top, 0xb0), ni_rd(n2c_top, 0xc0));
+}
+static void __attribute__((unused))
+n2s_clock_gates(void)
+{
+	ni_wr(n2s_camsys, 0x8, 0x1fcfu);
+	printf("NORD2 SENINF: camsys CG %#x\n", ni_rd(n2s_camsys, 0x0));
+}
+static void __attribute__((unused))
+n2s_clocks(void)
+{
+	/* cam_sel = univpll_d4 */
+	ni_wr(n2c_top, 0x38, 0x8fu << 16); ni_wr(n2c_top, 0x34, 3u << 16); ni_wr(n2c_top, 0x04, 1u << 10);
+	/* seninf_sel, seninf1_sel = univpll_d6 (416 MHz) */
+	ni_wr(n2c_top, 0xb8, (0x87u << 16) | (0x87u << 24)); ni_wr(n2c_top, 0xb4, (5u << 16) | (5u << 24));
+	/* seninf2_sel, seninf3_sel */
+	ni_wr(n2c_top, 0xc8, 0x87u | (0x87u << 8)); ni_wr(n2c_top, 0xc4, 5u | (5u << 8));
+	ni_wr(n2c_top, 0x08, 0xfu << 11);
+	/* camsys_main gates: larb13-15, dfp, cam, camtg, seninf, camsv0-3 */
+	ni_wr(n2s_camsys, 0x8, 0x1fcfu);
+	printf("NORD2 SENINF: clocks: CLK_CFG_2 %#x CLK_CFG_10 %#x CLK_CFG_11 %#x camsys CG %#x\n", ni_rd(n2c_top, 0x30),
+	    ni_rd(n2c_top, 0xb0), ni_rd(n2c_top, 0xc0), ni_rd(n2s_camsys, 0x0));
+}
+
+/* CAM's path to memory (clk-mt6885-pg.c CAM steps). Off only while a capture runs: q10g5/g6 died 26-44 s after it was
+ * cleared for good; q10gb: with it on, the CAMSV DMA never leaves reset. */
+static void __attribute__((unused))
+n2s_cam_bus(bool open)
+{
+	if (open) {
+		ni_wr(n2s_infra, 0x2ac, 1u << 22); ni_wr(n2s_infra, 0x2d8, (1u << 1) | (1u << 3) | (1u << 5));
+		ni_wr(n2s_infra, 0x718, 1u << 1);  ni_wr(n2s_infra, 0x2d8, (1u << 0) | (1u << 2) | (1u << 4));
+	} else {
+		ni_wr(n2s_infra, 0x714, 1u << 1);  (void)n2s_wait(n2s_infra, 0x724, 1u << 1, 1u << 1);
+		ni_wr(n2s_infra, 0x2d4, (1u << 0) | (1u << 2) | (1u << 4)); (void)n2s_wait(n2s_infra, 0x2ec, 0x15u, 0x15u);
+		ni_wr(n2s_infra, 0x2a8, 1u << 22); (void)n2s_wait(n2s_infra, 0x258, 1u << 22, 1u << 22);
+		ni_wr(n2s_infra, 0x2d4, (1u << 1) | (1u << 3) | (1u << 5)); (void)n2s_wait(n2s_infra, 0x2ec, 0x2au, 0x2au);
+	}
+	printf("NORD2 SENINF: CAM bus %s: prot1 %#x mm %#x prot2 %#x\n", open ? "OPEN" : "closed", ni_rd(n2s_infra, 0x258),
+	    ni_rd(n2s_infra, 0x2ec), ni_rd(n2s_infra, 0x724));
+}
+
+static bool
+n2s_init(void)
+{
+	if (!n2s_if) {
+		n2s_if = ml_io_map_unmappable(0x1a004000, 0xa000, VM_WIMG_IO);
+		n2s_ana = ml_io_map_unmappable(0x11c80000, 0x10000, VM_WIMG_IO);
+		n2s_spm = ml_io_map_unmappable(0x10006000, 0x1000, VM_WIMG_IO);
+		n2s_infra = ml_io_map_unmappable(0x10001000, 0x1000, VM_WIMG_IO);
+		n2s_camsys = ml_io_map_unmappable(0x1a000000, 0x1000, VM_WIMG_IO);
+		n2s_mdp = ml_io_map_unmappable(0x1f000000, 0x25000, VM_WIMG_IO);
+		n2s_camsub = ml_io_map_unmappable(0x1a00c000, 0x3000, VM_WIMG_IO);
+		n2s_dispsmi = ml_io_map_unmappable(0x1411f000, 0x3000, VM_WIMG_IO);
+		n2s_larb13 = ml_io_map_unmappable(0x1a001000, 0x1000, VM_WIMG_IO);
+		n2s_larb14 = ml_io_map_unmappable(0x1a002000, 0x1000, VM_WIMG_IO);
+	}
+#ifdef N2S_BISECT
+	/* q10g6: the system died ~73 s after boot whenever the CAM domain was on: one step at a time, a heartbeat between */
+	uint64_t t0 = mach_absolute_time();
+	for (unsigned s = 0; s < 150; s++) {
+		uint64_t ns; absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (s == 0) { printf("NORD2 BISECT: step 1 CAM MTCMOS + bus protection\n"); if (!n2s_cam_power()) { return false; } }
+		
+		
+		printf("NORD2 BISECT: heartbeat %u s (since start %llu ms) spm status %#x\n", s, ns / 1000000ULL, ni_rd(n2s_spm, 0x16c));
+		n2c_sleep(1000);
+	}
+	printf("NORD2 BISECT: step 4 SENINF\n");
+#else
+	if (!n2s_mdp_power()) { return false; }
+	if (!n2s_cam_power()) { return false; }
+	n2s_clocks();
+	n2s_smi();
+#endif
+	memset(&n2s_ctx, 0, sizeof(n2s_ctx));
+	mtk_cam_seninf_init_iomem(&n2s_ctx, (void *)n2s_if, (void *)n2s_ana);
+	printf("NORD2 SENINF: top %#x %#x %#x\n", ni_rd(n2s_if, 0x0), ni_rd(n2s_if, 0x4), ni_rd(n2s_if, 0x8));
+	return true;
+}
+
+/*
+ * The IMX766's receiver: CSI port 2 in C-PHY mode, 3 trios, into SENINF5. The TCL driver's C-PHY path kills this SoC
+ * (q10gd/gf/gg: dead inside mtk_cam_seninf_set_csi_mipi), so these are the register values of stock Android while the
+ * sensor streams (gpu/build/cam-android-regs-20261109/imx766/ana2.log, sen_8.log), written block by block.
+ */
+struct n2s_rv { uint16_t off; uint32_t val; };
+static void
+n2s_replay(const char *what, vm_offset_t base, const struct n2s_rv *t, unsigned n)
+{
+	(void)what;
+	for (unsigned i = 0; i < n; i++) { ni_wr(base, t[i].off, t[i].val); }
+}
+static void
+n2s_rx_cphy2(void)
+{
+	static const struct n2s_rv ana_a[] = { { 0x04, 0x00420844 }, { 0x08, 0x44001111 }, { 0x0c, 0x02001010 }, { 0x10, 0x00001111 }, { 0x14, 0x00000057 },
+	    { 0x18, 0x04090909 }, { 0x1c, 0x04090909 }, { 0x20, 0x203f413f }, { 0x24, 0x30030000 }, { 0x40, 0x03330000 }, { 0x54, 0x00000111 },
+	    { 0x60, 0x03330000 }, { 0x80, 0x00220000 }, { 0xf0, 0x000200e2 }, { 0x00, 0x00170013 } };
+	static const struct n2s_rv ana_b[] = { { 0x04, 0x00420844 }, { 0x08, 0x44000f0f }, { 0x0c, 0x02001010 }, { 0x10, 0x00001111 }, { 0x14, 0x00000057 },
+	    { 0x18, 0x04090909 }, { 0x1c, 0x04090909 }, { 0x20, 0x203f643f }, { 0x24, 0x30030000 }, { 0x40, 0x00130000 }, { 0x54, 0x00000111 },
+	    { 0x70, 0x00130000 }, { 0x90, 0x01010000 }, { 0xf0, 0x000200e2 }, { 0x00, 0x00170013 } };
+	static const struct n2s_rv dphy[] = { { 0x10, 0x10130000 }, { 0x14, 0x10130000 }, { 0x20, 0x10273002 }, { 0x24, 0x10273002 }, { 0x28, 0x10273002 },
+	    { 0x2c, 0x10273002 } };
+	static const struct n2s_rv cphy[] = { { 0x08, 0x44440012 }, { 0x10, 0x0e492300 }, { 0x14, 0x0e492301 }, { 0x18, 0x12492410 }, { 0x24, 0x00050000 },
+	    { 0x34, 0x01050000 }, { 0x44, 0x0f010000 }, { 0x54, 0x09000000 }, { 0xe4, 0x00010101 }, { 0x00, 0x00000007 } };
+	static const struct n2s_rv sen5[] = { { 0xa04, 0x001f0037 }, { 0xa08, 0x00000402 }, { 0xa10, 0x00000106 }, { 0xa00, 0x00000007 }, { 0x200, 0x00000001 },
+	    { 0x210, 0x00000001 } };
+	n2s_replay("CSI2A analog", n2s_ana + 0x8000, ana_a, sizeof(ana_a) / sizeof(ana_a[0]));
+	n2s_replay("CSI2B analog", n2s_ana + 0x9000, ana_b, sizeof(ana_b) / sizeof(ana_b[0]));
+	n2s_replay("CSI2 D-PHY top", n2s_ana + 0xa000, dphy, sizeof(dphy) / sizeof(dphy[0]));
+	n2s_replay("CSI2 C-PHY top", n2s_ana + 0xb000, cphy, sizeof(cphy) / sizeof(cphy[0]));
+	ni_wr(n2s_if, 0x68, 2);
+	n2s_replay("SENINF5 CSI2", n2s_if + 0x4000, sen5, sizeof(sen5) / sizeof(sen5[0]));
+	printf("NORD2 SENINF: replay done: ana %#x %#x cphy %#x seninf5 %#x %#x %#x\n", ni_rd(n2s_ana, 0x8000), ni_rd(n2s_ana, 0x9000), ni_rd(n2s_ana, 0xb000),
+	    ni_rd(n2s_if, 0x4a00), ni_rd(n2s_if, 0x4a04), ni_rd(n2s_if, 0x4a10));
+}
+
+/* receive on a CSI port (4D1C ports 0..3): D-PHY 4 lanes or C-PHY 3 trios; RAW10 on VC0 into mux 0 */
+static void
+n2s_rx(int port, bool cphy, int lanes, int64_t pixel_rate)
+{
+	struct seninf_ctx *c = &n2s_ctx;
+	mtk_cam_seninf_init_port(c, port);
+	c->is_cphy = cphy;
+	c->num_data_lanes = lanes;
+	c->mipi_pixel_rate = pixel_rate;
+	c->fps_n = 0; c->fps_d = 0;
+	memset(&c->vcinfo, 0, sizeof(c->vcinfo));
+	c->vcinfo.cnt = 1;
+	c->vcinfo.vc[0].vc = 0; c->vcinfo.vc[0].dt = 0x2b; c->vcinfo.vc[0].group = 0; c->vcinfo.vc[0].pixel_mode = 2;
+#define N2S_STEP(x) do { } while (0)
+	N2S_STEP("reset"); mtk_cam_seninf_reset(c, c->seninfIdx);
+	N2S_STEP("set_vc"); mtk_cam_seninf_set_vc(c, c->seninfIdx, &c->vcinfo);
+	if (cphy && port == CSI_PORT_2) { n2s_rx_cphy2(); } else { mtk_cam_seninf_set_csi_mipi(c); }
+	N2S_STEP("mux"); mtk_cam_seninf_mux(c, SENINF_MUX1);
+	mtk_cam_seninf_set_mux_ctrl(c, SENINF_MUX1, 0, 0, MIPI_SENSOR, 2);
+	N2S_STEP("top mux");
+	mtk_cam_seninf_set_top_mux_ctrl(c, SENINF_MUX1, c->seninfIdx);
+}
+
+static void
+n2s_report(const char *what)
+{
+	struct seninf_ctx *c = &n2s_ctx;
+	vm_offset_t csi2 = (vm_offset_t)c->reg_if_csi2[c->seninfIdx], mux = (vm_offset_t)c->reg_if_mux[SENINF_MUX1];
+	struct mtk_cam_seninf_mux_meter m;
+	mtk_cam_seninf_get_mux_meter(c, SENINF_MUX1, &m);
+	printf("NORD2 SENINF: %s port %d seninf%d: csi2 irq %#x lines/frames %#x pkt %#x pktcnt %#x | mux irq %#x size %ux%u hv %u hb %u vv %u vb %u\n",
+	    what, c->port, c->seninfIdx + 1, ni_rd(csi2, 0xc8), ni_rd(csi2, 0xd0), ni_rd(csi2, 0xd4), ni_rd(csi2, 0xdc),
+	    ni_rd(mux, 0x18), m.width, m.height, m.h_valid, m.h_blank, m.v_valid, m.v_blank);
+	ni_wr(csi2, 0xc8, 0xffffffffu);      /* write-1-clear */
+	ni_wr(mux, 0x18, 0xffffffffu);
+}
--- a/bsd/dev/nord2_camsv.inc
+++ b/bsd/dev/nord2_camsv.inc
@@ -0,0 +1,218 @@
+/*
+ * nord2_camsv.inc - frames into memory: SENINF cam mux -> CAMSV -> IMGO DMA (MT6893).
+ *
+ * CAMSV is the simple capture channel HakiOS used on the MT6768 (redwood_mtkcam.c). On the MT6893 its registers and the
+ * values the vendor HAL writes were read out of the Nord 2's own /vendor/lib64/libimageio_plat_drv.so (C++ symbols kept:
+ * CAMSV_TOP_CTRL::_config/_enable, CAMSV_TG_CTRL::_config/_enable, DMAO_CAMSV_B::_config/_enable/setBaseAddr,
+ * CAMSV_BUF_CTRL::_config) and its register-dump strings (Reg(CAMSV_IMGO_XSIZE) ...); the TG block is the CAM TG's layout
+ * (mt6893/isp_ccu_reg.h in the CCU firmware's DWARF) at +0x130:
+ *   0x010 MODULE_EN  bit0 TG, bit2 PAK, bit4 IMGO, bit30 (set by _config and _enable)
+ *   0x014 FMT_SEL    TG format: 0 RAW8, 1 RAW10, 2 RAW12 (the HAL's switch)
+ *   0x018 INT_EN     0x31871            0x01c INT_STATUS     0x020 SW_CTL (1 IMGO reset, wait bits 0-1, 4 SW reset, 0)
+ *   0x030 (top)      |= 0x8005 (_enable)  0x04c PAK  0x058 &~0x80  0x05c &~1  0x2d0[20:16] = 0xe  0x418 |= 0x61000000
+ *   0x7b0 &= 0x7fffffff  0x7c4 = ~0  0x800 = 0, then |= 1 (DMAO_CAMSV_B::_enable)
+ *   0x130 TG_SEN_MODE (bit0 CMOS_EN, bit1/bit13 double/quad data bus, bit16 time stamp)  0x134 VF_CON (bit0 VFDATA_EN)
+ *   0x138 GRAB_PXL (start | end << 16)  0x13c GRAB_LIN  0x168 FRMSIZE_ST  0x16c INTER_ST (frame count bits 16-23)  0x1a4 SUB_PERIOD
+ *   0x420 IMGO_BASE_ADDR  0x428 OFST  0x430 XSIZE (bytes - 1)  0x434 YSIZE (lines - 1)  0x438 STRIDE (|= 0x080f0000)
+ *   0x43c CON 0x80000080  0x440 CON2  0x444 CON3 0x00200010  0x448 CROP  0xa00 FBC_IMGO_CTL1 (0: off)
+ * The DMA goes through SMI larbs 13/14 (CAMSV ports, m4u_port.h): their IOMMU is switched off per port (SMI_LARB_NON_SEC_CON
+ * 0x380 + 4 * port, bit 0) so the DMA takes physical addresses, as HakiOS found it must (docs/camera-x6826b.md).
+ */
+#define N2V_NBUF 2
+/*
+ * Stock Android measurements (2026-11-09, gpu/build/cam-android-regs-20261109/REPORT.md) replace the guesses above:
+ *  - the DMA only arms after an edge on MODULE_EN bit 30 written after TOP (0x30) = 1, 5, 0x8005 (CAMSV_TOP_CTRL::_enable);
+ *  - no 0x424 address MSB: the buffers must sit below 4 GB (the iOS window starts at 0x1_42000000, so they are a fixed claim in
+ *    the unused lower bank: 0xD0000000, 2 x 16 MiB; live.dts has no carve-out in 0xC0000000..0xDFE70000);
+ *  - CAMSV 0 (0x1a090000) is larb14 port 3 (L14_CAM_CAMSV0); cam mux i + 3 feeds CAMSV i;
+ *  - SENINF mux pixel mode 2 <-> TG single data bus (SEN_MODE 0x12000); RAW10 PAK = 0x49; STRIDE |= 0x08070000;
+ *  - enqueue = 0x420, 0x804, 0x2c = 0x11 (the FBC takes 0x420 at RCNT_INC); FBC CTL2 0xa04: [7:0] enqueued, [15:8] done,
+ *    [23:16] pending; 0x400 bit 0 clears and 0x48 bit 1 sets once the DMA runs.
+ */
+#define N2V_BUF_PA 0xd0000000ULL
+#define N2V_BUF_BYTES 0x1000000u
+#define N2V_SV 0u               /* the CAMSV in use */
+#define N2V_CAMMUX 3
+static vm_offset_t n2v_sv[4];
+static vm_offset_t n2v_buf[N2V_NBUF];
+static uint64_t n2v_pa[N2V_NBUF];
+static uint32_t n2v_bufsz;
+static uint32_t n2v_xoff;        /* first pixel grabbed: the DMA line must be a multiple of 8 bytes (IMX615: 3264 of 3280) */
+
+static void
+n2v_inval(vm_offset_t va, uint32_t len)
+{
+	for (vm_offset_t a = va & ~63ul; a < va + len; a += 64) { __asm__ volatile("dc civac, %0" :: "r"(a) : "memory"); }
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static bool
+n2v_alloc(uint32_t bytes)
+{
+	if (bytes > N2V_BUF_BYTES - 4096) { return false; }
+	if (n2v_buf[0]) { return true; }
+	for (unsigned i = 0; i < N2V_NBUF; i++) {
+		n2v_pa[i] = N2V_BUF_PA + (uint64_t)i * N2V_BUF_BYTES;
+		n2v_buf[i] = ml_io_map_unmappable(n2v_pa[i], N2V_BUF_BYTES, VM_WIMG_DEFAULT);
+		printf("NORD2 CAMSV: buffer %u: va %#lx pa %#llx (%u bytes, fixed claim)\n", i, (unsigned long)n2v_buf[i], (unsigned long long)n2v_pa[i], N2V_BUF_BYTES);
+		if (!n2v_buf[i]) { return false; }
+	}
+	n2v_bufsz = N2V_BUF_BYTES;
+	return true;
+}
+
+static void
+n2v_map(void)
+{
+	if (n2v_sv[0]) { return; }
+	for (unsigned i = 0; i < 4; i++) { n2v_sv[i] = ml_io_map_unmappable(0x1a090000 + 0x1000 * i, 0x1000, VM_WIMG_IO); }
+}
+
+/* SENINF mux 1 -> cam mux 3 -> CAMSV 0 */
+static void
+n2v_cammux(uint32_t w, uint32_t h)
+{
+	mtk_cam_seninf_set_cammux_vc(&n2s_ctx, N2V_CAMMUX, 0, 0x2b, 1, 1);
+	mtk_cam_seninf_set_cammux_src(&n2s_ctx, SENINF_MUX1, N2V_CAMMUX, (int)w, (int)h);
+	mtk_cam_seninf_set_cammux_chk_pixel_mode(&n2s_ctx, N2V_CAMMUX, 2);
+	mtk_cam_seninf_cammux(&n2s_ctx, N2V_CAMMUX);
+}
+
+/* CAMSV_BUF_CTRL::enqueueHwBuf: frame address, header address (64 bytes, after the frame), RCNT_INC */
+static void
+n2v_enqueue(vm_offset_t sv, uint64_t pa, uint32_t frame_bytes)
+{
+	ni_wr(sv, 0x420, (uint32_t)pa);
+	ni_wr(sv, 0x804, (uint32_t)((pa + frame_bytes + 63) & ~63ULL));
+	ni_wr(sv, 0x2c, ni_rd(sv, 0x2c) | 1u);
+}
+
+/* the stock HAL's writes, in its order (uprobes on IspDrvCamsv::writeReg: logs/camsv_hal_writes_ordered.txt) */
+static void
+n2v_camsv_cfg(vm_offset_t sv, uint32_t w, uint32_t h, uint32_t stride, uint64_t pa)
+{
+	/* CAMSV_TG_CTRL::_config */
+	ni_wr(sv, 0x130, 0x10000); ni_wr(sv, 0x194, 0x19); ni_wr(sv, 0x1b0, 1); ni_wr(sv, 0x1a4, 0); ni_wr(sv, 0x134, 0);
+	ni_wr(sv, 0x130, 0x12000);                                  /* time stamp, single data bus (SENINF mux pixel mode 2) */
+	ni_wr(sv, 0x138, n2v_xoff | (n2v_xoff + w) << 16); ni_wr(sv, 0x13c, h << 16);
+	/* reset (ISP_RESET_BY_HWMODULE and CAMSV_TOP_CTRL::_config) */
+	ni_wr(sv, 0x20, 0); ni_wr(sv, 0x20, 1); (void)n2s_wait(sv, 0x20, 3u, 3u); ni_wr(sv, 0x20, 4); ni_wr(sv, 0x20, 0);
+	/* CAMSV_TOP_CTRL::_config */
+	ni_wr(sv, 0x10, 0x50000001); ni_wr(sv, 0x10, 0x40000001);
+	ni_wr(sv, 0x5c, 0); ni_wr(sv, 0x58, 0);
+	ni_wr(sv, 0x14, 1);                                         /* RAW10 */
+	ni_wr(sv, 0x18, 0x31871);
+	ni_wr(sv, 0x10, 0x40000005);
+	ni_wr(sv, 0x4c, 0x09); ni_wr(sv, 0x2d0, 0xe0010); ni_wr(sv, 0x4c, 0x49);   /* PAK: RAW10, mode 2 */
+	ni_wr(sv, 0x800, 0); ni_wr(sv, 0x7b0, 0); ni_wr(sv, 0x7c4, 0xffffffffu); ni_wr(sv, 0x418, 0x61000000u);
+	/* CAMSV_BUF_CTRL::_config, DMAO_CAMSV_B::_config */
+	ni_wr(sv, 0xa00, 0); ni_wr(sv, 0xa00, 0x800);
+	ni_wr(sv, 0x430, stride - 1); ni_wr(sv, 0x434, h - 1); ni_wr(sv, 0x438, stride); ni_wr(sv, 0x438, stride | 0x08070000u);
+	ni_wr(sv, 0x448, 0); ni_wr(sv, 0x43c, 0x80000080u); ni_wr(sv, 0x440, 0x00400030u); ni_wr(sv, 0x444, 0x00200010u);
+	/* CAMSV_TG_CTRL::_enable, CAMSV_BUF_CTRL::_enable, DMAO_CAMSV_B::_enable */
+	ni_wr(sv, 0x130, 0x12001);
+	ni_wr(sv, 0xa00, 0x800); ni_wr(sv, 0xa00, 0x8800); ni_wr(sv, 0xa00, 0x8c00);
+	ni_wr(sv, 0x10, 0x40000015);
+	ni_wr(sv, 0x800, 1);
+	n2v_enqueue(sv, pa, stride * h);
+}
+/* CAMSV_TOP_CTRL::_enable and the view finder (the stock kernel's ISP_VF_LOG): the bit 30 edge arms the DMA */
+static void
+n2v_camsv_go(vm_offset_t sv)
+{
+	ni_wr(sv, 0x30, 0x1); ni_wr(sv, 0x30, 0x5); ni_wr(sv, 0x30, 0x8005);
+	ni_wr(sv, 0x10, 0x15); ni_wr(sv, 0x10, 0x40000015);
+	ni_wr(sv, 0x134, 1);
+}
+
+static void
+n2v_camsv_stop(vm_offset_t sv)
+{
+	ni_wr(sv, 0x134, 0);
+	ni_wr(sv, 0x130, 0x12000);
+	ni_wr(sv, 0x10, 0x40000005);
+	ni_wr(sv, 0x800, 0);
+	ni_wr(sv, 0xa00, 0);
+	ni_wr(sv, 0x30, 0);
+}
+
+static void __attribute__((unused))
+n2v_status(const char *what, vm_offset_t sv, unsigned i)
+{
+	printf("NORD2 CAMSV: %s camsv%u: tg inter %#x frmsize %#x datno %#x module %#x sw %#x fbc %#x/%#x base %#x dma rst %#x busy %#x cnt %#x\n", what, i,
+	    ni_rd(sv, 0x16c), ni_rd(sv, 0x168), ni_rd(sv, 0x160), ni_rd(sv, 0x10), ni_rd(sv, 0x20), ni_rd(sv, 0xa00), ni_rd(sv, 0xa04),
+	    ni_rd(sv, 0x420), ni_rd(sv, 0x400), ni_rd(sv, 0x48), ni_rd(sv, 0x0));
+}
+
+/* what is in a buffer: lines written, high bytes of RAW10, and a 64x48 thumbnail (HakiOS tools/camthumb.py) */
+static void __attribute__((unused))
+n2v_look(unsigned b, uint32_t w, uint32_t h, uint32_t stride)
+{
+	volatile uint8_t *p = (volatile uint8_t *)n2v_buf[b];
+	n2v_inval(n2v_buf[b], stride * h);
+	unsigned written = 0, first = ~0u, last = 0;
+	uint32_t mn = 255, mx = 0; uint64_t sum = 0, n = 0;
+	for (uint32_t y = 0; y < h; y += 8) {
+		bool any = false;
+		for (uint32_t x = 0; x < stride; x += 97) { if (p[y * stride + x] != 0x5a) { any = true; break; } }
+		if (any) { written++; if (y < first) { first = y; } last = y; }
+	}
+	for (uint32_t y = 0; y < h; y += 16) {
+		for (uint32_t g = 0; g < w / 4; g += 13) {
+			uint8_t v = p[y * stride + g * 5];
+			mn = v < mn ? v : mn; mx = v > mx ? v : mx; sum += v; n++;
+		}
+	}
+	printf("NORD2 CAMSV: buffer %u: %u of %u sampled lines written (first %u last %u), high bytes min %u max %u mean %llu\n", b, written,
+	    (h + 7) / 8, first, last, mn, mx, n ? (unsigned long long)(sum / n) : 0ULL);
+	printf("NORD2 CAMSV: line 0: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x | mid: %02x %02x %02x %02x %02x\n", p[0], p[1], p[2], p[3], p[4],
+	    p[5], p[6], p[7], p[8], p[9], p[(h / 2) * stride + stride / 2], p[(h / 2) * stride + stride / 2 + 1], p[(h / 2) * stride + stride / 2 + 2],
+	    p[(h / 2) * stride + stride / 2 + 3], p[(h / 2) * stride + stride / 2 + 4]);
+	if (!written) { return; }
+	uint32_t cw = w / 64, ch = h / 48;
+	for (uint32_t cy = 0; cy < 48; cy++) {
+		char row[140];
+		for (uint32_t cx = 0; cx < 64; cx++) {
+			uint32_t acc = 0;
+			for (uint32_t s = 0; s < 16; s++) {
+				uint32_t y = cy * ch + (s / 4) * (ch / 4), x = cx * cw + (s % 4) * (cw / 4);
+				const volatile uint8_t *g = p + y * stride + (x / 4) * 5;      /* little-endian 40-bit groups */
+				uint64_t v = (uint64_t)g[0] | (uint64_t)g[1] << 8 | (uint64_t)g[2] << 16 | (uint64_t)g[3] << 24 | (uint64_t)g[4] << 32;
+				acc += (uint32_t)(v >> (10 * (x % 4) + 2)) & 0xff;
+			}
+			snprintf(row + cx * 2, 3, "%02x", acc / 16);
+		}
+		printf("NORD2 CAMSV: THUMB %02u: %s\n", cy, row);
+	}
+}
+
+/* T2b: before the sensor streams: the receiver on its port, cam mux 3, CAMSV 0 armed on buffer 0 */
+static bool __attribute__((unused))
+n2v_start(const char *name, int port, bool cphy, int lanes, int64_t rate, uint32_t w, uint32_t h)
+{
+	uint32_t stride = w * 10 / 8;
+	n2v_map();
+	if (!n2v_alloc(stride * h + 4096)) { printf("NORD2 CAMSV: %s: no buffer for %u bytes\n", name, stride * h); return false; }
+	memset((void *)n2v_buf[0], 0x5a, stride * h + 64); n2v_inval(n2v_buf[0], stride * h + 64);
+	printf("NORD2 CAMSV: %s STEP rx next (port %d %s)\n", name, port, cphy ? "C-PHY" : "D-PHY");
+	n2s_rx(port, cphy, lanes, rate);
+	printf("NORD2 CAMSV: %s STEP rx done\n", name);
+	n2v_cammux(w, h);
+	printf("NORD2 CAMSV: %s: camsv%u -> pa %#llx, %ux%u stride %u\n", name, N2V_SV, (unsigned long long)n2v_pa[0], w, h, stride);
+	n2v_camsv_cfg(n2v_sv[N2V_SV], w, h, stride, n2v_pa[0]);
+	n2v_camsv_go(n2v_sv[N2V_SV]);
+	return true;
+}
+static void __attribute__((unused))
+n2v_finish(const char *name, uint32_t w, uint32_t h)
+{
+	uint32_t stride = w * 10 / 8;
+	for (unsigned t = 0; t < 4; t++) {
+		n2c_sleep(150);
+		n2v_status(name, n2v_sv[N2V_SV], N2V_SV);
+		n2s_report(name);
+	}
+	n2v_camsv_stop(n2v_sv[N2V_SV]);
+	n2c_sleep(50);
+	n2v_look(0, w, h, stride);
+}
--- a/bsd/dev/nord2_camdev.inc
+++ b/bsd/dev/nord2_camdev.inc
@@ -0,0 +1,379 @@
+/*
+ * nord2_camdev.inc - /dev/redwood-camera for the Nord 2: HakiOS' camera ABI (hakios-xnu-kernel, branch mtk,
+ * xnu/files/bsd/sys/redwood_camera.h, RWFRAME1) and the session logic of its MediaTek skeleton
+ * (xnu/files/bsd/dev/redwood_mtkcam_skel.c), with three sensors instead of one:
+ *   sensor 1 = the wide (main) camera IMX766, 2 = the front IMX615, 3 = the ultra-wide IMX355
+ *   (the numbers of the frame header's `sensor` field; REDWOOD_CAMERA_SENSOR switches, the next read starts it).
+ * A session starts when something reads and ends when nothing has for 4 s. Frames are MIPI RAW10 (4 pixels in 5
+ * bytes) as the DMA writes them (CAMSV PAK RAW10). A frame is done when the last 64 bytes of its buffer are no longer
+ * the fill pattern (HakiOS' rule); the DMA is then pointed at the next free buffer.
+ * Gain over the ABI is linear, 256 = 1x (gain_unity 256); the kernel turns it into the Sony code
+ * (code = 1024 - 1024 * 256 / gain, the OnePlus drivers' gain2reg with BASEGAIN 64 -> 1024 scale).
+ */
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+
+#define REDWOOD_CAMERA_MAGIC "RWFRAME1"
+struct redwood_camera_frame {
+	char magic[8]; uint32_t header_bytes, width, height, stride, format, bayer, black;
+	uint64_t sequence, time;
+	uint32_t exposure_lines, line_ns, gain, gain_unity, gain_max, frame_lines, frame_lines_min, frame_lines_max, margin, sensor;
+	uint32_t reserved[6];
+};
+enum { REDWOOD_CAMERA_EXPOSURE = 1, REDWOOD_CAMERA_KEEP = 2, REDWOOD_CAMERA_SENSOR = 3 };
+struct redwood_camera_command { uint32_t command, bytes, a, b, c, d; };
+
+#define N2D_NBUF 3
+#define N2D_FILL 0x5a
+#define N2D_IDLE_MS 4000u
+
+/* per sensor (index into n2c_sensors): ABI number, Bayer order and black level of its preview mode, line time */
+struct n2d_info { uint32_t abi, bayer, black, line_ns, frame_lines, margin, gain_max; };
+static const struct n2d_info n2d_info[N2C_NSENSORS] = {
+	/* IMX766: 4096x3072 QBIN, Bayer B first (SENSOR_OUTPUT_FORMAT_RAW_4CELL_HW_BAYER_B, HV mirror) = BGGR; 15616/1488 MHz */
+	[N2C_IMX766] = { 1, 3, 64, 10495, 3176, 48, 64 * 256 },
+	/* IMX615: 3280x2464, R first (RAW_4CELL_HW_BAYER_R, normal) = RGGB; 3768/597.6 MHz */
+	[N2C_IMX615] = { 2, 0, 64, 6305, 2642, 48, 16 * 256 },
+	/* IMX355: 3264x2448, B first (RAW_B, HV mirror) = BGGR; 3672/280.8 MHz */
+	[N2C_IMX355] = { 3, 3, 64, 13077, 2548, 10, 16 * 256 },
+	[N2C_GC02M1B] = { 0, 0, 64, 26095, 1276, 16, 12 * 256 },
+};
+
+static LCK_GRP_DECLARE(n2d_grp, "nord2-camera");
+static LCK_MTX_DECLARE(n2d_lock, &n2d_grp);
+enum { N2D_FREE, N2D_DMA, N2D_READY, N2D_READING };
+static struct { int state; uint64_t seq, time; uint32_t exp, gain, frame; } n2d_slot[N2D_NBUF];
+static vm_offset_t n2d_buf[N2D_NBUF];
+static uint64_t n2d_pa[N2D_NBUF];
+static uint32_t n2d_bufsz;
+static unsigned n2d_sensor = N2C_IMX766, n2d_want_sensor = N2C_IMX766;
+static int n2d_dma = -1;                       /* the buffer the DMA writes now */
+static uint32_t n2d_opens;
+static bool n2d_wanted, n2d_streaming, n2d_reading, n2d_broken, n2d_made;
+static uint64_t n2d_seq, n2d_given, n2d_last_read_ms;
+static struct { bool pending; uint32_t lines, gain, frame; } n2d_ask;
+static uint32_t n2d_cur_exp = 1000, n2d_cur_gain = 256, n2d_cur_frame;
+static uint8_t n2d_chunk[8 * 5120];
+
+static uint64_t
+n2d_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static uint32_t n2d_stride(unsigned s) { return n2c_sensors[s].w * 10 / 8; }
+
+static bool
+n2d_alloc(uint32_t bytes)
+{
+	if (bytes > N2V_BUF_BYTES - 4096) { return false; }
+	if (n2d_buf[0]) { return true; }
+	for (unsigned i = 0; i < N2D_NBUF; i++) {            /* the fixed claim below 4 GB (nord2_camsv.inc), 3 x 16 MiB */
+		n2d_pa[i] = N2V_BUF_PA + (uint64_t)i * N2V_BUF_BYTES;
+		n2d_buf[i] = ml_io_map_unmappable(n2d_pa[i], N2V_BUF_BYTES, VM_WIMG_DEFAULT);
+		if (!n2d_buf[i]) { printf("NORD2 CAMERA: buffer %u cannot be mapped\n", i); return false; }
+	}
+	n2d_bufsz = N2V_BUF_BYTES;
+	return true;
+}
+
+/* rails, the MDP and CAM domains, clocks, SMI: once, at the first session (n2c_t1's first half) */
+static bool n2d_plat_ok, n2d_plat_tried;
+static bool
+n2d_platform(void)
+{
+	if (n2d_plat_tried) { return n2d_plat_ok; }
+	n2d_plat_tried = true;
+	n2c_top = ml_io_map_unmappable(0x10000000, 0x1000, VM_WIMG_IO);
+	if (!n2c_lvl(29)) { n2c_out(29, true); }
+	n2c_out(133, true);
+	n2c_sleep(5);
+	(void)n2c_fan_setup();
+	if (!n2c_vcamio(1)) { printf("NORD2 CAMERA: VCAMIO FAILED\n"); return false; }
+	n2c_sleep(2);
+	n2c_seninf_ok = n2s_init();
+	n2v_map();
+	n2d_plat_ok = n2c_seninf_ok;
+	return n2d_plat_ok;
+}
+
+static void
+n2d_arm(unsigned b)                            /* the fill pattern at the end of buffer b, then the DMA's */
+{
+	uint32_t size = n2d_stride(n2d_sensor) * n2c_sensors[n2d_sensor].h;
+	memset((void *)(n2d_buf[b] + size - 64), N2D_FILL, 64);
+	n2v_inval(n2d_buf[b] + size - 64, 64);
+	n2d_slot[b].state = N2D_DMA;
+	n2d_dma = (int)b;
+	n2v_enqueue(n2v_sv[N2V_SV], n2d_pa[b], size);
+}
+
+/* Sony exposure, gain and frame length (OnePlus write_shutter / set_gain: 0x0104 group hold) */
+static void
+n2d_set_exposure(uint32_t lines, uint32_t gain, uint32_t frame)
+{
+	const struct n2d_info *in = &n2d_info[n2d_sensor];
+	if (gain < 256) { gain = 256; }
+	if (gain > in->gain_max) { gain = in->gain_max; }
+	if (!frame || frame < lines + in->margin) { frame = lines + in->margin; }
+	if (frame < in->frame_lines) { frame = in->frame_lines; }
+	if (frame > 0xffff) { frame = 0xffff; }
+	if (lines > frame - in->margin) { lines = frame - in->margin; }
+	if (lines < 1) { lines = 1; }
+	uint32_t code = 1024 - (1024 * 256) / gain;
+	n2c_s = &n2c_sensors[n2d_sensor];
+	(void)n2c_s_wr(0x0104, 1);
+	(void)n2c_s_wr(0x0340, (uint8_t)(frame >> 8)); (void)n2c_s_wr(0x0341, (uint8_t)frame);
+	(void)n2c_s_wr(0x0202, (uint8_t)(lines >> 8)); (void)n2c_s_wr(0x0203, (uint8_t)lines);
+	(void)n2c_s_wr(0x0204, (uint8_t)(code >> 8)); (void)n2c_s_wr(0x0205, (uint8_t)code);
+	(void)n2c_s_wr(0x0104, 0);
+	n2d_cur_exp = lines; n2d_cur_gain = gain; n2d_cur_frame = frame;
+}
+
+static bool
+n2d_start(unsigned s)
+{
+	const struct n2c_sensor *se = &n2c_sensors[s];
+	uint32_t stride = n2d_stride(s), size = stride * se->h;
+	if (se->port < 0) { printf("NORD2 CAMERA: %s has no receiver port yet\n", se->name); return false; }
+	if (!n2d_platform() || !n2d_alloc(5120 * 3072 + 4096)) { return false; }
+	n2c_s = se;
+	n2d_sensor = s;
+	if (!n2c_power(s, true)) { (void)n2c_power(s, false); return false; }
+	n2c_bus_init(se->bus);
+	int hi = n2c_s_rd(se->idreg_hi), lo = n2c_s_rd(se->idreg_lo);
+	if (hi != (se->id >> 8) || lo != (se->id & 0xff)) {
+		printf("NORD2 CAMERA: %s chip id %#x %#x: not there\n", se->name, hi, lo);
+		(void)n2c_power(s, false);
+		return false;
+	}
+	(void)n2c_s_table(se->init, se->init_n);
+	(void)n2c_s_wr(0x0101, se->mirror);
+	(void)n2c_s_table(se->mode, se->mode_n);
+	n2d_set_exposure(n2d_info[s].frame_lines / 2, 2 * 256, 0);
+	for (unsigned k = 0; k < N2D_NBUF; k++) { memset((void *)(n2d_buf[k] + size - 64), N2D_FILL, 64); n2v_inval(n2d_buf[k] + size - 64, 64); n2d_slot[k].state = N2D_FREE; }
+	/* the receiver and CAMSV armed on buffer 0 first, then the stream */
+	n2v_xoff = s == N2C_IMX615 ? 8 : 0;
+	n2s_rx(se->port, se->cphy, se->lanes, se->pixel_rate);
+	n2v_cammux(se->w, se->h);
+	n2d_slot[0].state = N2D_DMA; n2d_dma = 0;
+	n2v_camsv_cfg(n2v_sv[N2V_SV], se->w, se->h, stride, n2d_pa[0]);
+	n2v_camsv_go(n2v_sv[N2V_SV]);
+	(void)n2c_s_wr(0x0100, 1);
+	n2d_sensor = s;
+	printf("NORD2 CAMERA: %s streaming %ux%u RAW10\n", se->name, se->w, se->h);
+	return true;
+}
+
+static void
+n2d_stop(unsigned s)
+{
+	n2v_camsv_stop(n2v_sv[N2V_SV]);
+	n2c_s = &n2c_sensors[s];
+	(void)n2c_s_wr(0x0100, 0);
+	n2c_sleep(40);
+	(void)n2c_power(s, false);
+	n2d_dma = -1;
+}
+
+/* a session: one sensor until nobody reads */
+static bool
+n2d_session(unsigned s)
+{
+	uint32_t size = n2d_stride(s) * n2c_sensors[s].h;
+	uint64_t last_frame = n2d_ms();
+	if (!n2d_start(s)) { return false; }
+	lck_mtx_lock(&n2d_lock);
+	n2d_given = 0; n2d_streaming = true; n2d_last_read_ms = n2d_ms();
+	lck_mtx_unlock(&n2d_lock);
+	for (;;) {
+		bool stop = false;
+		int b = n2d_dma;
+		if (b >= 0) {
+			n2v_inval(n2d_buf[b] + size - 64, 64);
+			const volatile uint8_t *tail = (const volatile uint8_t *)(n2d_buf[b] + size - 64);
+			bool done = false;
+			for (unsigned k = 0; k < 64; k++) { if (tail[k] != N2D_FILL) { done = true; break; } }
+			if (done) {
+				lck_mtx_lock(&n2d_lock);
+				for (unsigned i = 0; i < N2D_NBUF; i++) { if (n2d_slot[i].state == N2D_READY) { n2d_slot[i].state = N2D_FREE; } }
+				n2d_slot[b].state = N2D_READY;
+				n2d_slot[b].seq = ++n2d_seq;
+				n2d_slot[b].time = mach_absolute_time();
+				n2d_slot[b].exp = n2d_cur_exp; n2d_slot[b].gain = n2d_cur_gain; n2d_slot[b].frame = n2d_cur_frame;
+				int next = -1;
+				for (unsigned i = 1; i <= N2D_NBUF; i++) { unsigned c = ((unsigned)b + i) % N2D_NBUF; if (n2d_slot[c].state == N2D_FREE) { next = (int)c; break; } }
+				wakeup(&n2d_seq);
+				lck_mtx_unlock(&n2d_lock);
+				if (next >= 0) { n2d_arm((unsigned)next); } else { n2d_dma = -1; }
+				last_frame = n2d_ms();
+			}
+		} else {
+			lck_mtx_lock(&n2d_lock);
+			for (unsigned i = 0; i < N2D_NBUF; i++) { if (n2d_slot[i].state == N2D_FREE) { lck_mtx_unlock(&n2d_lock); n2d_arm(i); lck_mtx_lock(&n2d_lock); break; } }
+			lck_mtx_unlock(&n2d_lock);
+		}
+		lck_mtx_lock(&n2d_lock);
+		if (n2d_ask.pending) {
+			uint32_t l = n2d_ask.lines, g = n2d_ask.gain, f = n2d_ask.frame;
+			n2d_ask.pending = false;
+			lck_mtx_unlock(&n2d_lock);
+			n2d_set_exposure(l, g, f);
+			lck_mtx_lock(&n2d_lock);
+		}
+		if (n2d_opens == 0 || n2d_ms() - n2d_last_read_ms > N2D_IDLE_MS || n2d_want_sensor != s) {
+			stop = true;
+		} else if (n2d_ms() - last_frame > 3000u) {
+			printf("NORD2 CAMERA: no frame for 3 s\n");
+			stop = true;
+		}
+		lck_mtx_unlock(&n2d_lock);
+		if (stop) { break; }
+		n2c_sleep(3);
+	}
+	lck_mtx_lock(&n2d_lock);
+	n2d_streaming = false;
+	lck_mtx_unlock(&n2d_lock);
+	n2d_stop(s);
+	printf("NORD2 CAMERA: session of %s stopped after %llu frames\n", n2c_sensors[s].name, n2d_seq);
+	return n2d_ms() - last_frame <= 3000u;
+}
+
+static int
+n2d_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	if (n2d_broken) { return EIO; }
+	lck_mtx_lock(&n2d_lock); n2d_opens++; lck_mtx_unlock(&n2d_lock);
+	return 0;
+}
+
+static int
+n2d_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(&n2d_lock); if (n2d_opens) { n2d_opens--; } lck_mtx_unlock(&n2d_lock);
+	return 0;
+}
+
+static int
+n2d_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct redwood_camera_frame f;
+	uint64_t since = n2d_ms();
+	int b, error = 0;
+	lck_mtx_lock(&n2d_lock);
+	if (n2d_reading) { lck_mtx_unlock(&n2d_lock); return EBUSY; }
+	n2d_reading = true;
+	n2d_last_read_ms = n2d_ms();
+	for (;;) {
+		if (n2d_broken) { error = EIO; break; }
+		b = -1;
+		for (int i = 0; i < N2D_NBUF; i++) {
+			if (n2d_slot[i].state == N2D_READY && n2d_slot[i].seq > n2d_given && (b < 0 || n2d_slot[i].seq > n2d_slot[b].seq)) { b = i; }
+		}
+		if (b >= 0 && n2d_streaming && n2d_sensor == n2d_want_sensor) { break; }
+		if (!n2d_streaming && !n2d_wanted) { n2d_wanted = true; wakeup(&n2d_wanted); }
+		if (n2d_ms() - since > (n2d_streaming ? 3000u : 20000u)) { error = EAGAIN; break; }
+		struct timespec ts = { 0, 50 * NSEC_PER_MSEC };
+		error = msleep(&n2d_seq, &n2d_lock, PZERO | PCATCH, "nord2-camera", &ts);
+		if (error == EWOULDBLOCK) { error = 0; }
+		if (error) { break; }
+		n2d_last_read_ms = n2d_ms();
+	}
+	if (error) { n2d_reading = false; lck_mtx_unlock(&n2d_lock); return error; }
+	unsigned s = n2d_sensor;
+	const struct n2c_sensor *se = &n2c_sensors[s];
+	uint32_t stride = n2d_stride(s);
+	n2d_slot[b].state = N2D_READING;
+	n2d_given = n2d_slot[b].seq;
+	bzero(&f, sizeof(f));
+	memcpy(f.magic, REDWOOD_CAMERA_MAGIC, 8);
+	f.header_bytes = sizeof(f);
+	f.width = se->w; f.height = se->h; f.stride = stride; f.format = 1;
+	f.bayer = n2d_info[s].bayer; f.black = n2d_info[s].black;
+	f.sequence = n2d_slot[b].seq; f.time = n2d_slot[b].time;
+	f.exposure_lines = n2d_slot[b].exp; f.line_ns = n2d_info[s].line_ns;
+	f.gain = n2d_slot[b].gain; f.gain_unity = 256; f.gain_max = n2d_info[s].gain_max;
+	f.frame_lines = n2d_slot[b].frame; f.frame_lines_min = n2d_info[s].frame_lines; f.frame_lines_max = 0xffff;
+	f.margin = n2d_info[s].margin; f.sensor = n2d_info[s].abi;
+	lck_mtx_unlock(&n2d_lock);
+	error = uiomove((caddr_t)&f, (int)MIN(sizeof(f), (size_t)uio_resid(uio)), uio);
+	for (uint32_t y = 0; y < se->h && !error && uio_resid(uio) > 0; y += 8) {
+		uint32_t n = MIN(8u, se->h - y);
+		n2v_inval(n2d_buf[b] + y * stride, n * stride);
+		/* the DMA packs 4 pixels as one little-endian 40-bit word (PAK mode 2); the ABI is MIPI RAW10: 4 high bytes, then the low bits */
+		const uint8_t *src = (const uint8_t *)(n2d_buf[b] + y * stride);
+		for (uint32_t k = 0; k + 5 <= n * stride; k += 5) {
+			uint64_t x = (uint64_t)src[k] | (uint64_t)src[k + 1] << 8 | (uint64_t)src[k + 2] << 16 | (uint64_t)src[k + 3] << 24 | (uint64_t)src[k + 4] << 32;
+			uint32_t p0 = (uint32_t)x & 0x3ff, p1 = (uint32_t)(x >> 10) & 0x3ff, p2 = (uint32_t)(x >> 20) & 0x3ff, p3 = (uint32_t)(x >> 30) & 0x3ff;
+			n2d_chunk[k] = (uint8_t)(p0 >> 2); n2d_chunk[k + 1] = (uint8_t)(p1 >> 2); n2d_chunk[k + 2] = (uint8_t)(p2 >> 2); n2d_chunk[k + 3] = (uint8_t)(p3 >> 2);
+			n2d_chunk[k + 4] = (uint8_t)((p0 & 3) | (p1 & 3) << 2 | (p2 & 3) << 4 | (p3 & 3) << 6);
+		}
+		error = uiomove((caddr_t)n2d_chunk, (int)MIN((user_ssize_t)(n * stride), uio_resid(uio)), uio);
+	}
+	lck_mtx_lock(&n2d_lock);
+	n2d_slot[b].state = N2D_FREE;
+	n2d_reading = false;
+	n2d_last_read_ms = n2d_ms();
+	lck_mtx_unlock(&n2d_lock);
+	return error;
+}
+
+static int
+n2d_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct redwood_camera_command c = { 0, 0, 0, 0, 0, 0 };
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c) || uiomove((caddr_t)&c, sizeof(c), uio) != 0) { return EINVAL; }
+	switch (c.command) {
+	case REDWOOD_CAMERA_EXPOSURE:
+		lck_mtx_lock(&n2d_lock); n2d_ask.lines = c.a; n2d_ask.gain = c.b; n2d_ask.frame = c.c; n2d_ask.pending = true; lck_mtx_unlock(&n2d_lock);
+		return 0;
+	case REDWOOD_CAMERA_SENSOR:
+		for (unsigned s = 0; s < N2C_NSENSORS; s++) {
+			if (n2d_info[s].abi == c.a && c.a != 0) {
+				lck_mtx_lock(&n2d_lock); n2d_want_sensor = s; lck_mtx_unlock(&n2d_lock);
+				printf("NORD2 CAMERA: sensor %u asked (%s)\n", c.a, n2c_sensors[s].name);
+				return 0;
+			}
+		}
+		return EINVAL;
+	case REDWOOD_CAMERA_KEEP:
+		return ENOSPC;
+	default:
+		return EINVAL;
+	}
+}
+
+static const struct cdevsw n2d_cdevsw = {
+	.d_open = n2d_open, .d_close = n2d_close, .d_read = n2d_read, .d_write = n2d_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+n2d_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	unsigned failed = 0;
+	int major = cdevsw_add(-1, &n2d_cdevsw);
+	n2d_made = major >= 0 && devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-camera") != NULL;
+	printf("NORD2 CAMERA: /dev/redwood-camera %s (sensors: 1 wide IMX766, 2 front IMX615, 3 ultra-wide IMX355)\n", n2d_made ? "made" : "CANNOT BE MADE");
+	while (n2d_made && !n2d_broken) {
+		struct timespec ts = { 1, 0 };
+		lck_mtx_lock(&n2d_lock);
+		while (!n2d_wanted) { (void)msleep(&n2d_wanted, &n2d_lock, PZERO, "nord2-camera-idle", &ts); }
+		n2d_wanted = false;
+		unsigned s = n2d_want_sensor;
+		bool any = n2d_opens != 0;
+		lck_mtx_unlock(&n2d_lock);
+		if (!any) { continue; }
+		if (!n2d_session(s)) {
+			if (++failed >= 5) { printf("NORD2 CAMERA: five sessions failed: given up\n"); n2d_broken = true; }
+		} else {
+			failed = 0;
+		}
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
