+static int csirx_phy_init(struct seninf_ctx *ctx)
+{
+	/* phyA init */
+	csirx_phyA_init(ctx);
+
+	/* phyD init */
+	csirx_dphy_init(ctx);
+	csirx_cphy_init(ctx);
+
+	return 0;
+}
