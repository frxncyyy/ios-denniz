+/*
+ * The receiver. On the iPhone X the receiver is on the codec ("Codec", Device_Codec_Aspen in the virtual
+ * audio device), the speaker on its own amplifier device ("Speaker"): the virtual audio device makes the
+ * receiver port of the codec's output element RECEIVER_ELEMENT (it must have a mute control there), and a
+ * call is switched between the two ports by which device's output stream it keeps active
+ * (kAudioStreamPropertyIsActive) and by the receiver's mute. The call's audio itself is the kernel's
+ * (modem -> AFE -> amplifiers); what the plug-in passes on is where iOS puts the call, the call volume iOS
+ * sets on each port's volume control and the input's mute. With the lock held.
+ */
+static void
+route_to_kernel(const char *why)
+{
+	int route, receiver_on = !inactive[OBJECT_CODEC_OUTPUT] && !receiver_muted, speaker_on = !inactive[OBJECT_SPEAKER_OUTPUT];
+	uint32_t r;
+
+	say("redwood: audio: %s: codec output %s, receiver %s, speaker output %s\n", why,
+	    inactive[OBJECT_CODEC_OUTPUT] ? "inactive" : "active", receiver_muted ? "muted" : "unmuted",
+	    inactive[OBJECT_SPEAKER_OUTPUT] ? "inactive" : "active");
+	if (receiver_on == speaker_on) {
+		return;                 /* both or neither: not a choice between them */
+	}
+	route = receiver_on ? 0 : 1;
+	if (route == call_route) {
+		return;
+	}
+	r = (uint32_t)route;
+	if (sink < 0 || ioctl(sink, REDWOOD_AUDIO_SET_CALL_ROUTE, &r) < 0) {
+		say("redwood: audio: the call route (%s) could not be given to the kernel (%s)\n", route ? "speaker" : "receiver",
+		    strerror(errno));
+		return;
+	}
+	call_route = route;
+	say("redwood: audio: calls are heard on the %s\n", route ? "speaker" : "receiver");
+}
+
+static void
+call_volume_to_kernel(uint32_t port, Float32 scalar)
+{
+	struct redwood_audio_call_volume v = { port, (uint32_t)lround(-scalar_to_db(scalar) * 8), scalar <= 0 };
+
+	if (sink < 0 || ioctl(sink, REDWOOD_AUDIO_SET_CALL_VOLUME, &v) < 0) {
+		say("redwood: audio: the %s's call volume %.3f could not be given to the kernel (%s)\n", port ? "speaker" : "receiver",
+		    scalar, strerror(errno));
+	}
+}
+
+static void
+mic_mute_to_kernel(void)
+{
+	uint32_t m = mic_muted != 0 || mic_muted1 != 0 || speaker_in_muted != 0;
+
+	if (sink < 0 || ioctl(sink, REDWOOD_AUDIO_SET_CALL_MUTE, &m) < 0) {
+		say("redwood: audio: the microphone's mute (%u) could not be given to the kernel (%s)\n", m, strerror(errno));
+		return;
+	}
+	say("redwood: audio: the microphone is %s\n", m ? "muted" : "unmuted");
+}
