+/*
+ * The receiver. On the iPhone X the virtual audio device makes a receiver port (beside the speaker port)
+ * of a built-in device whose last output stream answers kNord2StreamPropertyReceiver, and switches a call
+ * between the two by which of the device's output streams it keeps active (kAudioStreamPropertyIsActive).
+ * The call's audio itself is the kernel's (modem -> AFE -> amplifiers); what the plug-in passes on is
+ * where iOS puts the call and the call volume iOS sets on each port's volume control. With the lock held.
+ */
+static void
+route_to_kernel(void)
+{
+	int route;
+	uint32_t r;
+
+	if (inactive[OBJECT_SPEAKER_RECEIVER] == inactive[OBJECT_SPEAKER_OUTPUT]) {
+		return;                 /* both or neither: not a choice between them */
+	}
+	route = inactive[OBJECT_SPEAKER_RECEIVER] ? 1 : 0;
+	if (route == call_route) {
+		return;
+	}
+	r = (uint32_t)route;
+	if (sink < 0 || ioctl(sink, REDWOOD_AUDIO_SET_CALL_ROUTE, &r) < 0) {
+		say("redwood: audio: the call route (%s) could not be given to the kernel (%s)\n", route ? "speaker" : "receiver",
+		    strerror(errno));
+		return;
+	}
+	call_route = route;
+	say("redwood: audio: calls are heard on the %s\n", route ? "speaker" : "receiver");
+}
+
+static void
+call_volume_to_kernel(uint32_t port, Float32 scalar)
+{
+	struct redwood_audio_call_volume v = { port, (uint32_t)lround(-scalar_to_db(scalar) * 8), scalar <= 0 };
+
+	if (sink < 0 || ioctl(sink, REDWOOD_AUDIO_SET_CALL_VOLUME, &v) < 0) {
+		say("redwood: audio: the %s's call volume %.3f could not be given to the kernel (%s)\n", port ? "speaker" : "receiver",
+		    scalar, strerror(errno));
+	}
+}
