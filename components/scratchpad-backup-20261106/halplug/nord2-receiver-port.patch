+/*
+ * Nord2 call audio (kernel patch 0280; a call's audio never passes through the plug-in):
+ * ioctl(REDWOOD_AUDIO_SET_CALL_ROUTE): where the call is heard, as iOS routes it (the Phone app's speaker
+ * button): 0 the receiver (earpiece), 1 the speaker.
+ * ioctl(REDWOOD_AUDIO_SET_CALL_VOLUME): iOS's call volume, the volume control of the port the call is on
+ * (port 0 receiver, port 1 speaker), in eighths of a dB under its top as for REDWOOD_AUDIO_SET_VOLUME.
+ */
+#define REDWOOD_AUDIO_SET_CALL_ROUTE _IOW('r', 2, uint32_t)
+struct redwood_audio_call_volume {
+	uint32_t port;                  /* 0 receiver, 1 speaker */
+	uint32_t below;                 /* eighths of a dB */
+	uint32_t muted;
+};
+#define REDWOOD_AUDIO_SET_CALL_VOLUME _IOW('r', 3, struct redwood_audio_call_volume)
