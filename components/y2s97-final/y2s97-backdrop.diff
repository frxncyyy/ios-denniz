diff -ruN base-src-y2s96/rw-backdrop-host-test.sh src/rw-backdrop-host-test.sh
--- base-src-y2s96/rw-backdrop-host-test.sh	1970-01-01 01:00:00.000000000 +0100
+++ src/rw-backdrop-host-test.sh	2026-11-13 16:36:32.435735760 +0100
@@ -0,0 +1,6 @@
+#!/bin/bash
+# y2s97: rw_backdrop_pure.h (the backdrop-rename matcher) on the build machine, ASan/UBSan, -Werror. Prints 'rw_backdrop: ok ...'.
+set -euo pipefail
+D=$(cd "$(dirname "$0")" && pwd); T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
+cc -std=c11 -O1 -g -Wall -Wextra -Werror -fsanitize=address,undefined -fno-sanitize-recover=all -o "$T/t" "$D/rw_backdrop_host_test.c"
+"$T/t"
diff -ruN base-src-y2s96/rw_backdrop_host_test.c src/rw_backdrop_host_test.c
--- base-src-y2s96/rw_backdrop_host_test.c	1970-01-01 01:00:00.000000000 +0100
+++ src/rw_backdrop_host_test.c	2026-11-13 16:36:40.269588106 +0100
@@ -0,0 +1,389 @@
+/*
+ * y2s97: rw_backdrop_pure.h on the build machine. (1) hand-made cases, one per rule; (2) a fuzz: random command buffers over a
+ * few textures (biased towards the capture pattern) are run through an abstract executor -- every texture's content is a hash
+ * of what made it, every read is logged -- before and after the rewrite redwoodmetal.m applies (rw_bdr_rewrite's mirror,
+ * below); wherever rwb_find matches, final contents and every read must be identical. Prints 'rw_backdrop: ok ...'.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rw_backdrop_pure.h"
+
+#define CHECK(c, what) do { if (!(c)) { printf("FAIL %s (line %d)\n", what, __LINE__); exit(1); } } while (0)
+#define NT 6
+#define MAXS 40
+
+static struct rwb_step
+mk(int kind)
+{
+	struct rwb_step s;
+
+	memset(&s, 0, sizeof(s));
+	s.kind = (uint8_t)kind;
+	s.depth = s.src = s.dst = -1;
+	for (int i = 0; i < 8; i++) {
+		s.color[i] = -1;
+	}
+	for (int i = 0; i < RWB_TEX; i++) {
+		s.tex[i] = -1;
+	}
+	s.c0_base = 1;
+	return s;
+}
+static struct rwb_step
+pass(int t, int load, int sampled)
+{
+	struct rwb_step s = mk(RWB_DRAW);
+
+	s.color[0] = t;
+	s.ncolor = 1;
+	s.load0 = (uint8_t)load;
+	if (sampled >= 0) {
+		s.tex[0] = sampled;
+		s.ntex = 1;
+	}
+	return s;
+}
+static struct rwb_step
+copy(int src, int dst, int full)
+{
+	struct rwb_step s = mk(RWB_COPY);
+
+	s.src = src;
+	s.dst = dst;
+	s.copy_full = (uint8_t)full;
+	s.copy_shape = 1;
+	s.copy_bok = 1;
+	return s;
+}
+
+static int
+run_find(const struct rwb_step *st, unsigned n, struct rwb_match *m, int *reason)
+{
+	unsigned rej[RWB_R_N] = { 0 }, cand = 0;
+	int r = rwb_find(st, n, m, rej, &cand);
+
+	*reason = -1;
+	for (int i = 0; i < RWB_R_N; i++) {
+		if (rej[i]) {
+			*reason = i;
+		}
+	}
+	return r;
+}
+
+/* ---- the abstract executor ---- */
+static uint64_t
+mix(uint64_t h, uint64_t v)
+{
+	h ^= v + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+	return h * 0xff51afd7ed558ccdULL;
+}
+struct exec {
+	uint64_t content[NT];
+	uint64_t reads[MAXS * 2];   /* by original step id */
+	int nreads;
+};
+static void
+execute(const struct rwb_step *st, const int *ids, unsigned n, struct exec *e)
+{
+	for (int t = 0; t < NT; t++) {
+		e->content[t] = mix(1000, (uint64_t)t);
+	}
+	memset(e->reads, 0, sizeof(e->reads));
+	for (unsigned i = 0; i < n; i++) {
+		const struct rwb_step *s = &st[i];
+		int id = ids[i];
+		uint64_t in = mix(77, (uint64_t)(id < 0 ? 999 : id));
+
+		if (s->kind == RWB_DRAW || s->kind == RWB_COMPUTE) {
+			for (unsigned j = 0; j < s->ntex; j++) {
+				if (s->tex[j] >= 0) {
+					in = mix(in, e->content[s->tex[j]]);
+				}
+			}
+		}
+		if (s->kind == RWB_COPY) {
+			in = mix(in, e->content[s->src]);
+		}
+		if (id >= 0) {
+			e->reads[id] = in;
+		}
+		if (s->kind == RWB_DRAW || s->kind == RWB_CLEAR) {
+			for (unsigned j = 0; j < s->ncolor; j++) {
+				int t = s->color[j];
+				uint64_t prev = j == 0 ? (s->load0 == RWB_LOAD_LOAD ? e->content[t] : s->load0 == RWB_LOAD_CLEAR ? 5 : 6) : e->content[t];
+
+				/* the pass's result in attachment j: what it started from + what it read + (the draw itself: its id) */
+				e->content[t] = mix(mix(prev, s->kind == RWB_DRAW ? in : 3), (uint64_t)j);
+			}
+			if (s->depth >= 0) {
+				e->content[s->depth] = mix(e->content[s->depth], in);
+			}
+		} else if (s->kind == RWB_COPY) {
+			e->content[s->dst] = s->copy_full ? e->content[s->src] : mix(e->content[s->dst], e->content[s->src]);
+		} else if (s->kind == RWB_COMPUTE) {
+			for (unsigned j = 0; j < s->ntex; j++) {
+				if (s->tex[j] >= 0) {
+					e->content[s->tex[j]] = mix(e->content[s->tex[j]], in);
+				}
+			}
+		}
+	}
+}
+
+/* the mirror of redwoodmetal.m's rewrite: attachment 0 of the S passes in [f, k) -> B, drop k, whole copy B -> S before l */
+static unsigned
+rewrite(const struct rwb_step *st, const int *ids, unsigned n, const struct rwb_match *m, struct rwb_step *out, int *oids)
+{
+	unsigned o = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		if (i == m->k) {
+			continue;
+		}
+		if (i == m->l) {
+			out[o] = copy(m->b, m->s, 1);
+			oids[o++] = -1;
+		}
+		out[o] = st[i];
+		if (i >= m->f && i < m->k && (st[i].kind == RWB_DRAW || st[i].kind == RWB_CLEAR) && st[i].color[0] == m->s) {
+			out[o].color[0] = m->b;
+		}
+		oids[o++] = ids[i];
+	}
+	return o;
+}
+
+static int
+equivalent(const struct rwb_step *st, unsigned n, const struct rwb_match *m)
+{
+	int ids[MAXS] = { 0 }, oids[MAXS + 1] = { 0 };
+	struct rwb_step out[MAXS + 1];
+	struct exec a, b;
+
+	for (unsigned i = 0; i < n; i++) {
+		ids[i] = (int)i;
+	}
+	unsigned on = rewrite(st, ids, n, m, out, oids);
+
+	execute(st, ids, n, &a);
+	execute(out, oids, on, &b);
+	if (memcmp(a.content, b.content, sizeof(a.content)) != 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		if (i != m->k && a.reads[i] != b.reads[i]) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static unsigned rng = 12345;
+static unsigned
+rnd(unsigned n)
+{
+	rng = rng * 1103515245u + 12345u;
+	return (rng >> 8) % n;
+}
+
+static struct rwb_step
+random_step(void)
+{
+	unsigned k = rnd(20);
+	struct rwb_step s;
+
+	if (k < 9) {
+		s = pass((int)rnd(NT), (int)rnd(3), rnd(2) ? (int)rnd(NT) : -1);
+		if (rnd(6) == 0) {
+			s.color[1] = (int)rnd(NT);
+			s.ncolor = 2;
+			if (s.color[1] == s.color[0]) {
+				s.ncolor = 1;
+				s.color[1] = -1;
+			}
+		}
+		if (rnd(10) == 0) {
+			s.depth = (int)rnd(NT);
+		}
+		if (rnd(25) == 0) {
+			s.argbuf = 1;
+		}
+		if (rnd(25) == 0) {
+			s.c0_base = 0;
+		}
+	} else if (k < 15) {
+		int a = (int)rnd(NT), b = (int)rnd(NT);
+
+		s = copy(a, b == a ? (a + 1) % NT : b, rnd(5) != 0);
+		if (rnd(20) == 0) {
+			s.copy_shape = 0;
+		}
+		if (rnd(20) == 0) {
+			s.copy_bok = 0;
+		}
+	} else if (k < 17) {
+		s = mk(RWB_COMPUTE);
+		s.tex[0] = (int)rnd(NT);
+		s.ntex = 1;
+	} else if (k < 18) {
+		s = mk(RWB_OPAQUE);
+	} else {
+		s = mk(RWB_CLEAR);
+		s.color[0] = (int)rnd(NT);
+		s.ncolor = 1;
+		s.load0 = RWB_LOAD_CLEAR;
+	}
+	return s;
+}
+
+int
+main(void)
+{
+	struct rwb_step st[MAXS];
+	struct rwb_match m;
+	int why;
+	unsigned n;
+
+	/* T1 the pattern: S=0 cleared and drawn, copy 0->1 whole, blur 1->2, 2->3, S loaded and drawn sampling 3 */
+	n = 0;
+	st[n++] = pass(0, RWB_LOAD_CLEAR, 4);
+	st[n++] = pass(0, RWB_LOAD_LOAD, 5);
+	st[n++] = copy(0, 1, 1);
+	st[n++] = pass(2, RWB_LOAD_DONTCARE, 1);
+	st[n++] = pass(3, RWB_LOAD_DONTCARE, 2);
+	st[n++] = pass(0, RWB_LOAD_LOAD, 3);
+	CHECK(run_find(st, n, &m, &why) && m.f == 0 && m.k == 2 && m.l == 5 && m.s == 0 && m.b == 1, "T1 match");
+	CHECK(equivalent(st, n, &m), "T1 equivalent");
+	/* T2 partial copy: untouched */
+	st[2].copy_full = 0;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_PARTIAL, "T2 partial");
+	st[2].copy_full = 1;
+	/* T3 S first loaded (not cleared) */
+	st[0].load0 = RWB_LOAD_LOAD;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_FIRST, "T3 first not clear");
+	st[0].load0 = RWB_LOAD_CLEAR;
+	/* T4 S sampled before the copy */
+	st[1].tex[0] = 0;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_SUSED, "T4 S sampled in [f,k)");
+	st[1].tex[0] = 5;
+	/* T5 B sampled before the copy */
+	st[1].tex[0] = 1;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_BUSED, "T5 B used in [f,k)");
+	st[1].tex[0] = 5;
+	/* T6 B written between copy and Load pass */
+	st[3].color[0] = 1;
+	st[3].tex[0] = 4;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_BWRITTEN, "T6 B written in (k,l)");
+	st[3].color[0] = 2;
+	st[3].tex[0] = 1;
+	/* T7 S sampled between copy and Load pass -> the next S use is not a Load pass */
+	st[4].tex[0] = 0;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_LATER, "T7 S sampled in (k,l)");
+	st[4].tex[0] = 2;
+	/* T8 the later S pass clears */
+	st[5].load0 = RWB_LOAD_CLEAR;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_LATER, "T8 later pass clears");
+	st[5].load0 = RWB_LOAD_LOAD;
+	/* T9 nothing after */
+	CHECK(!run_find(st, 5, &m, &why) && why == RWB_R_NOLATER, "T9 no later use");
+	/* T10 opaque blit inside */
+	{
+		struct rwb_step sv = st[3];
+
+		st[3] = mk(RWB_OPAQUE);
+		CHECK(!run_find(st, n, &m, &why) && why == RWB_R_OPAQUE, "T10 opaque");
+		st[3] = sv;
+	}
+	/* T11 argument buffers */
+	st[4].argbuf = 1;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_ARGBUF, "T11 argbuf");
+	st[4].argbuf = 0;
+	/* T12 shape / B shared */
+	st[2].copy_shape = 0;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_SHAPE, "T12 shape");
+	st[2].copy_shape = 1;
+	st[2].copy_bok = 0;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_BSHARED, "T12 b shared");
+	st[2].copy_bok = 1;
+	/* T13 S as attachment 1 of a pass in [f,k) */
+	st[1].color[1] = 0;
+	st[1].ncolor = 2;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_SUSED, "T13 S attachment 1");
+	st[1].color[1] = -1;
+	st[1].ncolor = 1;
+	/* T14 S at another level */
+	st[1].c0_base = 0;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_SUSED, "T14 S level");
+	st[1].c0_base = 1;
+	/* T15 B the attachment 1 of the Load pass */
+	st[5].color[1] = 1;
+	st[5].ncolor = 2;
+	CHECK(!run_find(st, n, &m, &why) && why == RWB_R_LATER, "T15 B attachment of l");
+	st[5].color[1] = -1;
+	st[5].ncolor = 1;
+	/* T16 compute on B between: refused (may write) */
+	{
+		struct rwb_step sv = st[3];
+
+		st[3] = mk(RWB_COMPUTE);
+		st[3].tex[0] = 1;
+		st[3].ntex = 1;
+		CHECK(!run_find(st, n, &m, &why) && why == RWB_R_BWRITTEN, "T16 compute on B");
+		st[3] = sv;
+	}
+	/* T17 a copy of a texture not drawn in this buffer: not a candidate at all */
+	{
+		struct rwb_step t[2] = { copy(4, 1, 1), pass(4, RWB_LOAD_LOAD, -1) };
+		unsigned rej[RWB_R_N] = { 0 }, cand = 0;
+
+		CHECK(!rwb_find(t, 2, &m, rej, &cand) && cand == 0, "T17 not a capture");
+	}
+	CHECK(run_find(st, n, &m, &why) && equivalent(st, n, &m), "T* restored");
+
+	/* fuzz */
+	unsigned tried = 0, matched = 0, rejected = 0, rej_by[RWB_R_N] = { 0 };
+
+	for (int iter = 0; iter < 400000; iter++) {
+		n = 3 + rnd(MAXS - 8);
+		for (unsigned i = 0; i < n; i++) {
+			st[i] = random_step();
+		}
+		if (rnd(2)) {   /* plant the pattern's skeleton at random places */
+			unsigned a = rnd(n), b = rnd(n), c = rnd(n);
+			int S = (int)rnd(NT), Bt = (S + 1 + (int)rnd(NT - 1)) % NT;
+
+			if (a < b && b < c) {
+				st[a] = pass(S, RWB_LOAD_CLEAR, rnd(2) ? (int)rnd(NT) : -1);
+				st[b] = copy(S, Bt, 1);
+				st[c] = pass(S, RWB_LOAD_LOAD, rnd(2) ? (int)rnd(NT) : -1);
+			}
+		}
+		unsigned rej[RWB_R_N] = { 0 }, cand = 0;
+
+		tried++;
+		if (rwb_find(st, n, &m, rej, &cand)) {
+			matched++;
+			if (!equivalent(st, n, &m)) {
+				printf("FAIL fuzz iteration %d: a match whose rewrite is not equivalent (f %u k %u l %u S %d B %d)\n", iter, m.f, m.k,
+				    m.l, m.s, m.b);
+				for (unsigned i = 0; i < n; i++) {
+					printf("  %u kind %d load %d c0 %d c1 %d d %d tex %d src %d dst %d full %d\n", i, st[i].kind, st[i].load0,
+					    st[i].color[0], st[i].color[1], st[i].depth, st[i].tex[0], st[i].src, st[i].dst, st[i].copy_full);
+				}
+				return 1;
+			}
+		}
+		for (int i = 0; i < RWB_R_N; i++) {
+			rejected += rej[i];
+			rej_by[i] += rej[i];
+		}
+	}
+	CHECK(matched > 1000, "fuzz found too few matches to mean anything");
+	printf("rw_backdrop: ok (17 cases; fuzz %u buffers, %u matches all equivalent, %u candidates rejected: partial %u shape %u "
+	    "b-shared %u first %u s-used %u b-used %u opaque %u later %u no-later %u b-written %u argbuf %u)\n", tried, matched,
+	    rejected, rej_by[0], rej_by[1], rej_by[2], rej_by[3], rej_by[4], rej_by[5], rej_by[6], rej_by[7], rej_by[8], rej_by[9],
+	    rej_by[10]);
+	return 0;
+}
diff -ruN base-src-y2s96/rw_backdrop_pure.h src/rw_backdrop_pure.h
--- base-src-y2s96/rw_backdrop_pure.h	1970-01-01 01:00:00.000000000 +0100
+++ src/rw_backdrop_pure.h	2026-11-13 16:35:19.529132153 +0100
@@ -0,0 +1,235 @@
+/*
+ * y2s97 (backdrop capture rename): the MATCHER, pure C over an abstract list of a command buffer's steps, so that it can be
+ * tested on the build machine (rw_backdrop_host_test.c, rw-backdrop-host-test.sh). redwoodmetal.m (rw_bdr_commit) turns the
+ * command buffer's RedwoodMetalWork list into this list, asks rwb_find, and rewrites (or, by default, only counts).
+ *
+ * Pattern (inferred from CoreAnimation's backdrop comment at air_metal.c rwa_texture_copy, NOT yet seen in a trace):
+ *   f: the first step of the command buffer that touches S is a pass into S (attachment 0, level 0, slice 0) whose load is Clear;
+ *   k: a later texture copy S -> B of the WHOLE surface (level 0, slice 0, origin 0, full size; same format and size, one sample,
+ *      2D, one level, one slice; B private: no IOSurface, no buffer, not a view, not a YCbCr plane);
+ *   l: the next step after k that touches S is a pass into S (attachment 0, level 0, slice 0) whose load is Load.
+ * Conditions, every one of them required:
+ *   in [f, k): S only ever as attachment 0 at level 0 / slice 0 (never sampled, never another attachment / depth / copied);
+ *              B not touched at all; no opaque step (a blit whose textures are not known); no argument-buffer pipeline;
+ *   in (k, l): S not touched (by the definition of l); B never WRITTEN (attachment, depth, copy destination, compute texture);
+ *              no opaque step; no argument-buffer pipeline;
+ *   at l:      S only as attachment 0; B not an attachment of it; no argument-buffer pipeline.
+ * Rewrite (redwoodmetal.m): attachment 0 of the S passes in [f, k) becomes B, the copy k is dropped, one whole copy B -> S is
+ * inserted right before l (rwa_texture_copy_whole: S not preloaded). What S and B hold after l is what they held before.
+ * Copyright (c) 2026 ios-sweet contributors.  SPDX-License-Identifier: MIT.
+ */
+#ifndef RW_BACKDROP_PURE_H
+#define RW_BACKDROP_PURE_H
+#include <stdint.h>
+
+enum { RWB_NONE = 0, RWB_DRAW, RWB_CLEAR, RWB_COPY, RWB_OPAQUE, RWB_COMPUTE };
+enum { RWB_LOAD_DONTCARE = 0, RWB_LOAD_LOAD = 1, RWB_LOAD_CLEAR = 2 };
+
+/* rejection reasons, in the order they are checked for a candidate copy */
+enum {
+	RWB_R_PARTIAL = 0,  /* the copy is not of the whole level-0 / slice-0 surface (left untouched, by design) */
+	RWB_R_SHAPE,        /* S and B differ in format / size / samples / type / levels / slices, or S is not plain */
+	RWB_R_BSHARED,      /* B has an IOSurface / buffer / is a view / a YCbCr plane, or B == S */
+	RWB_R_FIRST,        /* the first step touching S is not a Clear pass into S's level 0 / slice 0 */
+	RWB_R_SUSED,        /* S touched in [f, k) other than as attachment 0 at level 0 / slice 0 */
+	RWB_R_BUSED,        /* B touched in [f, k) */
+	RWB_R_OPAQUE,       /* a blit with unknown textures in [f, l) */
+	RWB_R_LATER,        /* the next step touching S after k is not a Load pass into S (or B is an attachment of it) */
+	RWB_R_NOLATER,      /* nothing touches S after k */
+	RWB_R_BWRITTEN,     /* B written in (k, l) */
+	RWB_R_ARGBUF,       /* an argument-buffer pipeline in [f, l] (its textures are not visible here) */
+	RWB_R_TABLE,        /* (redwoodmetal.m) too many steps / textures in the command buffer */
+	RWB_R_LIB,          /* (redwoodmetal.m, rename on) the library has no rwa_texture_copy_whole */
+	RWB_R_N
+};
+
+#define RWB_TEX 32
+struct rwb_step {
+	uint8_t kind;        /* RWB_* */
+	uint8_t load0;       /* draw / clear: attachment 0's load action */
+	uint8_t c0_base;     /* draw / clear: attachment 0 is at level 0, slice 0 */
+	uint8_t argbuf;      /* draw / compute: the pipeline declares argument buffers */
+	uint8_t copy_full;   /* copy: whole level-0 / slice-0 surface, origins 0 */
+	uint8_t copy_shape;  /* copy: same format/size, 1 sample, 2D, 1 level, 1 slice, and the source is plain */
+	uint8_t copy_bok;    /* copy: the destination is private (no IOSurface / buffer / parent / YCbCr) */
+	uint8_t ncolor, ntex;
+	int color[8];        /* texture identities (-1: none) */
+	int depth;
+	int tex[RWB_TEX];
+	int src, dst;        /* copy */
+};
+
+struct rwb_match {
+	unsigned f, k, l;
+	int s, b;
+};
+
+#define RWB_REF_C0    1u   /* attachment 0 */
+#define RWB_REF_OTHER 2u   /* anything else: another attachment, depth, sampled / compute texture, copy source or destination */
+
+static inline unsigned
+rwb_refs(const struct rwb_step *st, int id)
+{
+	unsigned r = 0;
+
+	if (id < 0) {
+		return 0;
+	}
+	if (st->kind == RWB_DRAW || st->kind == RWB_CLEAR) {
+		for (unsigned i = 0; i < st->ncolor && i < 8; i++) {
+			if (st->color[i] == id) {
+				r |= i == 0 ? RWB_REF_C0 : RWB_REF_OTHER;
+			}
+		}
+		if (st->depth == id) {
+			r |= RWB_REF_OTHER;
+		}
+	}
+	if (st->kind == RWB_DRAW || st->kind == RWB_COMPUTE) {
+		for (unsigned i = 0; i < st->ntex && i < RWB_TEX; i++) {
+			if (st->tex[i] == id) {
+				r |= RWB_REF_OTHER;
+			}
+		}
+	}
+	if (st->kind == RWB_COPY && (st->src == id || st->dst == id)) {
+		r |= RWB_REF_OTHER;
+	}
+	return r;
+}
+
+/* does this (known) step write `id`? */
+static inline int
+rwb_writes(const struct rwb_step *st, int id)
+{
+	if (id < 0) {
+		return 0;
+	}
+	if (st->kind == RWB_DRAW || st->kind == RWB_CLEAR) {
+		for (unsigned i = 0; i < st->ncolor && i < 8; i++) {
+			if (st->color[i] == id) {
+				return 1;
+			}
+		}
+		return st->depth == id;
+	}
+	if (st->kind == RWB_COMPUTE) {   /* a compute texture may be written: no way to tell from here */
+		for (unsigned i = 0; i < st->ntex && i < RWB_TEX; i++) {
+			if (st->tex[i] == id) {
+				return 1;
+			}
+		}
+		return 0;
+	}
+	return st->kind == RWB_COPY && st->dst == id;
+}
+
+/* the candidate copy k checked; 0 = it matches (m filled), else 1 + the reason */
+static inline int
+rwb_check(const struct rwb_step *st, unsigned n, unsigned k, struct rwb_match *m)
+{
+	const struct rwb_step *c = &st[k];
+	int s = c->src, b = c->dst;
+	unsigned f, l, j;
+
+	if (!c->copy_full) {
+		return 1 + RWB_R_PARTIAL;
+	}
+	if (!c->copy_shape) {
+		return 1 + RWB_R_SHAPE;
+	}
+	if (!c->copy_bok || s == b || s < 0 || b < 0) {
+		return 1 + RWB_R_BSHARED;
+	}
+	for (f = 0; f < k && rwb_refs(&st[f], s) == 0; f++) {
+	}
+	if (f == k || (st[f].kind != RWB_DRAW && st[f].kind != RWB_CLEAR) || rwb_refs(&st[f], s) != RWB_REF_C0 ||
+	    !st[f].c0_base || st[f].load0 != RWB_LOAD_CLEAR) {
+		return 1 + RWB_R_FIRST;
+	}
+	for (j = f; j < k; j++) {
+		unsigned r = rwb_refs(&st[j], s);
+
+		if (st[j].kind == RWB_OPAQUE) {
+			return 1 + RWB_R_OPAQUE;
+		}
+		if (st[j].argbuf) {
+			return 1 + RWB_R_ARGBUF;
+		}
+		if ((r & RWB_REF_OTHER) || ((r & RWB_REF_C0) && !st[j].c0_base)) {
+			return 1 + RWB_R_SUSED;
+		}
+		if (rwb_refs(&st[j], b) != 0) {
+			return 1 + RWB_R_BUSED;
+		}
+	}
+	for (l = k + 1; l < n && rwb_refs(&st[l], s) == 0 && st[l].kind != RWB_OPAQUE; l++) {
+		if (st[l].argbuf) {
+			return 1 + RWB_R_ARGBUF;
+		}
+		if (rwb_writes(&st[l], b)) {
+			return 1 + RWB_R_BWRITTEN;
+		}
+	}
+	if (l == n) {
+		return 1 + RWB_R_NOLATER;
+	}
+	if (st[l].kind == RWB_OPAQUE) {
+		return 1 + RWB_R_OPAQUE;
+	}
+	if (st[l].argbuf) {
+		return 1 + RWB_R_ARGBUF;
+	}
+	if ((st[l].kind != RWB_DRAW && st[l].kind != RWB_CLEAR) || rwb_refs(&st[l], s) != RWB_REF_C0 || !st[l].c0_base ||
+	    st[l].load0 != RWB_LOAD_LOAD) {
+		return 1 + RWB_R_LATER;
+	}
+	for (unsigned i = 0; i < st[l].ncolor && i < 8; i++) {
+		if (st[l].color[i] == b) {
+			return 1 + RWB_R_LATER;
+		}
+	}
+	if (st[l].depth == b) {
+		return 1 + RWB_R_LATER;
+	}
+	m->f = f;
+	m->k = k;
+	m->l = l;
+	m->s = s;
+	m->b = b;
+	return 0;
+}
+
+/*
+ * The first candidate (a copy whose source was drawn into earlier in the buffer) that matches: 1 and *m; 0 if none does.
+ * Every candidate before it that does not match is counted in rejects[reason]; *candidates counts all that were looked at.
+ */
+static inline int
+rwb_find(const struct rwb_step *st, unsigned n, struct rwb_match *m, unsigned rejects[RWB_R_N], unsigned *candidates)
+{
+	for (unsigned k = 0; k < n; k++) {
+		if (st[k].kind != RWB_COPY || st[k].src < 0) {
+			continue;
+		}
+		unsigned j;
+
+		for (j = 0; j < k; j++) {
+			if ((st[j].kind == RWB_DRAW || st[j].kind == RWB_CLEAR) && st[j].ncolor > 0 && st[j].color[0] == st[k].src) {
+				break;
+			}
+		}
+		if (j == k) {
+			continue;   /* not a capture of something this buffer drew */
+		}
+		(*candidates)++;
+		int r = rwb_check(st, n, k, m);
+
+		if (r == 0) {
+			return 1;
+		}
+		rejects[r - 1]++;
+	}
+	return 0;
+}
+
+#endif
