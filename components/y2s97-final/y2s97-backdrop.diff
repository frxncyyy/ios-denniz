+/*
+ * y2s97 (backdrop rename, redwoodmetal.m rw_bdr_*): the copy that puts the renamed capture back into the screen. It overwrites
+ * every texel of dst's level 0, so -- when it is a GPU blit (the same test as rwa_texture_copy's) -- dst is not preloaded:
+ * rwa_fb_discard_level flushes whatever batch still uses dst and clears its valid bit; the blit's own submit sets it again
+ * (emit_fragment_job), and rwa_fb_flushed / rwa_fb_note_read count a bit found still clear as a violation and set it back.
+ */
+int
+rwa_texture_copy_whole(struct rwa_texture *dst, struct rwa_texture *src, char *why, size_t why_size)
+{
+   RWA_GUARD();
+   static const unsigned zero[3] = { 0, 0, 0 };
+
+   if (!dst || !src) {
+      say(why, why_size, "a whole copy with no %s texture", dst ? "source" : "destination");
+      return -1;
+   }
+   struct pipe_resource *d = dst->res, *s = src->res;
+   const unsigned size[3] = { d->width0, d->height0, 1 };
+   bool discarded = false;
+#ifdef GALLIUM_PANFROST
+   struct pipe_screen *screen = dst->device->screen;
+   enum pipe_format f = src->format;
+   if (!dst->is_view && !src->is_view && f == dst->format && d->width0 == s->width0 && d->height0 == s->height0 &&
+       d->depth0 == 1 && d->array_size == 1 && d->nr_samples <= 1 && d->target == PIPE_TEXTURE_2D &&
+       util_format_get_num_planes(f) == 1 && !util_format_is_depth_or_stencil(f) &&
+       screen->is_format_supported(screen, f, d->target, d->nr_samples, d->nr_storage_samples, PIPE_BIND_RENDER_TARGET) &&
+       screen->is_format_supported(screen, f, s->target, s->nr_samples, s->nr_storage_samples, PIPE_BIND_SAMPLER_VIEW))
+      discarded = rwa_fb_discard_level(dst->device->pipe, d, 0);
+#endif
+   int rc = rwa_texture_copy(dst, 0, 0, zero, src, 0, 0, zero, size, why, why_size);
+#ifdef GALLIUM_PANFROST
+   if (rc != 0 && discarded)
+      rwa_fb_discard_undo(d, 0);
+#endif
+   return rc;
+}
