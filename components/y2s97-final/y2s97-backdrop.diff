 /*
+ * y2s97 (backdrop capture rename). Switches in /var/db/nord2-metal/, read once per process:
+ *   (none)            DRY RUN: every command buffer is matched (rw_backdrop_pure.h) and counted, nothing is changed
+ *   backdrop-rename   the matches are rewritten: the screen's passes before the capture draw into the capture B instead, the
+ *                     whole-surface copy S -> B is dropped, and one whole copy B -> S (S not preloaded) goes right before the
+ *                     pass that Loads S again
+ *   no-backdrop       nothing at all (not even matched)
+ * Lines: once per process 'NORD2 GPU BACKDROP: pid= name= config ...'; the first match and the first 6 rejections of a process
+ * with their step numbers; every 5 s while anything moved 'NORD2 GPU BACKDROP: pid= name= renamed=N would rename=M cbs=..
+ * candidates=.. | rejected partial=.. ... | discards=.. undone=.. violations=..' (discards/undone/violations: the library's
+ * valid-bit guard of the B -> S copy, rwa_pan_fb.c; violations must stay 0).
+ */
+#include "rw_backdrop_pure.h"
+
+static void rw_tex_desc(id t, char *out, size_t n);
+
+static const char *const rw_bdr_reason[RWB_R_N] = {
+	"partial", "shape", "b-shared", "first-not-clear", "s-used", "b-used", "opaque", "later-not-load", "no-later-use",
+	"b-written", "argbuf", "table", "lib"
+};
+static struct {
+	int mode;   /* 1 rename, 0 dry run, -1 off */
+	int (*copy_whole)(struct rwa_texture *dst, struct rwa_texture *src, char *why, size_t why_size);
+	uint64_t cbs, candidates, would, renamed, rej[RWB_R_N];
+	unsigned said;
+} rw_bdr;
+
+static void
+rw_bdr_init(void)
+{
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		BOOL off = access("/var/db/nord2-metal/no-backdrop", F_OK) == 0;
+		BOOL on = access("/var/db/nord2-metal/backdrop-rename", F_OK) == 0;
+
+		rw_bdr.mode = off ? -1 : on ? 1 : 0;
+		if (mesa.handle != NULL) {
+			*(void **)&rw_bdr.copy_whole = dlsym(mesa.handle, "rwa_texture_copy_whole");
+		}
+		m2m_log('I', "FB", "NORD2 GPU BACKDROP: pid=%d name=%s config %s (backdrop-rename %d, no-backdrop %d) library %s\n", getpid(),
+		    getprogname(), off ? "OFF" : on ? "rename ON" : "DRY-RUN (count only)", on, off,
+		    rw_bdr.copy_whole != NULL ? "y2s97 (whole copy without preload)" : "older (no rwa_texture_copy_whole: no rename)");
+	});
+}
+
+/* one identity per memory: a view counts as its root, a texture over a surface or buffer as that surface or buffer */
+static void *
+rw_bdr_key(id t)
+{
+	if (t == nil) {
+		return NULL;
+	}
+	if (![t isKindOfClass:[RedwoodMetalTexture class]]) {
+		return (void *)t;
+	}
+	id root = t;
+
+	while ([root parentTexture] != nil) {
+		root = [root parentTexture];
+	}
+	if ([root iosurface] != nil) {
+		return (void *)[root iosurface];
+	}
+	if ([root buffer] != nil) {
+		return (void *)[root buffer];
+	}
+	return (void *)root;
+}
+
+#define RWB_IDS 256
+#define RWB_STEPS 768
+struct rw_bdr_ids {
+	void *key[RWB_IDS];
+	unsigned n;
+	BOOL full;
+};
+
+static int
+rw_bdr_id(struct rw_bdr_ids *ids, id t)
+{
+	void *k = rw_bdr_key(t);
+
+	if (k == NULL) {
+		return -1;
+	}
+	for (unsigned i = 0; i < ids->n; i++) {
+		if (ids->key[i] == k) {
+			return (int)i;
+		}
+	}
+	if (ids->n == RWB_IDS) {
+		ids->full = YES;
+		return -1;
+	}
+	ids->key[ids->n] = k;
+	return (int)ids->n++;
+}
+
+static BOOL
+rw_bdr_plain(id t, BOOL surface)
+{
+	return [t isKindOfClass:[RedwoodMetalTexture class]] && [(RedwoodMetalTexture *)t redwoodBackdropPlain:surface];
+}
+
+static void
+rw_bdr_say(const char *what, NSArray *works, unsigned f, unsigned k, unsigned l, unsigned n)
+{
+	char a[64] = "?", b[64] = "?";
+
+	if (k < [works count]) {
+		RedwoodMetalWork *c = works[k];
+
+		rw_tex_desc(c->copySrc, a, sizeof(a));
+		rw_tex_desc(c->copyDst, b, sizeof(b));
+	}
+	m2m_log('I', "FB", "NORD2 GPU BACKDROP: pid=%d name=%s %s: steps first %u copy %u load %u of %u, S %s -> B %s\n", getpid(),
+	    getprogname(), what, f, k, l, n, a, b);
+}
+
+static void
+rw_bdr_report_maybe(void)
+{
+	static uint64_t last, prev_sum;
+	static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER;
+	uint64_t now = rw_now_ns(), c[16] = { 0 }, sum = 0;
+
+	if (now - last < 5000000000ULL || pthread_mutex_trylock(&lk) != 0) {
+		return;
+	}
+	if (now - last < 5000000000ULL) {
+		pthread_mutex_unlock(&lk);
+		return;
+	}
+	last = now;
+	if (rw_fb.stats != NULL) {
+		rw_fb.stats(c);
+	}
+	sum = rw_bdr.cbs + rw_bdr.candidates + c[12] + c[13] + c[14];
+	if (sum != prev_sum) {
+		char r[400];
+		size_t at = 0;
+
+		r[0] = 0;
+		for (unsigned i = 0; i < RWB_R_N; i++) {
+			at += (size_t)snprintf(r + at, at < sizeof(r) ? sizeof(r) - at : 0, " %s=%llu", rw_bdr_reason[i],
+			    (unsigned long long)rw_bdr.rej[i]);
+		}
+		m2m_log('I', "FB", "NORD2 GPU BACKDROP: pid=%d name=%s renamed=%llu would rename=%llu cbs=%llu candidates=%llu | rejected%s | "
+		    "discards=%llu undone=%llu violations=%llu (%s)\n", getpid(), getprogname(), (unsigned long long)rw_bdr.renamed,
+		    (unsigned long long)rw_bdr.would, (unsigned long long)rw_bdr.cbs, (unsigned long long)rw_bdr.candidates, r,
+		    (unsigned long long)c[12], (unsigned long long)c[13], (unsigned long long)c[14],
+		    rw_bdr.mode > 0 ? "rename ON" : "DRY-RUN");
+		prev_sum = sum;
+	}
+	pthread_mutex_unlock(&lk);
+}
+
+static void
+rw_bdr_commit(NSMutableArray *works)
+{
+	rw_bdr_init();
+	rw_fb_init();   /* (rw_fb.stats for the report) */
+	if (rw_bdr.mode < 0) {
+		return;
+	}
+	rw_bdr_report_maybe();
+	unsigned n = (unsigned)[works count], i;
+	BOOL any = NO;
+
+	for (RedwoodMetalWork *w in works) {
+		if (w->blit != nil && w->texCopy) {
+			any = YES;
+			break;
+		}
+	}
+	if (!any) {
+		return;
+	}
+	__sync_add_and_fetch(&rw_bdr.cbs, 1);
+	if (n > RWB_STEPS) {
+		__sync_add_and_fetch(&rw_bdr.rej[RWB_R_TABLE], 1);
+		return;
+	}
+	struct rwb_step *st = calloc(n, sizeof(*st));
+	struct rw_bdr_ids *ids = calloc(1, sizeof(*ids));
+	BOOL table = NO;
+
+	if (st == NULL || ids == NULL) {
+		free(st);
+		free(ids);
+		return;
+	}
+	for (i = 0; i < n; i++) {
+		RedwoodMetalWork *w = works[i];
+		struct rwb_step *s = &st[i];
+
+		s->depth = s->src = s->dst = -1;
+		for (unsigned j = 0; j < 8; j++) {
+			s->color[j] = -1;
+		}
+		for (unsigned j = 0; j < RWB_TEX; j++) {
+			s->tex[j] = -1;
+		}
+		if (w->blit != nil) {
+			if (!w->texCopy) {
+				s->kind = RWB_OPAQUE;
+				continue;
+			}
+			s->kind = RWB_COPY;
+			s->src = rw_bdr_id(ids, w->copySrc);
+			s->dst = rw_bdr_id(ids, w->copyDst);
+			s->copy_full = w->copyFull;
+			s->copy_shape = rw_bdr_plain(w->copySrc, YES) && rw_bdr_plain(w->copyDst, YES) &&
+			    [w->copySrc pixelFormat] == [w->copyDst pixelFormat] && [w->copySrc width] == [w->copyDst width] &&
+			    [w->copySrc height] == [w->copyDst height];
+			s->copy_bok = rw_bdr_plain(w->copyDst, NO);
+			continue;
+		}
+		if (w->render != nil || w->clearOnly) {
+			s->kind = w->render != nil ? RWB_DRAW : RWB_CLEAR;
+			s->load0 = (uint8_t)MIN(w->loadAction, 255u);
+			s->ncolor = (uint8_t)MIN(w->colorCount, 8u);
+			for (unsigned j = 0; j < s->ncolor; j++) {
+				s->color[j] = rw_bdr_id(ids, w->color[j]);
+			}
+			s->c0_base = w->colorCount > 0 && w->color[0] != nil && w->colorLevel[0] == 0 && w->colorSlice[0] == 0 &&
+			    w->level == 0 && w->slice == 0 && [w->color[0] isKindOfClass:[RedwoodMetalTexture class]] &&
+			    [w->color[0] parentTexture] == nil;
+			s->depth = rw_bdr_id(ids, w->depth);
+			s->argbuf = w->render != nil && [w->render redwoodHasArgbuf];
+		} else if (w->pipeline != nil) {
+			s->kind = RWB_COMPUTE;
+			s->argbuf = [w->pipeline redwoodHasArgbuf];
+		} else {
+			continue;
+		}
+		if (w->textureCount > RWB_TEX) {
+			table = YES;
+		}
+		s->ntex = (uint8_t)MIN(w->textureCount, (unsigned)RWB_TEX);
+		for (unsigned j = 0; j < s->ntex; j++) {
+			s->tex[j] = rw_bdr_id(ids, w->textures[j]);
+		}
+	}
+	if (table || ids->full) {
+		__sync_add_and_fetch(&rw_bdr.rej[RWB_R_TABLE], 1);
+		free(st);
+		free(ids);
+		return;
+	}
+	unsigned rej[RWB_R_N] = { 0 }, cand = 0;
+	struct rwb_match m;
+	int found = rwb_find(st, n, &m, rej, &cand);
+
+	free(st);
+	free(ids);
+	__sync_add_and_fetch(&rw_bdr.candidates, cand);
+	for (i = 0; i < RWB_R_N; i++) {
+		if (rej[i]) {
+			__sync_add_and_fetch(&rw_bdr.rej[i], rej[i]);
+			if (rw_bdr.said < 6 && __sync_add_and_fetch(&rw_bdr.said, 1) <= 6) {
+				char what[64];
+
+				snprintf(what, sizeof(what), "rejected (%s)", rw_bdr_reason[i]);
+				rw_bdr_say(what, works, 0, n, 0, n);
+			}
+		}
+	}
+	if (!found) {
+		return;
+	}
+	if (rw_bdr.mode == 0) {
+		if (__sync_add_and_fetch(&rw_bdr.would, 1) == 1) {
+			rw_bdr_say("WOULD RENAME (dry run; first match)", works, m.f, m.k, m.l, n);
+		}
+		return;
+	}
+	if (rw_bdr.copy_whole == NULL) {
+		__sync_add_and_fetch(&rw_bdr.rej[RWB_R_LIB], 1);
+		return;
+	}
+	/* ---- the rewrite (rw_backdrop_host_test.c rewrite() is its mirror) ---- */
+	RedwoodMetalWork *cap = works[m.k], *ld = works[m.l];
+	id B = cap->copyDst, S = ld->color[0];
+	void *ks = rw_bdr_key(cap->copySrc);
+
+	if (__sync_add_and_fetch(&rw_bdr.renamed, 1) == 1) {
+		rw_bdr_say("RENAMED (first)", works, m.f, m.k, m.l, n);
+	}
+	for (i = m.f; i < m.k; i++) {
+		RedwoodMetalWork *w = works[i];
+
+		if ((w->render != nil || w->clearOnly) && w->colorCount > 0 && rw_bdr_key(w->color[0]) == ks) {
+			if (w->retained) {
+				[B retain];
+				[w->color[0] release];
+			}
+			w->color[0] = B;
+		}
+	}
+	RedwoodMetalWork *cw = [[RedwoodMetalWork alloc] init];
+	int (*whole)(struct rwa_texture *, struct rwa_texture *, char *, size_t) = rw_bdr.copy_whole;
+
+	cw->blit = Block_copy(^BOOL(char *why, size_t size) {
+		return whole([S mesaTexture], [B mesaTexture], why, size) == 0;
+	});
+	cw->note = strdup("backdrop rename (y2s97): whole copy B -> S, S not preloaded");
+	cw->pass = ld->pass;
+	cw->texCopy = YES;
+	cw->copyFull = YES;
+	cw->copySrc = B;
+	cw->copyDst = S;
+	[cw redwoodRetainReferences];
+	[works removeObjectAtIndex:m.k];         /* (k < l) */
+	[works insertObject:cw atIndex:m.l - 1];
+	[cw release];
+}
+
+/*
  * y2s96 (A, investigation only): with /var/db/nord2-metal/trace-cc present, backboardd does what com.redwood.metal.trace does
  * (the next 3 command buffers written out draw by draw: 'TRACE trace: a command buffer of N steps (asked for)' + one
  * 'TRACE trace:   pass ...' line per step) by itself: first 60 s after its first commit, then every 15 s, 20 times (5 minutes),
@@ -8080,6 +8408,13 @@
 
 /* y2s91 rttouch: a render-pass attachment that writes a plane of a two-plane (YCbCr) surface IN PLACE: the texture to touch at
  * completion (its seed then moves, and every conversion of the surface, in this process or another, follows), or nil */
+- (BOOL)redwoodBackdropPlain:(BOOL)surface
+{
+	return _parent == nil && _buffer == nil && !_copied && !_copiedPlane && !_ycbcr && !_padded && _texture != NULL &&
+	    _shape.sample_count <= 1 && _shape.type == MTLTextureType2D && [self mipmapLevelCount] == 1 && [self arrayLength] == 1 &&
+	    [self depth] == 1 && (surface || _iosurface == NULL) && [self redwoodTGTargetRoot] == nil;
+}
+
 - (RedwoodMetalTexture *)redwoodTGTargetRoot
 {
 	RedwoodMetalTexture *t = self;
@@ -9184,6 +9519,8 @@
 
 - (void)redwoodDoesNotOwnCompute { _kept = YES; }
 
+- (BOOL)redwoodHasArgbuf { return _info.argbuf_mask != 0; }
+
 - (struct rwa_compute *)compute
 {
 	return _compute;
@@ -9244,6 +9581,7 @@
 }
 
 - (struct rwa_render *)render { return _render; }
+- (BOOL)redwoodHasArgbuf { return _info.vertex_argbuf_mask != 0 || _info.fragment_argbuf_mask != 0; }
 - (BOOL)writesDepth           { return _info.fragment_writes_depth != 0; }
 - (unsigned)vertexStreamMask  { return _info.vertex_stream_mask; }
 - (unsigned)colorWriteMasks   { return _info.color_write_masks; }
@@ -10445,6 +10783,7 @@
 		}
 	}
 	_status = RW_CB_COMMITTED;
+	rw_bdr_commit(_work);           /* y2s97: backdrop capture rename (dry run unless backdrop-rename) */
 	rw_fb_single_target(_work);     /* y2s96 (C) */
