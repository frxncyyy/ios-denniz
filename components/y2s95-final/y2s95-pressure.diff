 {
@@ -940,6 +963,7 @@
     */
    device->ubo_offset_align = MAX2(device->screen->caps.constant_buffer_offset_alignment, 1);
    device->ssbo_offset_align = MAX2(device->screen->caps.shader_buffer_offset_alignment, 1);
+   rwa_registry_add(device);   /* y2s95: for rwa_memory_pressure */
 
    return device;
 
@@ -969,6 +993,7 @@
          device->pipe->sampler_view_destroy(device->pipe, device->placeholder[i].view);
       pipe_resource_reference(&device->placeholder[i].res, NULL);
    }
+   rwa_registry_del(device);   /* y2s95 */
    isp_state_destroy(device);
    ycbcr_state_destroy(device);
    device->pipe->destroy(device->pipe);
@@ -1053,6 +1078,50 @@
    return -1;
 #endif
 }
+
+/*
+ * y2s95 (pressure): called by Nord2Metal on a WARN/CRITICAL memory-pressure event of this process (and with flags 0 for the counts
+ * alone). Under rwa_lock, like every other call of this library, so nothing of this process renders through Mesa meanwhile:
+ *   RWA_PRESSURE_BO_CACHE  Panfrost's BO cache of every open device emptied (panfrost_bo_cache_evict_all: buffers Mesa closed and
+ *                          keeps up to 30 s / 64 MiB for reuse; nobody references them; the bo_map lock is taken first, as
+ *                          panfrost_bo_unreference does before the cache lock)
+ *   RWA_PRESSURE_POOL      then the shim's pool (nord2_pan.c) back to the kernel, and no pooling for holdoff_ms
+ * out: [0] BO-cache bytes before [1] after [2] BOs it held before [3] devices; [4..11] = np_pressure's out (see nord2_pan.c).
+ * Returns -1 if this build keeps no such caches.
+ */
+#ifdef GALLIUM_PANFROST
+extern void rwa_pan_evict_bo_cache(struct pipe_screen *screen);   /* rwa_pressure_pan.c */
+extern int np_pressure(int drain, unsigned holdoff_ms, uint64_t out[8]);
+#endif
+
+int
+rwa_memory_pressure(unsigned flags, unsigned holdoff_ms, uint64_t out[12])
+{
+   RWA_GUARD();
+   memset(out, 0, 12 * sizeof(out[0]));
+#ifdef GALLIUM_PANFROST
+   out[0] = p_atomic_read(&redwood_bo_cache_stats.cached_bytes);
+   out[2] = p_atomic_read(&redwood_bo_cache_stats.cached_bos);
+   for (unsigned i = 0; i < RWA_REGISTRY; i++) {
+      struct rwa_device *device = rwa_registry[i];
+
+      if (!device || device->software || !device->screen)
+         continue;
+      out[3]++;
+      if (flags & RWA_PRESSURE_BO_CACHE) {
+         rwa_pan_evict_bo_cache(device->screen);
+      }
+   }
+   out[1] = p_atomic_read(&redwood_bo_cache_stats.cached_bytes);
+   if (np_pressure(!!(flags & RWA_PRESSURE_POOL), holdoff_ms, out + 4) != 0)
+      return out[3] ? 0 : -1;
+   return 0;
+#else
+   (void)flags;
+   (void)holdoff_ms;
+   return -1;
+#endif
+}
 
