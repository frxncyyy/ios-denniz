+/* y2s95 (pressure): the open devices of this process (one in practice), read and changed only under rwa_lock */
+#define RWA_REGISTRY 4
+static struct rwa_device *rwa_registry[RWA_REGISTRY];
+
+static void
+rwa_registry_add(struct rwa_device *device)
+{
+   for (unsigned i = 0; i < RWA_REGISTRY; i++) {
+      if (!rwa_registry[i]) {
+         rwa_registry[i] = device;
+         return;
+      }
+   }
+}
+
+static void
+rwa_registry_del(struct rwa_device *device)
+{
+   for (unsigned i = 0; i < RWA_REGISTRY; i++)
