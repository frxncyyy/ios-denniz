+/*
+ * y2s95 (pressure): after a memory-pressure drain (np_pressure) the pool stays empty for a while: the refill thread makes nothing and a
+ * closed buffer goes straight back to the kernel instead of into the pool. 0: no hold-off.
+ */
+static volatile uint64_t np_holdoff_until;
+
+static int np_holdoff(void)
+{
+	uint64_t u = __atomic_load_n(&np_holdoff_until, __ATOMIC_RELAXED);
+
+	return u != 0 && now_ns() < u;
+}
+
 static int do_close(uint32_t h)
 {
 	struct bo *b;
@@ -990,7 +1003,7 @@
 	b = &D.bos[h];
 	if (b->pooled)
 		return np_fail(EINVAL);                                   /* closed twice */
-	if (D.pool_enabled && b->cls != 0xff && !b->imported && !b->heap && b->noexec && D.pool_count < NP_POOL_MAX_BOS &&
+	if (D.pool_enabled && !np_holdoff() && b->cls != 0xff && !b->imported && !b->heap && b->noexec && D.pool_count < NP_POOL_MAX_BOS &&
 	    D.pool_bytes + b->size <= NP_POOL_CAP) {
 		pool_push(h);                                                 /* the kernel buffer and its CPU mapping stay for the next one of this size */
 		D.stats.closes++;
@@ -1473,6 +1486,48 @@
 	pthread_mutex_unlock(&D.lock);
 }
 
+/*
+ * y2s95 (pressure): what this process holds through the shim, and (drain) every pooled buffer back to the kernel with the pool held
+ * empty for holdoff_ms. Pooled buffers belong to nobody (closed by Mesa, kept for reuse): giving them back is what new_bo_ex already
+ * does when an allocation is refused, under the same lock; a buffer the GPU still reads is freed by the kernel when idle (Busy).
+ * out: [0] pooled buffers returned [1] their bytes [2] live buffers (not pooled) [3] their bytes [4] imported (IOSurface) buffers
+ *      [5] imported bytes [6] buffers still pooled [7] pooled bytes left.  Returns -1 if the shim is not up.
+ */
+int np_pressure(int drain, unsigned holdoff_ms, uint64_t out[8])
+{
+	memset(out, 0, 8 * sizeof(out[0]));
+	pthread_mutex_lock(&D.lock);
+	if (!D.up || !D.bos) {
+		pthread_mutex_unlock(&D.lock);
+		return -1;
+	}
+	if (drain) {
+		uint64_t before = D.pool_bytes;
+
+		if (holdoff_ms)
+			__atomic_store_n(&np_holdoff_until, now_ns() + (uint64_t)holdoff_ms * 1000000ull, __ATOMIC_RELAXED);
+		out[0] = pool_drain();
+		out[1] = before - D.pool_bytes;
+	}
+	for (uint32_t h = 1; h <= NP_BOS; h++) {
+		const struct bo *b = &D.bos[h];
+
+		if (!b->kernel || b->kernel == 0xffffffffu || b->pooled)
+			continue;
+		if (b->imported) {
+			out[4]++;
+			out[5] += b->size;
+		} else {
+			out[2]++;
+			out[3] += b->size;
+		}
+	}
+	out[6] = D.pool_count;
+	out[7] = D.pool_bytes;
+	pthread_mutex_unlock(&D.lock);
+	return 0;
+}
+
 /* ------------------------------------------------------------------ pool pre-fill */
 
 /* One pool buffer of class c, made with the shim's lock released during the kernel call (a few ms; the renderer must not wait for it).
@@ -1485,7 +1540,7 @@
 	int e;
 
 	pthread_mutex_lock(&D.lock);
-	if (!D.up || !D.pool_enabled || D.pool_count >= NP_POOL_MAX_BOS || D.pool_bytes + size > NP_POOL_CAP) {
+	if (!D.up || !D.pool_enabled || np_holdoff() || D.pool_count >= NP_POOL_MAX_BOS || D.pool_bytes + size > NP_POOL_CAP) {
 		pthread_mutex_unlock(&D.lock);
 		return 0;
 	}
