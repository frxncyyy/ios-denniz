+/*
+ * ===================================================================================== PRESSURE (y2s95)
+ * The kernel has no jetsam here: memory-pressure notes reach a process and nobody acted on them (nord2_srcprobe only logged them, in
+ * backboardd and SpringBoard, with the bundle's diag marker). Every process that makes a Metal device now listens for its own
+ * WARN/CRITICAL notes and lets go of what its GPU driver keeps IDLE for reuse:
+ *   1. the library (rwa_memory_pressure, under the library's process-wide lock, so this process renders nothing through Mesa meanwhile):
+ *      Panfrost's BO cache (up to 64 MiB / 30 s, otherwise only trimmed when a buffer is put back), then the shim's pool of closed
+ *      buffers (up to 200 MiB / 320) back to the kernel, with no pooling or pre-fill for 10 s (WARN) / 30 s (CRITICAL);
+ *   2. the thumbnail-grid pools of Photos (y2s91: buffers 48 MiB, textures 40 MiB, converted thumbnails 32 MiB): only when none of them
+ *      was used for 2 s (a grid being scrolled keeps them; tried again 2.5 s later, up to 4 times), and of each only the entries whose
+ *      command buffers are back (rw_tg_safe) and that are not being zeroed (busy) -- the same rule as the pools' own sweeps.
+ * Nothing that is in use is freed: every one of these entries is owned by the cache it sits in. While the level stays WARN or worse
+ * (sysctl kern.memorystatus_vm_pressure_level) the same is done again every 30 s; never more than once per 5 s.
+ * One line per event and per process: 'NORD2 MEM GPU CTX: pid=.. name=.. private=..KiB/..bos imported=..KiB/..bos pooled=..' plus what
+ * was freed; one 'armed' line per process when the source is made.
+ *   /var/db/nord2-metal/no-pressure        no source at all (gpufinal4 behaviour); read once per process
+ *   /var/db/nord2-metal/pressure-dryrun    the source and the lines, nothing freed
+ */
+static struct {
+	dispatch_queue_t q;
+	dispatch_source_t src;
+	int dryrun;
+	uint64_t last_action;
+	int recheck_armed;
+} rw_mp;
+
+/* the thumbnail-grid pools emptied of what is idle and back from the GPU; returns entries and bytes dropped */
+static unsigned
+rw_tg_pressure_drop(size_t *bytes_out)
+{
+	struct rw_tg_pbuf *dropb = NULL, **pb;
+	struct rw_tg_ptex *dropt = NULL, **pt;
+	struct rw_tg_thumb *droph = NULL, **ph;
+	unsigned n = 0;
+	size_t bytes = 0;
+
+	pthread_once(&rw_tg_q_once, rw_tg_q_init);
+	pthread_mutex_lock(&rw_tg_buf_lock);
+	for (pb = &rw_tg_bufs; *pb != NULL;) {
+		struct rw_tg_pbuf *c = *pb;
+
+		if (!c->busy && rw_tg_safe(c->mark)) {
+			*pb = c->next;
+			rw_tg_buf_bytes -= c->cap;
+			rw_tg_buf_count--;
+			bytes += c->cap;
+			c->next = dropb;
+			dropb = c;
+			continue;
+		}
+		pb = &c->next;
+	}
+	pthread_mutex_unlock(&rw_tg_buf_lock);
+	pthread_mutex_lock(&rw_tg_tex_lock);
+	for (pt = &rw_tg_texs; *pt != NULL;) {
+		struct rw_tg_ptex *c = *pt;
+
+		if (rw_tg_safe(c->mark)) {
+			*pt = c->next;
+			rw_tg_tex_count--;
+			rw_tg_tex_bytes -= c->bytes;
+			bytes += c->bytes;
+			c->next = dropt;
+			dropt = c;
+			continue;
+		}
+		pt = &c->next;
+	}
+	pthread_mutex_unlock(&rw_tg_tex_lock);
+	pthread_mutex_lock(&rw_tg_thumb_lock);
+	for (ph = &rw_tg_thumbs; *ph != NULL;) {
+		struct rw_tg_thumb *c = *ph;
+
+		if (rw_tg_safe(c->mark)) {
+			*ph = c->next;
+			bytes += c->bytes;
+			c->next = droph;
+			droph = c;
+			continue;
+		}
+		ph = &c->next;
+	}
+	pthread_mutex_unlock(&rw_tg_thumb_lock);
+	/* destroyed outside the pool locks, as the sweeps do (the library takes its own lock) */
+	while (dropb != NULL) {
+		struct rw_tg_pbuf *x = dropb->next;
+
+		mesa.buffer_destroy(dropb->b);
+		free(dropb);
+		dropb = x;
+		n++;
+		__sync_add_and_fetch(&rw_tg_n.buf_drop, 1);
+	}
+	while (dropt != NULL) {
+		struct rw_tg_ptex *x = dropt->next;
+
+		mesa.texture_destroy(dropt->t);
+		free(dropt);
+		dropt = x;
+		n++;
+		__sync_add_and_fetch(&rw_tg_n.tex_drop, 1);
+	}
+	while (droph != NULL) {
+		struct rw_tg_thumb *x = droph->next;
+
+		rw_tg_thumb_free(droph);
+		droph = x;
+		n++;
+		__sync_add_and_fetch(&rw_tg_n.thumb_evict, 1);
+	}
+	*bytes_out = bytes;
+	return n;
+}
+
+static int
+rw_mp_kernel_level(void)
+{
+	int level = 0;
+	size_t len = sizeof(level);
+
+	if (sysctlbyname("kern.memorystatus_vm_pressure_level", &level, &len, NULL, 0) != 0) {
+		return -1;
+	}
+	return level;       /* 1 normal, 2 warn, 4 critical */
+}
+
+static void rw_mp_tg_try(int tries);
+
+static void
+rw_mp_tg_try(int tries)
+{
+	rw_tg_init();
+	if (!(rw_tg.bufpool || rw_tg.texpool || rw_tg.thumbcache) || mesa.buffer_destroy == NULL || mesa.texture_destroy == NULL) {
+		return;
+	}
+	uint64_t now = rw_now_ns(), last = __atomic_load_n(&rw_tg_last_use, __ATOMIC_RELAXED);
+
+	if (last != 0 && now - last < 2000000000ULL) {
+		if (tries < 4) {
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2500 * NSEC_PER_MSEC), rw_mp.q, ^{
+				rw_mp_tg_try(tries + 1);
+			});
+		} else {
+			m2m_log('I', "MEM", "NORD2 MEM GPU CTX: pid=%d name=%s thumbgrid pools kept: the grid is in use (%u buffers %zu KiB, %u textures)\n",
+			    getpid(), getprogname(), rw_tg_buf_count, rw_tg_buf_bytes >> 10, rw_tg_tex_count);
+		}
+		return;
+	}
+	size_t bytes = 0;
+	unsigned n = rw_mp.dryrun ? 0 : rw_tg_pressure_drop(&bytes);
+
+	m2m_log('I', "MEM", "NORD2 MEM GPU CTX: pid=%d name=%s thumbgrid pools idle %llu ms: %s %u entries, ~%zu KiB\n", getpid(), getprogname(),
+	    last ? (unsigned long long)((now - last) / 1000000ULL) : 0ULL, rw_mp.dryrun ? "dry run, would drop" : "dropped", n, bytes >> 10);
+}
+
+/* one event (or recheck) on rw_mp.q: level 0 normal (counts only), 1 warn, 2 critical */
+static void
+rw_mp_act(int level, const char *why)
+{
+	uint64_t now = rw_now_ns(), out[12] = { 0 };
+	int r = -1, acted = 0;
+	vm_statistics64_data_t vm;
+	mach_msg_type_number_t cnt = HOST_VM_INFO64_COUNT;
+	unsigned free_mib = 0;
+
+	if (host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t)&vm, &cnt) == KERN_SUCCESS) {
+		free_mib = (unsigned)((uint64_t)vm.free_count * vm_page_size >> 20);
+	}
+	if (level > 0 && !rw_mp.dryrun && (rw_mp.last_action == 0 || now - rw_mp.last_action >= 5000000000ULL)) {
+		rw_mp.last_action = now;
+		acted = 1;
+	}
+	if (mesa.memory_pressure != NULL) {
+		r = mesa.memory_pressure(acted ? (1u | 2u) : 0u, level >= 2 ? 30000u : 10000u, out);
+	}
+	m2m_log('I', "MEM", "NORD2 MEM GPU CTX: pid=%d name=%s private=%lluKiB/%llubos imported=%lluKiB/%llubos pooled=%lluKiB/%llubos "
+	    "bocache=%lluKiB/%llubos | %s %s, %u MiB free: %s; bocache %llu->%llu KiB, pool returned %llu bufs %llu KiB%s\n",
+	    getpid(), getprogname(), (unsigned long long)(out[7] >> 10), (unsigned long long)out[6], (unsigned long long)(out[9] >> 10),
+	    (unsigned long long)out[8], (unsigned long long)(out[11] >> 10), (unsigned long long)out[10], (unsigned long long)(out[1] >> 10),
+	    (unsigned long long)out[2], why, level >= 2 ? "CRITICAL" : level == 1 ? "WARN" : "NORMAL", free_mib,
+	    acted ? "freed" : level == 0 ? "counts only" : rw_mp.dryrun ? "dry run" : "rate-limited (5 s)",
+	    (unsigned long long)(out[0] >> 10), (unsigned long long)(out[1] >> 10), (unsigned long long)out[4], (unsigned long long)(out[5] >> 10),
+	    r != 0 ? " (no library call)" : "");
+	if (level > 0) {
+		rw_mp_tg_try(0);
+	}
+	if (level > 0 && !rw_mp.recheck_armed && rw_mp_kernel_level() >= 0) {
+		rw_mp.recheck_armed = 1;
+		dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC), rw_mp.q, ^{
+			int k = rw_mp_kernel_level();
+
+			rw_mp.recheck_armed = 0;
+			if (k >= 2) {
+				rw_mp_act(k >= 4 ? 2 : 1, "recheck");
+			}
+		});
+	}
+}
+
+static void
+rw_mp_install(void)
+{
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		if (access("/var/db/nord2-metal/no-pressure", F_OK) == 0) {
+			m2m_log('I', "MEM", "NORD2 MEM GPU CTX: pid=%d name=%s pressure handler OFF (no-pressure)\n", getpid(), getprogname());
+			return;
+		}
+		rw_mp.dryrun = access("/var/db/nord2-metal/pressure-dryrun", F_OK) == 0;
+		rw_mp.q = dispatch_queue_create("com.redwood.metal.pressure", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+		    QOS_CLASS_UTILITY, 0));
+		rw_mp.src = dispatch_source_create(DISPATCH_SOURCE_TYPE_MEMORYPRESSURE, 0,
+		    DISPATCH_MEMORYPRESSURE_NORMAL | DISPATCH_MEMORYPRESSURE_WARN | DISPATCH_MEMORYPRESSURE_CRITICAL, rw_mp.q);
+		if (rw_mp.src == NULL) {
+			m2m_log('W', "MEM", "NORD2 MEM GPU CTX: pid=%d name=%s no memory-pressure source could be made\n", getpid(), getprogname());
+			return;
+		}
+		dispatch_source_set_event_handler(rw_mp.src, ^{
+			unsigned long m = dispatch_source_get_data(rw_mp.src);
+
+			rw_mp_act((m & DISPATCH_MEMORYPRESSURE_CRITICAL) ? 2 : (m & DISPATCH_MEMORYPRESSURE_WARN) ? 1 : 0, "event");
+		});
+		dispatch_resume(rw_mp.src);
+		m2m_log('I', "MEM", "NORD2 MEM GPU CTX: pid=%d name=%s pressure handler armed%s (library call %s, kernel level %d)\n", getpid(),
+		    getprogname(), rw_mp.dryrun ? " DRY RUN" : "", mesa.memory_pressure != NULL ? "found" : "missing", rw_mp_kernel_level());
+	});
+}
