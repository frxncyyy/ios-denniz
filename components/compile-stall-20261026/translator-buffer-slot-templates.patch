+/// One statically used buffer slot of a plan as instantiation reads it: the window the stages
+/// reach, the descriptor `(set, binding)` of a descriptor-form slot, the descriptor base alignment
+/// and maximum range, whether it is read through a uniform view no written slot may overlap
+/// (`disjoint`), and whether it is written. A consumer that keeps an instantiated draw across
+/// binds that differ only in a buffer's bind offset or allocation length re-derives each
+/// descriptor range and `SlotBindOffset` residual from these with the rule
+/// `bind::instantiate::descriptor_range` documents.
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BufferSlotTemplate {
+    pub slot: SlotRef,
+    pub window: Window,
+    pub descriptor: Option<(u32, u32)>,
+    pub alignment: u64,
+    pub max_range: u64,
+    pub disjoint: bool,
+    pub written: bool,
+}
+
+impl BindingPlan {
+    /// Every statically used buffer slot of the plan (compute or render), by slot.
+    pub fn buffer_slot_templates(&self) -> Vec<BufferSlotTemplate> {
+        let buffers = match (&self.compute, &self.graphics) {
+            (Some(c), _) => &c.buffers,
+            (None, Some(g)) => &g.buffers,
+            (None, None) => return Vec::new(),
+        };
+        buffers
+            .iter()
+            .map(|pb| BufferSlotTemplate {
+                slot: pb.slot,
+                window: pb.window,
+                descriptor: match pb.form {
+                    BufferForm::Descriptor(_) => pb.binding,
+                    _ => None,
+                },
+                alignment: pb.alignment,
+                max_range: pb.max_range,
+                disjoint: pb.disjoint,
+                written: pb.access.write,
+            })
+            .collect()
+    }
+}
+
+impl BufferSlotTemplate {
+    /// The descriptor range `(offset, range)` and `SlotBindOffset` residual instantiation binds
+    /// for this slot's buffer bound at `bind_offset` in an allocation of `length` bytes (the
+    /// rule of `bind::instantiate::descriptor_range`), or `None` where instantiation refuses it
+    /// (an empty allocation, or a range above `max_range`).
+    pub fn descriptor_range(&self, bind_offset: u64, length: u64) -> Option<(u64, u64, u32)> {
+        crate::bind::instantiate::descriptor_range(
+            bind_offset,
+            length,
+            self.window,
+            self.alignment,
+            self.max_range,
+        )
+        .ok()
+        .map(|(range, residual)| (range.offset, range.range, residual))
+    }
+}
+
