+/* A word-wise multiply-xor hash of the canonical key (draw, layouts, key records): a cheap
+ * pre-check before the full comparison, never a substitute for it. */
+static uint64_t tegu_plan_memo_mix(uint64_t h,const void *p,size_t n) {
+ const unsigned char *b=(const unsigned char *)p;
+ for(;n>=8;n-=8,b+=8){uint64_t w;memcpy(&w,b,8);h=(h^w)*0x9e3779b97f4a7c15ull;h^=h>>29;}
+ if(n){uint64_t w=0;memcpy(&w,b,n);h=(h^w^((uint64_t)n<<56))*0x9e3779b97f4a7c15ull;h^=h>>29;}
+ return h;
+}
+static uint64_t tegu_plan_memo_hash(const TeguAIRRenderDraw *draw,const TeguAIRVertexLayout *layouts,unsigned layoutCount,
+ const TeguAIRRenderResource *keys,size_t count) {
+ uint64_t h=0x243f6a8885a308d3ull;
+ h=tegu_plan_memo_mix(h,draw,sizeof(*draw));h=tegu_plan_memo_mix(h,layouts,layoutCount*sizeof(*layouts));
+ h=tegu_plan_memo_mix(h,keys,count*sizeof(*keys));
+ return h?h:1;
