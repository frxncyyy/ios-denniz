+/* y2s65: camera_isp.c's isp_measure() choice of step for a frame of cw x ch cells (the whole frame) */
+static uint32_t
+isp_stats_step(uint32_t cw, uint32_t ch)
+{
+   uint32_t step = cw >= 1024 && ch >= 768 ? 8 : cw >= 256 && ch >= 192 ? 4 : 2;
+
+   return cw < 256 ? 4 : step;
+}
