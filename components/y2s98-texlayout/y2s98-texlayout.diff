+/*
+ * y2s98 (texlayout): the texture layout of block-compressed (ASTC) textures and the texture made over memory laid out by it.
+ *
+ * The two device selectors below (-newTextureLayoutWithDescriptor:isHeapOrBufferBacked: and
+ * -newTextureWithBytesNoCopy:length:descriptor:deallocator:) answered nil until now, and that is why every ASTC picture
+ * CoreAnimation is given as a CGImage -- the .atx snapshots PosterBoard shows in the wallpaper gallery and SpringBoard shows
+ * for the wallpaper and the application switcher -- was composited as NOTHING: ImageIO (ASTCTwiddler) builds the "texture
+ * memory" with the device's layout, CA::Render::CompressedImage carries it to the window server, and
+ * CA::OGL::MetalContext::update_texture makes the texture with -newTextureWithBytesNoCopy: (its only caller in QuartzCore;
+ * deallocator nil, the image keeps the bytes).  rw_texlayout_pure.h has the layout (linear rows of blocks, levels packed) and
+ * the evidence; the object here forwards to it.
+ *
+ * The texture is made by COPYING the levels in (-replaceRegion:'s path, rwa_texture_write), which the old comment refused
+ * for a caller that goes on writing to its pages.  A block-compressed picture is not such a caller: nobody encodes ASTC in
+ * place, CoreAnimation's CompressedImage is immutable, and only the formats rw_texlayout_pure.h serves get here -- every
+ * other descriptor is answered nil as before.
+ *
+ * Switch /var/db/nord2-metal/no-texlayout (read once per process): both selectors answer nil again (gpufinal6 behaviour).
+ * Lines: 'NORD2 GPU TEXLAYOUT: pid= name= config ON|OFF (no-texlayout n) y2s98' once per process that asks;
+ *        'NORD2 GPU TEXLAYOUT: pid= name= layouts=N refused=R | textures ok=K (bytes B) refused=F' at 1, 2, 4, 8... events;
+ *        'I RES texlayout: ...' for the first layouts and textures, 'W RES texlayout: ...' for every kind of refusal.
+ */
+#include "rw_texlayout_pure.h"
+
+static struct {
+	BOOL on;
+	unsigned long layouts, layouts_refused, textures, textures_refused, events;
+	unsigned long long bytes;
+} rw_tl;
+static pthread_mutex_t rw_tl_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL
+rw_tl_on(void)
+{
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		int off = access("/var/db/nord2-metal/no-texlayout", F_OK) == 0;
+
+		rw_tl.on = !off;
+		m2m_log('I', "RES", "NORD2 GPU TEXLAYOUT: pid=%d name=%s config %s (no-texlayout %d) y2s98\n", getpid(), getprogname(),
+		    off ? "OFF" : "ON", off);
+	});
+	return rw_tl.on;
+}
+
+/* which: 0 a layout made, 1 a layout refused, 2 a texture made (`bytes` copied), 3 a texture refused */
+static void
+rw_tl_count(int which, size_t bytes)
+{
+	unsigned long n, a, b, c, d;
+	unsigned long long by;
+
+	pthread_mutex_lock(&rw_tl_lock);
+	if (which == 0) {
+		rw_tl.layouts++;
+	} else if (which == 1) {
+		rw_tl.layouts_refused++;
+	} else if (which == 2) {
+		rw_tl.textures++;
+		rw_tl.bytes += bytes;
+	} else {
+		rw_tl.textures_refused++;
+	}
+	n = ++rw_tl.events;
+	a = rw_tl.layouts; b = rw_tl.layouts_refused; c = rw_tl.textures; d = rw_tl.textures_refused; by = rw_tl.bytes;
+	pthread_mutex_unlock(&rw_tl_lock);
+	if ((n & (n - 1)) == 0) {
+		m2m_log('I', "RES", "NORD2 GPU TEXLAYOUT: pid=%d name=%s layouts=%lu refused=%lu | textures ok=%lu (bytes %llu) "
+		    "refused=%lu\n", getpid(), getprogname(), a, b, c, by, d);
+	}
+}
+
+/* The layout of a descriptor, or -1 with *why: a 2D, one-slice, one-sample texture of a format rw_texlayout_pure.h serves. */
+static int
+rw_tl_of(MTLTextureDescriptor *descriptor, struct rwtl_layout *l, const char **why)
+{
+	if (descriptor == nil) {
+		*why = "no descriptor";
+		return -1;
+	}
+	if ([descriptor textureType] != 2 /* MTLTextureType2D */ || [descriptor depth] > 1 || [descriptor arrayLength] > 1 ||
+	    [descriptor sampleCount] > 1) {
+		*why = "not a plain 2D texture";
+		return -1;
+	}
+	if ([descriptor width] > RWTL_MAX_SIDE || [descriptor height] > RWTL_MAX_SIDE || [descriptor mipmapLevelCount] > RWTL_MAX_LEVELS) {
+		*why = "larger than this layout goes";
+		return -1;
+	}
+	return rwtl_init(l, (uint32_t)[descriptor pixelFormat], (uint32_t)[descriptor width], (uint32_t)[descriptor height],
+	    (uint32_t)[descriptor mipmapLevelCount], why);
+}
+
+struct rw_tl_watermark { uint64_t a, b; };      /* 16 bytes in x0/x1, as AGXTextureLayout's (-[AGXTextureLayout watermark]) */
+
+/* MTLTextureLayout, the selectors ImageIO and QuartzCore send (AGXTextureLayout's list). */
+@interface RedwoodMetalTextureLayout : NSObject {
+	struct rwtl_layout _l;
+}
+- (instancetype)initWithRedwoodLayout:(const struct rwtl_layout *)layout;
+@end
+
+@implementation RedwoodMetalTextureLayout
+
+- (instancetype)initWithRedwoodLayout:(const struct rwtl_layout *)layout
+{
+	self = [super init];
+	if (self != nil) {
+		_l = *layout;
+	}
+	return self;
+}
+
+- (NSUInteger)size                 { return _l.size; }
+/* what the callers round their allocation up to (ImageIO) or assert is no more than a page (CoreAnimation) */
+- (NSUInteger)alignment            { return 64; }
+- (MTLSize)copyGranularity         { return MTLSizeMake(_l.block_w, _l.block_h, 1); }
+/* 0: the layout the ATX files written while this driver had no layout are already in (rw_texlayout_pure.h) */
+- (struct rw_tl_watermark)watermark { struct rw_tl_watermark w = { 0, 0 }; return w; }
+
+/* AGX's is empty too, and it has to be: ImageIO sends it before EVERY level's copy, so clearing here would wipe the levels
+ * already copied. */
+- (void)initializeTextureMemory:(void *)memory { (void)memory; }
+- (void)finalizeTextureMemory:(void *)memory   { (void)memory; }
+
+- (void)copyFromLinearBytes:(const void *)linear
+	       linearOffset:(NSUInteger)offset
+	  linearBytesPerRow:(NSUInteger)rowBytes
+	linearBytesPerImage:(NSUInteger)imageBytes
+	    toTextureMemory:(void *)memory
+	       textureSlice:(NSUInteger)slice
+	       textureLevel:(NSUInteger)level
+	      textureRegion:(MTLRegion)region
+{
+	const char *why = "a slice or a depth this 2D layout does not have";
+
+	(void)imageBytes;
+	if (slice != 0 || region.origin.z != 0 || region.size.depth > 1 || level >= _l.levels ||
+	    rwtl_copy_in(&_l, memory, (uint32_t)level, region.origin.x, region.origin.y, region.size.width, region.size.height,
+	    linear, offset, rowBytes, &why) != 0) {
+		RW_AGAIN('W', "RES", "texlayout: blocks NOT copied into texture memory (%s): level %lu region %lu,%lu %lux%lu of "
+		    "%ux%u format %u, %lu bytes a row\n", why, (unsigned long)level, (unsigned long)region.origin.x,
+		    (unsigned long)region.origin.y, (unsigned long)region.size.width, (unsigned long)region.size.height, _l.width,
+		    _l.height, _l.format, (unsigned long)rowBytes);
+	}
+}
+
+- (void)copyFromTextureMemory:(const void *)memory
+		 textureSlice:(NSUInteger)slice
+		 textureLevel:(NSUInteger)level
+		textureRegion:(MTLRegion)region
+		toLinearBytes:(void *)linear
+		 linearOffset:(NSUInteger)offset
+	    linearBytesPerRow:(NSUInteger)rowBytes
+	  linearBytesPerImage:(NSUInteger)imageBytes
+{
+	const char *why = "a slice or a depth this 2D layout does not have";
+
+	(void)imageBytes;
+	if (slice != 0 || region.origin.z != 0 || region.size.depth > 1 || level >= _l.levels ||
+	    rwtl_copy_out(&_l, memory, (uint32_t)level, region.origin.x, region.origin.y, region.size.width, region.size.height,
+	    linear, offset, rowBytes, &why) != 0) {
+		RW_AGAIN('W', "RES", "texlayout: blocks NOT copied out of texture memory (%s): level %lu region %lu,%lu %lux%lu of "
+		    "%ux%u format %u, %lu bytes a row\n", why, (unsigned long)level, (unsigned long)region.origin.x,
+		    (unsigned long)region.origin.y, (unsigned long)region.size.width, (unsigned long)region.size.height, _l.width,
+		    _l.height, _l.format, (unsigned long)rowBytes);
+	}
+}
+
+@end
+
+/* Runs a -newTextureWithBytesNoCopy: deallocator when the texture it is tied to goes (CoreAnimation passes none). */
+@interface RedwoodMetalTextureBytes : NSObject {
+	void (^_deallocator)(void *, NSUInteger);
+	void *_bytes;
+	NSUInteger _length;
+}
+- (instancetype)initWithBytes:(void *)bytes length:(NSUInteger)length deallocator:(void (^)(void *, NSUInteger))deallocator;
+@end
+
+@implementation RedwoodMetalTextureBytes
+
+- (instancetype)initWithBytes:(void *)bytes length:(NSUInteger)length deallocator:(void (^)(void *, NSUInteger))deallocator
+{
+	self = [super init];
+	if (self != nil) {
+		_deallocator = [deallocator copy];
+		_bytes = bytes;
+		_length = length;
+	}
+	return self;
+}
+
+- (void)dealloc
+{
+	if (_deallocator != nil) {
+		_deallocator(_bytes, _length);
+		[_deallocator release];
+	}
+	[super dealloc];
+}
+
+@end
+
