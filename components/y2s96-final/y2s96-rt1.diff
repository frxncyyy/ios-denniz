+/*
+ * y2s96 (A, investigation only): with /var/db/nord2-metal/trace-cc present, backboardd does what com.redwood.metal.trace does
+ * (the next 3 command buffers written out draw by draw: 'TRACE trace: a command buffer of N steps (asked for)' + one
+ * 'TRACE trace:   pass ...' line per step) by itself: first 60 s after its first commit, then every 15 s, 20 times (5 minutes),
+ * so that Control Center held open over Photos in that window is caught without a shell on the phone. Absent: nothing.
+ */
+static void
+rw_trace_cc_maybe(void)
+{
+	static int on = -1;
+	static uint64_t next;
+	static unsigned shots;
+	static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER;
+	uint64_t now;
+
+	if (on == 0 || pthread_mutex_trylock(&lk) != 0) {
+		return;
+	}
+	now = rw_now_ns();
+	if (on < 0) {
+		on = strcmp(getprogname(), "backboardd") == 0 && access("/var/db/nord2-metal/trace-cc", F_OK) == 0;
+		next = now + 60000000000ULL;
+		if (on) {
+			m2m_log('I', "TRACE", "trace-cc: armed: 3 command buffers traced every 15 s from 60 s on, 20 times\n");
+		}
+	}
+	if (on > 0 && shots < 20 && now >= next) {
+		next = now + 15000000000ULL;
+		shots++;
+		if (rw_trace_force <= 0) {
+			rw_trace_force = 3;
+		}
+		m2m_log('I', "TRACE", "trace-cc: shot %u/20: the next 3 command buffers are written out draw by draw\n", shots);
+	}
+	pthread_mutex_unlock(&lk);
+}
+
+static void
+rw_fb_report_maybe(void)
+{
+	static uint64_t last, prev[16];
+	static uint64_t prev_works;
+	static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER;
+	uint64_t now = rw_now_ns(), c[16] = { 0 };
+
+	rw_fb_init();
+	if (rw_fb.stats == NULL || now - last < 5000000000ULL || pthread_mutex_trylock(&lk) != 0) {
+		return;
+	}
+	if (now - last < 5000000000ULL) {
+		pthread_mutex_unlock(&lk);
+		return;
+	}
+	last = now;
+	rw_fb.stats(c);
+	if (memcmp(c, prev, sizeof(c)) != 0 || rw_fb.works != prev_works) {
+		m2m_log('I', "FB", "NORD2 GPU FB: pid=%d name=%s rt1 drawn=%llu preload avoided=%llu store discarded=%llu violations=%llu | "
+		    "restored=%llu unseen=%llu | single-target cbs=%llu targets=%llu works=%llu draws=%llu clears=%llu refused=%llu | "
+		    "deadstore %s discarded=%llu violations=%llu tablefull=%llu\n", getpid(), getprogname(),
+		    (unsigned long long)c[0], (unsigned long long)c[1], (unsigned long long)c[2], (unsigned long long)c[4],
+		    (unsigned long long)c[3], (unsigned long long)c[9], (unsigned long long)rw_fb.cbs, (unsigned long long)rw_fb.targets,
+		    (unsigned long long)rw_fb.works, (unsigned long long)c[7], (unsigned long long)c[11], (unsigned long long)c[8],
+		    (rw_fb.flags & RWA_FB_DEADSTORE) ? "on" : "off", (unsigned long long)c[5], (unsigned long long)c[6],
+		    (unsigned long long)c[10]);
+		memcpy(prev, c, sizeof(c));
+		prev_works = rw_fb.works;
+	}
+	pthread_mutex_unlock(&lk);
+}
