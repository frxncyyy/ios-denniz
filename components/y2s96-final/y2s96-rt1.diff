+static void
+rw_fb_single_target(NSArray *works)
+{
+	struct { id t; unsigned level, slice; BOOL bad; } tg[RW_FB_TARGETS];
+	unsigned n = 0, good = 0, flagged = 0;
+
+	rw_fb_init();
+	if (!rw_fb.single || rw_fb.stats == NULL) {
+		return;
+	}
+	for (RedwoodMetalWork *w in works) {
+		if ((w->render == nil && !w->clearOnly) || w->colorCount != 2 || w->color[0] == nil || w->color[1] == nil) {
+			continue;
+		}
+		unsigned k;
+
+		for (k = 0; k < n; k++) {
+			if (tg[k].t == w->color[0] && tg[k].level == w->colorLevel[0] && tg[k].slice == w->colorSlice[0]) {
+				break;
+			}
+		}
+		if (k == n) {
+			if (n == RW_FB_TARGETS) {
+				continue;
+			}
+			tg[n].t = w->color[0];
+			tg[n].level = w->colorLevel[0];
+			tg[n].slice = w->colorSlice[0];
+			tg[n].bad = NO;
+			n++;
+		}
+		BOOL writes = w->render != nil && (([w->render colorWriteMasks] >> 4) & 0xf) != 0;
+
+		if (writes || (w->clearMask & 2u) || w->loads[1] == MTLLoadActionClear || w->color[1] == w->color[0]) {
+			tg[k].bad = YES;
+		}
+	}
+	for (unsigned k = 0; k < n; k++) {
+		good += !tg[k].bad;
+	}
+	if (good == 0) {
+		return;
+	}
+	for (RedwoodMetalWork *w in works) {
+		if ((w->render == nil && !w->clearOnly) || w->colorCount != 2 || w->color[0] == nil || w->color[1] == nil) {
+			continue;
+		}
+		for (unsigned k = 0; k < n; k++) {
+			if (tg[k].t == w->color[0] && tg[k].level == w->colorLevel[0] && tg[k].slice == w->colorSlice[0]) {
+				if (!tg[k].bad) {
+					w->dropMask = 2u;
+					flagged++;
+				}
+				break;
+			}
+		}
+	}
+	__sync_add_and_fetch(&rw_fb.cbs, 1);
+	__sync_add_and_fetch(&rw_fb.targets, good);
+	__sync_add_and_fetch(&rw_fb.works, flagged);
+}
